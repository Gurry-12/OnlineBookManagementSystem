@using OnlineBookManagementSystem.Models.ViewModel
@model BookListViewModel
<link href="~/css/booksindex.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" />
<link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet" />

@{
    ViewData["Title"] = "Books List";
}

<div class="container mt-4">
    <h2>Book List</h2>
    <div class="table-responsive">
        <table id="booksTable" class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Image</th>
                    <th>Title</th>
                    <th>Author</th>
                    <th>Category</th>
                    <th>Price</th>
                    <th>Stock</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var book in Model.Books)
                {
                    <tr>
                        <td><img src="@book.ImgUrl" alt="@book.Title" style="height: 50px; width: auto;" /></td>
                        <td>@book.Title</td>
                        <td>@book.Author</td>
                        <td>@book.CategoryName</td>
                        <td>@book.Price</td>
                        <td>@book.Stock</td>
                        <td>
                            <a href="/Books/GetBookDetails/@book.Id" class="btn btn-warning btn-sm">Edit</a>
                            <button class="btn btn-danger btn-sm" onclick="DeleteBookEntry(@book.Id)">Delete</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
<!-- Toastr JS -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>

<script>
    $(document).ready(function () {
        $('#booksTable').DataTable({
             "paging": true,
             "searching": true,
             "ordering": true,
             "pageLength": 10
        });
    });

    function DeleteBookEntry(id) {
        if (confirm('Are you sure you want to delete this book?')) {
            $.ajax({
                url: '/Books/DeleteBook/' + id,
                type: 'DELETE',
                success: function (response) {
                    if (response.success) {
                        toastr.success(response.message);
                        // Reload page or remove row
                        location.reload();
                    } else {
                        toastr.error('Failed to delete book.');
                    }
                },
                error: function () {
                    toastr.error('Error occurred while deleting book.');
                }
            });
        }
    }
</script>
