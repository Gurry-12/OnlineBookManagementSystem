@model List<OnlineBookManagementSystem.Models.ViewModel.CategoryClassifyViewModel>
@{
    ViewData["Title"] = "Browse by Categories";
    Layout = User.IsInRole("User") ? "_LayoutUser" : "_LayoutPublic";
}

<div class="container-fluid py-4">
    <div class="row">
        <div class="col-12">
            <h2 class="text-center mb-5 display-5 fw-bold text-primary">
                <i class="bi bi-tags me-3"></i>Browse by Categories
            </h2>

            @if (Model != null && Model.Any())
            {
                @foreach (var category in Model)
                {
                    <div class="mb-5">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h3 class="text-primary">
                                <i class="bi bi-tag me-2"></i>@category.CategoryName
                            </h3>
                            <span class="badge bg-primary rounded-pill">@category.Books.Count books</span>
                        </div>

                        @if (category.Books.Any())
                        {
                            <div class="row g-4">
                                @foreach (var book in category.Books.Take(6))
                                {
                                    <div class="col-lg-2 col-md-3 col-sm-4 col-6">
                                        <div class="card h-100 shadow-sm border-0 book-card">
                                            <div class="position-relative">
                                                @if (!string.IsNullOrEmpty(book.ImageUrl))
                                                {
                                                    <img src="@book.ImageUrl" alt="@book.Title" class="card-img-top book-cover">
                                                }
                                                else
                                                {
                                                    <div class="card-img-top book-cover bg-light d-flex align-items-center justify-content-center">
                                                        <i class="fas fa-book fa-2x text-muted"></i>
                                                    </div>
                                                }
                                                
                                                @if (book.StockQuantity <= 0)
                                                {
                                                    <div class="position-absolute top-0 end-0 m-2">
                                                        <span class="badge bg-danger">Out of Stock</span>
                                                    </div>
                                                }
                                            </div>
                                            
                                            <div class="card-body p-3">
                                                <h6 class="card-title text-truncate" title="@book.Title">@book.Title</h6>
                                                <p class="card-text text-muted small mb-2">by @book.Author</p>
                                                <div class="d-flex justify-content-between align-items-center">
                                                    <span class="fw-bold text-primary">₹@book.Price.ToString("F2")</span>
                                                    @if (book.StockQuantity > 0)
                                                    {
                                                        <small class="text-success">In Stock</small>
                                                    }
                                                </div>
                                            </div>
                                            
                                            <div class="card-footer bg-transparent border-0 p-3 pt-0">
                                                <div class="d-grid gap-2">
                                                    <a asp-controller="Books" asp-action="Details" asp-route-id="@book.Id" 
                                                       class="btn btn-outline-primary btn-sm">
                                                        <i class="fas fa-eye me-1"></i>View Details
                                                    </a>
                                                    
                                                    @if (User.Identity?.IsAuthenticated == true && User.IsInRole("User") && book.StockQuantity > 0)
                                                    {
                                                        <button onclick="addToCart(@book.Id)" class="btn btn-primary btn-sm">
                                                            <i class="fas fa-cart-plus me-1"></i>Add to Cart
                                                        </button>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                            
                            @if (category.Books.Count > 6)
                            {
                                <div class="text-center mt-3">
                                    <a asp-controller="Books" asp-action="PublicList" asp-route-categoryId="@category.Books.First().CategoryId" 
                                       class="btn btn-outline-primary">
                                        <i class="fas fa-plus me-1"></i>View All @category.CategoryName Books (@category.Books.Count)
                                    </a>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="text-center py-4">
                                <i class="fas fa-book-open fa-3x text-muted mb-3"></i>
                                <p class="text-muted">No books available in this category yet.</p>
                            </div>
                        }
                    </div>
                }
            }
            else
            {
                <div class="text-center py-5">
                    <i class="fas fa-tags fa-3x text-muted mb-4"></i>
                    <h4>No Categories Available</h4>
                    <p class="text-muted">Categories will appear here once books are added to the system.</p>
                    <a asp-controller="Books" asp-action="PublicList" class="btn btn-primary">
                        <i class="fas fa-book me-2"></i>Browse All Books
                    </a>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <script src="~/js/cart-utils.js"></script>
}

<style>
    .book-card {
        transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
    }
    
    .book-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 25px rgba(0,0,0,0.15);
    }
    
    .book-cover {
        height: 200px;
        object-fit: cover;
    }
    
    .card-title {
        font-size: 0.9rem;
        line-height: 1.2;
    }
    
    .card-text {
        font-size: 0.8rem;
    }
    
    .btn-sm {
        font-size: 0.75rem;
        padding: 0.25rem 0.5rem;
    }
</style>