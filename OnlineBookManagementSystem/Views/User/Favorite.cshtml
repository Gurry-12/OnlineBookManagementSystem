@model IEnumerable<OnlineBookManagementSystem.Models.Book>

@{
    ViewData["Title"] = "My Favorites";
    Layout = ViewData["Layout"]?.ToString() ?? "_LayoutUser";
}

<link href="~/css/booksindex.css" rel="stylesheet" />

<div class="container">
    <h2 class="mb-4">❤️ My Favorite Books</h2>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center">
            <i class="bi bi-heart fs-1 mb-2"></i>
            <h4>No favorites yet!</h4>
            <p>Browse books and add some to your favorites.</p>
            <a asp-controller="User" asp-action="Dashboard" class="btn btn-primary">Start Browsing</a>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var book in Model)
            {
                <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                    <div class="book-card shadow-sm p-2 bg-white rounded position-relative h-100">
                        <img src="@(book.ImageUrl ?? Url.Content("~/images/default-book.jpg"))" alt="@book.Title" class="book-image" />
                        <h6 class="mt-2">@book.Title</h6>
                        <small class="text-muted">@book.Author</small>
                        <p class="text-primary fw-bold">₹@book.Price</p>
                        <div class="d-flex justify-content-between align-items-center mt-2">
                            <button onclick="ToggleFavorite(@book.Id)" class="btn btn-outline-danger btn-sm" style="z-index: 2;">
                                <i class="bi bi-heart-fill"></i> Remove
                            </button>
                            <button onclick="AddToCart(@book.Id)" class="btn btn-primary btn-sm" style="z-index: 2;">Add to Cart</button>
                        </div>
                        <a asp-controller="User" asp-action="BookDetails" asp-route-id="@book.Id" class="stretched-link"></a>
                    </div>
                </div>
            }
        </div>
    }
</div>

@await Html.PartialAsync("_Notification")

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/js/toastr.min.js"></script>
    <script>
        function ToggleFavorite(id) {
            $.post('/Books/ToggleFavorite', { bookId: id }, function(res) {
                if (res.success) {
                    toastr.success('Removed from favorites!');
                    location.reload();
                } else toastr.error('Failed to update.');
            });
        }

        function AddToCart(id) {
            // Using authFetch if available, or fetch
            fetch('/User/AddToCart', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ bookId: id, quantity: 1 })
            })
            .then(response => {
                // If 401/403, redirect to login might be needed, or authFetch handles it
                if (response.status === 401) {
                    window.location.href = '/Auth/Login';
                    return;
                }
                return response.json();
            })
            .then(res => {
                if (res.success) {
                    toastr.success(res.message);
                } else {
                    toastr.error(res.message);
                }
            })
            .catch(err => console.error(err));
        }
    </script>
}