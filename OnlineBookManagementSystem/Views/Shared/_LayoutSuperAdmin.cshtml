<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Whispering Pages Super Admin </title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <link href="~/css/site.css" rel="stylesheet" />
    <link href="~/css/color.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/layouts.css" asp-append-version="true" />
    <!-- Toastr CSS -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet" />

    @RenderSection("Styles", required: false)
</head>
<body class="superadmin-layout">

    <header>
        <nav class="navbar navbar-expand-lg bg-danger text-white px-4 py-3">
            <!-- Danger for super -->
            <div class="container-fluid">
                <a class="navbar-brand fw-bold text-white" asp-controller="SuperAdmin" asp-action="Dashboard">
                    <img src="~/images/render_main_logo_30x301.png" alt="Logo" style="height: 30px; filter: brightness(0) invert(1);">
                    Whispering Pages - Super Admin
                </a>
                <ul class="navbar-nav me-auto">
                    <li class="nav-item"><a class="nav-link text-white" asp-controller="SuperAdmin" asp-action="Dashboard"><i class="bi bi-house me-1"></i>Super Dashboard</a></li>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle text-white" href="#" role="button" data-bs-toggle="dropdown">
                            <i class="bi bi-gear me-1"></i>System
                        </a>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" asp-controller="Auth" asp-action="ManageUsers"><i class="bi bi-people"></i> Manage Users/Roles</a></li>
                            <li><a class="dropdown-item" asp-controller="Logs" asp-action="Index"><i class="bi bi-journal"></i> Activity Logs</a></li>
                            <li><a class="dropdown-item" asp-controller="Settings" asp-action="Index"><i class="bi bi-sliders"></i> Site Settings</a></li>
                        </ul>
                    </li>
                    <li class="nav-item"><a class="nav-link text-white" asp-controller="Books" asp-action="AdminIndex"><i class="bi bi-book me-1"></i>Books (Admin)</a></li>
                </ul>
                <div class="ms-auto d-flex gap-2">
                    <a class="btn btn-outline-light" asp-controller="Auth" asp-action="ProfileView"><i class="bi bi-person me-1"></i>@User.Identity?.Name</a>
                    <form asp-controller="Auth" asp-action="Logout" method="post" style="display: inline;">
                        <button type="submit" class="btn btn-light" id="LogoutBtn"><i class="bi bi-box-arrow-right me-1"></i>Logout</button>
                    </form>
                </div>
            </div>
        </nav>
    </header>

    <main class="container py-4">
        @RenderBody()
    </main>

    <footer class="text-center py-4 text-muted bg-light">
        <div class="container">
            &copy; 2025 - Whispering Pages <i class="bi bi-book-half"></i> | Super Admin Mode - Full Access
        </div>
    </footer>

    <!-- Same scripts -->
    @await RenderSectionAsync("Scripts", required: false)
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <script src="~/js/auth/auth.js"></script>
    <script src="~/js/books/bookshome.js"></script>
    <script src="~/js/site.js"></script>
</body>
</html>