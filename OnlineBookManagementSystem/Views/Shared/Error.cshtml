@model ErrorViewModel
@{
    ViewData["Title"] = ViewData["Title"] ?? "Error";
    Layout = "~/Views/Shared/_LayoutPublic.cshtml"; // Use the public layout for errors
}

<div class="container-fluid d-flex align-items-center justify-content-center min-vh-100 bg-light">
    <div class="row justify-content-center w-100">
        <div class="col-md-6 col-lg-5">
            <div class="card border-0 shadow-lg rounded-4">
                <div class="card-body text-center p-5">
                    <div class="mb-4">
                        <i class="bi bi-exclamation-triangle-fill text-danger" style="font-size: 4rem;"></i>
                    </div>
                    
                    <h1 class="display-6 fw-bold text-danger mb-3">@ViewData["ErrorCode"] - @ViewData["Title"]</h1>
                    
                    @if (Model?.ShowRequestId == true)
                    {
                        <div class="alert alert-light border mb-3">
                            <small class="text-muted">Request ID: <code>@Model.RequestId</code></small>
                        </div>
                    }
                    
                    <p class="text-muted mb-4 lead">
                        @ViewData["ErrorMessage"]
                    </p>
                    
                    <div class="d-flex flex-column flex-sm-row gap-3 justify-content-center">
                        <button onclick="history.back()" class="btn btn-outline-primary">
                            <i class="bi bi-arrow-left me-2"></i>Go Back
                        </button>
                        <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
                            <i class="bi bi-house me-2"></i>Go Home
                        </a>
                        @if (ViewData["ErrorCode"] as string == "500") {
                        <button onclick="location.reload()" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-clockwise me-2"></i>Try Again
                        </button>
                        }
                    </div>
                    
                    <hr class="my-4">
                    
                    <div class="text-muted">
                        <small>
                            If this problem persists, please contact our support team at 
                            <a href="mailto:support@whisperingpages.com" class="text-decoration-none">
                                support@whisperingpages.com
                            </a>
                        </small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Auto-report error to analytics (if available)
        if (typeof gtag !== 'undefined') {
            gtag('event', 'exception', {
                'description': 'Error page viewed: ' + '@ViewData["ErrorCode"]',
                'fatal': false
            });
        }
    </script>
}
