<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Whispering Pages</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
          integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- Shared CSS -->
    <link href="~/css/color-layout.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />

    <!-- User-Specific CSS -->
    <link href="~/css/user.css" rel="stylesheet" asp-append-version="true" />

    @RenderSection("Styles", required: false)
</head>
<body class="user-layout">
    <!-- Sidebar -->
    <div class="sidebar" id="sidebar">
        <div class="d-flex justify-content-end">
            <button id="toggleSidebar" class="btn btn-transparent border-0 text-light my-3" aria-label="Toggle Sidebar">
                <i class="bi bi-list"></i>
            </button>
        </div>
        <!-- Logo Section -->
        <div class="container-fluid p-3 mx-auto w-75 bg-white shadow rounded-3 logo-card">
            <img src="@Url.Content("~/images/render_website_name.png")" alt="Whispering Pages Logo" class="img-fluid">
        </div>

        <!-- Sidebar Navigation -->
        <a asp-controller="User" asp-action="Dashboard" class="d-flex align-items-center">
            <i class="bi bi-house-door me-2"></i>
            <span class="sidebar-text">Explore Books</span>
        </a>
        <a asp-controller="Category" asp-action="CategoryClassify" class="d-flex align-items-center">
            <i class="bi bi-search me-2"></i>
            <span class="sidebar-text">Classify Books</span>
        </a>
        <a asp-controller="Cart" asp-action="CartIndexUser" class="d-flex align-items-center cart-link">
            <i class="bi bi-cart me-2"></i>
            <span class="sidebar-text">Cart</span>
        </a>
        <a asp-controller="User" asp-action="Favorite" class="d-flex align-items-center favorites-link">
            <i class="bi bi-heart-fill me-2"></i>
            <span class="sidebar-text">Favorites</span>
        </a>
        <a asp-controller="Order" asp-action="Index" class="d-flex align-items-center">
            <i class="bi bi-bag-check me-2"></i>
            <span class="sidebar-text">My Orders</span>
        </a>
        <hr />
        <a asp-controller="Home" asp-action="About" class="d-flex align-items-center">
            <i class="bi bi-info-circle me-2"></i>
            <span class="sidebar-text">About</span>
        </a>
        <a asp-controller="Home" asp-action="Support" class="d-flex align-items-center">
            <i class="bi bi-question-circle me-2"></i>
            <span class="sidebar-text">Support</span>
        </a>
        <a asp-controller="Home" asp-action="Terms" class="d-flex align-items-center">
            <i class="bi bi-file-earmark-text me-2"></i>
            <span class="sidebar-text">Terms & Conditions</span>
        </a>
    </div>

    <!-- Main Content -->
    <div class="content">
        <!-- Top Bar -->
        <div class="top-bar d-flex justify-content-between align-items-center p-3 gap-3">
            <div class="d-none d-md-block">
                <h3 class="fw-bold">Welcome to <span class="text-white">Whispering Pages</span></h3>
                <h5 class="text-white">Good Morning, Reader</h5>
            </div>
            <div class="d-flex align-items-center gap-3">
                <span><i class="bi bi-clock me-1"></i><span class="currenttime"></span></span>
                <span><i class="bi bi-calendar me-1"></i><span class="currentdate"></span></span>
                <!-- Cart Badge -->
                <div class="position-relative">
                    <a class="text-decoration-none text-dark" asp-controller="Cart" asp-action="CartIndexUser">
                        <i class="bi bi-cart" style="font-size: 1.5rem;"></i>
                        <span id="cartItemCount" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="display: none;">0</span>
                    </a>
                </div>
                <!-- User Dropdown -->
                <form asp-controller="Auth" asp-action="Logout" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-light">
                        <i class="bi bi-box-arrow-right me-1"></i>Logout
                    </button>
                </form>
            </div>
        </div>

        @RenderBody()
    </div>

    <!-- Bootstrap Toast Container -->
    <div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1100">
        <!-- Toasts injected via JS -->
    </div>

    <!-- Bootstrap JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>

    @await RenderSectionAsync("Scripts", required: false)

    <!-- Shared Scripts -->
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/Auth/auth.js" asp-append-version="true"></script>

</body>
</html>