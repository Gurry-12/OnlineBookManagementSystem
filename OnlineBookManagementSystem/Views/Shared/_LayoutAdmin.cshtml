<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Whispering Pages Admin</title>

    <!-- Bootstrap CSS - Local First -->
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet"
          asp-fallback-href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          asp-fallback-test-class="visually-hidden" asp-fallback-test-property="position" asp-fallback-test-value="absolute" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet" />

    <!-- Unified Role-Based Theme Engine -->
    <link href="~/css/role-based-theme-engine.css" rel="stylesheet" asp-append-version="true" />

    @RenderSection("Styles", required: false)
</head>
<body class="admin-layout">
    <div class="wp-sidebar" id="sidebar">
        <div class="d-flex justify-content-end">
            <button id="toggleSidebar" class="btn btn-transparent border-0 text-light my-3" aria-label="Toggle Sidebar">
                <i class="bi bi-list"></i>
            </button>
        </div>
        <div class="wp-sidebar-logo container-fluid p-3 mx-auto w-75 bg-white shadow rounded-3 logo-card">
            <img src="@Url.Content("~/images/render_website_name.png")" alt="Whispering Pages Logo" class="img-fluid">
        </div>

        <!-- Sidebar Navigation -->
        <nav class="wp-sidebar-nav">
            <a asp-controller="Admin" asp-action="Dashboard" class="wp-sidebar-nav-link">
                <i class="bi bi-house-door"></i>
                <span class="wp-sidebar-nav-text sidebar-text">Dashboard</span>
            </a>
            <a asp-controller="Admin" asp-action="Books" asp-route-page="1" class="wp-sidebar-nav-link">
                <i class="bi bi-book"></i>
                <span class="wp-sidebar-nav-text sidebar-text">Books</span>
            </a>
            <a asp-controller="Admin" asp-action="CategoryManagement" class="wp-sidebar-nav-link">
                <i class="bi bi-tags"></i>
                <span class="wp-sidebar-nav-text sidebar-text">Categories</span>
            </a>
            <a asp-controller="Admin" asp-action="CreateBook" class="wp-sidebar-nav-link">
                <i class="bi bi-plus-square"></i>
                <span class="wp-sidebar-nav-text sidebar-text">Add Book</span>
            </a>
            <a asp-controller="Admin" asp-action="OrderManagement" class="wp-sidebar-nav-link">
                <i class="bi bi-box-seam"></i>
                <span class="wp-sidebar-nav-text sidebar-text">Orders</span>
            </a>
            <a asp-controller="Admin" asp-action="UserList" class="wp-sidebar-nav-link">
                <i class="bi bi-people"></i>
                <span class="wp-sidebar-nav-text sidebar-text">Users</span>
            </a>
            <a asp-controller="Admin" asp-action="ActivityLogs" class="wp-sidebar-nav-link">
                <i class="bi bi-clock-history"></i>
                <span class="wp-sidebar-nav-text sidebar-text">Activity Logs</span>
            </a>
            <hr />
            <a asp-controller="Home" asp-action="About" class="wp-sidebar-nav-link">
                <i class="bi bi-info-circle"></i>
                <span class="wp-sidebar-nav-text sidebar-text">About</span>
            </a>
            <a asp-controller="Home" asp-action="Support" class="wp-sidebar-nav-link">
                <i class="bi bi-telephone"></i>
                <span class="wp-sidebar-nav-text sidebar-text">Support</span>
            </a>
            <a asp-controller="Home" asp-action="Terms" class="wp-sidebar-nav-link">
                <i class="bi bi-file-earmark-text"></i>
                <span class="wp-sidebar-nav-text sidebar-text">Terms & Conditions</span>
            </a>
        </nav>
    </div>

    <div class="wp-content">
        <div class="wp-top-bar d-flex align-items-center justify-content-between px-4 py-3 bg-white shadow-sm border-bottom sticky-top">
            <div>
                <h2 class="fw-bold">Admin Dashboard</h2>
            </div>
            <div>
            <span><i class="bi bi-clock me-1"></i><span class="currenttime"></span></span>
            <span><i class="bi bi-calendar me-1"></i><span class="currentdate"></span></span>
            <a asp-controller="Auth" asp-action="ProfileView" class="wp-btn wp-btn-secondary btn btn-outline-light btn-sm">
                <i class="bi bi-person-circle me-1"></i>Profile
            </a>
            <form asp-controller="Auth" asp-action="Logout" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="wp-btn wp-btn-secondary btn btn-outline-light">
                    <i class="bi bi-box-arrow-right me-1"></i>Logout
                </button>
            </form>
            </div>
        </div>

        <main class="wp-main-content container-fluid py-4">
            @RenderBody()
        </main>
    </div>

    <!-- Bootstrap Toast Container -->
    <div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1100">
        <!-- Toasts injected via JS -->
    </div>

    <!-- Bootstrap JS - Local First -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"
            asp-fallback-src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
            asp-fallback-test="window.bootstrap"></script>

    @await RenderSectionAsync("Scripts", required: false)

    <!-- Shared Scripts -->
    <script src="~/js/site.js" asp-append-version="true"></script>

</body>
</html>
