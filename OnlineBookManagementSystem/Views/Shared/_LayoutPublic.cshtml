<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Whispering Pages</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/css/toastr.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link href="~/css/color.css" rel="stylesheet" />
</head>
<body class="public-layout">
    <!-- Role class for CSS -->

    <header>
        <nav class="navbar navbar-expand-lg bg-light px-4 py-3">
            <!-- Light for public -->
            <div class="container-fluid">
                <a class="navbar-brand fw-bold text-dark d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                    <img src="~/images/render_main_logo_30x301.png" alt="Logo" style="height: 30px;">
                    Whispering Pages
                </a>
                <ul class="navbar-nav me-auto">
                    <!-- Public links -->
                    <li class="nav-item"><a class="nav-link" asp-controller="Books" asp-action="PublicList"><i class="bi bi-book me-1"></i>Browse Books</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Categories" asp-action="Index"><i class="bi bi-tags me-1"></i>Categories</a></li>
                </ul>
                <div class="ms-auto d-flex gap-2">
                    <a class="btn btn-outline-primary" asp-controller="Auth" asp-action="Login"><i class="bi bi-box-arrow-in-right me-1"></i>Login</a>
                    <a class="btn btn-primary" asp-controller="Auth" asp-action="Registration"><i class="bi bi-person-plus me-1"></i>Sign Up</a>
                </div>
            </div>
        </nav>
    </header>

    <main class="container py-4">
        <a href="e:\ddrive\github\onlinebookmanagementsystem\onlinebookmanagementsystem\views\shared\_layoutpublic.cshtml">e:\ddrive\github\onlinebookmanagementsystem\onlinebookmanagementsystem\views\shared\_layoutpublic.cshtml</a>
        @RenderBody()
    </main>

    <footer class="text-center py-4 text-muted bg-light">
        <div class="container">
            &copy; 2025 - Whispering Pages <i class="bi bi-book-half"></i> | <a href="/Privacy">Privacy</a>
        </div>
    </footer>
    @await RenderSectionAsync("Scripts", required: false)
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <script src="~/js/auth/auth.js"></script>
    <script src="~/js/site.js"></script>
</body>
</html>