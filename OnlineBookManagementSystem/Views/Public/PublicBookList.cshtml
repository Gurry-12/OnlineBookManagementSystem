@using OnlineBookManagementSystem.Models.ViewModel
@model BookListViewModel

@{
    ViewData["Title"] = "Browse Books";
    Layout = ViewData["Layout"]?.ToString() ?? "_LayoutPublic";
}

<link href="~/css/booksindex.css" rel="stylesheet" />

<div class="container">
    <h2 class="mb-4">📚 Books Management</h2>

    <!-- Search & Filters -->
    <div class="row mb-4">
        <div class="col-md-6">
            <form method="get" asp-action="BookList">
                <div class="input-group">
                    <input type="text" name="search" value="@Model.SearchTerm" class="form-control" placeholder="Search by title/author..." />
                    <button class="btn btn-primary" type="submit"><i class="bi bi-search"></i></button>
                </div>
            </form>
        </div>
        <div class="col-md-6 text-end">
            <a asp-action="Create" class="btn btn-success"><i class="bi bi-plus-circle"></i> Add Book</a>
        </div>
    </div>

    <!-- Books Grid -->
    <div class="row g-4 mb-4" id="books-list">
        @foreach (var book in Model.Books)
        {
            <div class="col-lg-3 col-md-4 col-sm-6 col-12 p-2">
                <div class="book-card shadow-sm p-2 bg-white rounded position-relative h-100">
                    <div class="position-absolute end-0 top-0 me-1 mt-1 z-3">
                        <button class="btn btn-link p-0" data-bs-toggle="dropdown">
                            <i class="bi bi-three-dots-vertical"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end border-0 shadow z-3">
                            <li><a class="dropdown-item" asp-action="Edit" asp-route-id="@book.Id">Edit</a></li>
                            <li><a class="dropdown-item text-danger" onclick="DeleteBook(@book.Id)">Delete</a></li>
                        </ul>
                    </div>
                    <img src="@(book.ImageUrl ?? Url.Content("~/images/default-book.jpg"))" alt="@book.Title" class="book-image" />
                    <h6 class="mt-2">@book.Title</h6>
                    <small class="text-muted">@book.Author</small>
                    <p class="text-primary fw-bold">₹@book.Price</p>
                    <small class="text-success">@book.StockQuantity in stock</small>
                    <a asp-action="Details" asp-route-id="@book.Id" class="stretched-link btn btn-sm btn-outline-primary">View Details</a>
                </div>
            </div>
        }
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <nav aria-label="Book pagination">
            <ul class="pagination justify-content-center">
                <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="BookList" asp-route-page="@(Model.CurrentPage - 1)">Previous</a>
                </li>
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(Model.CurrentPage == i ? "active" : "")">
                        <a class="page-link" asp-action="BookList" asp-route-page="@i">@i</a>
                    </li>
                }
                <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="BookList" asp-route-page="@(Model.CurrentPage + 1)">Next</a>
                </li>
            </ul>
        </nav>
    }
</div>

@await Html.PartialAsync("_Notification")

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/js/toastr.min.js"></script>
    <script src="~/js/books/bookshome.js"></script>
    <script>
        function DeleteBook(id) {
            if (confirm('Delete this book?')) {
                $.post('/Books/Delete', { id }, function (res) {
                    if (res.success) {
                        toastr.success('Deleted!');
                        location.reload();
                    } else toastr.error('Failed to delete.');
                });
            }
        }
    </script>
}