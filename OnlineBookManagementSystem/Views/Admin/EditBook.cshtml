@using OnlineBookManagementSystem.Models.ViewModel
@model BookFormViewModel

@{
    ViewData["Title"] = "Edit Book";
    Layout = ViewData["Layout"]?.ToString() ?? "_LayoutAdmin";
}

<!-- Same styles as CreateBook -->

<div class="container">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-lg rounded-3">
                <div class="card-header bg-warning text-dark text-center py-4">
                    <h2 class="mb-0"><i class="bi bi-pencil-square me-2"></i>Edit Book: @Model.Book.Title</h2>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Edit" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <input asp-for="Book.Id" type="hidden" />

                        <!-- Same form fields as Create, with values pre-filled -->
                        <!-- ... (copy from CreateBook, add current image preview) ... -->
                        <!-- Basic Info -->
                        <div class="form-section">
                            <h5><i class="bi bi-book me-2 text-primary"></i>Basic Information</h5>
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label asp-for="Book.Title" class="form-label">📖 Title</label>
                                    <input asp-for="Book.Title" class="form-control" required />
                                    <span asp-validation-for="Book.Title" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label asp-for="Book.Author" class="form-label">✍️ Author</label>
                                    <input asp-for="Book.Author" class="form-control" required />
                                    <span asp-validation-for="Book.Author" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-4 mb-3">
                                    <label asp-for="Book.ISBN" class="form-label">📱 ISBN</label>
                                    <input asp-for="Book.ISBN" class="form-control" />
                                    <span asp-validation-for="Book.ISBN" class="text-danger small"></span>
                                </div>
                                <div class="col-md-4 mb-3">
                                    <label asp-for="Book.Price" class="form-label">💰 Price (₹)</label>
                                    <input asp-for="Book.Price" type="number" step="0.01" class="form-control" required />
                                    <span asp-validation-for="Book.Price" class="text-danger small"></span>
                                </div>
                                <div class="col-md-4 mb-3">
                                    <label asp-for="Book.StockQuantity" class="form-label">📦 Stock Quantity</label>
                                    <input asp-for="Book.StockQuantity" type="number" class="form-control" required />
                                    <span asp-validation-for="Book.StockQuantity" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="mb-3">
                                <label asp-for="Book.CategoryId" class="form-label">🏷️ Category</label>
                                <select asp-for="Book.CategoryId" asp-items="Model.Categories" class="form-select" required>
                                    <option value="">-- Select Category --</option>
                                </select>
                                <span asp-validation-for="Book.CategoryId" class="text-danger small"></span>
                            </div>
                            <div class="mb-3">
                                <label asp-for="ImageFile"
                                       class="form-label">🖼️ Book Image</label>
                                <input asp-for="ImageFile" type="file" accept="image/*" class="form-control" />
                                <span class="text-muted small">Max 5MB, JPG/PNG recommended.</span>
                            </div>
                            <div class="mb-3">
                                <label asp-for="Book.Description" class="form-label">📝 Description</label>
                                <textarea asp-for="Book.Description" rows="4" class="form-control"></textarea>
                                <span asp-validation-for="Book.Description" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Current Image</label>
                            @if (!string.IsNullOrEmpty(Model.Book.ImageUrl))
                            {
                                <img src="@Model.Book.ImageUrl" alt="Current" style="max-width: 200px; border-radius: 0.5rem;" />
                            }
                        </div>

                        <div class="text-end mt-4">
                            <a asp-action="BookList" class="btn btn-secondary me-2">Cancel</a>
                            <button type="submit" class="btn btn-lg btn-gradient rounded-pill shadow-sm">
                                <i class="bi bi-save2 me-2"></i>Update Book
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Same scripts as CreateBook -->
@await Html.PartialAsync("_Notification")

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/js/toastr.min.js"></script>
    <script src="~/js/books/bookshome.js"></script>
}