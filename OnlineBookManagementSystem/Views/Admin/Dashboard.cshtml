@{
    ViewData["Title"] = "Admin Dashboard - Whispering Pages";
}
@model OnlineBookManagementSystem.Models.ViewModel.AdminDashboardViewModel;

<!-- 📚 Inspirational Quotes Carousel Section -->
<div class="row g-4 mb-5">
    <div class="col-md-6 col-sm-12 ">
        <div id="quoteCarousel" class="carousel slide wp-quote-box shadow-sm rounded" data-bs-ride="carousel" aria-label="Quote Carousel" data-bs-interval="3000">
            <div class="carousel-inner">
                <div class="carousel-item active">
                    <p class="fs-6 fst-italic px-2">“There is more treasure in books than in all the pirate's loot on Treasure Island.”</p>
                    <p class="text-end fw-semibold px-2">- Walt Disney</p>
                </div>
                <div class="carousel-item">
                    <p class="fs-6 fst-italic px-2">“A room without books is like a body without a soul.”</p>
                    <p class="text-end fw-semibold px-2">- Marcus Tullius Cicero</p>
                </div>
                <div class="carousel-item">
                    <p class="fs-6 fst-italic px-2">“So many books, so little time.”</p>
                    <p class="text-end fw-semibold px-2">- Frank Zappa</p>
                </div>
                <div class="carousel-item">
                    <p class="fs-6 fst-italic px-2">“Books are a uniquely portable magic.”</p>
                    <p class="text-end fw-semibold px-2">- Stephen King</p>
                </div>
                <div class="carousel-item">
                    <p class="fs-6 fst-italic px-2">“I declare after all there is no enjoyment like reading!”</p>
                    <p class="text-end fw-semibold px-2">- Jane Austen</p>
                </div>
            </div>
            <!-- Improved badge positioning -->
            <div class="position-absolute bottom-0 start-50 translate-middle-x mb-4 d-none d-md-block z-2">
                <small class="text-white-50 fs-7 fst-italic px-3 py-1 bg-dark bg-opacity-30 rounded-pill">
                    — A journey through Whispering Pages
                </small>
            </div>

            <!-- Carousel controls -->
            <button class="carousel-control-prev" type="button" data-bs-target="#quoteCarousel" data-bs-slide="prev" aria-label="Previous quote">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Previous</span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#quoteCarousel" data-bs-slide="next" aria-label="Next quote">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Next</span>
            </button>

        </div>
 </div>
    <!-- 🧑‍💼 Admin Profile Section (right of carousel) -->
     <div class="col-md-6 col-sm-6">
        <div class="wp-card  bg-opacity-75 bg-secondary bg-gradient text-white shadow-lg rounded-4 border-0 h-100">
            <div class="card-body d-flex flex-column justify-content-center align-items-start gap-3 p-4">
                <h5 class="card-title fw-semibold mb-3"><i class="bi bi-tools me-2"></i>Admin Tools</h5>
                <div class="row g-2 w-100">
                    <div class="col-6">
                        <a href="/admin/books/add" class="btn btn-outline-light w-100 text-start" aria-label="Add or Update Books">
                            <i class="bi bi-plus-circle me-2"></i>Add or Update Books
                        </a>
                    </div>
                    <div class="col-6">
                        <a href="/admin/users/manage" class="btn btn-outline-light w-100 text-start" aria-label="Manage User Accounts">
                            <i class="bi bi-person-lines-fill me-2"></i>Manage User Accounts
                        </a>
                    </div>
                    <div class="col-6">
                        <a href="/admin/orders/view" class="btn btn-outline-light w-100 text-start" aria-label="View and Process Orders">
                            <i class="bi bi-cart-check me-2"></i>View & Process Orders
                        </a>
                    </div>
                    <div class="col-6">
                        <a href="/admin/security/access" class="btn btn-outline-light w-100 text-start" aria-label="Access Control">
                            <i class="bi bi-shield-lock me-2"></i>Access Control
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- End of row with carousel and profile -->
<!-- 📊 Quick Stats & Recent Activities Section -->
<div class="row g-4 mb-5">
    <!-- Quick Stats -->
    <div class="col-md-6">
        <div class="card shadow-sm rounded bg-white">
            <div class="card-body">
                <h5 class="text-primary mb-3"><i class="bi bi-bar-chart-fill me-2"></i>Quick Stats</h5>
                <ul class="list-group list-group-flush">
                    <li class="list-group-item d-flex justify-content-between">
                        <span><i class="bi bi-book me-2 text-success"></i>Books</span>
                        <span class="badge bg-success rounded-pill">@Model.TotalBooks</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between">
                        <span><i class="bi bi-tags me-2 text-info"></i>Categories</span>
                        <span class="badge bg-info rounded-pill">@Model.TotalCategories</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between">
                        <span><i class="bi bi-people me-2 text-warning"></i>Users</span>
                        <span class="badge bg-warning text-dark rounded-pill">@Model.TotalUsers</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between">
                        <span><i class="bi bi-cart-check me-2 text-danger"></i>Orders</span>
                        <span class="badge bg-danger rounded-pill">@Model.TotalOrders</span>
                    </li>
                </ul>
            </div>
        </div>
    </div>

    <!-- Recent Activities -->
    <div class="col-md-6">
        <div class="card shadow-sm rounded-4 bg-white">
            <div class="card-body">
                <h5 class="text-primary mb-3"><i class="bi bi-clock-history me-2"></i>Recent Activities</h5>
                <ul class="list-group" style="max-height: 260px; overflow-y: auto;">
                    @if (Model.RecentActivity != null && Model.RecentActivity.Any())
                    {
                        foreach (var log in Model.RecentActivity)
                        {
                            var iconClass = log.ActionType switch
                            {
                                "Add" => "bi bi-book text-success",
                                "Update" => "bi bi-pencil-square text-warning",
                                "Delete" => "bi bi-trash text-danger",
                                "Register" => "bi bi-person-plus text-info",
                                "Login" => "bi bi-box-arrow-in-right text-primary",
                                _ => "bi bi-info-circle text-secondary"
                            };

                            var badgeClass = log.ActionType switch
                            {
                                "Add" => "bg-success",
                                "Update" => "bg-warning text-dark",
                                "Delete" => "bg-danger",
                                "Register" => "bg-info text-dark",
                                "Login" => "bg-primary",
                                _ => "bg-secondary"
                            };

                            <li class="list-group-item d-flex justify-content-between align-items-start">
                                <div class="me-auto">
                                    <i class="@iconClass me-2"></i>@log.Description
                                    <div class="small text-muted">@((DateTime.UtcNow - log.Timestamp).TotalMinutes < 1 ? "Just now" : 
                                        (DateTime.UtcNow - log.Timestamp).TotalMinutes < 60 ? $"{(int)(DateTime.UtcNow - log.Timestamp).TotalMinutes} min ago" :
                                        (DateTime.UtcNow - log.Timestamp).TotalHours < 24 ? $"{(int)(DateTime.UtcNow - log.Timestamp).TotalHours} hrs ago" :
                                        $"{(int)(DateTime.UtcNow - log.Timestamp).TotalDays} days ago")</div>
                                </div>
                                <span class="badge @badgeClass">@log.ActionType</span>
                            </li>
                        }
                    }
                    else
                    {
                        <li class="list-group-item text-muted">No recent activity found.</li>
                    }
                </ul>
            </div>
        </div>
    </div>
</div>

<!-- 📊 Enhanced Charts Section -->
<div class="row g-4 mb-5">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h4 class="text-primary mb-0">
                <i class="bi bi-graph-up me-2"></i>Analytics Dashboard
            </h4>
            <button id="refreshCharts" class="btn btn-outline-primary btn-sm">
                <i class="bi bi-arrow-clockwise me-1"></i>Refresh Charts
            </button>
        </div>
    </div>
</div>

<!-- Main Dashboard Charts -->
<div class="row g-4 mb-5">
    <div class="col-md-6">
        <div class="card admin-chart-card shadow-sm h-100 fade-in">
            <div class="card-header chart-header bg-light border-0">
                <h5 class="mb-0 text-primary">
                    <i class="bi bi-graph-up-arrow chart-icon"></i>Monthly Book Uploads
                </h5>
            </div>
            <div class="card-body p-3">
                <div class="chart-container">
                    <canvas id="monthlyChart"></canvas>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card admin-chart-card shadow-sm h-100 fade-in">
            <div class="card-header chart-header bg-light border-0">
                <h5 class="mb-0 text-primary">
                    <i class="bi bi-pie-chart chart-icon"></i>Books by Category
                </h5>
            </div>
            <div class="card-body p-3">
                <div class="chart-container">
                    <canvas id="categoryChart"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Detailed Analytics Charts -->
<div class="analytics-section">
    <div class="row g-4 mb-5">
        <div class="col-12">
            <h5 class="text-secondary mb-3">
                <i class="bi bi-bar-chart-line me-2"></i>Detailed Analytics
            </h5>
        </div>
        
        <!-- Chart 1: Monthly Trends -->
        <div class="col-lg-6 col-md-12">
            <div class="card admin-chart-card shadow-sm h-100 slide-up">
                <div class="card-header chart-header bg-gradient bg-primary text-white border-0">
                    <h6 class="mb-0">
                        <i class="bi bi-calendar-month chart-icon"></i>Monthly Upload Trends
                    </h6>
                </div>
                <div class="card-body p-3">
                    <div class="chart-container">
                        <canvas id="chart1"></canvas>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Chart 2: Category Distribution -->
        <div class="col-lg-6 col-md-12">
            <div class="card admin-chart-card shadow-sm h-100 slide-up">
                <div class="card-header chart-header bg-gradient bg-info text-white border-0">
                    <h6 class="mb-0">
                        <i class="bi bi-tags chart-icon"></i>Category Distribution
                    </h6>
                </div>
                <div class="card-body p-3">
                    <div class="chart-container">
                        <canvas id="chart2"></canvas>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Chart 3: Author Analytics -->
        <div class="col-lg-6 col-md-12">
            <div class="card admin-chart-card shadow-sm h-100 slide-up">
                <div class="card-header chart-header bg-gradient bg-success text-white border-0">
                    <h6 class="mb-0">
                        <i class="bi bi-person-lines-fill chart-icon"></i>Top Authors
                    </h6>
                </div>
                <div class="card-body p-3">
                    <div class="chart-container">
                        <canvas id="chart3"></canvas>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Chart 4: Favorites Analysis -->
        <div class="col-lg-6 col-md-12">
            <div class="card admin-chart-card shadow-sm h-100 slide-up">
                <div class="card-header chart-header bg-gradient bg-warning text-dark border-0">
                    <h6 class="mb-0">
                        <i class="bi bi-heart-fill chart-icon"></i>Favorites Analysis
                    </h6>
                </div>
                <div class="card-body p-3">
                    <div class="chart-container">
                        <canvas id="chart4"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


<!-- 🔒 Admin-only Controls Section -->
<!-- 🔒 Admin Controls -->
<div id="adminSection" style="display: none;" class="mt-5">
    <h5 class="mb-3"><i class="bi bi-tools me-2"></i>Admin Controls</h5>
    <div class="row g-3 mb-4">

        <!-- Add New Book -->
        <div class="col-md-4 col-sm-6">
            <a asp-controller="Admin" asp-action="CreateBook" class="text-decoration-none">
                <div class="card h-100 shadow-sm border-0 bg-light hover-lift rounded-4 text-center py-4">
                    <div class="card-body">
                        <div class="text-success mb-2" style="font-size: 2rem;">
                            <i class="bi bi-plus-circle-fill"></i>
                        </div>
                        <h6 class="text-dark">Add New Book</h6>
                        <p class="text-muted small">Upload or manage book records</p>
                    </div>
                </div>
            </a>
        </div>

        <!-- Manage Users -->
        <div class="col-md-4 col-sm-6">
            <a asp-controller="Admin" asp-action="UserList" class="text-decoration-none">
                <div class="card h-100 shadow-sm border-0 bg-light hover-lift rounded-4 text-center py-4">
                    <div class="card-body">
                        <div class="text-secondary mb-2" style="font-size: 2rem;">
                            <i class="bi bi-person-lines-fill"></i>
                        </div>
                        <h6 class="text-dark">Manage Users</h6>
                        <p class="text-muted small">View, edit or delete users</p>
                    </div>
                </div>
            </a>
        </div>

        <!-- Manage Orders -->
        <div class="col-md-4 col-sm-6">
            <a asp-controller="Order" asp-action="AdminIndex" class="text-decoration-none">
                <div class="card h-100 shadow-sm border-0 bg-light hover-lift rounded-4 text-center py-4">
                    <div class="card-body">
                        <div class="text-danger mb-2" style="font-size: 2rem;">
                            <i class="bi bi-cart-check-fill"></i>
                        </div>
                        <h6 class="text-dark">Manage Orders</h6>
                        <p class="text-muted small">Track and process orders</p>
                    </div>
                </div>
            </a>
        </div>

    </div>

    <!-- 📚 Book Cards Grid -->
    <div class="row g-4" id="bookGrid">
        <!-- Example Card -->
        
    </div>
</div>

@{
    ViewData["Title"] = "Admin Dashboard - Whispering Pages";
    Layout = ViewData["Layout"]?.ToString() ?? "_LayoutAdmin";
}

<link href="~/css/booksindex.css" rel="stylesheet" />
<div class="container-fluid px-3 px-md-5 py-4">
    <h2 class="mb-4 text-warning fw-bold">
        <i class="bi bi-gear-fill me-2"></i>Admin Dashboard
    </h2>

    <!-- Stats Cards -->
    <div class="row g-4 mb-4">
        <div class="col-md-3">
            <div class="card h-100 shadow-sm border-0 bg-warning text-dark rounded-4">
                <div class="card-body text-center p-4">
                    <i class="bi bi-book fs-1 mb-3"></i>
                    <h3>@Model.TotalBooks</h3>
                    <p>Total Books</p>
                    <a asp-action="Books" class="btn btn-outline-dark btn-sm">Manage</a>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card h-100 shadow-sm border-0 bg-info text-white rounded-4">
                <div class="card-body text-center p-4">
                    <i class="bi bi-receipt fs-1 mb-3"></i>
                    <h3>@Model.TotalOrders</h3>
                    <p>Total Orders</p>
                    <a asp-controller="Order" asp-action="AdminIndex" class="btn btn-light btn-sm">View Orders</a>
                </div>
            </div>
        </div>
        <!-- Add more stats as needed -->
    </div>

    <!-- Charts Section -->
    <div class="row g-4 mb-4">
        <div class="col-md-6">
            <div class="card shadow-sm rounded-4">
                <div class="card-header bg-light">
                    <h5>Revenue Trends</h5>
                </div>
                <div class="card-body p-0">
                    <canvas id="revenueChart" height="200"></canvas>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card shadow-sm rounded-4">
                <div class="card-header bg-light">
                    <h5>Order Status Distribution</h5>
                </div>
                <div class="card-body p-0">
                    <canvas id="orderStatusChart" height="200"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="row g-3 mt-4">
        <div class="col-md-3">
            <a asp-action="CreateBook" class="text-decoration-none">
                <div class="card h-100 shadow-sm border-0 bg-light rounded-4 text-center py-4">
                    <i class="bi bi-plus-circle fs-1 text-success mb-2"></i>
                    <h6>Add New Book</h6>
                </div>
            </a>
        </div>
        <div class="col-md-3">
            <a asp-action="Books" class="text-decoration-none">
                <div class="card h-100 shadow-sm border-0 bg-light rounded-4 text-center py-4">
                    <i class="bi bi-list-ul fs-1 text-primary mb-2"></i>
                    <h6>View Books</h6>
                </div>
            </a>
        </div>
        <!-- Add more -->
    </div>
</div>

@await Html.PartialAsync("_Notification")

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="~/js/books/ChartsAdmin.js"></script>
}
