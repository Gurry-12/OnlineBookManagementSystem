@model OnlineBookManagementSystem.Models.ViewModel.ReviewAnalyticsViewModel
@{
    ViewData["Title"] = "Review Analytics";
    Layout = "_LayoutAdmin";
}

<div class="container-fluid py-4">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2>
                    <i class="fas fa-chart-bar text-primary me-2"></i>
                    Review Analytics
                </h2>
                <a asp-action="Pending" class="btn btn-outline-primary">
                    <i class="fas fa-clock"></i> Pending Reviews
                </a>
            </div>
        </div>
    </div>

    <!-- Summary Cards -->
    <div class="row mb-4">
        <div class="col-md-2">
            <div class="card bg-primary text-white">
                <div class="card-body text-center">
                    <i class="fas fa-comments fa-2x mb-2"></i>
                    <h4>@Model.TotalReviews</h4>
                    <p class="mb-0">Total Reviews</p>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card bg-warning text-white">
                <div class="card-body text-center">
                    <i class="fas fa-clock fa-2x mb-2"></i>
                    <h4>@Model.PendingReviews</h4>
                    <p class="mb-0">Pending</p>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card bg-success text-white">
                <div class="card-body text-center">
                    <i class="fas fa-check fa-2x mb-2"></i>
                    <h4>@Model.ApprovedReviews</h4>
                    <p class="mb-0">Approved</p>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card bg-danger text-white">
                <div class="card-body text-center">
                    <i class="fas fa-times fa-2x mb-2"></i>
                    <h4>@Model.RejectedReviews</h4>
                    <p class="mb-0">Rejected</p>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card bg-info text-white">
                <div class="card-body text-center">
                    <i class="fas fa-flag fa-2x mb-2"></i>
                    <h4>@Model.FlaggedReviews</h4>
                    <p class="mb-0">Flagged</p>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card bg-secondary text-white">
                <div class="card-body text-center">
                    <i class="fas fa-star fa-2x mb-2"></i>
                    <h4>@Model.AverageRating.ToString("F1")</h4>
                    <p class="mb-0">Avg Rating</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Rating Distribution Chart -->
        <div class="col-md-6 mb-4">
            <div class="card shadow-sm">
                <div class="card-header">
                    <h5 class="mb-0">Rating Distribution</h5>
                </div>
                <div class="card-body">
                    <canvas id="ratingDistributionChart" width="400" height="300"></canvas>
                </div>
            </div>
        </div>

        <!-- Review Status Chart -->
        <div class="col-md-6 mb-4">
            <div class="card shadow-sm">
                <div class="card-header">
                    <h5 class="mb-0">Review Status Distribution</h5>
                </div>
                <div class="card-body">
                    <canvas id="statusDistributionChart" width="400" height="300"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Review Trends -->
    @if (Model.ReviewTrends.Any())
    {
        <div class="row">
            <div class="col-12 mb-4">
                <div class="card shadow-sm">
                    <div class="card-header">
                        <h5 class="mb-0">Review Trends (Last 30 Days)</h5>
                    </div>
                    <div class="card-body">
                        <canvas id="reviewTrendsChart" width="400" height="200"></canvas>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Top and Lowest Rated Books -->
    <div class="row">
        <div class="col-md-6 mb-4">
            <div class="card shadow-sm">
                <div class="card-header">
                    <h5 class="mb-0">Top Rated Books</h5>
                </div>
                <div class="card-body">
                    <div id="topRatedBooks">
                        <div class="text-center">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6 mb-4">
            <div class="card shadow-sm">
                <div class="card-header">
                    <h5 class="mb-0">Lowest Rated Books</h5>
                </div>
                <div class="card-body">
                    <div id="lowestRatedBooks">
                        <div class="text-center">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        $(document).ready(function() {
            initializeCharts();
            loadTopRatedBooks();
            loadLowestRatedBooks();
        });

        function initializeCharts() {
            // Rating Distribution Chart
            const ratingData = @Html.Raw(Json.Serialize(Model.RatingDistribution));
            const ratingLabels = ['1 Star', '2 Stars', '3 Stars', '4 Stars', '5 Stars'];
            const ratingCounts = [
                ratingData['1'] || 0,
                ratingData['2'] || 0,
                ratingData['3'] || 0,
                ratingData['4'] || 0,
                ratingData['5'] || 0
            ];

            new Chart(document.getElementById('ratingDistributionChart'), {
                type: 'bar',
                data: {
                    labels: ratingLabels,
                    datasets: [{
                        label: 'Number of Reviews',
                        data: ratingCounts,
                        backgroundColor: [
                            '#dc3545', '#fd7e14', '#ffc107', '#28a745', '#20c997'
                        ],
                        borderColor: [
                            '#dc3545', '#fd7e14', '#ffc107', '#28a745', '#20c997'
                        ],
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                stepSize: 1
                            }
                        }
                    }
                }
            });

            // Status Distribution Chart
            const statusData = [
                @Model.PendingReviews,
                @Model.ApprovedReviews,
                @Model.RejectedReviews,
                @Model.FlaggedReviews
            ];

            new Chart(document.getElementById('statusDistributionChart'), {
                type: 'doughnut',
                data: {
                    labels: ['Pending', 'Approved', 'Rejected', 'Flagged'],
                    datasets: [{
                        data: statusData,
                        backgroundColor: ['#ffc107', '#28a745', '#dc3545', '#17a2b8'],
                        borderColor: ['#ffc107', '#28a745', '#dc3545', '#17a2b8'],
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false
                }
            });

            @if (Model.ReviewTrends.Any())
            {
                <text>
                // Review Trends Chart
                const trendsData = @Html.Raw(Json.Serialize(Model.ReviewTrends));
                const trendLabels = trendsData.map(t => new Date(t.date).toLocaleDateString());
                const trendCounts = trendsData.map(t => t.reviewCount);
                const trendRatings = trendsData.map(t => t.averageRating);

                new Chart(document.getElementById('reviewTrendsChart'), {
                    type: 'line',
                    data: {
                        labels: trendLabels,
                        datasets: [{
                            label: 'Reviews per Day',
                            data: trendCounts,
                            borderColor: '#007bff',
                            backgroundColor: 'rgba(0, 123, 255, 0.1)',
                            yAxisID: 'y'
                        }, {
                            label: 'Average Rating',
                            data: trendRatings,
                            borderColor: '#ffc107',
                            backgroundColor: 'rgba(255, 193, 7, 0.1)',
                            yAxisID: 'y1'
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        scales: {
                            y: {
                                type: 'linear',
                                display: true,
                                position: 'left',
                                beginAtZero: true
                            },
                            y1: {
                                type: 'linear',
                                display: true,
                                position: 'right',
                                min: 0,
                                max: 5,
                                grid: {
                                    drawOnChartArea: false,
                                }
                            }
                        }
                    }
                });
                </text>
            }
        }

        function loadTopRatedBooks() {
            $.get('@Url.Action("GetTopRatedBooks", "ReviewModeration")', { count: 10 })
                .done(function(data) {
                    let html = '';
                    if (data.length > 0) {
                        data.forEach(function(book, index) {
                            html += `
                                <div class="d-flex justify-content-between align-items-center py-2 ${index < data.length - 1 ? 'border-bottom' : ''}">
                                    <div>
                                        <strong>${book.bookTitle}</strong>
                                        <br>
                                        <small class="text-muted">by ${book.author}</small>
                                    </div>
                                    <div class="text-end">
                                        <div class="text-warning">
                                            ${'★'.repeat(Math.floor(book.averageRating))}${'☆'.repeat(5 - Math.floor(book.averageRating))}
                                        </div>
                                        <small class="text-muted">${book.averageRating.toFixed(1)} (${book.totalReviews} reviews)</small>
                                    </div>
                                </div>
                            `;
                        });
                    } else {
                        html = '<p class="text-muted text-center">No rated books found.</p>';
                    }
                    $('#topRatedBooks').html(html);
                })
                .fail(function() {
                    $('#topRatedBooks').html('<p class="text-danger text-center">Error loading data.</p>');
                });
        }

        function loadLowestRatedBooks() {
            $.get('@Url.Action("GetLowestRatedBooks", "ReviewModeration")', { count: 10 })
                .done(function(data) {
                    let html = '';
                    if (data.length > 0) {
                        data.forEach(function(book, index) {
                            html += `
                                <div class="d-flex justify-content-between align-items-center py-2 ${index < data.length - 1 ? 'border-bottom' : ''}">
                                    <div>
                                        <strong>${book.bookTitle}</strong>
                                        <br>
                                        <small class="text-muted">by ${book.author}</small>
                                    </div>
                                    <div class="text-end">
                                        <div class="text-warning">
                                            ${'★'.repeat(Math.floor(book.averageRating))}${'☆'.repeat(5 - Math.floor(book.averageRating))}
                                        </div>
                                        <small class="text-muted">${book.averageRating.toFixed(1)} (${book.totalReviews} reviews)</small>
                                    </div>
                                </div>
                            `;
                        });
                    } else {
                        html = '<p class="text-muted text-center">No rated books found.</p>';
                    }
                    $('#lowestRatedBooks').html(html);
                })
                .fail(function() {
                    $('#lowestRatedBooks').html('<p class="text-danger text-center">Error loading data.</p>');
                });
        }
    </script>
}

<style>
    .card {
        border: none;
        box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
    }
    
    .card-body canvas {
        max-height: 300px;
    }
    
    .spinner-border {
        width: 2rem;
        height: 2rem;
    }
</style>