@model OnlineBookManagementSystem.Models.ViewModel.ActivityLogsViewModel
@{
    ViewData["Title"] = "Activity Logs";
    Layout = "~/Views/Shared/_LayoutSuperAdmin.cshtml";
}

<div class="container-fluid px-3 px-md-5 py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-danger fw-bold">
            <i class="bi bi-journal-text me-2"></i>Activity Logs
        </h2>
        <div class="d-flex gap-2">
            <a href="@Url.Action("ExportActivityLogs", Context.Request.Query)" class="btn btn-outline-primary">
                <i class="bi bi-download me-1"></i>Export
            </a>
            <button class="btn btn-outline-danger" onclick="clearOldLogs()">
                <i class="bi bi-trash me-1"></i>Clear Old Logs
            </button>
        </div>
    </div>

    <!-- Filters -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body">
            <form method="get" class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">Search</label>
                    <input type="text" name="search" class="form-control" placeholder="Search logs..." value="@ViewBag.Search">
                </div>
                <div class="col-md-2">
                    <label class="form-label">Action Type</label>
                    <select name="action" class="form-select">
                        <option value="">All Actions</option>
                        <option value="Login" selected="@(ViewBag.Action == "Login")">Login</option>
                        <option value="Logout" selected="@(ViewBag.Action == "Logout")">Logout</option>
                        <option value="Create" selected="@(ViewBag.Action == "Create")">Create</option>
                        <option value="Update" selected="@(ViewBag.Action == "Update")">Update</option>
                        <option value="Delete" selected="@(ViewBag.Action == "Delete")">Delete</option>
                        <option value="View" selected="@(ViewBag.Action == "View")">View</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">User Role</label>
                    <select name="role" class="form-select">
                        <option value="">All Roles</option>
                        <option value="SuperAdmin" selected="@(ViewBag.Role == "SuperAdmin")">SuperAdmin</option>
                        <option value="Admin" selected="@(ViewBag.Role == "Admin")">Admin</option>
                        <option value="User" selected="@(ViewBag.Role == "User")">User</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Date From</label>
                    <input type="date" name="dateFrom" class="form-control" value="@ViewBag.DateFrom">
                </div>
                <div class="col-md-2">
                    <label class="form-label">Date To</label>
                    <input type="date" name="dateTo" class="form-control" value="@ViewBag.DateTo">
                </div>
                <div class="col-md-1 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-funnel"></i>
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Statistics Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card border-0 bg-primary text-white">
                <div class="card-body text-center">
                    <i class="bi bi-activity fs-1 mb-2"></i>
                    <h4>@Model?.TotalLogs</h4>
                    <small>Total Activities</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 bg-success text-white">
                <div class="card-body text-center">
                    <i class="bi bi-calendar-day fs-1 mb-2"></i>
                    <h4>@Model?.TodayLogs</h4>
                    <small>Today's Activities</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 bg-warning text-white">
                <div class="card-body text-center">
                    <i class="bi bi-people fs-1 mb-2"></i>
                    <h4>@Model?.ActiveUsers</h4>
                    <small>Active Users</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 bg-danger text-white">
                <div class="card-body text-center">
                    <i class="bi bi-exclamation-triangle fs-1 mb-2"></i>
                    <h4>@Model?.ErrorLogs</h4>
                    <small>Error Logs</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Logs Table -->
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Timestamp</th>
                            <th>User</th>
                            <th>Action</th>
                            <th>Details</th>
                            <th>IP Address</th>
                            <th>User Agent</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model?.Logs?.Any() == true)
                        {
                            @foreach (var log in Model.Logs)
                            {
                                <tr class="@GetRowClass(log.Action)">
                                    <td>
                                        <div class="fw-medium">@log.Timestamp.ToString("MMM dd, yyyy")</div>
                                        <small class="text-muted">@log.Timestamp.ToString("HH:mm:ss")</small>
                                    </td>
                                    <td>
                                        @if (log.User != null)
                                        {
                                            <div class="d-flex align-items-center">
                                                <div class="avatar-sm me-2">
                                                    @log.User.Name?.Substring(0, 1).ToUpper()
                                                </div>
                                                <div>
                                                    <div class="fw-medium">@log.User.Name</div>
                                                    <small class="text-muted">@log.User.Email</small>
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted">System</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge bg-@GetActionBadgeColor(log.Action)">
                                            @log.Action
                                        </span>
                                    </td>
                                    <td>
                                        <div class="text-truncate" style="max-width: 300px;" title="@log.Message">
                                            @log.Message
                                        </div>
                                    </td>
                                    <td>
                                        <code class="small">@log.IpAddress</code>
                                    </td>
                                    <td>
                                        <div class="text-truncate" style="max-width: 200px;" title="@log.UserAgent">
                                            @GetBrowserInfo(log.UserAgent)
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-4">
                                    <i class="bi bi-journal-x fs-1 text-muted"></i>
                                    <p class="text-muted mt-2">No activity logs found</p>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Pagination -->
    @if (Model?.TotalPages > 1)
    {
        <nav class="mt-4">
            <ul class="pagination justify-content-center">
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                        <a class="page-link" href="?page=@i&search=@ViewBag.Search&action=@ViewBag.Action&role=@ViewBag.Role&dateFrom=@ViewBag.DateFrom&dateTo=@ViewBag.DateTo">@i</a>
                    </li>
                }
            </ul>
        </nav>
    }
</div>

@section Styles {
    <style>
        .avatar-sm {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background: linear-gradient(45deg, #007bff, #6610f2);
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: bold;
            font-size: 12px;
        }
        
        .table tbody tr.error-row {
            background-color: #fff5f5;
        }
        
        .table tbody tr.warning-row {
            background-color: #fffbf0;
        }
        
        .table tbody tr.success-row {
            background-color: #f0fff4;
        }
    </style>
}

@section Scripts {
    <script>
        // Export handled by link now
        function clearOldLogs() {
            if (confirm('Are you sure you want to clear logs older than 30 days? This action cannot be undone.')) {
                fetch('/SuperAdmin/ClearOldLogs', {
                    method: 'POST'
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        location.reload();
                    } else {
                        alert('Failed to clear logs: ' + data.message);
                    }
                });
            }
        }

        // Auto-refresh every 30 seconds
        setInterval(function() {
            if (!document.hidden) {
                location.reload();
            }
        }, 30000);
    </script>
}

@functions {
    public string GetRowClass(string action)
    {
        return action?.ToLower() switch
        {
            "error" or "delete" => "error-row",
            "warning" or "update" => "warning-row",
            "login" or "create" => "success-row",
            _ => ""
        };
    }

    public string GetActionBadgeColor(string action)
    {
        return action?.ToLower() switch
        {
            "login" => "success",
            "logout" => "secondary",
            "create" => "primary",
            "update" => "warning",
            "delete" => "danger",
            "view" => "info",
            "error" => "danger",
            _ => "secondary"
        };
    }

    public string GetBrowserInfo(string userAgent)
    {
        if (string.IsNullOrEmpty(userAgent)) return "Unknown";
        
        if (userAgent.Contains("Chrome")) return "Chrome";
        if (userAgent.Contains("Firefox")) return "Firefox";
        if (userAgent.Contains("Safari")) return "Safari";
        if (userAgent.Contains("Edge")) return "Edge";
        
        return "Other";
    }
}