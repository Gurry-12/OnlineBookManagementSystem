@{
    ViewData["Title"] = "Home Page";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">

    <style>
        /* 1. Define the transition on the body */
        body {
            opacity: 1;
            /* Smoothly transition opacity changes over 0.5 seconds */
            transition: opacity 0.5s ease-in-out;
            background-color: #fff; /* Ensure background is solid white during fade */
        }

            /* 2. The class that triggers the fade out */
            body.fade-out {
                opacity: 0;
            }
    </style>
</head>
<body>

    <div class="container fluid w-100 vh-100 d-flex justify-content-center align-items-center">
        <div class="mx-auto w-25">
            <img src="~/images/render_website_name.png" class="img-fluid" alt="image" />
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>

    <script>
        // Total wait time: 3000ms (3 seconds)
        // Animation time: 500ms (0.5 seconds)
        // Start animation at: 2500ms

        setTimeout(function () {
            // Step 1: Add the class to start fading out visually
            document.body.classList.add('fade-out');

            // Step 2: Wait for the animation (500ms) to complete, then redirect
            setTimeout(function() {
                window.location.href = '@Url.Action("Login", "Auth")';
            }, 500);

        }, 2500);
    </script>
</body>
</html>