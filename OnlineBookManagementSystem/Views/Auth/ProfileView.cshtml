@using OnlineBookManagementSystem.Models.ViewModel
@model UserViewModel
@{
    ViewData["Title"] = "Profile";
}

<div class="container">
    <h2><i class="bi bi-person-circle me-2"></i>Your Profile</h2>
    <div class="row">
        <div class="col-md-6">
            <dl class="row">
                <dt class="col-sm-3">Name</dt>
                <dd class="col-sm-9">@Model.Name</dd>
                <dt class="col-sm-3">Email</dt>
                <dd class="col-sm-9">@Model.Email</dd>
                <dt class="col-sm-3">Role</dt>
                <dd class="col-sm-9">@Model.Role</dd>
                <dt class="col-sm-3">Cart Items</dt>
                <dd class="col-sm-9">@Model.CartItemCount</dd>
            </dl>
            <a asp-action="EditProfile" class="btn btn-primary">Edit Profile</a>
            <button id="LogoutBtn" class="btn btn-secondary">Logout</button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="~/js/auth/auth.js"></script>
}