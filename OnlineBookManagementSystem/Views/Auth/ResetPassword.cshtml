@using OnlineBookManagementSystem.Models.ViewModel.AuthViewModels
@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset Password";
    var token = Context.Request.Query["token"].ToString();
    var email = Context.Request.Query["email"].ToString();
}

<div class="auth-container">
    <div class="auth-card">
        <h2><i class="bi bi-lock-fill me-2"></i>Reset Password</h2>
        <form id="resetForm">
            <input type="hidden" id="Token" value="@token" />
            <input type="hidden" id="Email" value="@email" />
            <div class="mb-3">
                <label asp-for="NewPassword" class="form-label">New Password</label>
                <input asp-for="NewPassword" type="password" class="form-control" required />
                <span asp-validation-for="NewPassword" class="text-danger" id="NewPasswordError"></span>
            </div>
            <div class="mb-3">
                <label asp-for="ConfirmPassword" class="form-label">Confirm Password</label>
                <input asp-for="ConfirmPassword" type="password" class="form-control" required />
                <span asp-validation-for="ConfirmPassword" class="text-danger" id="ConfirmPasswordError"></span>
            </div>
            <button type="button" class="btn btn-primary" id="ResetPasswordBtn">Reset</button>
            <a asp-action="Login" class="btn btn-link">Back to Login</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="~/js/auth/auth.js"></script>
}