@{
    ViewData["Title"] = "Forgot Password";
    ViewData["Layout"] = "_LayoutAuth";
}

<div class="auth-container">
    <div class="auth-card">
        <h2><i class="bi bi-key me-2"></i>Forgot Password?</h2>
        <p>Enter your email to receive a reset link.</p>
        <form id="forgotForm">
            <div class="mb-3">
                <label for="Email" class="form-label">Email</label>
                <input type="email" id="ForgotEmail" class="form-control" required />
            </div>
            <button type="button" class="btn btn-primary" id="ForgotPasswordBtn">Send Reset Link</button>
            <a asp-action="Login" class="btn btn-link">Back to Login</a>
        </form>
    </div>
</div>

@if (TempData["Message"] != null)
{
    <script>toastr.info('@TempData["Message"]');</script>
}

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="~/js/auth/auth.js"></script>
}