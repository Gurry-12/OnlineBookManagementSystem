@using OnlineBookManagementSystem.Models.ViewModel.AuthViewModels
@model RegisterViewModel
@{
    ViewData["Title"] = "Registration";
    ViewData["Layout"] = "_LayoutAuth";
}

<div class="auth-grid">
    <div class="auth-illustration">
        <img src="~/images/3d-design-removebg-preview.png" alt="Whimsical Character" />
    </div>

    <div class="auth-container">
        <div class="auth-card">
            <div class="text-center mb-4">
                <h2 class="fw-bold">Sign Up</h2>
            </div>

            <form id="regForm">
                <div class="mb-3">
                    <label asp-for="Name" class="form-label"><i class="bi bi-person-fill me-1"></i>Name</label>
                    <input asp-for="Name" type="text" class="form-control" required />
                    <span asp-validation-for="Name" class="text-danger small" id="NameError"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label"><i class="bi bi-envelope-fill me-1"></i>Email</label>
                    <input asp-for="Email" type="email" class="form-control" required />
                    <span asp-validation-for="Email" class="text-danger small" id="EmailError"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label"><i class="bi bi-lock-fill me-1"></i>Password</label>
                    <div class="input-group">
                        <input asp-for="Password" type="password" class="form-control" required />
                        <span class="input-group-text toggle-password">
                            <i class="bi bi-eye-slash" toggle-password-icon></i>
                        </span>
                    </div>
                    <span asp-validation-for="Password" class="text-danger small" id="PasswordError"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="RequestedRole" class="form-label"><i class="bi bi-briefcase-fill me-1"></i>Account Type</label>
                    <select asp-for="RequestedRole" class="form-control form-select">
                        <option value="User">Standard User (Consumer)</option>
                        <option value="Admin">Retailer (Admin)</option>
                    </select>
                </div>

                <div class="d-grid mt-3 mb-3">
                    <button type="button" class="btn btn-primary-custom" id="SubmitForm">
                        <i class="bi bi-person-check-fill me-1"></i>Request Account
                    </button>
                    <small class="text-center text-muted mt-2">Note: New accounts require SuperAdmin approval.</small>
                </div>
            </form>

            <div class="text-center mb-3">
                <small>Or Continue With</small>
                <div class="social-buttons mt-2">
                    <button class="btn btn-light"><img src="https://www.google.com/favicon.ico" width="20" alt="Google"></button>
                    <button class="btn btn-light"><i class="bi bi-github"></i></button>
                    <button class="btn btn-light"><i class="bi bi-facebook"></i></button>
                </div>
            </div>

            <div class="text-center mt-2">
                <span class="fs-6">Already registered? <a asp-action="Login" class="auth-link ms-1">Login</a></span>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <script src="~/js/auth/auth.js"></script>

    @if (TempData["Error"] != null)
    {
        <script>toastr.error('@TempData["Error"]');</script>
    }

    <script>
        $(document).ready(function () {
            $('.toggle-password').click(function () {
                const input = $(this).prev('input');
                const icon = $(this).find('[toggle-password-icon]');
                if (input.attr('type') === 'password') {
                    input.attr('type', 'text');
                    icon.removeClass('bi-eye-slash').addClass('bi-eye');
                } else {
                    input.attr('type', 'password');
                    icon.removeClass('bi-eye').addClass('bi-eye-slash');
                }
            });
        });
    </script>
}