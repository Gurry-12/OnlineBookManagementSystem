@using OnlineBookManagementSystem.Models.ViewModel.AuthViewModels
@model LoginViewModel
@{
    ViewData["Title"] = "Login";
    ViewData["Layout"] = "_LayoutAuth";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" />
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600&display=swap" rel="stylesheet" />

<div class="auth-container">
    <div class="auth-card">
        <div class="text-center mb-4">
            <img src="~/images/render_website_name.png" class="img-fluid" style="max-width: 100px;" alt="Logo" />
            <h2 class="mt-3"><i class="bi bi-box-arrow-in-right me-2"></i>Login</h2>
        </div>

        <form id="loginForm">
            <div class="mb-3">
                <label asp-for="Email" class="form-label"><i class="bi bi-envelope-fill me-1"></i>Email</label>
                <input asp-for="Email" type="email" class="form-control" required />
                <span asp-validation-for="Email" class="text-danger small" id="EmailError"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label"><i class="bi bi-lock-fill me-1"></i>Password</label>
                <input asp-for="Password" type="password" class="form-control" required />
                <span asp-validation-for="Password" class="text-danger small" id="PasswordError"></span>
            </div>

            <div class="d-flex justify-content-between align-items-center mb-3">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="RememberMe" />
                    <label class="form-check-label" for="RememberMe">Remember me</label>
                </div>
                <a id="ForgotPasswordBtn" class="forgot-password-link" href="#" data-bs-toggle="modal" data-bs-target="#forgotModal">
                    Forgot Password?
                </a>
            </div>

            <div class="d-grid mb-3">
                <button type="button" class="btn btn-gradient" id="LoginData">
                    <i class="bi bi-door-open-fill me-1"></i>Login
                </button>
            </div>

            <div class="text-center">
                <p class="mb-0">
                    New here? <a asp-action="Registration" class="login-link ms-1">Sign up</a>
                </p>
            </div>
        </form>
    </div>
</div>

<!-- Forgot Password Modal -->
<div class="modal fade" id="forgotModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Reset Password</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="email" id="ForgotEmail" class="form-control" placeholder="Enter your email" required />
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="ForgotPasswordBtn">Send Reset Link</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>

    <!-- ONLY THIS ONE AUTH SCRIPT -->
    <script src="~/js/auth/auth.js"></script>

    <!-- Remove any reference to registration.js or BooksHome.js here -->
}