@using OnlineBookManagementSystem.Models.ViewModel
@model ProfileViewModel
@{
    ViewData["Title"] = "Edit Profile";
    // Assume Model populated from session/user
    <input type="hidden" id="UserId" value="@Model.Id" />
}

<div class="container">
    <h2>Edit Profile</h2>
    <form id="profileForm">
        <div class="mb-3">
            <label asp-for="NewName" class="form-label">Name</label>
            <input asp-for="NewName" type="text" class="form-control" value="@Model.NewName" required />
            <span asp-validation-for="NewName" class="text-danger" id="NameError"></span>
        </div>
        <div class="mb-3">
            <label asp-for="NewEmail" class="form-label">Email</label>
            <input asp-for="NewEmail" type="email" class="form-control" value="@Model.NewEmail" required />
            <span asp-validation-for="NewEmail" class="text-danger" id="EmailError"></span>
        </div>
        <button type="button" class="btn btn-primary" id="UpdateProfileBtn">Update</button>
        <a asp-action="ProfileView" class="btn btn-secondary">Cancel</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="~/js/auth/auth.js"></script>
}