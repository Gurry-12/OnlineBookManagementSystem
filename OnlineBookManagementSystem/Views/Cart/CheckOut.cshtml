@using OnlineBookManagementSystem.Models.ViewModel
@model CheckOutViewModel

@{
    ViewData["Title"] = "Checkout    ";
    Layout = ViewData["Layout"]?.ToString() ?? "_LayoutUser";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <h2 class="text-center mb-5 display-5 fw-bold text-success">
                <i class="bi bi-check2-circle me-3"></i>Checkout
            </h2>

            <div class="row g-5">
                <!-- Order Summary -->
                <div class="col-lg-5 order-lg-2">
                    <div class="card shadow-sm border-0 rounded-4 sticky-top" style="top: 100px;">
                        <div class="card-header bg-success text-white">
                            <h5 class="mb-0"><i class="bi bi-receipt me-2"></i>Order Summary</h5>
                        </div>
                        <div class="card-body">
                            @foreach (var item in Model.CartItems)
                            {
                                <div class="d-flex justify-content-between mb-2">
                                    <span>@item.BookTitle <small class="text-muted">× @item.Quantity</small></span>
                                    <span>₹@item.Subtotal.ToString("F2")</span>
                                </div>
                            }
                            <hr>
                            <div class="d-flex justify-content-between mb-2">
                                <span>Subtotal</span>
                                <span>₹@Model.Subtotal.ToString("F2")</span>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span>Tax (10%)</span>
                                <span>₹@Model.Tax.ToString("F2")</span>
                            </div>
                            <div class="d-flex justify-content-between mb-3 text-success fw-bold">
                                <span>Shipping</span>
                                <span>@(Model.Shipping == 0 ? "FREE" : $"₹{Model.Shipping}")</span>
                            </div>
                            <hr class="border-2">
                            <div class="d-flex justify-content-between align-items-center">
                                <h4 class="mb-0">Total</h4>
                                <h4 class="text-success mb-0">₹@Model.GrandTotal.ToString("F2")</h4>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Checkout Form -->
                <div class="col-lg-7 order-lg-1">
                    <div class="card shadow-sm border-0 rounded-4">
                        <div class="card-body p-5">
                            <form asp-action="ProcessCheckout" method="post">
                                @Html.AntiForgeryToken()

                                <h4 class="mb-4"><i class="bi bi-truck me-2"></i>Shipping Address</h4>
                                <div class="row g-3">
                                    <div class="col-12">
                                        <label class="form-label">Full Name</label>
                                        <input type="text" name="Name" class="form-control form-control-lg" required />
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label">Phone Number</label>
                                        <input type="tel" name="Phone" class="form-control form-control-lg" placeholder="10-digit mobile" />
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label">Shipping Address</label>
                                        <textarea name="Address" class="form-control" rows="3" required></textarea>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label">City</label>
                                        <input type="text" name="City" class="form-control" required />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label">PIN Code</label>
                                        <input type="text" name="PinCode" class="form-control" required />
                                    </div>
                                </div>

                                <hr class="my-5">

                                <h4 class="mb-4"><i class="bi bi-credit-card me-2"></i>Payment Method</h4>
                                <div class="row g-3">
                                    <div class="col-12">
                                        <div class="form-check">
                                            <input class="form-check-input" type="radio" name="PaymentMethod" value="COD" checked>
                                            <label class="form-check-label">
                                                <i class="bi bi-cash-stack me-2 text-success"></i>
                                                Cash on Delivery (COD)
                                            </label>
                                        </div>
                                    </div>
                                    <div class="col-12">
                                        <div class="form-check">
                                            <input class="form-check-input" type="radio" name="PaymentMethod" value="UPI">
                                            <label class="form-check-label">
                                                <i class="bi bi-phone me-2 text-info"></i>
                                                UPI / Card / Net Banking
                                            </label>
                                        </div>
                                    </div>
                                </div>

                                <div class="mt-5 text-center">
                                    <button type="submit" class="btn btn-success btn-lg px-5 rounded-pill shadow">
                                        <i class="bi bi-lock-fill me-2"></i>
                                        Place Order – ₹@Model.GrandTotal.ToString("F2")
                                    </button>
                                    <p class="text-muted mt-3">
                                        <i class="bi bi-shield-check me-2"></i>
                                        Your payment is secure and encrypted.
                                    </p>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@await Html.PartialAsync("_Notification")