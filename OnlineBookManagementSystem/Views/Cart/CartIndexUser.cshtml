@using OnlineBookManagementSystem.Models.ViewModel
@model CartViewModel

@{
    ViewData["Title"] = "My Cart";
    Layout = ViewData["Layout"]?.ToString() ?? "_LayoutUser";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
<link href="~/css/cartstylesheet.css" rel="stylesheet" />

<div class="container py-5">
    <div class="container">
        <h2 class="text-center mb-5 display-5 fw-bold text-primary">
            <i class="bi bi-cart4 me-3"></i>My Cart
        </h2>

        @if (Model?.CartItems == null || !Model.CartItems.Any())
        {
            <div class="text-center py-5">
                <i class="bi bi-cart-x display-1 text-muted mb-4"></i>
                <h3>Your cart is empty</h3>
                <p class="text-muted mb-4">Looks like you haven't added anything yet.</p>
                <a asp-controller="Books" asp-action="UserIndex" class="btn btn-primary btn-lg">
                    Continue Shopping
                </a>
            </div>
            return;
        }

        <div class="row g-5">
            <!-- Cart Items -->
            <div class="col-lg-8">
                <div class="card shadow-sm border-0 rounded-4">
                    <div class="card-body p-4">
                        @foreach (var item in Model.CartItems)
                        {
                            <div class="cart-item border-bottom pb-4 mb-4" data-book-id="@item.BookId">
                                <div class="row align-items-center">
                                    <div class="col-3 col-md-2 text-center">
                                        <img src="@(item.BookImage ?? Url.Content("~/images/default-book.jpg"))"
                                             alt="@item.BookTitle"
                                             class="img-fluid rounded shadow-sm"
                                             style="height: 120px; object-fit: cover;" />
                                    </div>
                                    <div class="col-9 col-md-10">
                                        <div class="d-flex justify-content-between align-items-start">
                                            <div>
                                                <h5 class="mb-1">@item.BookTitle</h5>
                                                <p class="text-muted mb-1">by @item.BookAuthor</p>
                                                @if (!string.IsNullOrEmpty(item.CategoryName))
                                                {
                                                    <span class="badge bg-light text-dark">@item.CategoryName</span>
                                                }
                                            </div>
                                            <button class="btn btn-link text-danger p-0" onclick="RemoveFromCart(@item.BookId)">
                                                <i class="bi bi-trash3 fs-5"></i>
                                            </button>
                                        </div>

                                        <div class="mt-3 d-flex align-items-center gap-3">
                                            <div class="input-group input-group-sm" style="width: 130px;">
                                                <button class="btn btn-outline-secondary" onclick="UpdateQuantity(@item.BookId, -1)">−</button>
                                                <input type="text" class="form-control text-center" value="@item.Quantity" readonly id="qty-@item.BookId" />
                                                <button class="btn btn-outline-secondary" onclick="UpdateQuantity(@item.BookId, 1)">+</button>
                                            </div>
                                            <span class="fw-bold text-primary">₹@item.BookPrice.ToString("F2")</span>
                                            <span class="ms-auto fw-bold">= ₹<span class="item-total">@(item.Subtotal.ToString("F2"))</span></span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Order Summary -->
            <div class="col-lg-4">
                <div class="card shadow-sm border-0 rounded-4 sticky-top" style="top: 100px;">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0"><i class="bi bi-receipt me-2"></i>Order Summary</h5>
                    </div>
                    <div class="card-body">
                        <div class="d-flex justify-content-between mb-2">
                            <span>Subtotal (@Model.Summary.ItemCount items)</span>
                            <span>₹<span id="subtotal">@Model.Summary.Subtotal.ToString("F2")</span></span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span>Tax (10%)</span>
                            <span>₹<span id="tax">@Model.Summary.Tax.ToString("F2")</span></span>
                        </div>
                        <div class="d-flex justify-content-between mb-3 text-success fw-bold">
                            <span>Shipping</span>
                            <span id="shipping">
                                @(Model.Summary.Shipping == 0 ? "FREE" : $"₹{Model.Summary.Shipping}")
                            </span>
                        </div>
                        <hr>
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <h4 class="mb-0">Total</h4>
                            <h4 class="text-primary mb-0">₹<span id="grand-total">@Model.Summary.GrandTotal.ToString("F2")</span></h4>
                        </div>

                        @if (Model.Summary.GrandTotal > 1000)
                        {
                            <div class="alert alert-success small py-2 text-center">
                                <i class="bi bi-truck me-2"></i>Congrats! You get <strong>Free Shipping</strong>
                            </div>
                        }

                        <a asp-action="Checkout" class="btn btn-success btn-lg w-100 rounded-pill shadow">
                            <i class="bi bi-lock me-2"></i>Proceed to Checkout
                        </a>
                        <a asp-controller="Books" asp-action="UserIndex" class="btn btn-outline-primary w-100 mt-2">
                            <i class="bi bi-arrow-left me-2"></i>Continue Shopping
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@await Html.PartialAsync("_Notification")

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <script src="~/js/books/bookshome.js"></script>
    <script>
        function UpdateQuantity(bookId, change) {
            const input = $(`#qty-${bookId}`);
            let qty = parseInt(input.val()) || 1;
            qty = Math.max(1, qty + change);
            input.val(qty);

            $.post('/Cart/UpdateQuantity', { bookId, quantity: qty }, function(res) {
                if (res.success) {
                    location.reload(); // Refresh totals
                } else {
                    toastr.error('Stock limit reached!');
                    location.reload();
                }
            });
        }

        function RemoveFromCart(bookId) {
            if (confirm('Remove this item from cart?')) {
                $.ajax({
                    url: '/Cart/RemoveItem',
                    method: 'DELETE',
                    data: { bookId },
                    success: function(res) {
                        if (res.success) {
                            $(`#cart-item-${bookId}`).fadeOut(300, function() { $(this).remove(); });
                            toastr.success('Item removed');
                            setTimeout(() => location.reload(), 500);
                        }
                    }
                });
            }
        }
    </script>
}