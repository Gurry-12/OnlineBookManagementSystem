@{
    ViewData["Title"] = "Email Confirmation - Whispering Pages";
    bool isSuccess = ViewBag.IsSuccess ?? false;
    ViewData["Layout"] = "_LayoutAuth";
}

@* Use semantic auth view wrapper for consistent min-height and centering *@
<div class="view-auth-confirm">
    <div class="auth-confirm-card wp-card wp-card--glass text-center">
        <div class="wp-card-body">

            @if (isSuccess)
            {
                <div class="auth-confirm-card__icon auth-confirm-card__icon--success">
                    <i class="bi bi-check-circle-fill"></i>
                </div>
                <h1 class="wp-card-title auth-confirm-card__heading text-success">Email Confirmed!</h1>
                <p class="wp-card-text auth-confirm-card__message">
                    Your email address has been successfully verified. You now have full access to your account.
                </p>
                <a asp-controller="Auth" asp-action="Login" class="wp-btn wp-btn-primary wp-btn-full"
                   id="ConfirmEmailLoginBtn">
                    <i class="bi bi-box-arrow-in-right me-2"></i> Sign In Now
                </a>
            }
            else
            {
                <div class="auth-confirm-card__icon auth-confirm-card__icon--danger">
                    <i class="bi bi-x-circle-fill"></i>
                </div>
                <h1 class="wp-card-title auth-confirm-card__heading text-danger">Confirmation Failed</h1>
                <p class="wp-card-text auth-confirm-card__message">
                    We couldn't confirm your email. The link may be invalid or expired.
                </p>
                <a asp-controller="Auth" asp-action="Login" class="wp-btn wp-btn-outline wp-btn-full"
                   id="ConfirmEmailFallbackBtn">
                    <i class="bi bi-arrow-left me-2"></i> Go to Login
                </a>
            }
        </div>
    </div>
</div>
