@model OnlineBookManagementSystem.Presentation.ViewModels.AuthViewModels.ForgotPasswordViewModel

@{
    ViewData["Title"] = "Forgot Password";
}

<div class="row justify-content-center">
    <div class="col-md-4">
        <h2 class="text-center">Forgot Password</h2>
        <form id="forgotPasswordForm">
            <div class="form-group mb-3">
                <label asp-for="Email" class="control-label"></label>
                <input asp-for="Email" class="form-control" type="email" required />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="form-group d-grid">
                <button type="submit" class="wp-btn wp-btn-primary">Send Reset Link</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('forgotPasswordForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            const btn = e.target.querySelector('button');
            const originalText = btn.innerText;
            btn.disabled = true;
            btn.innerText = 'Sending...';

            const email = document.getElementById('Email').value;

            try {
                const response = await fetch('/Auth/ForgotPassword', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ email: email })
                });
                const result = await response.json();

                if (result.success) {
                    toastr.success(result.message);
                } else {
                    toastr.error(result.message);
                }
            } catch (error) {
                toastr.error("An error occurred.");
            } finally {
                btn.disabled = false;
                btn.innerText = originalText;
            }
        });
    </script>
}


