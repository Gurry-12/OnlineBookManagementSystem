@model OnlineBookManagementSystem.Presentation.ViewModels.User.ProfileViewModel
@{
    ViewData["Title"] = "User Profile";
    
    // Determine layout based on user role
    var userRoles = Model.Roles;
    if (userRoles.Contains("SuperAdmin"))
    {
        Layout = "/Presentation/Views/Shared/_LayoutSuperAdmin.cshtml";
    }
    else if (userRoles.Contains("Admin"))
    {
        Layout = "/Presentation/Views/Shared/_LayoutAdmin.cshtml";
    }
    else
    {
        Layout = "/Presentation/Views/Shared/_LayoutUser.cshtml";
    }
}

<div class="container-fluid p-4">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="mb-0">
                    <i class="bi bi-person-circle me-2"></i>User Profile
                </h2>
                <div class="d-flex gap-2">
                    @foreach (var role in Model.Roles)
                    {
                        <span class="wp-badge @GetRoleBadgeClass(role) fs-6">@role</span>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Profile Information Card -->
        <div class="col-md-6">
            <div class="wp-card border-0 shadow-sm h-100">
                <div class="wp-card-header bg-primary text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-info-circle me-2"></i>Profile Information
                    </h5>
                </div>
                <div class="wp-card-body">
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label fw-bold">Full Name</label>
                            <div class="form-control-plaintext border rounded p-2 bg-light">
                                @Model.Name
                            </div>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-bold">Email Address</label>
                            <div class="form-control-plaintext border rounded p-2 bg-light">
                                @Model.Email
                            </div>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-bold">Account Created</label>
                            <div class="form-control-plaintext border rounded p-2 bg-light">
                                @Model.CreatedAt.ToString("MMMM dd, yyyy 'at' hh:mm tt")
                            </div>
                        </div>
                        @if (Model.LastLoginDate.HasValue)
                        {
                            <div class="col-12">
                                <label class="form-label fw-bold">Last Login</label>
                                <div class="form-control-plaintext border rounded p-2 bg-light">
                                    @Model.LastLoginDate.Value.ToString("MMMM dd, yyyy 'at' hh:mm tt")
                                </div>
                            </div>
                        }
                        <div class="col-12">
                            <label class="form-label fw-bold">Assigned Roles</label>
                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var role in Model.Roles)
                                {
                                    <span class="wp-badge @GetRoleBadgeClass(role) fs-6">
                                        <i class="bi @GetRoleIcon(role) me-1"></i>@role
                                    </span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Update Profile Card -->
        <div class="col-md-6">
            <div class="wp-card border-0 shadow-sm h-100">
                <div class="wp-card-header bg-success text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-pencil-square me-2"></i>Update Profile
                    </h5>
                </div>
                <div class="wp-card-body">
                    <form id="updateProfileForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />
                        
                        <div class="mb-3">
                            <label asp-for="NewName" class="form-label">New Name</label>
                            <input asp-for="NewName" class="form-control" placeholder="Enter new name (optional)">
                            <span asp-validation-for="NewName" class="text-danger"></span>
                        </div>
                        
                        <div class="mb-3">
                            <label asp-for="NewEmail" class="form-label">New Email</label>
                            <input asp-for="NewEmail" type="email" class="form-control" placeholder="Enter new email (optional)">
                            <span asp-validation-for="NewEmail" class="text-danger"></span>
                        </div>
                        
                        <hr class="my-4">
                        
                        <h6 class="text-muted mb-3">Change Password</h6>
                        
                        <div class="mb-3">
                            <label asp-for="CurrentPassword" class="form-label">Current Password</label>
                            <input asp-for="CurrentPassword" type="password" class="form-control" placeholder="Enter current password">
                            <span asp-validation-for="CurrentPassword" class="text-danger"></span>
                        </div>
                        
                        <div class="mb-3">
                            <label asp-for="NewPassword" class="form-label">New Password</label>
                            <input asp-for="NewPassword" type="password" class="form-control" placeholder="Enter new password">
                            <span asp-validation-for="NewPassword" class="text-danger"></span>
                        </div>
                        
                        <div class="mb-4">
                            <label asp-for="ConfirmNewPassword" class="form-label">Confirm New Password</label>
                            <input asp-for="ConfirmNewPassword" type="password" class="form-control" placeholder="Confirm new password">
                            <span asp-validation-for="ConfirmNewPassword" class="text-danger"></span>
                        </div>
                        
                        <div class="d-grid">
                            <button type="submit" class="wp-btn-success">
                                <i class="bi bi-check-circle me-2"></i>Update Profile
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Account Statistics Card -->
    <div class="row mt-4">
        <div class="col-12">
            <div class="wp-card border-0 shadow-sm">
                <div class="wp-card-header bg-info text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-graph-up me-2"></i>Account Statistics
                    </h5>
                </div>
                <div class="wp-card-body">
                    <div class="row text-center g-4">
                        <div class="col-md-3">
                            <div class="p-3">
                                <i class="bi bi-calendar-check display-4 text-primary"></i>
                                <h6 class="mt-2">Account Age</h6>
                                <p class="text-muted">@((DateTime.Now - Model.CreatedAt).Days) days</p>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="p-3">
                                <i class="bi bi-shield-check display-4 text-success"></i>
                                <h6 class="mt-2">Security Level</h6>
                                <p class="text-muted">@(Model.Roles.Contains("SuperAdmin") ? "Maximum" : Model.Roles.Contains("Admin") ? "High" : "Standard")</p>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="p-3">
                                <i class="bi bi-person-badge display-4 text-warning"></i>
                                <h6 class="mt-2">Role Count</h6>
                                <p class="text-muted">@Model.Roles.Count role(s)</p>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="p-3">
                                <i class="bi bi-clock-history display-4 text-info"></i>
                                <h6 class="mt-2">Last Activity</h6>
                                <p class="text-muted">@(Model.LastLoginDate?.ToString("MMM dd") ?? "Never")</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Toast Container -->
<div class="toast-container position-fixed bottom-0 end-0 p-3">
    <div id="successToast" class="toast" role="alert">
        <div class="toast-header bg-success text-white">
            <i class="bi bi-check-circle me-2"></i>
            <strong class="me-auto">Success</strong>
            <button type="button" class="wp-btn-close wp-btn-close-white" data-bs-dismiss="toast"></button>
        </div>
        <div class="toast-body"></div>
    </div>
    
    <div id="errorToast" class="toast" role="alert">
        <div class="toast-header bg-danger text-white">
            <i class="bi bi-exclamation-triangle me-2"></i>
            <strong class="me-auto">Error</strong>
            <button type="button" class="wp-btn-close wp-btn-close-white" data-bs-dismiss="toast"></button>
        </div>
        <div class="toast-body"></div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('updateProfileForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            
            const formData = new FormData(this);
            const data = Object.fromEntries(formData.entries());
            
            // Only send fields that have values
            const updateData = {};
            if (data.NewName && data.NewName.trim()) updateData.NewName = data.NewName.trim();
            if (data.NewEmail && data.NewEmail.trim()) updateData.NewEmail = data.NewEmail.trim();
            if (data.CurrentPassword && data.NewPassword) {
                updateData.CurrentPassword = data.CurrentPassword;
                updateData.NewPassword = data.NewPassword;
                updateData.ConfirmNewPassword = data.ConfirmNewPassword;
            }
            
            if (Object.keys(updateData).length === 0) {
                showError('Please fill in at least one field to update.');
                return;
            }
            
            updateData.Id = data.Id;
            
            try {
                const response = await fetch('/Auth/UpdateProfile', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${localStorage.getItem('token')}`
                    },
                    body: JSON.stringify(updateData)
                });
                
                const result = await response.json();
                
                if (result.success) {
                    showSuccess(result.message);
                    setTimeout(() => location.reload(), 2000);
                } else {
                    showError(result.message);
                }
            } catch (error) {
                showError('An error occurred while updating your profile');
            }
        });
        
        function showSuccess(message) {
            const toast = document.getElementById('successToast');
            toast.querySelector('.toast-body').textContent = message;
            new bootstrap.Toast(toast).show();
        }
        
        function showError(message) {
            const toast = document.getElementById('errorToast');
            toast.querySelector('.toast-body').textContent = message;
            new bootstrap.Toast(toast).show();
        }
    </script>
}

@functions {
    string GetRoleBadgeClass(string role)
    {
        return role switch
        {
            "SuperAdmin" => "bg-danger",
            "Admin" => "bg-warning text-dark",
            "User" => "bg-primary",
            "Guest" => "bg-secondary",
            _ => "bg-secondary"
        };
    }
    
    string GetRoleIcon(string role)
    {
        return role switch
        {
            "SuperAdmin" => "bi-shield-fill-exclamation",
            "Admin" => "bi-shield-fill-check",
            "User" => "bi-person-fill",
            "Guest" => "bi-person",
            _ => "bi-question-circle"
        };
    }
}



