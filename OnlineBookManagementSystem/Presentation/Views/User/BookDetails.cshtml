@using OnlineBookManagementSystem.Presentation.ViewModels.Books
@model BookDetailsViewModel

@{
    ViewData["Title"] = Model.Title;
    Layout = ViewData["Layout"]?.ToString() ?? "_LayoutUser";
}

<div class="container py-5">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="UserBookList">Books</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Title</li>
        </ol>
    </nav>

    <div class="row">
        <!-- Image Column -->
        <div class="col-md-4 mb-4">
            <div class="card border-0 shadow-sm">
                <img src="@(Model.ImageUrl ?? Url.Content("~/images/default-book-improved.svg"))" class="card-img-top" alt="@Model.Title">
            </div>
        </div>

        <!-- Details Column -->
        <div class="col-md-8">
            <h1 class="display-5 fw-bold">@Model.Title</h1>
            <p class="fs-4 text-muted">by @Model.Author</p>

            <div class="d-flex align-items-center mb-3">
                <span class="text-warning fs-5 me-2">
                    @for(int i=0; i < 5; i++) {
                        if (i < Math.Round(Model.Rating.AverageRating)) { <i class="bi bi-star-fill"></i> }
                        else { <i class="bi bi-star"></i> }
                    }
                </span>
                <span class="text-muted">(@Model.Rating.TotalReviews reviews)</span>
            </div>

            <h2 class="text-primary mb-3">@Model.FormattedPrice</h2>

            <!-- Stock Status -->
            <div class="mb-4">
                @if (Model.StockQuantity > 0)
                {
                    <span class="badge bg-success fs-6"><i class="bi bi-check-circle me-1"></i>In Stock (@Model.StockQuantity available)</span>
                }
                else
                {
                    <span class="badge bg-danger fs-6"><i class="bi bi-x-circle me-1"></i>Out of Stock</span>
                }
            </div>

            <p class="lead">@Model.Description</p>

            <div class="row mt-4">
                <div class="col-md-6 d-grid gap-2">
                    @if (Model.StockQuantity > 0)
                    {
                        <div class="input-group mb-3">
                            <span class="input-group-text">Qty</span>
                            <input type="number" id="qty" class="form-control" value="1" min="1" max="@Model.StockQuantity">
                            <button class="btn btn-primary" onclick="AddToCart(@Model.Id)">
                                <i class="bi bi-cart-plus me-2"></i>Add to Cart
                            </button>
                        </div>
                    }
                    else
                    {
                        <button class="btn btn-secondary disabled" disabled>
                            <i class="bi bi-cart-x me-2"></i>Out of Stock
                        </button>
                    }
                </div>
                <div class="col-md-6 d-grid gap-2">
                     <button class="btn btn-outline-danger" onclick="ToggleFavorite(@Model.Id)">
                        <i class="bi @(Model.IsFavorite == true ? "bi-heart-fill" : "bi-heart")" id="fav-icon-@Model.Id"></i>
                        <span id="fav-text-@Model.Id">@(Model.IsFavorite == true ? "Remove from Favorites" : "Add to Favorites")</span>
                    </button>
                </div>
            </div>

            <div class="mt-4">
                <h5>Product Details</h5>
                <ul class="list-unstyled">
                    <li><strong>ISBN:</strong> @(Model.ISBN ?? "Not Available")</li>
                    <li><strong>Category:</strong> @Model.CategoryName</li>
                    <li><strong>Added:</strong> @Model.FormattedCreatedAt</li>
                </ul>
            </div>
        </div>
    </div>
</div>

@await Html.PartialAsync("_Notification")

@section Scripts {
    <!-- Core AJAX Infrastructure -->
    <script src="~/js/core/apiClient.js"></script>
    <script src="~/js/core/notifications.js"></script>
    
    <script>
        async function AddToCart(bookId) {
            const qty = document.getElementById('qty').value;
            try {
                const response = await fetch('/User/AddToCart', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ bookId: bookId, quantity: parseInt(qty) })
                });
                const res = await response.json();
                if (res.success) {
                    notifications.success(res.message);
                    // Update cart badge if exists
                    const cartCount = document.getElementById('cartItemCount');
                    if(cartCount) {
                        cartCount.innerText = res.cartCount;
                        cartCount.style.display = res.cartCount > 0 ? 'inline' : 'none';
                    }
                } else {
                    notifications.error(res.message);
                }
            } catch (err) {
                notifications.error('Error adding to cart');
            }
        }

        async function ToggleFavorite(bookId) {
             try {
                const response = await fetch('/User/ToggleFavorite', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ bookId: bookId })
                });
                const res = await response.json();
                if (res.success) {
                    notifications.success(res.message);
                    const icon = document.getElementById('fav-icon-' + bookId);
                    const text = document.getElementById('fav-text-' + bookId);
                    if (res.isFavorite) {
                        icon.classList.remove('bi-heart');
                        icon.classList.add('bi-heart-fill');
                        text.innerText = "Remove from Favorites";
                    } else {
                        icon.classList.remove('bi-heart-fill');
                        icon.classList.add('bi-heart');
                        text.innerText = "Add to Favorites";
                    }
                } else {
                    notifications.error(res.message);
                }
            } catch (err) {
                notifications.error('Error updating favorites');
            }
        }
    </script>
}
