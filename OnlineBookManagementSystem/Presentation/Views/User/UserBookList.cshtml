@using OnlineBookManagementSystem.Presentation.ViewModels.Books
@model BookListViewModel

@{
    ViewData["Title"] = "Browse Books - User";
    Layout = ViewData["Layout"]?.ToString() ?? "_LayoutUser";
}

<div class="container user-books-page" data-page="user-books">
    <!-- Page Header -->
    <div class="wp-card mb-4">
        <div class="wp-card-header">
            <h2 class="mb-0 user-text-on-primary">
                <i class="bi bi-book me-2"></i>Browse Books
            </h2>
        </div>
        <div class="wp-card-body">
            <p class="user-text-muted mb-0">Discover your next favorite book from our collection</p>
        </div>
    </div>

    <!-- Search & Filters -->
    <div class="wp-card mb-4">
        <div class="wp-card-body">
            <div class="row g-3">
                <div class="col-md-3">
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-search"></i></span>
                        <input type="text" name="search" value="@ViewBag.Search" 
                               class="wp-form-control" placeholder="Search title/author..." />
                    </div>
                </div>
                
                <div class="col-md-2">
                    <select name="categoryId" class="wp-form-control" asp-items="ViewBag.Categories">
                        <option value="">All Categories</option>
                    </select>
                </div>
                
                <div class="col-md-2">
                    <select name="sortBy" class="wp-form-control">
                        <option value="">Sort By</option>
                        <option value="priceAsc">Price: Low to High</option>
                        <option value="priceDesc">Price: High to Low</option>
                        <option value="title">Title A-Z</option>
                        <option value="newest">Newest First</option>
                    </select>
                </div>
                
                <div class="col-md-2">
                    <input type="number" name="minPrice" value="@ViewBag.MinPrice" 
                           class="wp-form-control" placeholder="Min Price" min="0" step="0.01" />
                </div>
                
                <div class="col-md-2">
                    <input type="number" name="maxPrice" value="@ViewBag.MaxPrice" 
                           class="wp-form-control" placeholder="Max Price" min="0" step="0.01" />
                </div>
                
                <div class="col-md-1">
                    <button class="wp-btn wp-btn-secondary w-100" type="button" onclick="windows.refresh()">
                        <i class="bi bi-arrow-clockwise"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Books Content Container -->
    <div id="user-books-content">
        @await Html.PartialAsync("_UserBooksGrid", Model)
    </div>
</div>

@await Html.PartialAsync("_Notification")

@section Scripts {
    <!-- Core AJAX Infrastructure -->
    <script src="~/js/core/apiClient.js"></script>
    <script src="~/js/core/notifications.js"></script>
    <script src="~/js/core/urlStateManager.js"></script>
    
    <!-- User Book Management -->
    <script src="~/js/user/userBookManager.js"></script>
}