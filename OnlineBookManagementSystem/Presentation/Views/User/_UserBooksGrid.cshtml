@using OnlineBookManagementSystem.Presentation.ViewModels.Books
@model BookListViewModel

<!-- Books Grid -->
<div class="row g-4 mb-4" id="books-list">
    @if (Model.Books.Any())
    {
        @foreach (var book in Model.Books)
        {
            <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                <div class="wp-card h-100 book-card">
                    <div class="position-relative">
                        <!-- Favorite Button -->
                        <button class="btn btn-link position-absolute top-0 end-0 p-2 toggle-favorite-btn" 
                                data-book-id="@book.Id" 
                                title="@(book.IsFavorite ? "Remove from favorites" : "Add to favorites")">
                            <i class="bi @(book.IsFavorite ? "bi-heart-fill text-danger" : "bi-heart")"></i>
                        </button>
                        
                        <!-- Stock Badge -->
                        @if (book.StockQuantity <= 0)
                        {
                            <div class="position-absolute top-0 start-0 m-2">
                                <span class="wp-badge wp-badge-error">Out of Stock</span>
                            </div>
                        }
                        else if (book.StockQuantity <= 5)
                        {
                            <div class="position-absolute top-0 start-0 m-2">
                                <span class="wp-badge wp-badge-warning">Low Stock</span>
                            </div>
                        }
                        
                        <!-- Book Image -->
                        <img src="@(book.ImageUrl ?? Url.Content("~/images/default-book-improved.svg"))" 
                             alt="@book.Title" 
                             class="card-img-top wp-book-image" 
                             style="height: 250px; object-fit: cover;" />
                    </div>
                    
                    <div class="wp-card-body d-flex flex-column">
                        <h6 class="card-title user-text-primary">@book.Title</h6>
                        <p class="card-text user-text-muted small mb-2">
                            <i class="bi bi-person me-1"></i>@book.Author
                        </p>
                        
                        @if (!string.IsNullOrEmpty(book.Category?.Name))
                        {
                            <div class="mb-2">
                                <span class="wp-badge wp-badge-info">
                                    <i class="bi bi-tag me-1"></i>@book.Category.Name
                                </span>
                            </div>
                        }
                        
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span class="h5 user-text-secondary mb-0">₹@book.Price.Amount.ToString("N2")</span>
                            <small class="wp-badge wp-badge-success">
                                <i class="bi bi-box me-1"></i>@book.StockQuantity in stock
                            </small>
                        </div>
                        
                        <div class="mt-auto">
                            <div class="d-flex gap-2">
                                <a asp-action="BookDetails" asp-route-id="@book.Id" 
                                   class="wp-btn wp-btn-secondary btn-sm flex-fill">
                                    <i class="bi bi-eye me-1"></i>View Details
                                </a>
                                
                                @if (book.StockQuantity > 0)
                                {
                                    <button class="wp-btn wp-btn-primary btn-sm add-to-cart-btn" 
                                            data-book-id="@book.Id" 
                                            data-quantity="1">
                                        <i class="bi bi-cart-plus me-1"></i>Add to Cart
                                    </button>
                                }
                                else
                                {
                                    <button class="btn btn-secondary btn-sm" disabled>
                                        <i class="bi bi-x-circle me-1"></i>Out of Stock
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12">
            <div class="wp-card text-center py-5">
                <div class="wp-card-body">
                    <i class="bi bi-book display-1 user-text-muted mb-3"></i>
                    <h5 class="user-text-primary">No Books Found</h5>
                    <p class="user-text-muted mb-4">No books match your current search criteria. Try adjusting your filters.</p>
                    <a asp-controller="Home" asp-action="Index" class="wp-btn wp-btn-primary">
                        <i class="bi bi-house me-2"></i>Browse All Books
                    </a>
                </div>
            </div>
        </div>
    }
</div>

<!-- Pagination -->
@if (Model.TotalPages > 1)
{
    <nav aria-label="Book pagination" class="pagination-container">
        <ul class="pagination justify-content-center">
            <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                <a class="page-link" href="#" data-page="@(Model.CurrentPage - 1)">
                    <i class="bi bi-chevron-left"></i> Previous
                </a>
            </li>
            
            @for (int i = Math.Max(1, Model.CurrentPage - 2); i <= Math.Min(Model.TotalPages, Model.CurrentPage + 2); i++)
            {
                <li class="page-item @(Model.CurrentPage == i ? "active" : "")">
                    <a class="page-link" href="#" data-page="@i">@i</a>
                </li>
            }
            
            <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                <a class="page-link" href="#" data-page="@(Model.CurrentPage + 1)">
                    Next <i class="bi bi-chevron-right"></i>
                </a>
            </li>
        </ul>
        
        <!-- Results Info -->
        <div class="text-center mt-3">
            <small class="text-muted">
                Showing @((Model.CurrentPage - 1) * 12 + 1) to @(Math.Min(Model.CurrentPage * 12, Model.TotalBooks)) 
                of @Model.TotalBooks books
            </small>
        </div>
    </nav>
}