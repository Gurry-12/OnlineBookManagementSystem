@model OnlineBookManagementSystem.Core.Domain.Entities.Order
@{
    ViewData["Title"] = $"Order #{Model?.Id} Details";
    Layout = "_LayoutUser";
}

<div class="container-fluid p-4">
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h2 class="mb-0">
                        <i class="bi bi-receipt me-2"></i>Order #@Model?.Id
                    </h2>
                    <p class="text-muted">Placed on @(Model?.OrderDate?.ToString("MMMM dd, yyyy 'at' hh:mm tt") ?? "N/A")</p>
                </div>
                <div>
                    <a asp-action="OrderHistory" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i>Back to Orders
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Order Status Timeline -->
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-truck me-2"></i>Order Status
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-12">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <span class="badge @GetStatusBadgeClass(Model?.Status.ToString()) fs-5">
                                    @Model?.Status.ToString()
                                </span>
                                <small class="text-muted">
                                    Last updated: @Model?.UpdatedAt.ToString("MMM dd, yyyy 'at' hh:mm tt")
                                </small>
                            </div>
                            
                            <!-- Status Timeline -->
                            <div class="progress mb-3" style="height: 8px;">
                                <div class="progress-bar @GetProgressBarClass(Model?.Status.ToString())" 
                                     role="progressbar" 
                                     style="width: @GetProgressPercentage(Model?.Status.ToString())%">
                                </div>
                            </div>
                            
                            <div class="d-flex justify-content-between">
                                <small class="text-muted">Pending</small>
                                <small class="text-muted">Processing</small>
                                <small class="text-muted">Shipped</small>
                                <small class="text-muted">Delivered</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Order Items -->
        <div class="col-md-8">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-light">
                    <h5 class="mb-0">
                        <i class="bi bi-bag me-2"></i>Order Items (@Model?.OrderDetails.Count)
                    </h5>
                </div>
                <div class="card-body p-0">
                    @if (Model?.OrderDetails != null && Model.OrderDetails.Any())
                    {
                        @foreach (var item in Model.OrderDetails)
                        {
                            <div class="border-bottom p-3">
                                <div class="row align-items-center">
                                    <div class="col-md-2">
                                        @if (!string.IsNullOrEmpty(item.Book?.ImageUrl))
                                        {
                                            <img src="@item.Book.ImageUrl" alt="@item.Book.Title" class="img-fluid rounded" style="max-height: 80px;">
                                        }
                                        else
                                        {
                                            <div class="bg-light rounded d-flex align-items-center justify-content-center" style="height: 80px;">
                                                <i class="bi bi-book fs-2 text-muted"></i>
                                            </div>
                                        }
                                    </div>
                                    <div class="col-md-6">
                                        <h6 class="mb-1">@item.Book?.Title</h6>
                                        <p class="text-muted mb-1">by @item.Book?.Author</p>
                                        <small class="text-muted">ISBN: @(item.Book?.ISBN?.Value ?? "N/A")</small>
                                    </div>
                                    <div class="col-md-2 text-center">
                                        <span class="badge bg-light text-dark">Qty: @item.Quantity</span>
                                    </div>
                                    <div class="col-md-2 text-end">
                                        <div>
                                            <strong>$@item.Price.Amount.ToString("F2")</strong>
                                            @if (item.Quantity > 1)
                                            {
                                                <br><small class="text-muted">each</small>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>

        <!-- Order Summary -->
        <div class="col-md-4">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-light">
                    <h5 class="mb-0">
                        <i class="bi bi-calculator me-2"></i>Order Summary
                    </h5>
                </div>
                <div class="card-body">
                    <div class="d-flex justify-content-between mb-2">
                        <span>Subtotal:</span>
                        <span>$@(Model?.OrderDetails.Sum(od => od.Quantity * od.Price).ToString("F2"))</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span>Shipping:</span>
                        <span>Free</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span>Tax:</span>
                        <span>$0.00</span>
                    </div>
                    <hr>
                    <div class="d-flex justify-content-between">
                        <strong>Total:</strong>
                        <strong>$@Model?.TotalAmount.Amount.ToString("F2")</strong>
                    </div>
                </div>
            </div>

            <!-- Shipping Information -->
            <div class="card border-0 shadow-sm mt-4">
                <div class="card-header bg-light">
                    <h5 class="mb-0">
                        <i class="bi bi-geo-alt me-2"></i>Shipping Information
                    </h5>
                </div>
                <div class="card-body">
                    <h6>@Model?.FullName</h6>
                    <p class="mb-1">@Model?.Address</p>
                    <p class="mb-1">@Model?.City, @Model?.State @Model?.ZipCode</p>
                    <p class="mb-0">@Model?.Country</p>
                    
                    @if (!string.IsNullOrEmpty(Model?.PhoneNumber))
                    {
                        <hr>
                        <p class="mb-0">
                            <i class="bi bi-telephone me-2"></i>@(Model?.PhoneNumber)
                        </p>
                    }
                </div>
            </div>

            <!-- Order Actions -->
            <div class="card border-0 shadow-sm mt-4">
                <div class="card-header bg-light">
                    <h5 class="mb-0">
                        <i class="bi bi-gear me-2"></i>Actions
                    </h5>
                </div>
                <div class="card-body">
                    @if (Model?.Status == OrderStatus.Pending)
                    {
                        <button class="btn btn-outline-danger w-100 mb-2" onclick="cancelOrder(@Model.Id)">
                            <i class="bi bi-x-circle me-2"></i>Cancel Order
                        </button>
                    }
                    
                    @if (Model?.Status == OrderStatus.Delivered)
                    {
                        <button class="btn btn-outline-primary w-100 mb-2">
                            <i class="bi bi-arrow-repeat me-2"></i>Reorder Items
                        </button>
                    }
                    
                    <button class="btn btn-outline-secondary w-100" onclick="window.print()">
                        <i class="bi bi-printer me-2"></i>Print Order
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Toast Container -->
<div class="toast-container position-fixed bottom-0 end-0 p-3">
    <div id="successToast" class="toast" role="alert">
        <div class="toast-header bg-success text-white">
            <i class="bi bi-check-circle me-2"></i>
            <strong class="me-auto">Success</strong>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast"></button>
        </div>
        <div class="toast-body"></div>
    </div>
    
    <div id="errorToast" class="toast" role="alert">
        <div class="toast-header bg-danger text-white">
            <i class="bi bi-exclamation-triangle me-2"></i>
            <strong class="me-auto">Error</strong>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast"></button>
        </div>
        <div class="toast-body"></div>
    </div>
</div>

@section Scripts {
    <script>
        async function cancelOrder(orderId) {
            if (!confirm('Are you sure you want to cancel this order?')) {
                return;
            }
            
            try {
                const response = await fetch('/User/CancelOrder', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${localStorage.getItem('token')}`
                    },
                    body: JSON.stringify({ orderId })
                });
                
                const result = await response.json();
                
                if (result.success) {
                    showSuccess(result.message);
                    setTimeout(() => location.reload(), 1500);
                } else {
                    showError(result.message);
                }
            } catch (error) {
                showError('An error occurred while canceling the order');
            }
        }
        
        function showSuccess(message) {
            const toast = document.getElementById('successToast');
            toast.querySelector('.toast-body').textContent = message;
            new bootstrap.Toast(toast).show();
        }
        
        function showError(message) {
            const toast = document.getElementById('errorToast');
            toast.querySelector('.toast-body').textContent = message;
            new bootstrap.Toast(toast).show();
        }
    </script>
}

@functions {
    string GetStatusBadgeClass(string status)
    {
        return status switch
        {
            "Pending" => "bg-warning text-dark",
            "Processing" => "bg-info text-white",
            "Shipped" => "bg-primary text-white",
            "Delivered" => "bg-success text-white",
            "Cancelled" => "bg-danger text-white",
            _ => "bg-secondary text-white"
        };
    }
    
    string GetProgressBarClass(string status)
    {
        return status switch
        {
            "Cancelled" => "bg-danger",
            "Delivered" => "bg-success",
            _ => "bg-primary"
        };
    }
    
    int GetProgressPercentage(string status)
    {
        return status switch
        {
            "Pending" => 25,
            "Processing" => 50,
            "Shipped" => 75,
            "Delivered" => 100,
            "Cancelled" => 0,
            _ => 0
        };
    }
}