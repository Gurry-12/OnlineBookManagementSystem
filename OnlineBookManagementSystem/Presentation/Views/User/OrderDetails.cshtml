@model OnlineBookManagementSystem.Presentation.ViewModels.User.OrderDetailViewModel
@{
    ViewData["Title"] = $"Order {Model.OrderNumber} Details";
    Layout = "_LayoutUser";
}

<div class="container-fluid p-4">
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h2 class="mb-0">
                        <i class="bi bi-receipt me-2"></i>Order @Model.OrderNumber
                    </h2>
                    <p class="text-muted">Placed on @Model.FormattedOrderDate</p>
                </div>
                <div>
                    <a asp-action="OrderHistory" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i>Back to Orders
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Order Status Timeline -->
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-truck me-2"></i>Order Status
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-12">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <span class="@Model.StatusBadgeClass fs-5">
                                    @Model.StatusText
                                </span>
                                <span class="@Model.PaymentStatusBadgeClass ms-2">
                                    @Model.PaymentStatusText
                                </span>
                            </div>
                            
                            <!-- Status Timeline -->
                            <div class="progress mb-3" style="height: 8px;">
                                <div class="progress-bar bg-primary" 
                                     role="progressbar" 
                                     style="width: @(Model.Status == OnlineBookManagementSystem.Core.Domain.Enums.OrderStatus.Pending ? 25 : Model.Status == OnlineBookManagementSystem.Core.Domain.Enums.OrderStatus.Processing ? 50 : Model.Status == OnlineBookManagementSystem.Core.Domain.Enums.OrderStatus.Shipped ? 75 : Model.Status == OnlineBookManagementSystem.Core.Domain.Enums.OrderStatus.Completed ? 100 : 0)%">
                                </div>
                            </div>
                            
                            <div class="d-flex justify-content-between">
                                <small class="text-muted">Pending</small>
                                <small class="text-muted">Processing</small>
                                <small class="text-muted">Shipped</small>
                                <small class="text-muted">Completed</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Order Items -->
        <div class="col-md-8">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-light">
                    <h5 class="mb-0">
                        <i class="bi bi-bag me-2"></i>Order Items (@Model.TotalItems)
                    </h5>
                </div>
                <div class="card-body p-0">
                    @if (Model.Items != null && Model.Items.Any())
                    {
                        @foreach (var item in Model.Items)
                        {
                            <div class="border-bottom p-3">
                                <div class="row align-items-center">
                                    <div class="col-md-2">
                                        @if (!string.IsNullOrEmpty(item.BookImageUrl))
                                        {
                                            <img src="@item.BookImageUrl" alt="@item.BookTitle" class="img-fluid rounded" style="max-height: 80px;">
                                        }
                                        else
                                        {
                                            <div class="bg-light rounded d-flex align-items-center justify-content-center" style="height: 80px;">
                                                <i class="bi bi-book fs-2 text-muted"></i>
                                            </div>
                                        }
                                    </div>
                                    <div class="col-md-6">
                                        <h6 class="mb-1">@item.BookTitle</h6>
                                    </div>
                                    <div class="col-md-2 text-center">
                                        <span class="badge bg-light text-dark">Qty: @item.Quantity</span>
                                    </div>
                                    <div class="col-md-2 text-end">
                                        <div>
                                            <strong>@item.FormattedUnitPrice</strong>
                                            @if (item.Quantity > 1)
                                            {
                                                <br><small class="text-muted">each</small>
                                                <br><strong>@item.FormattedSubtotal</strong>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>

        <!-- Order Summary -->
        <div class="col-md-4">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-light">
                    <h5 class="mb-0">
                        <i class="bi bi-calculator me-2"></i>Order Summary
                    </h5>
                </div>
                <div class="card-body">
                    <div class="d-flex justify-content-between mb-2">
                        <span>Subtotal:</span>
                        <span>@Model.FormattedSubtotal</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span>Shipping:</span>
                        <span>@Model.FormattedShipping</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span>Tax:</span>
                        <span>@Model.FormattedTax</span>
                    </div>
                    <hr>
                    <div class="d-flex justify-content-between">
                        <strong>Total:</strong>
                        <strong>@Model.FormattedTotal</strong>
                    </div>
                </div>
            </div>

            <!-- Shipping Information -->
            <div class="card border-0 shadow-sm mt-4">
                <div class="card-header bg-light">
                    <h5 class="mb-0">
                        <i class="bi bi-geo-alt me-2"></i>Shipping Information
                    </h5>
                </div>
                <div class="card-body">
                    <h6>@Model.FullName</h6>
                    <p class="mb-1">@Model.ShippingAddress</p>
                    <p class="mb-1">@Model.City @Model.PinCode</p>
                    
                    @if (!string.IsNullOrEmpty(Model.PhoneNumber))
                    {
                        <hr>
                        <p class="mb-0">
                            <i class="bi bi-telephone me-2"></i>@Model.PhoneNumber
                        </p>
                    }
                </div>
            </div>

            <!-- Order Actions -->
            <div class="card border-0 shadow-sm mt-4">
                <div class="card-header bg-light">
                    <h5 class="mb-0">
                        <i class="bi bi-gear me-2"></i>Actions
                    </h5>
                </div>
                <div class="card-body">
                    @if (Model.CanCancel)
                    {
                        <button class="btn btn-outline-danger w-100 mb-2" onclick="cancelOrder(@Model.OrderId)">
                            <i class="bi bi-x-circle me-2"></i>Cancel Order
                        </button>
                    }
                    
                    @if (Model.IsCompleted)
                    {
                        <button class="btn btn-outline-primary w-100 mb-2">
                            <i class="bi bi-arrow-repeat me-2"></i>Reorder Items
                        </button>
                    }
                    
                    <button class="btn btn-outline-secondary w-100" onclick="window.print()">
                        <i class="bi bi-printer me-2"></i>Print Order
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Toast Container -->
<div class="toast-container position-fixed bottom-0 end-0 p-3">
    <div id="successToast" class="toast" role="alert">
        <div class="toast-header bg-success text-white">
            <i class="bi bi-check-circle me-2"></i>
            <strong class="me-auto">Success</strong>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast"></button>
        </div>
        <div class="toast-body"></div>
    </div>
    
    <div id="errorToast" class="toast" role="alert">
        <div class="toast-header bg-danger text-white">
            <i class="bi bi-exclamation-triangle me-2"></i>
            <strong class="me-auto">Error</strong>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast"></button>
        </div>
        <div class="toast-body"></div>
    </div>
</div>

@section Scripts {
    <script>
        async function cancelOrder(orderId) {
            if (!confirm('Are you sure you want to cancel this order?')) {
                return;
            }
            
            try {
                const response = await fetch('/User/CancelOrder', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${localStorage.getItem('token')}`
                    },
                    body: JSON.stringify({ orderId })
                });
                
                const result = await response.json();
                
                if (result.success) {
                    showSuccess(result.message);
                    setTimeout(() => location.reload(), 1500);
                } else {
                    showError(result.message);
                }
            } catch (error) {
                showError('An error occurred while canceling the order');
            }
        }
        
        function showSuccess(message) {
            const toast = document.getElementById('successToast');
            toast.querySelector('.toast-body').textContent = message;
            new bootstrap.Toast(toast).show();
        }
        
        function showError(message) {
            const toast = document.getElementById('errorToast');
            toast.querySelector('.toast-body').textContent = message;
            new bootstrap.Toast(toast).show();
        }
    </script>
}