                                        "There is more treasure in books than in all the pirate's loot on Treasure Island."
                                    </blockquote>
                                    <cite class="quote-author">— Walt Disney</cite>
                                    <div class="quote-category">Imagination & Wonder</div>
                                </div>
                                <div class="quote-visual">
                                    <i class="bi bi-gem text-warning"></i>
                                </div>
                            </div>
                        </div>

                    <!-- Quote 2 -->
                    <div class="carousel-item">
                        <div class="quote-slide">
                            <div class="quote-content">
                                <div class="quote-icon">
                                    <i class="bi bi-quote"></i>
                                </div>
                                <blockquote class="quote-text">
                                    "A room without books is like a body without a soul."
                                </blockquote>
                                <cite class="quote-author">— Marcus Tullius Cicero</cite>
                                <div class="quote-category">Life & Wisdom</div>
                            </div>
                            <div class="quote-visual">
                                <i class="bi bi-house-heart text-danger"></i>
                            </div>
                        </div>
                    </div>

                    <!-- Quote 3 -->
                    <div class="carousel-item">
                        <div class="quote-slide">
                            <div class="quote-content">
                                <div class="quote-icon">
                                    <i class="bi bi-quote"></i>
                                </div>
                                <blockquote class="quote-text">
                                    "Books are a uniquely portable magic."
                                </blockquote>
                                <cite class="quote-author">— Stephen King</cite>
                                <div class="quote-category">Magic & Mystery</div>
                            </div>
                            <div class="quote-visual">
                                <i class="bi bi-magic text-purple"></i>
                            </div>
                        </div>
                    </div>

                    <!-- Quote 4 -->
                    <div class="carousel-item">
                        <div class="quote-slide">
                            <div class="quote-content">
                                <div class="quote-icon">
                                    <i class="bi bi-quote"></i>
                                </div>
                                <blockquote class="quote-text">
                                    "I declare after all there is no enjoyment like reading!"
                                </blockquote>
                                <cite class="quote-author">— Jane Austen</cite>
                                <div class="quote-category">Joy & Pleasure</div>
                            </div>
                            <div class="quote-visual">
                                <i class="bi bi-emoji-smile text-success"></i>
                            </div>
                        </div>
                    </div>

                    <!-- Quote 5 -->
                    <div class="carousel-item">
                        <div class="quote-slide">
                            <div class="quote-content">
                                <div class="quote-icon">
                                    <i class="bi bi-quote"></i>
                                </div>
                                <blockquote class="quote-text">
                                    "The more that you read, the more things you will know. The more that you learn, the more places you'll go."
                                </blockquote>
                                <cite class="quote-author">— Dr. Seuss</cite>
                                <div class="quote-category">Learning & Growth</div>
                            </div>
                            <div class="quote-visual">
                                <i class="bi bi-airplane text-info"></i>
                            </div>
                        </div>
                    </div>

                    <!-- Quote 6 -->
                    <div class="carousel-item">
                        <div class="quote-slide">
                            <div class="quote-content">
                                <div class="quote-icon">
                                    <i class="bi bi-quote"></i>
                                </div>
                                <blockquote class="quote-text">
                                    "Reading is to the mind what exercise is to the body."
                                </blockquote>
                                <cite class="quote-author">— Joseph Addison</cite>
                                <div class="quote-category">Mind & Body</div>
                            </div>
                            <div class="quote-visual">
                                <i class="bi bi-lightning text-warning"></i>
                            </div>
                        </div>
                    </div>

                    <!-- Quote 7 -->
                    <div class="carousel-item">
                        <div class="quote-slide">
                            <div class="quote-content">
                                <div class="quote-icon">
                                    <i class="bi bi-quote"></i>
                                </div>
                                <blockquote class="quote-text">
                                    "Books fall open, you fall in, delighted where you've never been."
                                </blockquote>
                                <cite class="quote-author">— David T.W. McCord</cite>
                                <div class="quote-category">Adventure & Discovery</div>
                            </div>
                            <div class="quote-visual">
                                <i class="bi bi-door-open text-primary"></i>
                            </div>
                        </div>
                    </div>

                    <!-- Quote 8 -->
                    <div class="carousel-item">
                        <div class="quote-slide">
                            <div class="quote-content">
                                <div class="quote-icon">
                                    <i class="bi bi-quote"></i>
                                </div>
                                <blockquote class="quote-text">
                                    "A book is a dream that you hold in your hand."
                                </blockquote>
                                <cite class="quote-author">— Neil Gaiman</cite>
                                <div class="quote-category">Dreams & Imagination</div>
                            </div>
                            <div class="quote-visual">
                                <i class="bi bi-cloud-moon text-info"></i>
                            </div>
                        </div>
                    </div>

                    <!-- Quote 9 -->
                    <div class="carousel-item">
                        <div class="quote-slide">
                            <div class="quote-content">
                                <div class="quote-icon">
                                    <i class="bi bi-quote"></i>
                                </div>
                                <blockquote class="quote-text">
                                    "Reading gives us someplace to go when we have to stay where we are."
                                </blockquote>
                                <cite class="quote-author">— Mason Cooley</cite>
                                <div class="quote-category">Escape & Freedom</div>
                            </div>
                            <div class="quote-visual">
                                <i class="bi bi-compass text-success"></i>
                            </div>
                        </div>
                    </div>

                    <!-- Quote 10 -->
                    <div class="carousel-item">
                        <div class="quote-slide">
                            <div class="quote-content">
                                <div class="quote-icon">
                                    <i class="bi bi-quote"></i>
                                </div>
                                <blockquote class="quote-text">
                                    "Today a reader, tomorrow a leader."
                                </blockquote>
                                <cite class="quote-author">— Margaret Fuller</cite>
                                <div class="quote-category">Leadership & Future</div>
                            </div>
                            <div class="quote-visual">
                                <i class="bi bi-trophy text-warning"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Enhanced Controls -->
                <button class="carousel-control-prev quote-control" type="button" data-bs-target="#inspirationalQuotes" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon"></span>
                    <span class="visually-hidden">Previous</span>
                </button>
                <button class="carousel-control-next quote-control" type="button" data-bs-target="#inspirationalQuotes" data-bs-slide="next">
                    <span class="carousel-control-next-icon"></span>
                    <span class="visually-hidden">Next</span>
                </button>
            </div>
        </div>
    </div>

    <!-- Enhanced Stats Panel -->
    <div class="col-lg-4 col-md-5">
        <div class="user-stats-panel">
            <div class="stats-header">
                <h5 class="mb-0">
                    <i class="bi bi-graph-up me-2"></i>Your Reading Journey
                </h5>
            </div>
            <div class="stats-body">
                <div class="stat-card">
                    <div class="stat-icon books">
                        <i class="bi bi-collection"></i>
                    </div>
                    <div class="stat-info">
                        <div class="stat-number">@Model.TotalBooks.ToString("N0")</div>
                        <div class="stat-label">Books Available</div>
                    </div>
                </div>
                
                <div class="stat-card">
                    <div class="stat-icon favorites">
                        <i class="bi bi-heart-fill"></i>
                    </div>
                    <div class="stat-info">
                        <div class="stat-number">@Model.FavoritesCount</div>
                        <div class="stat-label">Your Favorites</div>
                    </div>
                </div>
                
                <div class="stat-card">
                    <div class="stat-icon orders">
                        <i class="bi bi-bag-check"></i>
                    </div>
                    <div class="stat-info">
                        <div class="stat-number">@Model.OrdersCount</div>
                        <div class="stat-label">Books Ordered</div>
                    </div>
                </div>
                
                <div class="stat-card">
                    <div class="stat-icon spending">
                        <i class="bi bi-currency-dollar"></i>
                    </div>
                    <div class="stat-info">
                        <div class="stat-number">@Model.TotalSpent.ToString("C")</div>
                        <div class="stat-label">Total Invested</div>
                    </div>
                </div>
            </div>
            
            <div class="stats-footer">
                <a asp-action="UserBookList" class="btn btn-primary btn-sm w-100">
                    <i class="bi bi-search me-2"></i>Explore More Books
                </a>
            </div>
        </div>
    </div>
</div>

<hr class="mt-4 mb-3" />

<!-- New Arrivals Section -->
<div class="row mb-4">
    <div class="col-12">
        <div class="wp-card">
            <div class="wp-card-header">
                <h5 class="mb-0 user-text-on-primary">
                    <i class="bi bi-box-seam me-2"></i>📦 New Arrivals
                </h5>
            </div>
            <div class="wp-card-body">
                <div id="newArrivals" class="row g-4">
                    <div class="user-text-muted">Loading new books...</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- 🎯 Recommendations Section -->
<div class="wp-card mb-4">
    <div class="wp-card-header">
        <h5 class="mb-0 user-text-on-primary">
            <i class="bi bi-stars me-2"></i>📚 Recommended for You
        </h5>
    </div>
    <div class="wp-card-body">
        <div id="recommendedBooks" class="row g-4">
            <div class="user-text-muted">Loading recommendations...</div>
        </div>
    </div>
</div>
</div>

@await Html.PartialAsync("_Notification")

@section Scripts {
    <!-- Core AJAX Infrastructure -->
    <script src="~/js/core/apiClient.js"></script>
    <script src="~/js/core/notifications.js"></script>
    
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            loadNewArrivals();
            loadRecommendations();
            updateCartCount();
        });

        async function loadNewArrivals() {
            try {
                const response = await fetch('/User/GetNewArrivals');
                const data = await response.json();
                
                if (data.success && data.books) {
                    const container = document.getElementById('newArrivals');
                    container.innerHTML = '';
                    
                    data.books.forEach(book => {
                        const col = document.createElement('div');
                        col.className = 'col-lg-6 col-md-6 col-sm-6 col-12';
                        const bookCard = createBookCard(col,book);
                        container.appendChild(bookCard);
                    });
                } else {
                    document.getElementById('newArrivals').innerHTML = '<div class="text-muted">No new arrivals available</div>';
                }
            } catch (error) {
                console.error('Error loading new arrivals:', error);
                document.getElementById('newArrivals').innerHTML = '<div class="text-muted">Failed to load new arrivals</div>';
            }
        }

        async function loadRecommendations() {
            try {
                const response = await fetch('/User/GetRecommendations');
                const data = await response.json();
                
                if (data.success && data.books) {
                    const container = document.getElementById('recommendedBooks');
                    container.innerHTML = '';
                    
                    data.books.forEach(book => {
                        const col = document.createElement('div');
                        col.className = 'col-lg-3 col-md-4 col-sm-6 col-12';
                        const bookCard = createBookCard(col,book);
                        container.appendChild(bookCard);
                    });
                } else {
                    document.getElementById('recommendedBooks').innerHTML = '<div class="text-muted">No recommendations available</div>';
                }
            } catch (error) {
                console.error('Error loading recommendations:', error);
                document.getElementById('recommendedBooks').innerHTML = '<div class="text-muted">Failed to load recommendations</div>';
            }
        }

        function createBookCard(col,book) {
             // Changed to col-lg-4 for 3 books per row
            
            col.innerHTML = `
                <div class="wp-card shadow-sm h-100 book-card">
                    <div class="position-relative">
                        <button class="btn btn-link position-absolute top-0 end-0 p-2 toggle-favorite-btn" 
                                data-book-id="${book.id}" 
                                title="${book.isFavorite ? 'Remove from favorites' : 'Add to favorites'}"
                                onclick="toggleFavorite(${book.id}, this)">
                            <i class="bi ${book.isFavorite ? 'bi-heart-fill text-danger' : 'bi-heart'}"></i>
                        </button>
                        <img src="${book.imageUrl || '/images/default-book-improved.svg'}" 
                             alt="${book.title}" 
                             class="card-img-top wp-book-image" 
                             style="height: 200px; object-fit: cover;" />
                        ${book.stockQuantity <= 0 ? '<div class="position-absolute top-0 start-0 m-2"><span class="wp-badge wp-badge-error">Out of Stock</span></div>' : ''}
                    </div>
                    <div class="wp-card-body d-flex flex-column">
                        <h6 class="card-title user-text-primary">${book.title}</h6>
                        <p class="card-text user-text-muted small mb-2">by ${book.author}</p>
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span class="h6 user-text-secondary mb-0">₹${book.price}</span>
                        </div>
                        <div class="mt-auto">
                            <div class="d-flex gap-2">
                                <a href="/User/BookDetails/${book.id}" class="wp-btn wp-btn-secondary btn-sm flex-fill">
                                    <i class="bi bi-eye me-1"></i>View
                                </a>
                                ${book.stockQuantity > 0 ? 
                                    `<button class="wp-btn wp-btn-primary btn-sm" onclick="addToCart(${book.id})">
                                        <i class="bi bi-cart-plus me-1"></i>Add
                                    </button>` : 
                                    `<button class="btn btn-secondary btn-sm" disabled>
                                        <i class="bi bi-x-circle me-1"></i>Out
                                    </button>`
                                }
                            </div>
                        </div>
                    </div>
                </div>
            `;
            
            return col;
        }

        async function addToCart(bookId) {
            try {
                const response = await fetch('/User/AddToCart', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ bookId: bookId, quantity: 1 })
                });
                
                const result = await response.json();
                
                if (result.success) {
                    notifications.success(result.message || 'Added to cart successfully!');
                    // Update cart count using both methods
                    if (typeof window.updateCartCount === 'function') {
                        window.updateCartCount();
                    }
                    if (result.cartCount !== undefined) {
                        updateCartCountDisplay(result.cartCount);
                    }
                } else {
                    notifications.error(result.message || 'Failed to add to cart');
                }
            } catch (error) {
                console.error('Error adding to cart:', error);
                notifications.error('Failed to add to cart. Please try again.');
            }
        }

        function updateCartCountDisplay(count) {
            const cartCountElement = document.getElementById('cartItemCount');
            if (cartCountElement) {
                cartCountElement.textContent = count || 0;
                cartCountElement.style.display = (count && count > 0) ? 'inline' : 'none';
            }
        }

        async function toggleFavorite(bookId, buttonElement) {
            try {
                const response = await fetch('/User/ToggleFavorite', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ bookId: bookId })
                });
                
                const result = await response.json();
                
                if (result.success) {
                    notifications.success(result.message || 'Favorite updated!');
                    
                    // Update button state
                    const icon = buttonElement.querySelector('i');
                    if (result.isFavorite) {
                        icon.className = 'bi bi-heart-fill text-danger';
                        buttonElement.setAttribute('title', 'Remove from favorites');
                    } else {
                        icon.className = 'bi bi-heart';
                        buttonElement.setAttribute('title', 'Add to favorites');
                    }
                } else {
                    notifications.error(result.message || 'Failed to update favorite');
                }
            } catch (error) {
                console.error('Error toggling favorite:', error);
                notifications.error('Failed to update favorite. Please try again.');
            }
        }

        async function updateCartCount() {
            try {
                const response = await fetch('/User/GetCartCount');
                const data = await response.json();
                
                const cartCountElement = document.getElementById('cartItemCount');
                if (cartCountElement) {
                    cartCountElement.textContent = data.count;
                    cartCountElement.style.display = data.count > 0 ? 'inline' : 'none';
                }
            } catch (error) {
                console.error('Error updating cart count:', error);
            }
        }
    </script>
}