@model OnlineBookManagementSystem.Presentation.ViewModels.User.UserDashboardViewModel
@{
    ViewData["Title"] = "User Dashboard - Whispering Pages";
    Layout = "_LayoutUser"; // Custom layout for user
}

<div class="view-user-dashboard">
<div class="dashboard-grid dashboard-grid--user">
    <!-- Welcome Section with Enhanced Stats -->
    <div class="welcome-banner">
        <div class="welcome-banner__content">
            <h2 class="welcome-title">
                <i class="bi bi-book-half me-3"></i>
                Welcome to Your Literary Journey
            </h2>
            <p class="welcome-subtitle">Discover, explore, and immerse yourself in the world of books</p>
        </div>
        <div class="welcome-banner__stats">
            <div class="user-stats-mini">
                <span class="stat-item">
                    <i class="bi bi-heart-fill me-2"></i>
                    @Model.FavoritesCount Favorites
                </span>
                <span class="stat-item">
                    <i class="bi bi-cart-fill me-2"></i>
                    @Model.CartItemsCount In Cart
                </span>
                <span class="stat-item">
                    <i class="bi bi-bag-check-fill me-2"></i>
                    @Model.OrdersCount Orders
                </span>
            </div>
        </div>
    </div>

    <!-- Quick Actions Row -->
    <div class="quick-actions-row">
        <a asp-action="UserBookList" class="quick-action-card quick-action-card--primary">
            <div class="quick-action-card__icon">
                <i class="bi bi-search"></i>
            </div>
            <div class="quick-action-card__text">
                <span class="quick-action-card__title">Explore Books</span>
                <span class="quick-action-card__subtitle">@Model.TotalBooks books available</span>
            </div>
            <i class="bi bi-arrow-right quick-action-card__arrow"></i>
        </a>
        
        <a asp-action="Favorite" class="quick-action-card quick-action-card--danger">
            <div class="quick-action-card__icon">
                <i class="bi bi-heart"></i>
            </div>
            <div class="quick-action-card__text">
                <span class="quick-action-card__title">My Favorites</span>
                <span class="quick-action-card__subtitle">@Model.FavoritesCount saved books</span>
            </div>
            <i class="bi bi-arrow-right quick-action-card__arrow"></i>
        </a>
        
        <a asp-action="OrderHistory" class="quick-action-card quick-action-card--success">
            <div class="quick-action-card__icon">
                <i class="bi bi-bag"></i>
            </div>
            <div class="quick-action-card__text">
                <span class="quick-action-card__title">My Orders</span>
                <span class="quick-action-card__subtitle">@Model.OrdersCount completed</span>
            </div>
            <i class="bi bi-arrow-right quick-action-card__arrow"></i>
        </a>
        
        <a asp-action="UserCart" class="quick-action-card quick-action-card--warning">
            <div class="quick-action-card__icon">
                <i class="bi bi-cart"></i>
            </div>
            <div class="quick-action-card__text">
                <span class="quick-action-card__title">Shopping Cart</span>
                <span class="quick-action-card__subtitle">@Model.CartItemsCount items</span>
            </div>
            <i class="bi bi-arrow-right quick-action-card__arrow"></i>
        </a>
    </div>

    <!-- Main Content Grid -->
    <div class="view-section">
        <div class="view-grid view-grid--2-cols" style="grid-template-columns: 1fr 2fr;">
            <!-- Enhanced Stats Panel -->
            <div class="user-stats-panel">
                <div class="stats-header">
                    <h5 class="mb-0">
                        <i class="bi bi-graph-up me-2"></i>Your Reading Journey
                    </h5>
                </div>
                <div class="stats-body">
                    <div class="stat-card">
                        <div class="stat-icon books">
                            <i class="bi bi-collection"></i>
                        </div>
                        <div class="stat-info">
                            <div class="stat-number">@Model.TotalBooks.ToString("N0")</div>
                            <div class="stat-label">Books Available</div>
                        </div>
                    </div>
                    
                    <div class="stat-card">
                        <div class="stat-icon favorites">
                            <i class="bi bi-heart-fill"></i>
                        </div>
                        <div class="stat-info">
                            <div class="stat-number">@Model.FavoritesCount</div>
                            <div class="stat-label">Your Favorites</div>
                        </div>
                    </div>
                    
                    <div class="stat-card">
                        <div class="stat-icon orders">
                            <i class="bi bi-bag-check"></i>
                        </div>
                        <div class="stat-info">
                            <div class="stat-number">@Model.OrdersCount</div>
                            <div class="stat-label">Books Ordered</div>
                        </div>
                    </div>
                    
                    <div class="stat-card">
                        <div class="stat-icon spending">
                            <i class="bi bi-currency-dollar"></i>
                        </div>
                        <div class="stat-info">
                            <div class="stat-number">@Model.TotalSpent.ToString("C")</div>
                            <div class="stat-label">Total Invested</div>
                        </div>
                    </div>
                </div>
                
                <div class="stats-footer">
                    <a asp-action="UserBookList" class="wp-btn wp-btn-primary w-100 justify-content-center">
                        <i class="bi bi-search me-2"></i>Explore More Books
                    </a>
                </div>
            </div>

            <!-- Interactive Discovery Carousel -->
            <div class="interactive-discovery-carousel h-100 position-relative rounded-4 overflow-hidden shadow-sm p-1" style="background: linear-gradient(135deg, rgba(255,255,255,0.9), rgba(255,255,255,0.6)); backdrop-filter: blur(16px); border: 1px solid rgba(255,255,255,0.4);">
                <div class="carousel-bg-glow position-absolute w-100 h-100 top-0 start-0 opacity-50" style="background: radial-gradient(circle at 80% 20%, rgba(120,194,173,0.3) 0%, transparent 50%), radial-gradient(circle at 20% 80%, rgba(255,179,138,0.3) 0%, transparent 50%); z-index: 0;"></div>
                <div id="inspirationalQuotes" class="carousel slide h-100 rounded-3 overflow-hidden position-relative" style="z-index: 1;" data-bs-ride="carousel" data-bs-interval="5000">
                    <div class="carousel-indicators mb-2">
                        <button type="button" data-bs-target="#inspirationalQuotes" data-bs-slide-to="0" class="active rounded-pill bg-primary" style="width:20px; height:6px;"></button>
                        <button type="button" data-bs-target="#inspirationalQuotes" data-bs-slide-to="1" class="rounded-pill bg-primary opacity-50" style="width:10px; height:6px;"></button>
                        <button type="button" data-bs-target="#inspirationalQuotes" data-bs-slide-to="2" class="rounded-pill bg-primary opacity-50" style="width:10px; height:6px;"></button>
                        <button type="button" data-bs-target="#inspirationalQuotes" data-bs-slide-to="3" class="rounded-pill bg-primary opacity-50" style="width:10px; height:6px;"></button>
                    </div>
                    
                    <div class="carousel-inner h-100">
                        <!-- Slide 1 -->
                        <div class="carousel-item active h-100">
                            <div class="d-flex flex-column justify-content-center align-items-center h-100 p-5 p-lg-4 p-xl-5 text-center position-relative">
                                <span class="badge bg-primary text-white mb-3 rounded-pill px-3 py-2 shadow-sm" style="font-weight: 500; letter-spacing: 0.5px;"><i class="bi bi-stars me-2"></i>Daily Inspiration</span>
                                <h3 class="fw-bold mb-4 fst-italic position-relative z-1" style="color: #2c3e50; line-height: 1.5; font-size: clamp(1.2rem, 2vw, 1.8rem);">"There is more treasure in books than in all the pirate's loot on Treasure Island."</h3>
                                <div class="d-flex align-items-center gap-3 mt-2 z-1">
                                    <div class="bg-white text-primary d-flex align-items-center justify-content-center rounded-circle shadow" style="width: 48px; height: 48px;">
                                        <i class="bi bi-person-fill fs-4"></i>
                                    </div>
                                    <div class="text-start">
                                        <h6 class="mb-0 fw-bold text-dark">Walt Disney</h6>
                                        <small class="text-muted fw-medium">Imagination & Wonder</small>
                                    </div>
                                </div>
                                <i class="bi bi-quote position-absolute opacity-10" style="font-size: 15rem; right: 5%; bottom: -10%; color: var(--wp-primary);"></i>
                            </div>
                        </div>

                        <!-- Slide 2 -->
                        <div class="carousel-item h-100">
                            <div class="d-flex flex-column justify-content-center align-items-center h-100 p-5 p-lg-4 p-xl-5 text-center position-relative">
                                <span class="badge bg-success text-white mb-3 rounded-pill px-3 py-2 shadow-sm" style="font-weight: 500; letter-spacing: 0.5px;"><i class="bi bi-compass me-2"></i>Discover New Worlds</span>
                                <h3 class="fw-bold mb-4 fst-italic position-relative z-1" style="color: #2c3e50; line-height: 1.5; font-size: clamp(1.2rem, 2vw, 1.8rem);">"A room without books is like a body without a soul."</h3>
                                <div class="d-flex align-items-center gap-3 mt-2 z-1">
                                    <div class="bg-white text-success d-flex align-items-center justify-content-center rounded-circle shadow" style="width: 48px; height: 48px;">
                                        <i class="bi bi-book-half fs-4"></i>
                                    </div>
                                    <div class="text-start">
                                        <h6 class="mb-0 fw-bold text-dark">Marcus Tullius Cicero</h6>
                                        <small class="text-muted fw-medium">Life & Wisdom</small>
                                    </div>
                                </div>
                                <i class="bi bi-journal-bookmark position-absolute opacity-10" style="font-size: 15rem; right: 5%; bottom: -10%; color: var(--wp-success);"></i>
                            </div>
                        </div>

                        <!-- Slide 3 -->
                        <div class="carousel-item h-100">
                            <div class="d-flex flex-column justify-content-center align-items-center h-100 p-5 p-lg-4 p-xl-5 text-center position-relative">
                                <span class="badge bg-warning text-dark mb-3 rounded-pill px-3 py-2 shadow-sm" style="font-weight: 500; letter-spacing: 0.5px;"><i class="bi bi-magic me-2"></i>Unlock the Magic</span>
                                <h3 class="fw-bold mb-4 fst-italic position-relative z-1" style="color: #2c3e50; line-height: 1.5; font-size: clamp(1.2rem, 2vw, 1.8rem);">"Books are a uniquely portable magic."</h3>
                                <div class="d-flex align-items-center gap-3 mt-2 z-1">
                                    <div class="bg-white text-warning d-flex align-items-center justify-content-center rounded-circle shadow" style="width: 48px; height: 48px;">
                                        <i class="bi bi-lightning-charge-fill fs-4"></i>
                                    </div>
                                    <div class="text-start">
                                        <h6 class="mb-0 fw-bold text-dark">Stephen King</h6>
                                        <small class="text-muted fw-medium">Magic & Mystery</small>
                                    </div>
                                </div>
                                <i class="bi bi-stars position-absolute opacity-10" style="font-size: 15rem; right: 5%; bottom: -10%; color: var(--wp-warning);"></i>
                            </div>
                        </div>

                        <!-- Slide 4 -->
                        <div class="carousel-item h-100">
                            <div class="d-flex flex-column justify-content-center align-items-center h-100 p-5 p-lg-4 p-xl-5 text-center position-relative">
                                <span class="badge bg-info text-dark mb-3 rounded-pill px-3 py-2 shadow-sm" style="font-weight: 500; letter-spacing: 0.5px;"><i class="bi bi-rocket-takeoff me-2"></i>Learning & Growth</span>
                                <h3 class="fw-bold mb-4 fst-italic position-relative z-1" style="color: #2c3e50; line-height: 1.5; font-size: clamp(1.2rem, 2vw, 1.8rem);">"The more that you read, the more things you will know."</h3>
                                <div class="d-flex align-items-center gap-3 mt-2 z-1">
                                    <div class="bg-white text-info d-flex align-items-center justify-content-center rounded-circle shadow" style="width: 48px; height: 48px;">
                                        <i class="bi bi-emoji-sunglasses fs-4"></i>
                                    </div>
                                    <div class="text-start">
                                        <h6 class="mb-0 fw-bold text-dark">Dr. Seuss</h6>
                                        <small class="text-muted fw-medium">Knowledge is Power</small>
                                    </div>
                                </div>
                                <i class="bi bi-book position-absolute opacity-10" style="font-size: 15rem; right: 5%; bottom: -10%; color: var(--wp-info);"></i>
                            </div>
                        </div>
                    </div>

                    <!-- Enhanced Custom Controls -->
                    <button class="carousel-control-prev" type="button" data-bs-target="#inspirationalQuotes" data-bs-slide="prev" style="width: 10%; opacity: 1;">
                        <div class="bg-white bg-opacity-75 rounded-circle shadow-sm d-flex justify-content-center align-items-center carousel-control-hover transition-all" style="width: 40px; height: 40px; backdrop-filter: blur(4px);">
                            <i class="bi bi-chevron-left text-dark fs-5"></i>
                        </div>
                        <span class="visually-hidden">Previous</span>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#inspirationalQuotes" data-bs-slide="next" style="width: 10%; opacity: 1;">
                        <div class="bg-white bg-opacity-75 rounded-circle shadow-sm d-flex justify-content-center align-items-center carousel-control-hover transition-all" style="width: 40px; height: 40px; backdrop-filter: blur(4px);">
                            <i class="bi bi-chevron-right text-dark fs-5"></i>
                        </div>
                        <span class="visually-hidden">Next</span>
                    </button>
                </div>
            </div>
            
            <style>
                .carousel-control-hover:hover {
                    background-color: white !important;
                    transform: scale(1.1);
                    box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15) !important;
                }
                .transition-all {
                    transition: all 0.3s ease;
                }
                .interactive-discovery-carousel .carousel-indicators button {
                    transition: width 0.3s ease, opacity 0.3s ease;
                    border: none;
                }
                .interactive-discovery-carousel .carousel-indicators button.active {
                    opacity: 1 !important;
                    width: 25px !important;
                }
            </style>
        </div>
    </div>

    <!-- New Arrivals Section -->
    <div class="view-section">
        <div class="view-card">
            <div class="view-card__header">
                <h5 class="view-card__title">
                    <i class="bi bi-box-seam"></i>New Arrivals
                </h5>
                <a asp-action="UserBookList" class="action-bar__button action-bar__button--ghost">
                    View All <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>
            <div class="view-card__body">
                <div id="newArrivals" class="view-grid view-grid--4-cols">
                    <div class="col-12 text-center py-4">
                        <div class="view-loading">
                            <div class="view-loading__spinner"></div>
                            <p class="view-loading__text">Loading new books...</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Recommendations Section -->
    <div class="view-section">
        <div class="view-card">
            <div class="view-card__header">
                <h5 class="view-card__title">
                    <i class="bi bi-stars"></i>Recommended for You
                </h5>
                <a asp-action="UserBookList" class="action-bar__button action-bar__button--ghost">
                    View All <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>
            <div class="view-card__body">
                <div id="recommendedBooks" class="view-grid view-grid--4-cols">
                    <div class="col-12 text-center py-4">
                        <div class="view-loading">
                            <div class="view-loading__spinner"></div>
                            <p class="view-loading__text">Loading recommendations...</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
</div>

@await Html.PartialAsync("_Notification")

@section Scripts {
    <!-- Core AJAX Infrastructure -->
    <script src="~/js/core/apiClient.js"></script>
    <script src="~/js/core/notifications.js"></script>
    
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            loadNewArrivals();
            loadRecommendations();
            updateCartCount();
        });

        async function loadNewArrivals() {
            try {
                const response = await fetch('/User/GetNewArrivals');
                const data = await response.json();
                
                if (data.success && data.books) {
                    const container = document.getElementById('newArrivals');
                    container.innerHTML = '';
                    
                    data.books.forEach(book => {
                        const col = document.createElement('div');
                        col.className = '';
                        const bookCard = createBookCard(col,book);
                        container.appendChild(bookCard);
                    });
                } else {
                    document.getElementById('newArrivals').innerHTML = '<div class="text-muted">No new arrivals available</div>';
                }
            } catch (error) {
                console.error('Error loading new arrivals:', error);
                document.getElementById('newArrivals').innerHTML = '<div class="text-muted">Failed to load new arrivals</div>';
            }
        }

        async function loadRecommendations() {
            try {
                const response = await fetch('/User/GetRecommendations');
                const data = await response.json();
                
                if (data.success && data.books) {
                    const container = document.getElementById('recommendedBooks');
                    container.innerHTML = '';
                    
                    data.books.forEach(book => {
                        const col = document.createElement('div');
                        col.className = '';
                        const bookCard = createBookCard(col,book);
                        container.appendChild(bookCard);
                    });
                } else {
                    document.getElementById('recommendedBooks').innerHTML = '<div class="text-muted">No recommendations available</div>';
                }
            } catch (error) {
                console.error('Error loading recommendations:', error);
                document.getElementById('recommendedBooks').innerHTML = '<div class="text-muted">Failed to load recommendations</div>';
            }
        }

        function createBookCard(col,book) {
             // Changed to col-lg-4 for 3 books per row
            
            col.innerHTML = `
                <div class="wp-card shadow-sm h-100 book-card">
                    <div class="position-relative">
                        <button class="wp-btn wp-btn-primary position-absolute top-0 end-0 p-2 toggle-favorite-btn" 
                                data-book-id="${book.id}" 
                                title="${book.isFavorite ? 'Remove from favorites' : 'Add to favorites'}"
                                onclick="toggleFavorite(${book.id}, this)">
                            <i class="bi ${book.isFavorite ? 'bi-heart-fill text-danger' : 'bi-heart'}"></i>
                        </button>
                        <img src="${book.imageUrl || '/images/default-book-improved.svg'}" 
                             alt="${book.title}" 
                             class="wp-card-img-top fav-card__image" />
                        ${book.stockQuantity <= 0 ? '<div class="position-absolute top-0 start-0 m-2"><span class="text-white wp-badge wp-badge-error">Out of Stock</span></div>' : ''}
                    </div>
                    <div class="wp-card-body d-flex flex-column">
                        <h6 class="wp-card-title user-text-primary">${book.title}</h6>
                        <p class="wp-card-text user-text-muted small mb-2">by ${book.author}</p>
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span class="h6 user-text-secondary mb-0">₹${book.price?.amount !== undefined ? book.price.amount : book.price}</span>
                        </div>
                        <div class="mt-auto">
                            <div class="d-flex gap-2">
                                <a href="/User/BookDetails/${book.id}" class="wp-btn wp-btn-secondary  flex-fill">
                                    <i class="bi bi-eye me-1"></i>View
                                </a>
                                ${book.stockQuantity > 0 ? 
                                    `<button class="wp-btn wp-btn-primary " onclick="addToCart(${book.id})">
                                        <i class="bi bi-cart-plus me-1"></i>Add
                                    </button>` : 
                                    `<button class="wp-btn wp-btn-secondary " disabled>
                                        <i class="bi bi-x-circle me-1"></i>Out
                                    </button>`
                                }
                            </div>
                        </div>
                    </div>
                </div>
            `;
            
            return col;
        }

        async function addToCart(bookId) {
            try {
                const response = await fetch('/User/AddToCart', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ bookId: bookId, quantity: 1 })
                });
                
                const result = await response.json();
                
                if (result.success) {
                    notifications.success(result.message || 'Added to cart successfully!');
                    // Update cart count using both methods
                    if (typeof window.updateCartCount === 'function') {
                        window.updateCartCount();
                    }
                    if (result.cartCount !== undefined) {
                        updateCartCountDisplay(result.cartCount);
                    }
                } else {
                    notifications.error(result.message || 'Failed to add to cart');
                }
            } catch (error) {
                console.error('Error adding to cart:', error);
                notifications.error('Failed to add to cart. Please try again.');
            }
        }

        function updateCartCountDisplay(count) {
            const cartCountElement = document.getElementById('cartItemCount');
            if (cartCountElement) {
                cartCountElement.textContent = count || 0;
                cartCountElement.style.display = (count && count > 0) ? 'inline' : 'none';
            }
        }

        async function toggleFavorite(bookId, buttonElement) {
            try {
                const response = await fetch('/User/ToggleFavorite', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ bookId: bookId })
                });
                
                const result = await response.json();
                
                if (result.success) {
                    notifications.success(result.message || 'Favorite updated!');
                    
                    // Update button state
                    const icon = buttonElement.querySelector('i');
                    if (result.isFavorite) {
                        icon.className = 'bi bi-heart-fill text-danger';
                        buttonElement.setAttribute('title', 'Remove from favorites');
                    } else {
                        icon.className = 'bi bi-heart';
                        buttonElement.setAttribute('title', 'Add to favorites');
                    }
                } else {
                    notifications.error(result.message || 'Failed to update favorite');
                }
            } catch (error) {
                console.error('Error toggling favorite:', error);
                notifications.error('Failed to update favorite. Please try again.');
            }
        }

        async function updateCartCount() {
            try {
                const response = await fetch('/User/GetCartCount');
                const data = await response.json();
                
                const cartCountElement = document.getElementById('cartItemCount');
                if (cartCountElement) {
                    cartCountElement.textContent = data.count;
                    cartCountElement.style.display = data.count > 0 ? 'inline' : 'none';
                }
            } catch (error) {
                console.error('Error updating cart count:', error);
            }
        }
    </script>
}


