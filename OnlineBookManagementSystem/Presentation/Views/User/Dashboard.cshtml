@model OnlineBookManagementSystem.Presentation.ViewModels.User.UserDashboardViewModel
@{
    ViewData["Title"] = "User Dashboard - Whispering Pages";
    Layout = "_LayoutUser"; // Custom layout for user
}

<div class="view-user-dashboard">
<div class="dashboard-grid dashboard-grid--user">
    <!-- Welcome Section with Enhanced Stats -->
    <div class="welcome-banner">
        <h2 class="welcome-title">
            <i class="bi bi-book-half text-white me-2"></i>
            Welcome to Your Literary Journey
        </h2>
        <p class="welcome-subtitle">Discover, explore, and immerse yourself in the world of books</p>
        <div class="user-stats-mini">
            <span class="stat-item">
                <i class="bi bi-heart-fill text-danger me-1"></i>
                @Model.FavoritesCount Favorites
            </span>
            <span class="stat-item">
                <i class="bi bi-cart-fill text-success me-1"></i>
                @Model.CartItemsCount In Cart
            </span>
        </div>
    </div>

    <!-- Enhanced Quote Carousel and Stats Section -->
    <div class="row g-4 mb-5">
        <div class="col-lg-8 col-md-7">
            <div class="enhanced-quote-carousel">
                <div id="inspirationalQuotes" class="carousel slide" data-bs-ride="carousel" data-bs-interval="6000">
                    <div class="carousel-indicators quote-indicators">
                        <button type="button" data-bs-target="#inspirationalQuotes" data-bs-slide-to="0" class="active"></button>
                        <button type="button" data-bs-target="#inspirationalQuotes" data-bs-slide-to="1"></button>
                        <button type="button" data-bs-target="#inspirationalQuotes" data-bs-slide-to="2"></button>
                        <button type="button" data-bs-target="#inspirationalQuotes" data-bs-slide-to="3"></button>
                        <button type="button" data-bs-target="#inspirationalQuotes" data-bs-slide-to="4"></button>
                        <button type="button" data-bs-target="#inspirationalQuotes" data-bs-slide-to="5"></button>
                        <button type="button" data-bs-target="#inspirationalQuotes" data-bs-slide-to="6"></button>
                        <button type="button" data-bs-target="#inspirationalQuotes" data-bs-slide-to="7"></button>
                        <button type="button" data-bs-target="#inspirationalQuotes" data-bs-slide-to="8"></button>
                        <button type="button" data-bs-target="#inspirationalQuotes" data-bs-slide-to="9"></button>
                    </div>
                    <div class="carousel-inner">
                        <!-- Quote 1 -->
                        <div class="carousel-item active">
                            <div class="quote-slide">
                                <div class="quote-content">
                                    <div class="quote-icon">
                                        <i class="bi bi-quote"></i>
                                    </div>
