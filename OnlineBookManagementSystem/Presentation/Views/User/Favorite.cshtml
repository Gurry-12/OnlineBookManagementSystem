@{
    ViewData["Title"] = "My Favorites";
    Layout = ViewData["Layout"]?.ToString() ?? "_LayoutUser";
}

<div class="view-wrapper">
<div class="view-container">
    <!-- Unified Page Header -->
    <div class="page-header">
        <div class="page-header__content">
            <h2 class="page-header__title">
                <i class="bi bi-heart-fill"></i>My Favorite Books
            </h2>
            <p class="page-header__subtitle">
                @(Model.HasFavorites ? $"{Model.FavoriteBooks.Count()} books in your favorites" : "No favorites yet")
            </p>
        </div>
    </div>

    @if (!Model.HasFavorites)
    {
        <div class="view-card">
            <div class="view-card__body">
                <div class="view-empty-state">
                    <div class="view-empty-state__icon">
                        <i class="bi bi-heart"></i>
                    </div>
                    <h4 class="view-empty-state__title">No favorites yet!</h4>
                    <p class="view-empty-state__description">Browse books and add some to your favorites.</p>
                    <div class="view-empty-state__actions">
                        <a asp-controller="User" asp-action="Dashboard" class="action-bar__button action-bar__button--primary">
                            <i class="bi bi-search me-2"></i>Start Browsing
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="view-grid view-grid--4-cols">
            @foreach (var book in Model.FavoriteBooks)
            {
                <div class="view-card">
                    <div class="view-card__body">
                        <img src="@(book.ImageUrl ?? Url.Content("~/images/default-book-improved.svg"))" alt="@book.Title" class="fav-card__image" />
                        <h6 class="fav-card__title">@book.Title</h6>
                        <small class="fav-card__author">@book.Author</small>
                        <p class="fav-card__price">₹@book.Price</p>
                        <div class="d-flex gap-2">
                            <button onclick="ToggleFavorite(@book.Id)" class="action-bar__button action-bar__button--secondary flex-fill">
                                <i class="bi bi-heart-fill me-1"></i>Remove
                            </button>
                            <button onclick="AddToCart(@book.Id)" class="action-bar__button action-bar__button--primary flex-fill">
                                <i class="bi bi-cart-plus me-1"></i>Add
                            </button>
                        </div>
                        <a asp-controller="User" asp-action="BookDetails" asp-route-id="@book.Id" class="stretched-link"></a>
                    </div>
                </div>
            }
        </div>
    }
</div>
</div>
</div>

@await Html.PartialAsync("_Notification")

@section Scripts {
    <!-- Core AJAX Infrastructure -->
    <script src="~/js/core/apiClient.js"></script>
    <script src="~/js/core/notifications.js"></script>
    
    <script>
        async function ToggleFavorite(bookId) {
            try {
                const response = await fetch('/User/ToggleFavorite', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ bookId: bookId })
                });
                
                const result = await response.json();
                
                if (result.success) {
                    notifications.success('Removed from favorites!');
                    location.reload();
                } else {
                    notifications.error('Failed to update favorites.');
                }
            } catch (error) {
                console.error('Error toggling favorite:', error);
                notifications.error('Failed to update favorites. Please try again.');
            }
        }

        async function AddToCart(bookId) {
            try {
                const response = await fetch('/User/AddToCart', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ bookId: bookId, quantity: 1 })
                });
                
                const result = await response.json();
                
                if (result.success) {
                    notifications.success(result.message || 'Added to cart successfully!');
                } else {
                    notifications.error(result.message || 'Failed to add to cart');
                }
            } catch (error) {
                console.error('Error adding to cart:', error);
                notifications.error('Failed to add to cart. Please try again.');
            }
        }
    </script>
}


