@model OnlineBookManagementSystem.Presentation.ViewModels.Users.UserManagementViewModel

@{
    ViewData["Title"] = "User Management";
    Layout = Model.Capabilities.CanManageSuperAdmins ? "_LayoutSuperAdmin" : "_LayoutAdmin";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold @(Model.Capabilities.CanManageSuperAdmins ? "text-danger" : "")">
            <i class="bi bi-people me-2"></i>@(Model.Capabilities.CanManageSuperAdmins ? "Manage Users & Roles" : "User Management")
        </h2>
        
        <div class="btn-group">
            @if (Model.Capabilities.CanCreate)
            {
                <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createUserModal">
                    <i class="bi bi-person-plus me-2"></i>Add User
                </button>
            }
            @if (Model.Capabilities.CanExport)
            {
                <button type="button" class="btn btn-outline-primary" onclick="exportUsers()">
                    <i class="bi bi-download me-2"></i>Export
                </button>
            }
            <button type="button" class="btn btn-outline-secondary" onclick="refreshUsers()">
                <i class="bi bi-arrow-clockwise me-2"></i>Refresh
            </button>
        </div>
    </div>

    @if (Model.Capabilities.CanView)
    {
        <!-- Summary Stats -->
        <div class="row g-3 mb-4">
            <div class="col-md-3">
                <div class="card bg-primary text-white">
                    <div class="card-body text-center">
                        <i class="bi bi-people fs-2 mb-2"></i>
                        <h4 class="mb-0">@Model.TotalUsers.ToString("N0")</h4>
                        <small>Total Users</small>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-success text-white">
                    <div class="card-body text-center">
                        <i class="bi bi-person-check fs-2 mb-2"></i>
                        <h4 class="mb-0">@Model.ActiveUsers.ToString("N0")</h4>
                        <small>Active Users</small>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-warning text-white">
                    <div class="card-body text-center">
                        <i class="bi bi-person-plus fs-2 mb-2"></i>
                        <h4 class="mb-0">@Model.PendingUsers.ToString("N0")</h4>
                        <small>Pending Approval</small>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-secondary text-white">
                    <div class="card-body text-center">
                        <i class="bi bi-person-x fs-2 mb-2"></i>
                        <h4 class="mb-0">@Model.InactiveUsers.ToString("N0")</h4>
                        <small>Inactive Users</small>
                    </div>
                </div>
            </div>
        </div>

        <!-- Filters -->
        @await Html.PartialAsync("~/Presentation/Views/Users/_UserFilters.cshtml", Model.Filters)

        <!-- Users Table -->
        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0">
                    <i class="bi bi-list-ul me-2"></i>Users
                    @if (Model.Users.Any())
                    {
                        <span class="badge bg-light text-dark ms-2">
                            @Model.Users.Count of @Model.TotalUsers.ToString("N0") users
                        </span>
                    }
                </h5>
            </div>
            <div class="card-body p-0">
                @await Html.PartialAsync("~/Presentation/Views/Users/_UserTable.cshtml", (Model.Users, Model.Capabilities))
            </div>
        </div>

        <!-- Pagination -->
        @if (Model.TotalPages > 1)
        {
            <nav class="mt-4" aria-label="User pagination">
                <ul class="pagination justify-content-center">
                    @if (Model.CurrentPage > 1)
                    {
                        <li class="page-item">
                            <a class="page-link" href="@GetPageUrl(1)">First</a>
                        </li>
                        <li class="page-item">
                            <a class="page-link" href="@GetPageUrl(Model.CurrentPage - 1)">Previous</a>
                        </li>
                    }

                    @{
                        var startPage = Math.Max(1, Model.CurrentPage - 2);
                        var endPage = Math.Min(Model.TotalPages, Model.CurrentPage + 2);
                    }

                    @for (int i = startPage; i <= endPage; i++)
                    {
                        <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                            <a class="page-link" href="@GetPageUrl(i)">@i</a>
                        </li>
                    }

                    @if (Model.CurrentPage < Model.TotalPages)
                    {
                        <li class="page-item">
                            <a class="page-link" href="@GetPageUrl(Model.CurrentPage + 1)">Next</a>
                        </li>
                        <li class="page-item">
                            <a class="page-link" href="@GetPageUrl(Model.TotalPages)">Last</a>
                        </li>
                    }
                </ul>
            </nav>
        }
    }
    else
    {
        <div class="alert alert-warning">
            <i class="bi bi-exclamation-triangle me-2"></i>
            You don't have permission to view user management.
        </div>
    }
</div>

<!-- Create User Modal -->
@if (Model.Capabilities.CanCreate)
{
    <div class="modal fade" id="createUserModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Create New User</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form id="createUserForm">
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label">Full Name</label>
                            <input type="text" name="name" class="form-control" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Username</label>
                            <input type="text" name="username" class="form-control" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Email</label>
                            <input type="email" name="email" class="form-control" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Password</label>
                            <input type="password" name="password" class="form-control" required>
                            <div class="form-text">Minimum 8 characters with uppercase, lowercase, number, and special character.</div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Role</label>
                            <select name="role" class="form-select" required>
                                <option value="User">User</option>
                                <option value="Admin">Admin</option>
                                @if (Model.Capabilities.CanManageSuperAdmins)
                                {
                                    <option value="SuperAdmin">SuperAdmin</option>
                                }
                            </select>
                        </div>
                        <div class="mb-3 form-check">
                            <input type="checkbox" name="emailConfirmed" class="form-check-input" id="emailConfirmed">
                            <label class="form-check-label" for="emailConfirmed">
                                Email is confirmed (skip email verification)
                            </label>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Create User</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        function editUser(userId) {
            @if (Model.Capabilities.CanViewSensitiveData)
            {
                <text>
                window.location.href = '@Url.Action("UserDetails", "Users")/' + userId + '?edit=true';
                </text>
            }
            else
            {
                <text>
                alert('Edit user functionality - limited for Admin role');
                </text>
            }
        }

        function changeRole(userId, currentRole) {
            @if (Model.Capabilities.CanChangeRoles)
            {
                <text>
                const newRole = prompt(`Change role for user (current: ${currentRole}):`, currentRole);
                if (newRole && newRole !== currentRole) {
                    fetch('@Url.Action("ChangeUserRole", "SuperAdmin")', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
                        },
                        body: JSON.stringify({ userId: userId, newRole: newRole })
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            location.reload();
                        } else {
                            alert('Error: ' + data.message);
                        }
                    });
                }
                </text>
            }
            else
            {
                <text>
                alert('You do not have permission to change user roles.');
                </text>
            }
        }

        function lockUser(userId) {
            @if (Model.Capabilities.CanLockUnlock)
            {
                <text>
                if (confirm('Are you sure you want to lock this user?')) {
                    toggleUserLock(userId, true);
                }
                </text>
            }
            else
            {
                <text>
                alert('You do not have permission to lock users.');
                </text>
            }
        }

        function unlockUser(userId) {
            @if (Model.Capabilities.CanLockUnlock)
            {
                <text>
                if (confirm('Are you sure you want to unlock this user?')) {
                    toggleUserLock(userId, false);
                }
                </text>
            }
            else
            {
                <text>
                alert('You do not have permission to unlock users.');
                </text>
            }
        }

        function toggleUserLock(userId, lock) {
            fetch('@Url.Action("ToggleUserStatus", "SuperAdmin")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
                },
                body: JSON.stringify({ userId: userId })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    location.reload();
                } else {
                    alert('Error: ' + data.message);
                }
            });
        }

        function deleteUser(userId) {
            @if (Model.Capabilities.CanDelete)
            {
                <text>
                if (confirm('Are you sure you want to delete this user? This action cannot be undone.')) {
                    toggleUserStatus(userId, true);
                }
                </text>
            }
            else
            {
                <text>
                alert('You do not have permission to delete users.');
                </text>
            }
        }

        function restoreUser(userId) {
            @if (Model.Capabilities.CanDelete)
            {
                <text>
                if (confirm('Are you sure you want to restore this user?')) {
                    toggleUserStatus(userId, false);
                }
                </text>
            }
            else
            {
                <text>
                alert('You do not have permission to restore users.');
                </text>
            }
        }

        function toggleUserStatus(userId, deleted) {
            fetch('@Url.Action("ToggleUserStatus", "SuperAdmin")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
                },
                body: JSON.stringify({ userId: userId })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    location.reload();
                } else {
                    alert('Error: ' + data.message);
                }
            });
        }

        function exportUsers() {
            @if (Model.Capabilities.CanExport)
            {
                <text>
                const params = new URLSearchParams(window.location.search);
                params.append('export', 'true');
                
                const url = '@Url.Action("ExportUsers", "SuperAdmin")';
                window.open(`${url}?${params.toString()}`, '_blank');
                </text>
            }
            else
            {
                <text>
                alert('You do not have permission to export user data.');
                </text>
            }
        }

        function refreshUsers() {
            window.location.reload();
        }

        // Create user form submission
        document.getElementById('createUserForm')?.addEventListener('submit', function(e) {
            e.preventDefault();
            
            const formData = new FormData(this);
            const userData = Object.fromEntries(formData.entries());
            userData.emailConfirmed = formData.has('emailConfirmed');
            
            fetch('@Url.Action("CreateUser", "SuperAdmin")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
                },
                body: JSON.stringify(userData)
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    location.reload();
                } else {
                    alert('Error: ' + data.message);
                }
            });
        });
    </script>
}

@functions {
    private string GetPageUrl(int page)
    {
        var query = Context.Request.Query.ToDictionary(x => x.Key, x => x.Value.ToString());
        query["page"] = page.ToString();
        
        var queryString = string.Join("&", query.Select(x => $"{x.Key}={Uri.EscapeDataString(x.Value)}"));
        return $"{Context.Request.Path}?{queryString}";
    }
}