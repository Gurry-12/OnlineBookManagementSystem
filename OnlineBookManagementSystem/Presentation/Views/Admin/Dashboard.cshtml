@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = ViewData["Layout"]?.ToString() ?? "_LayoutAdmin";
}
@model OnlineBookManagementSystem.Presentation.ViewModels.Admin.AdminDashboardViewModel;

<div class="view-admin-dashboard">
<div class="dashboard-grid dashboard-grid--admin">
    <!-- Stats Section -->
    <div class="stats-row">
        <div class="stats-card stats-card--books">
            <div class="stats-card__body">
                <div class="stats-card__icon">
                    <i class="bi bi-book"></i>
                </div>
                <h3 class="stats-card__number">@Model.TotalBooks</h3>
                <p class="stats-card__label">Total Books</p>
                <a asp-action="Books" class="stats-card__action">
                    <i class="bi bi-arrow-right me-1"></i>Manage
                </a>
            </div>
        </div>
        
        <div class="stats-card stats-card--categories">
            <div class="stats-card__body">
                <div class="stats-card__icon">
                    <i class="bi bi-tags"></i>
                </div>
                <h3 class="stats-card__number">@Model.TotalCategories</h3>
                <p class="stats-card__label">Categories</p>
                <a asp-action="CategoryManagement" class="stats-card__action">
                    <i class="bi bi-arrow-right me-1"></i>Manage
                </a>
            </div>
        </div>
        
        <div class="stats-card stats-card--users">
            <div class="stats-card__body">
                <div class="stats-card__icon">
                    <i class="bi bi-people"></i>
                </div>
                <h3 class="stats-card__number">@Model.TotalUsers</h3>
                <p class="stats-card__label">Total Users</p>
                <a asp-action="UserList" class="stats-card__action">
                    <i class="bi bi-arrow-right me-1"></i>Manage
                </a>
            </div>
        </div>
        
        <div class="stats-card stats-card--orders">
            <div class="stats-card__body">
                <div class="stats-card__icon">
                    <i class="bi bi-cart-check"></i>
                </div>
                <h3 class="stats-card__number">@Model.TotalOrders</h3>
                <p class="stats-card__label">Total Orders</p>
                <a asp-action="OrderManagement" class="stats-card__action">
                    <i class="bi bi-arrow-right me-1"></i>View
                </a>
            </div>
        </div>
        
        <div class="stats-card stats-card--revenue">
            <div class="stats-card__body">
                <div class="stats-card__icon">
                    <i class="bi bi-currency-dollar"></i>
                </div>
                <h3 class="stats-card__number">@Model.TotalRevenue.ToString("C")</h3>
                <p class="stats-card__label">Total Revenue</p>
                <a asp-controller="Analytics" asp-action="OrdersAnalytics" class="stats-card__action">
                    <i class="bi bi-arrow-right me-1"></i>Analytics
                </a>
            </div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="view-section">
        <div class="view-card">
            <div class="view-card__header">
                <h5 class="view-card__title">
                    <i class="bi bi-lightning"></i>Quick Actions
                </h5>
            </div>
            <div class="view-card__body">
                <div class="quick-actions-grid">
                        <a asp-action="CreateBook" class="quick-action-btn">
                            <i class="bi bi-plus-circle"></i>
                            <span>Add Book</span>
                        </a>
                        <a asp-action="UserList" class="quick-action-btn">
                            <i class="bi bi-person-plus"></i>
                            <span>Manage Users</span>
                        </a>
                        <a asp-action="OrderManagement" class="quick-action-btn">
                            <i class="bi bi-cart-check"></i>
                            <span>View Orders</span>
                        </a>
                        <a asp-controller="Category" asp-action="CategoryList" class="quick-action-btn">
                            <i class="bi bi-tags"></i>
                            <span>Categories</span>
                        </a>
                        <a asp-controller="Analytics" asp-action="BooksAnalytics" class="quick-action-btn">
                            <i class="bi bi-graph-up"></i>
                            <span>Analytics</span>
                        </a>
                        <a asp-action="ActivityLogs" class="quick-action-btn">
                            <i class="bi bi-clock-history"></i>
                            <span>Activity Logs</span>
                        </a>
                    </div>
            </div>
        </div>
    </div>

    <!-- Featured Content Carousel -->
    <div class="view-section">
        <div class="view-card">
            <div class="view-card__header">
                <h5 class="view-card__title">
                    <i class="bi bi-star"></i>Featured Content
                    <span class="wp-badge wb-badge-secondary ms-2">Highlights</span>
                </h5>
            </div>
            <div class="view-card__body p-0">
                    <div class="interactive-discovery-carousel h-100 position-relative rounded-4 overflow-hidden shadow-sm p-1" style="background: linear-gradient(135deg, rgba(255,255,255,0.9), rgba(255,255,255,0.6)); backdrop-filter: blur(16px); border: 1px solid rgba(255,255,255,0.4);">
                        <div class="carousel-bg-glow position-absolute w-100 h-100 top-0 start-0 opacity-50" style="background: radial-gradient(circle at 80% 20%, rgba(120,194,173,0.3) 0%, transparent 50%), radial-gradient(circle at 20% 80%, rgba(255,179,138,0.3) 0%, transparent 50%); z-index: 0;"></div>
                        
                        <div id="adminCarousel" class="carousel slide h-100 rounded-3 overflow-hidden position-relative" style="z-index: 1;" data-bs-ride="carousel" data-bs-interval="5000">
                            <div class="carousel-indicators mb-2">
                                <button type="button" data-bs-target="#adminCarousel" data-bs-slide-to="0" class="active rounded-pill bg-primary" style="width:20px; height:6px;"></button>
                                <button type="button" data-bs-target="#adminCarousel" data-bs-slide-to="1" class="rounded-pill bg-primary opacity-50" style="width:10px; height:6px;"></button>
                                <button type="button" data-bs-target="#adminCarousel" data-bs-slide-to="2" class="rounded-pill bg-primary opacity-50" style="width:10px; height:6px;"></button>
                                <button type="button" data-bs-target="#adminCarousel" data-bs-slide-to="3" class="rounded-pill bg-primary opacity-50" style="width:10px; height:6px;"></button>
                            </div>
                            
                            <div class="carousel-inner h-100">
                                <!-- Slide 1: Recent Books -->
                                <div class="carousel-item active h-100">
                                    <div class="d-flex flex-column justify-content-center align-items-center h-100 p-5 p-lg-4 p-xl-5 text-center position-relative">
                                        <span class="badge bg-primary text-white mb-3 rounded-pill px-3 py-2 shadow-sm" style="font-weight: 500; letter-spacing: 0.5px;"><i class="bi bi-book-half me-2"></i>Catalog Management</span>
                                        <h3 class="fw-bold mb-3 position-relative z-1" style="color: #2c3e50; line-height: 1.5; font-size: clamp(1.2rem, 2vw, 1.8rem);">Recent Book Additions</h3>
                                        <p class="text-muted mb-4 z-1 mx-auto" style="max-width: 600px;">Stay updated with the latest books added to your catalog. Monitor new arrivals and ensure quality content for your users.</p>
                                        
                                        <div class="d-flex flex-wrap justify-content-center gap-3 mb-4 z-1">
                                            <div class="bg-white border text-success rounded-pill px-3 py-2 shadow-sm d-flex align-items-center gap-2">
                                                <i class="bi bi-plus-circle-fill"></i>
                                                <span class="fw-medium">@Model.RecentBooksCount New This Week</span>
                                            </div>
                                            <div class="bg-white border text-info rounded-pill px-3 py-2 shadow-sm d-flex align-items-center gap-2">
                                                <i class="bi bi-collection-fill"></i>
                                                <span class="fw-medium">@Model.TotalBooks Total Books</span>
                                            </div>
                                        </div>
                                        
                                        <a asp-action="Books" class="wp-btn wp-btn-primary px-4 py-2 z-1 shadow-sm rounded-pill transition-all" style="font-weight: 500;">
                                            Manage Books <i class="bi bi-arrow-right ms-2"></i>
                                        </a>
                                        <i class="bi bi-collection position-absolute opacity-10" style="font-size: 15rem; right: 5%; bottom: -10%; color: var(--wp-primary);"></i>
                                    </div>
                                </div>

                                <!-- Slide 2: User Activity -->
                                <div class="carousel-item h-100">
                                    <div class="d-flex flex-column justify-content-center align-items-center h-100 p-5 p-lg-4 p-xl-5 text-center position-relative">
                                        <span class="badge bg-success text-white mb-3 rounded-pill px-3 py-2 shadow-sm" style="font-weight: 500; letter-spacing: 0.5px;"><i class="bi bi-people-fill me-2"></i>Audience Insights</span>
                                        <h3 class="fw-bold mb-3 position-relative z-1" style="color: #2c3e50; line-height: 1.5; font-size: clamp(1.2rem, 2vw, 1.8rem);">User Engagement</h3>
                                        <p class="text-muted mb-4 z-1 mx-auto" style="max-width: 600px;">Track user activity and engagement metrics. Monitor registrations, active users, and platform growth.</p>
                                        
                                        <div class="d-flex flex-wrap justify-content-center gap-3 mb-4 z-1">
                                            <div class="bg-white border text-success rounded-pill px-3 py-2 shadow-sm d-flex align-items-center gap-2">
                                                <i class="bi bi-person-plus-fill"></i>
                                                <span class="fw-medium">@Model.NewUsersThisWeek New Users</span>
                                            </div>
                                            <div class="bg-white border text-warning rounded-pill px-3 py-2 shadow-sm d-flex align-items-center gap-2">
                                                <i class="bi bi-activity"></i>
                                                <span class="fw-medium">@Model.ActiveUsersToday Active Today</span>
                                            </div>
                                        </div>
                                        
                                        <a asp-action="UserList" class="wp-btn wp-btn-success px-4 py-2 z-1 shadow-sm rounded-pill transition-all" style="font-weight: 500;">
                                            View Users <i class="bi bi-arrow-right ms-2"></i>
                                        </a>
                                        <i class="bi bi-graph-up-arrow position-absolute opacity-10" style="font-size: 15rem; right: 5%; bottom: -10%; color: var(--wp-success);"></i>
                                    </div>
                                </div>

                                <!-- Slide 3: Order Management -->
                                <div class="carousel-item h-100">
                                    <div class="d-flex flex-column justify-content-center align-items-center h-100 p-5 p-lg-4 p-xl-5 text-center position-relative">
                                        <span class="badge bg-warning text-dark mb-3 rounded-pill px-3 py-2 shadow-sm" style="font-weight: 500; letter-spacing: 0.5px;"><i class="bi bi-cart-check-fill me-2"></i>Sales & Revenue</span>
                                        <h3 class="fw-bold mb-3 position-relative z-1" style="color: #2c3e50; line-height: 1.5; font-size: clamp(1.2rem, 2vw, 1.8rem);">Order Management</h3>
                                        <p class="text-muted mb-4 z-1 mx-auto" style="max-width: 600px;">Monitor and manage customer orders efficiently. Track pending orders, review revenue streams, and ensure timely fulfillment.</p>
                                        
                                        <div class="d-flex flex-wrap justify-content-center gap-3 mb-4 z-1">
                                            <div class="bg-white border text-warning rounded-pill px-3 py-2 shadow-sm d-flex align-items-center gap-2">
                                                <i class="bi bi-clock-fill"></i>
                                                <span class="fw-medium text-dark">@Model.PendingOrders Pending</span>
                                            </div>
                                            <div class="bg-white border text-success rounded-pill px-3 py-2 shadow-sm d-flex align-items-center gap-2">
                                                <i class="bi bi-currency-dollar"></i>
                                                <span class="fw-medium">@Model.TotalRevenue.ToString("C") Revenue</span>
                                            </div>
                                        </div>
                                        
                                        <a asp-action="OrderManagement" class="wp-btn wp-btn-warning px-4 py-2 z-1 shadow-sm rounded-pill transition-all text-dark" style="font-weight: 500;">
                                            Manage Orders <i class="bi bi-arrow-right ms-2"></i>
                                        </a>
                                        <i class="bi bi-bag-check position-absolute opacity-10" style="font-size: 15rem; right: 5%; bottom: -10%; color: var(--wp-warning);"></i>
                                    </div>
                                </div>

                                <!-- Slide 4: Analytics -->
                                <div class="carousel-item h-100">
                                    <div class="d-flex flex-column justify-content-center align-items-center h-100 p-5 p-lg-4 p-xl-5 text-center position-relative">
                                        <span class="badge bg-info text-dark mb-3 rounded-pill px-3 py-2 shadow-sm" style="font-weight: 500; letter-spacing: 0.5px;"><i class="bi bi-bar-chart-fill me-2"></i>Actionable Data</span>
                                        <h3 class="fw-bold mb-3 position-relative z-1" style="color: #2c3e50; line-height: 1.5; font-size: clamp(1.2rem, 2vw, 1.8rem);">Analytics & Insights</h3>
                                        <p class="text-muted mb-4 z-1 mx-auto" style="max-width: 600px;">Access comprehensive analytics and detailed reports. Make informed, data-driven decisions backed by robust platform metrics.</p>
                                        
                                        <div class="d-flex flex-wrap justify-content-center gap-3 mb-4 z-1">
                                            <div class="bg-white border text-info rounded-pill px-3 py-2 shadow-sm d-flex align-items-center gap-2">
                                                <i class="bi bi-graph-up text-info"></i>
                                                <span class="fw-medium text-dark">Growth Tracking</span>
                                            </div>
                                            <div class="bg-white border text-primary rounded-pill px-3 py-2 shadow-sm d-flex align-items-center gap-2">
                                                <i class="bi bi-clipboard-data text-primary"></i>
                                                <span class="fw-medium">Detailed Reports</span>
                                            </div>
                                        </div>
                                        
                                        <a asp-controller="Analytics" asp-action="BooksAnalytics" class="wp-btn wp-btn-info px-4 py-2 z-1 shadow-sm rounded-pill transition-all text-white" style="font-weight: 500;">
                                            View Analytics <i class="bi bi-arrow-right ms-2"></i>
                                        </a>
                                        <i class="bi bi-pie-chart position-absolute opacity-10" style="font-size: 15rem; right: 5%; bottom: -10%; color: var(--wp-info);"></i>
                                    </div>
                                </div>
                            </div>

                            <!-- Enhanced Custom Controls -->
                            <button class="carousel-control-prev" type="button" data-bs-target="#adminCarousel" data-bs-slide="prev" style="width: 10%; opacity: 1;">
                                <div class="bg-white bg-opacity-75 rounded-circle shadow-sm d-flex justify-content-center align-items-center carousel-control-hover transition-all" style="width: 40px; height: 40px; backdrop-filter: blur(4px);">
                                    <i class="bi bi-chevron-left text-dark fs-5"></i>
                                </div>
                                <span class="visually-hidden">Previous</span>
                            </button>
                            <button class="carousel-control-next" type="button" data-bs-target="#adminCarousel" data-bs-slide="next" style="width: 10%; opacity: 1;">
                                <div class="bg-white bg-opacity-75 rounded-circle shadow-sm d-flex justify-content-center align-items-center carousel-control-hover transition-all" style="width: 40px; height: 40px; backdrop-filter: blur(4px);">
                                    <i class="bi bi-chevron-right text-dark fs-5"></i>
                                </div>
                                <span class="visually-hidden">Next</span>
                            </button>
                        </div>
                    </div>
                    
                    <style>
                        .carousel-control-hover:hover {
                            background-color: white !important;
                            transform: scale(1.1);
                            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15) !important;
                        }
                        .transition-all {
                            transition: all 0.3s ease;
                        }
                        .interactive-discovery-carousel .carousel-indicators button {
                            transition: width 0.3s ease, opacity 0.3s ease;
                            border: none;
                        }
                        .interactive-discovery-carousel .carousel-indicators button.active {
                            opacity: 1 !important;
                            width: 25px !important;
                        }
                    </style>
                </div>
            </div>
        </div>
    </div>

    <!-- Charts Row -->
    <div class="view-section">
        <div class="view-grid view-grid--2-cols">
            <!-- Monthly Book Uploads Chart -->
            <div class="view-card">
                <div class="view-card__header">
                    <h6 class="view-card__title">
                        <i class="bi bi-graph-up"></i>Monthly Book Uploads
                    </h6>
                </div>
                <div class="view-card__body">
                    <div class="chart-container">
                        <canvas id="monthlyChart"></canvas>
                    </div>
                </div>
            </div>

            <!-- Books by Category Chart -->
            <div class="view-card">
                <div class="view-card__header">
                    <h6 class="view-card__title">
                        <i class="bi bi-tags"></i>Books by Category
                    </h6>
                </div>
                <div class="view-card__body">
                    <div class="chart-container">
                        <canvas id="categoryChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Bottom Row -->
    <div class="view-section">
        <div class="view-grid view-grid--2-cols">
            <!-- Recent Activities -->
            <div class="view-card">
                <div class="view-card__header">
                    <h6 class="view-card__title">
                        <i class="bi bi-clock-history"></i>Recent Activities
                    </h6>
                </div>
                <div class="view-card__body">
                    <div class="activity-list">
                        @if (Model.RecentActivity != null && Model.RecentActivity.Any())
                        {
                            @foreach (var log in Model.RecentActivity.Take(8))
                            {
                                var iconClass = log.ActionType switch
                                {
                                    "Add" => "bi bi-plus-circle text-success",
                                    "Update" => "bi bi-pencil-square text-warning",
                                    "Delete" => "bi bi-trash text-danger",
                                    "Register" => "bi bi-person-plus text-info",
                                    "Login" => "bi bi-box-arrow-in-right text-primary",
                                    _ => "bi bi-info-circle text-secondary"
                                };

                                <div class="activity-item">
                                    <div class="activity-icon">
                                        <i class="@iconClass"></i>
                                    </div>
                                    <div class="activity-content">
                                        <p class="activity-description">@log.Description</p>
                                        <small class="activity-time">
                                            @((DateTime.UtcNow - log.Timestamp).TotalMinutes < 1 ? "Just now" : 
                                            (DateTime.UtcNow - log.Timestamp).TotalMinutes < 60 ? $"{(int)(DateTime.UtcNow - log.Timestamp).TotalMinutes} min ago" :
                                            (DateTime.UtcNow - log.Timestamp).TotalHours < 24 ? $"{(int)(DateTime.UtcNow - log.Timestamp).TotalHours} hrs ago" :
                                            $"{(int)(DateTime.UtcNow - log.Timestamp).TotalDays} days ago")
                                        </small>
                                    </div>
                                    <div class="activity-badge">
                                        <span class="wp-badge bg-info">@log.ActionType</span>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="view-empty-state">
                                <div class="view-empty-state__icon">
                                    <i class="bi bi-clock-history"></i>
                                </div>
                                <p class="view-empty-state__description">No recent activity found.</p>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Revenue Chart -->
            <div class="view-card">
                <div class="view-card__header">
                    <h6 class="view-card__title">
                        <i class="bi bi-currency-dollar"></i>Revenue Trends
                    </h6>
                </div>
                <div class="view-card__body">
                    <div class="chart-container">
                        <canvas id="revenueChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
</div>

@await Html.PartialAsync("_Notification")

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="~/js/books/ChartsAdmin.js"></script>
}



