@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = ViewData["Layout"]?.ToString() ?? "_LayoutAdmin";
}
@model OnlineBookManagementSystem.Presentation.ViewModels.Admin.AdminDashboardViewModel;

<div class="view-admin-dashboard">
<div class="dashboard-grid dashboard-grid--admin">
    <!-- Stats Section -->
    <div class="stats-row">
        <div class="stats-card stats-card--books">
            <div class="stats-card__body">
                <div class="stats-card__icon">
                    <i class="bi bi-book"></i>
                </div>
                <h3 class="stats-card__number">@Model.TotalBooks</h3>
                <p class="stats-card__label">Total Books</p>
                <a asp-action="Books" class="stats-card__action">
                    <i class="bi bi-arrow-right me-1"></i>Manage
                </a>
            </div>
        </div>
        
        <div class="stats-card stats-card--categories">
            <div class="stats-card__body">
                <div class="stats-card__icon">
                    <i class="bi bi-tags"></i>
                </div>
                <h3 class="stats-card__number">@Model.TotalCategories</h3>
                <p class="stats-card__label">Categories</p>
                <a asp-action="CategoryManagement" class="stats-card__action">
                    <i class="bi bi-arrow-right me-1"></i>Manage
                </a>
            </div>
        </div>
        
        <div class="stats-card stats-card--users">
            <div class="stats-card__body">
                <div class="stats-card__icon">
                    <i class="bi bi-people"></i>
                </div>
                <h3 class="stats-card__number">@Model.TotalUsers</h3>
                <p class="stats-card__label">Total Users</p>
                <a asp-action="UserList" class="stats-card__action">
                    <i class="bi bi-arrow-right me-1"></i>Manage
                </a>
            </div>
        </div>
        
        <div class="stats-card stats-card--orders">
            <div class="stats-card__body">
                <div class="stats-card__icon">
                    <i class="bi bi-cart-check"></i>
                </div>
                <h3 class="stats-card__number">@Model.TotalOrders</h3>
                <p class="stats-card__label">Total Orders</p>
                <a asp-action="OrderManagement" class="stats-card__action">
                    <i class="bi bi-arrow-right me-1"></i>View
                </a>
            </div>
        </div>
        
        <div class="stats-card stats-card--revenue">
            <div class="stats-card__body">
                <div class="stats-card__icon">
                    <i class="bi bi-currency-dollar"></i>
                </div>
                <h3 class="stats-card__number">@Model.TotalRevenue.ToString("C")</h3>
                <p class="stats-card__label">Total Revenue</p>
                <a asp-controller="Analytics" asp-action="OrdersAnalytics" class="stats-card__action">
                    <i class="bi bi-arrow-right me-1"></i>Analytics
                </a>
            </div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="view-section">
        <div class="view-card">
            <div class="view-card__header">
                <h5 class="view-card__title">
                    <i class="bi bi-lightning"></i>Quick Actions
                </h5>
            </div>
            <div class="view-card__body">
                <div class="quick-actions-grid">
                        <a asp-action="CreateBook" class="quick-action-btn">
                            <i class="bi bi-plus-circle"></i>
                            <span>Add Book</span>
                        </a>
                        <a asp-action="UserList" class="quick-action-btn">
                            <i class="bi bi-person-plus"></i>
                            <span>Manage Users</span>
                        </a>
                        <a asp-action="OrderManagement" class="quick-action-btn">
                            <i class="bi bi-cart-check"></i>
                            <span>View Orders</span>
                        </a>
                        <a asp-controller="Category" asp-action="CategoryList" class="quick-action-btn">
                            <i class="bi bi-tags"></i>
                            <span>Categories</span>
                        </a>
                        <a asp-controller="Analytics" asp-action="BooksAnalytics" class="quick-action-btn">
                            <i class="bi bi-graph-up"></i>
                            <span>Analytics</span>
                        </a>
                        <a asp-action="ActivityLogs" class="quick-action-btn">
                            <i class="bi bi-clock-history"></i>
                            <span>Activity Logs</span>
                        </a>
                    </div>
            </div>
        </div>
    </div>

    <!-- Featured Content Carousel -->
    <div class="view-section">
        <div class="view-card">
            <div class="view-card__header">
                <h5 class="view-card__title">
                    <i class="bi bi-star"></i>Featured Content
                    <span class="wp-badge ms-2">Highlights</span>
                </h5>
            </div>
            <div class="view-card__body p-0">
                    <div id="adminCarousel" class="carousel slide" data-bs-ride="carousel" data-bs-interval="5000">
                        <div class="carousel-indicators">
                            <button type="button" data-bs-target="#adminCarousel" data-bs-slide-to="0" class="active"></button>
                            <button type="button" data-bs-target="#adminCarousel" data-bs-slide-to="1"></button>
                            <button type="button" data-bs-target="#adminCarousel" data-bs-slide-to="2"></button>
                            <button type="button" data-bs-target="#adminCarousel" data-bs-slide-to="3"></button>
                        </div>
                        <div class="carousel-inner">
                            <!-- Slide 1: Recent Books -->
                            <div class="carousel-item active">
                                <div class="carousel-slide-content">
                                    <div class="carousel-text">
                                        <h4 class="carousel-title">
                                            <i class="bi bi-book-half text-primary me-2"></i>
                                            Recent Book Additions
                                        </h4>
                                        <p class="carousel-description">
                                            Stay updated with the latest books added to your catalog. Monitor new arrivals and ensure quality content for your users.
                                        </p>
                                        <div class="carousel-stats">
                                            <span class="wp-badge bg-success me-2">
                                                <i class="bi bi-plus-circle me-1"></i>@Model.RecentBooksCount New This Week
                                            </span>
                                            <span class="wp-badge bg-info">
                                                <i class="bi bi-eye me-1"></i>@Model.TotalBooks Total Books
                                            </span>
                                        </div>
                                        <a asp-action="Books" class="wp-btn-primary mt-3">
                                            <i class="bi bi-arrow-right me-2"></i>Manage Books
                                        </a>
                                    </div>
                                    <div class="carousel-visual">
                                        <div class="feature-icon-large">
                                            <i class="bi bi-collection text-primary"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Slide 2: User Activity -->
                            <div class="carousel-item">
                                <div class="carousel-slide-content">
                                    <div class="carousel-text">
                                        <h4 class="carousel-title">
                                            <i class="bi bi-people text-success me-2"></i>
                                            User Engagement
                                        </h4>
                                        <p class="carousel-description">
                                            Track user activity and engagement metrics. Monitor registrations, active users, and platform growth.
                                        </p>
                                        <div class="carousel-stats">
                                            <span class="wp-badge bg-success me-2">
                                                <i class="bi bi-person-plus me-1"></i>@Model.NewUsersThisWeek New Users
                                            </span>
                                            <span class="wp-badge bg-warning">
                                                <i class="bi bi-activity me-1"></i>@Model.ActiveUsersToday Active Today
                                            </span>
                                        </div>
                                        <a asp-action="UserList" class="wp-btn-primary mt-3">
                                            <i class="bi bi-arrow-right me-2"></i>View Users
                                        </a>
                                    </div>
                                    <div class="carousel-visual">
                                        <div class="feature-icon-large">
                                            <i class="bi bi-graph-up-arrow text-success"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Slide 3: Order Management -->
                            <div class="carousel-item">
                                <div class="carousel-slide-content">
                                    <div class="carousel-text">
                                        <h4 class="carousel-title">
                                            <i class="bi bi-cart-check text-warning me-2"></i>
                                            Order Management
                                        </h4>
                                        <p class="carousel-description">
                                            Monitor and manage customer orders efficiently. Track pending orders, revenue, and fulfillment status.
                                        </p>
                                        <div class="carousel-stats">
                                            <span class="wp-badge bg-warning me-2">
                                                <i class="bi bi-clock me-1"></i>@Model.PendingOrders Pending
                                            </span>
                                            <span class="wp-badge bg-success">
                                                <i class="bi bi-currency-dollar me-1"></i>@Model.TotalRevenue.ToString("C") Revenue
                                            </span>
                                        </div>
                                        <a asp-action="OrderManagement" class="wp-btn-primary mt-3">
                                            <i class="bi bi-arrow-right me-2"></i>Manage Orders
                                        </a>
                                    </div>
                                    <div class="carousel-visual">
                                        <div class="feature-icon-large">
                                            <i class="bi bi-bag-check text-warning"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Slide 4: Analytics & Reports -->
                            <div class="carousel-item">
                                <div class="carousel-slide-content">
                                    <div class="carousel-text">
                                        <h4 class="carousel-title">
                                            <i class="bi bi-bar-chart text-info me-2"></i>
                                            Analytics & Insights
                                        </h4>
                                        <p class="carousel-description">
                                            Access comprehensive analytics and reports. Make data-driven decisions with detailed insights and trends.
                                        </p>
                                        <div class="carousel-stats">
                                            <span class="wp-badge bg-info me-2">
                                                <i class="bi bi-graph-up me-1"></i>Growth Tracking
                                            </span>
                                            <span class="wp-badge bg-primary">
                                                <i class="bi bi-clipboard-data me-1"></i>Detailed Reports
                                            </span>
                                        </div>
                                        <a asp-controller="Analytics" asp-action="BooksAnalytics" class="wp-btn-primary mt-3">
                                            <i class="bi bi-arrow-right me-2"></i>View Analytics
                                        </a>
                                    </div>
                                    <div class="carousel-visual">
                                        <div class="feature-icon-large">
                                            <i class="bi bi-pie-chart text-info"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Carousel Controls -->
                        <button class="carousel-control-prev" type="button" data-bs-target="#adminCarousel" data-bs-slide="prev">
                            <span class="carousel-control-prev-icon"></span>
                            <span class="visually-hidden">Previous</span>
                        </button>
                        <button class="carousel-control-next" type="button" data-bs-target="#adminCarousel" data-bs-slide="next">
                            <span class="carousel-control-next-icon"></span>
                            <span class="visually-hidden">Next</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Charts Row -->
    <div class="view-section">
        <div class="view-grid view-grid--2-cols">
            <!-- Monthly Book Uploads Chart -->
            <div class="view-card">
                <div class="view-card__header">
                    <h6 class="view-card__title">
                        <i class="bi bi-graph-up"></i>Monthly Book Uploads
                    </h6>
                </div>
                <div class="view-card__body">
                    <div class="chart-container">
                        <canvas id="monthlyChart"></canvas>
                    </div>
                </div>
            </div>

            <!-- Books by Category Chart -->
            <div class="view-card">
                <div class="view-card__header">
                    <h6 class="view-card__title">
                        <i class="bi bi-tags"></i>Books by Category
                    </h6>
                </div>
                <div class="view-card__body">
                    <div class="chart-container">
                        <canvas id="categoryChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Bottom Row -->
    <div class="view-section">
        <div class="view-grid view-grid--2-cols">
            <!-- Recent Activities -->
            <div class="view-card">
                <div class="view-card__header">
                    <h6 class="view-card__title">
                        <i class="bi bi-clock-history"></i>Recent Activities
                    </h6>
                </div>
                <div class="view-card__body">
                    <div class="activity-list">
                        @if (Model.RecentActivity != null && Model.RecentActivity.Any())
                        {
                            @foreach (var log in Model.RecentActivity.Take(8))
                            {
                                var iconClass = log.ActionType switch
                                {
                                    "Add" => "bi bi-plus-circle text-success",
                                    "Update" => "bi bi-pencil-square text-warning",
                                    "Delete" => "bi bi-trash text-danger",
                                    "Register" => "bi bi-person-plus text-info",
                                    "Login" => "bi bi-box-arrow-in-right text-primary",
                                    _ => "bi bi-info-circle text-secondary"
                                };

                                <div class="activity-item">
                                    <div class="activity-icon">
                                        <i class="@iconClass"></i>
                                    </div>
                                    <div class="activity-content">
                                        <p class="activity-description">@log.Description</p>
                                        <small class="activity-time">
                                            @((DateTime.UtcNow - log.Timestamp).TotalMinutes < 1 ? "Just now" : 
                                            (DateTime.UtcNow - log.Timestamp).TotalMinutes < 60 ? $"{(int)(DateTime.UtcNow - log.Timestamp).TotalMinutes} min ago" :
                                            (DateTime.UtcNow - log.Timestamp).TotalHours < 24 ? $"{(int)(DateTime.UtcNow - log.Timestamp).TotalHours} hrs ago" :
                                            $"{(int)(DateTime.UtcNow - log.Timestamp).TotalDays} days ago")
                                        </small>
                                    </div>
                                    <div class="activity-badge">
                                        <span class="wp-badge bg-info">@log.ActionType</span>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="view-empty-state">
                                <div class="view-empty-state__icon">
                                    <i class="bi bi-clock-history"></i>
                                </div>
                                <p class="view-empty-state__description">No recent activity found.</p>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Revenue Chart -->
            <div class="view-card">
                <div class="view-card__header">
                    <h6 class="view-card__title">
                        <i class="bi bi-currency-dollar"></i>Revenue Trends
                    </h6>
                </div>
                <div class="view-card__body">
                    <div class="chart-container">
                        <canvas id="revenueChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
</div>

@await Html.PartialAsync("_Notification")

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="~/js/books/ChartsAdmin.js"></script>
}



