@model OnlineBookManagementSystem.Presentation.ViewModels.Books.BookDetailsViewModel

@{
    ViewData["Title"] = $"Book Details: {Model.Title}";
    Layout = ViewData["Layout"]?.ToString() ?? "_LayoutUser";
    int stockValue = Model.StockQuantity;
    var currentRole = ViewContext.HttpContext.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "Guest";
    var isAdminOrHigher = currentRole == "Admin" || currentRole == "SuperAdmin";
    var isUserOrHigher = currentRole == "User" || isAdminOrHigher;
}

<link href="~/css/bookdisplay.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />

<div class="container my-5">
    <div class="book-container">
        <div class="row g-5 align-items-start">
            <!-- Book Cover -->
            <div class="col-lg-4 col-md-5 col-sm-6 col-10 text-center">
                <img src="@(Model.ImageUrl ?? Url.Content("~/images/default-book-improved.svg"))"
                     alt="@Model.Title by @Model.Author (Cover Image)"
                     class="book-cover shadow-sm img-fluid rounded lazyload"
                     loading="lazy"
                     onerror="this.src='~/images/default-book-improved.svg';" />
                @if (isAdminOrHigher)
                {
                    <small class="text-muted d-block mt-2">📁 <a href="@Model.ImageUrl" target="_blank">Download Image</a></small>
                }
            </div>

            <!-- Book Info -->
            <div class="col-lg-5 col-md-7 col-sm-6 col-12">
                <h2 class="book-title mb-3">@Model.Title</h2>
                <p class="book-author text-muted mb-3">by <strong>@Model.Author</strong></p>

                <ul class="list-unstyled">
                    <li class="mb-2"><i class="bi bi-upc-scan me-2 text-primary"></i><strong>ISBN:</strong> @(Model.ISBN ?? "Not Available")</li>
                    <li class="mb-2"><i class="bi bi-currency-rupee me-2 text-success"></i><strong>Price:</strong> <span class="price-tag fs-5 fw-bold">@Model.FormattedPrice</span></li>
                    <li class="mb-2">
                        <i class="bi bi-box-seam me-2 @(stockValue > 0 ? "text-success" : "text-danger")"></i><strong>Stock:</strong>
                        @if (stockValue > 0)
                        {
                            <span class="badge bg-success">@stockValue in stock</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Out of stock</span>
                        }
                    </li>
                    @if (!string.IsNullOrEmpty(Model.CategoryName))
                    {
                        <li class="mb-2"><i class="bi bi-tags me-2 text-info"></i><strong>Category:</strong> @Model.CategoryName</li>
                    }
                </ul>

                <!-- Role-Based Actions -->
                <div class="d-flex gap-2 flex-wrap mt-4">
                    @if (isUserOrHigher && stockValue > 0)
                    {
                        <button onclick="AddToCart(@Model.Id)" class="btn btn-success btn-lg rounded-pill">
                            <i class="bi bi-cart-plus me-2"></i>Add to Cart
                        </button>
                        <button onclick="ToggleFavorite(@Model.Id)" class="btn btn-outline-danger btn-lg rounded-pill">
                            <i class="bi bi-heart @(Model?.IsFavorite == true ? "bi-heart-fill text-danger" : "") me-2"></i>
                            @(Model?.IsFavorite == true ? "Remove from Favorites" : "Add to Favorites")
                        </button>
                    }
                    @if (!isUserOrHigher)
                    {
                        <a asp-controller="Auth" asp-action="Login" class="btn btn-primary btn-lg rounded-pill">
                            <i class="bi bi-box-arrow-in-right me-2"></i>Login to Buy
                        </a>
                    }
                    @if (isAdminOrHigher)
                    {
                        <a asp-controller="Books" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning btn-lg rounded-pill">
                            <i class="bi bi-pencil-square me-2"></i>Edit Book
                        </a>
                        <button onclick="DeleteBook(@Model.Id)" class="btn btn-danger btn-lg rounded-pill">
                            <i class="bi bi-trash me-2"></i>Delete
                        </button>
                    }
                </div>
            </div>

            <!-- Sidebar: Description & Tabs -->
            <div class="col-lg-3 col-md-12">
                <div class="sticky-top" style="top: 1rem;">
                    <div class="card shadow-sm rounded-3">
                        <div class="card-header bg-light border-0">
                            <h5 class="mb-0"><i class="bi bi-book me-2"></i>Quick Info</h5>
                        </div>
                        <ul class="nav nav-tabs nav-fill mb-0" id="infoTabs" role="tablist">
                            <li class="nav-item" role="presentation">
                                <button class="nav-link active" id="overview-tab" data-bs-toggle="tab" data-bs-target="#overview" type="button" role="tab">Overview</button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" id="details-tab" data-bs-toggle="tab" data-bs-target="#details" type="button" role="tab">Details</button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" id="reviews-tab" data-bs-toggle="tab" data-bs-target="#reviews" type="button" role="tab">Reviews</button>
                            </li>
                        </ul>

                        <div class="tab-content p-3 border border-top-0 bg-light rounded-bottom" id="infoTabContent">
                            <div class="tab-pane fade show active" id="overview" role="tabpanel">
                                <p class="mb-2"><strong>Published:</strong> @Model.FormattedCreatedAt</p>
                                <p class="mb-2"><strong>Updated:</strong> @Model.FormattedUpdatedAt</p>
                                <p class="mb-0"><strong>Status:</strong> @Model.DeletedStatus</p>
                            </div>
                            <div class="tab-pane fade" id="details" role="tabpanel">
                                @if (!string.IsNullOrEmpty(Model.Description))
                                {
                                    <p>@Model.Description</p>
                                }
                                else
                                {
                                    <p class="text-muted">No description available yet.</p>
                                }
                            </div>
                            <div class="tab-pane fade" id="reviews" role="tabpanel">
                                <div class="text-center py-4 text-muted">
                                    <i class="bi bi-star-fill fs-1 mb-2 text-warning"></i>
                                    <h6>No reviews yet.</h6>
                                    <p>Be the first to review this book!</p>
                                    @if (isUserOrHigher)
                                    {
                                        <button class="btn btn-outline-warning btn-sm" onclick="AddReview(@Model.Id)">Write Review</button>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@await Html.PartialAsync("_Notification")

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/js/toastr.min.js"></script>
    <script>
        function AddToCart(id) {
            $.post('/Cart/Add', { bookId: id }, function(res) {
                if (res.success) {
                    toastr.success('Added to cart!');
                } else toastr.error('Failed to add.');
            });
        }

        function ToggleFavorite(id) {
            $.post('/Books/ToggleFavorite', { bookId: id }, function(res) {
                if (res.success) {
                    location.reload();  // Refresh to update icon
                } else toastr.error('Failed to update favorite.');
            });
        }

        function DeleteBook(id) {
            if (confirm('Delete this book? This action cannot be undone.')) {
                $.post('/Books/Delete', { id }, function(res) {
                    if (res.success) {
                        toastr.success('Book deleted!');
                        window.location.href = '/Books/AdminIndex';
                    } else toastr.error('Failed to delete.');
                });
            }
        }

        function AddReview(id) {
            // TODO: Open modal/form for review
            toastr.info('Review feature coming soon!');
        }
    </script>
}