@using OnlineBookManagementSystem.Presentation.ViewModels.Books
@model BookFormViewModel

<!-- Basic Information Section -->
<div class="form-section mb-5">
    <div class="section-header mb-4">
        <h5 class="wp-heading-3 d-flex align-items-center">
            <i class="bi bi-book me-2 text-primary"></i>
            Basic Information
        </h5>
        <hr class="wp-divider">
    </div>
    
    <div class="row g-4">
        <div class="col-md-6">
            <div class="form__group">
                <label asp-for="Book.Title" class="form__label">
                    <i class="bi bi-book me-1"></i>Book Title
                </label>
                <input asp-for="Book.Title" class="form__input" placeholder="Enter book title" required />
                <span asp-validation-for="Book.Title" class="form__error"></span>
            </div>
        </div>
        
        <div class="col-md-6">
            <div class="form__group">
                <label asp-for="Book.Author" class="form__label">
                    <i class="bi bi-person me-1"></i>Author Name
                </label>
                <input asp-for="Book.Author" class="form__input" placeholder="Enter author name" required />
                <span asp-validation-for="Book.Author" class="form__error"></span>
            </div>
        </div>
        
        <div class="col-md-4">
            <div class="form__group">
                <label asp-for="Book.ISBN" class="form__label">
                    <i class="bi bi-upc me-1"></i>ISBN
                </label>
                <input asp-for="Book.ISBN" class="form__input" placeholder="978-0-123456-78-9" />
                <span asp-validation-for="Book.ISBN" class="form__error"></span>
            </div>
        </div>
        
        <div class="col-md-4">
            <div class="form__group">
                <label asp-for="Book.Price" class="form__label">
                    <i class="bi bi-currency-rupee me-1"></i>Price (₹)
                </label>
                <input asp-for="Book.Price" type="number" step="0.01" min="0" class="form__input" placeholder="0.00" required />
                <span asp-validation-for="Book.Price" class="form__error"></span>
            </div>
        </div>
        
        <div class="col-md-4">
            <div class="form__group">
                <label asp-for="Book.CategoryId" class="form__label">
                    <i class="bi bi-tags me-1"></i>Category
                </label>
                <select asp-for="Book.CategoryId" asp-items="Model.Categories" class="form__select" required>
                    <option value="">-- Select Category --</option>
                </select>
                <span asp-validation-for="Book.CategoryId" class="form__error"></span>
            </div>
        </div>
    </div>
</div>

<!-- Inventory Management Section -->
<div class="form-section mb-5">
    <div class="section-header mb-4">
        <h5 class="wp-heading-3 d-flex align-items-center">
            <i class="bi bi-boxes me-2 text-success"></i>
            Inventory Management
        </h5>
        <hr class="wp-divider">
    </div>
    
    <div class="row g-4">
        <div class="col-md-6">
            <div class="form__group">
                <label asp-for="Book.StockQuantity" class="form__label">
                    <i class="bi bi-box me-1"></i>Stock Quantity
                </label>
                <input asp-for="Book.StockQuantity" type="number" min="0" class="form__input" placeholder="0" required />
                <span asp-validation-for="Book.StockQuantity" class="form__error"></span>
            </div>
        </div>
        
        <div class="col-md-6">
            <div class="form__group">
                <label asp-for="Book.LowStockThreshold" class="form__label">
                    <i class="bi bi-exclamation-triangle me-1"></i>Low Stock Alert Threshold
                </label>
                <input asp-for="Book.LowStockThreshold" type="number" min="0" class="form__input" value="5" placeholder="5" />
                <span asp-validation-for="Book.LowStockThreshold" class="form__error"></span>
                <small class="form__help">Alert when stock falls below this number</small>
            </div>
        </div>
    </div>
</div>

<!-- Media & Description Section -->
<div class="form-section mb-5">
    <div class="section-header mb-4">
        <h5 class="wp-heading-3 d-flex align-items-center">
            <i class="bi bi-image me-2 text-info"></i>
            Media &amp; Description
        </h5>
        <hr class="wp-divider">
    </div>
    
    <div class="row g-4">
        <div class="col-md-6">
            <div class="form__group">
                <label asp-for="ImageFile" class="form__label">
                    <i class="bi bi-camera me-1"></i>Book Cover Image
                </label>
                <input asp-for="ImageFile" type="file" accept="image/*" class="form__input" />
                <small class="form__help">
                    <i class="bi bi-info-circle me-1"></i>
                    Recommended: JPG/PNG, Max 5MB, Aspect ratio 2:3
                </small>
            </div>
        </div>
        
        <div class="col-md-6">
            @if (Model.Book?.Id > 0 && !string.IsNullOrEmpty(Model.Book?.ImageUrl))
            {
                <div class="current-image-container">
                    <label class="form__label">
                        <i class="bi bi-image me-1"></i>Current Image
                    </label>
                    <div class="current-image-wrapper">
                        <img src="@Model.Book.ImageUrl" alt="Current book cover" class="wp-book-image current-book-image" style="max-height: 200px;" />
                        <div class="image-overlay">
                            <small class="">Current Cover</small>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="image-preview-container">
                    <div class="image-preview-placeholder">
                        <i class="bi bi-image display-1 text-muted"></i>
                        <p class="text-muted mt-2">Image Preview</p>
                    </div>
                </div>
            }
        </div>
        
        <div class="col-12">
            <div class="form__group">
                <label asp-for="Book.Description" class="form__label">
                    <i class="bi bi-text-paragraph me-1"></i>Book Description
                </label>
                <textarea asp-for="Book.Description" rows="5" class="form__textarea" 
                          placeholder="Enter a detailed description of the book..."></textarea>
                <span asp-validation-for="Book.Description" class="form__error"></span>
            </div>
        </div>
    </div>
</div>
