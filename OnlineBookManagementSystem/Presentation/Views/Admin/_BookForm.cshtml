@using OnlineBookManagementSystem.Presentation.ViewModels.Books
@model BookFormViewModel

<form id="bookForm" enctype="multipart/form-data" class="needs-validation" novalidate>
    @Html.AntiForgeryToken()
    
    @if (Model.Book?.Id > 0)
    {
        <input type="hidden" asp-for="Book.Id" />
    }

    <!-- Basic Information Section -->
    <div class="form-section mb-4">
        <div class="section-header mb-3">
            <h6 class="d-flex align-items-center mb-2">
                <i class="bi bi-book me-2 text-primary"></i>
                Basic Information
            </h6>
            <hr class="wp-divider">
        </div>
        
        <div class="row g-3">
            <div class="col-md-6">
                <div class="wp-form-group">
                    <label asp-for="Book.Title" class="wp-form-label">
                        <i class="bi bi-book me-1"></i>Book Title
                    </label>
                    <input asp-for="Book.Title" class="wp-form-control" placeholder="Enter book title" required />
                    <div class="invalid-feedback"></div>
                </div>
            </div>
            
            <div class="col-md-6">
                <div class="wp-form-group">
                    <label asp-for="Book.Author" class="wp-form-label">
                        <i class="bi bi-person me-1"></i>Author Name
                    </label>
                    <input asp-for="Book.Author" class="wp-form-control" placeholder="Enter author name" required />
                    <div class="invalid-feedback"></div>
                </div>
            </div>
            
            <div class="col-md-4">
                <div class="wp-form-group">
                    <label asp-for="Book.ISBN" class="wp-form-label">
                        <i class="bi bi-upc me-1"></i>ISBN
                    </label>
                    <input asp-for="Book.ISBN" class="wp-form-control" placeholder="978-0-123456-78-9" />
                    <div class="invalid-feedback"></div>
                </div>
            </div>
            
            <div class="col-md-4">
                <div class="wp-form-group">
                    <label asp-for="Book.Price" class="wp-form-label">
                        <i class="bi bi-currency-rupee me-1"></i>Price (₹)
                    </label>
                    <input asp-for="Book.Price" type="number" step="0.01" min="0" class="wp-form-control" placeholder="0.00" required />
                    <div class="invalid-feedback"></div>
                </div>
            </div>
            
            <div class="col-md-4">
                <div class="wp-form-group">
                    <label asp-for="Book.CategoryId" class="wp-form-label">
                        <i class="bi bi-tags me-1"></i>Category
                    </label>
                    <select asp-for="Book.CategoryId" asp-items="Model.Categories" class="wp-form-control" required>
                        <option value="">-- Select Category --</option>
                    </select>
                    <div class="invalid-feedback"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Inventory Management Section -->
    <div class="form-section mb-4">
        <div class="section-header mb-3">
            <h6 class="d-flex align-items-center mb-2">
                <i class="bi bi-boxes me-2 text-success"></i>
                Inventory Management
            </h6>
            <hr class="wp-divider">
        </div>
        
        <div class="row g-3">
            <div class="col-md-6">
                <div class="wp-form-group">
                    <label asp-for="Book.StockQuantity" class="wp-form-label">
                        <i class="bi bi-box me-1"></i>Stock Quantity
                    </label>
                    <input asp-for="Book.StockQuantity" type="number" min="0" class="wp-form-control" placeholder="0" required />
                    <div class="invalid-feedback"></div>
                </div>
            </div>
            
            <div class="col-md-6">
                <div class="wp-form-group">
                    <label asp-for="Book.LowStockThreshold" class="wp-form-label">
                        <i class="bi bi-exclamation-triangle me-1"></i>Low Stock Alert Threshold
                    </label>
                    <input asp-for="Book.LowStockThreshold" type="number" min="0" class="wp-form-control" value="5" placeholder="5" />
                    <div class="invalid-feedback"></div>
                    <small class="text-muted">Alert when stock falls below this number</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Media & Description Section -->
    <div class="form-section mb-4">
        <div class="section-header mb-3">
            <h6 class="d-flex align-items-center mb-2">
                <i class="bi bi-image me-2 text-info"></i>
                Media & Description
            </h6>
            <hr class="wp-divider">
        </div>
        
        <div class="row g-3">
            <div class="col-md-6">
                <div class="wp-form-group">
                    <label for="imageFile" class="wp-form-label">
                        <i class="bi bi-camera me-1"></i>Book Cover Image
                    </label>
                    <input name="imageFile" type="file" accept="image/*" class="wp-form-control" />
                    <small class="text-muted">
                        <i class="bi bi-info-circle me-1"></i>
                        Recommended: JPG/PNG, Max 5MB, Aspect ratio 2:3
                    </small>
                </div>
            </div>
            
            <div class="col-md-6">
                <div class="image-preview-container">
                    <div class="image-preview-placeholder">
                        @if (!string.IsNullOrEmpty(Model.Book?.ImageUrl))
                        {
                            <img src="@Model.Book.ImageUrl" class="wp-book-image" alt="Current Image" style="max-height: 150px;" />
                        }
                        else
                        {
                            <i class="bi bi-image display-4 text-muted"></i>
                            <p class="text-muted mt-2 small">Image Preview</p>
                        }
                    </div>
                </div>
            </div>
            
            <div class="col-12">
                <div class="wp-form-group">
                    <label asp-for="Book.Description" class="wp-form-label">
                        <i class="bi bi-text-paragraph me-1"></i>Book Description
                    </label>
                    <textarea asp-for="Book.Description" rows="4" class="wp-form-control" 
                              placeholder="Enter a detailed description of the book..."></textarea>
                    <div class="invalid-feedback"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Action Buttons -->
    <div class="form-actions d-flex justify-content-end gap-2 pt-3 border-top">
        <button type="button" class="wp-btn-secondary" data-bs-dismiss="modal">
            <i class="bi bi-x-circle me-2"></i>Cancel
        </button>
        <button type="submit" id="submit-btn" class="wp-btn-primary">
            <i class="bi bi-@(Model.Book?.Id > 0 ? "check-circle" : "plus-circle") me-2"></i>
            @(Model.Book?.Id > 0 ? "Update Book" : "Create Book")
        </button>
    </div>
</form>

<script>
    $(document).ready(function() {
        // Image preview functionality
        $('input[type="file"]').on('change', function(e) {
            const file = e.target.files[0];
            const preview = $('.image-preview-placeholder');
            
            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    preview.html(`<img src="${e.target.result}" class="wp-book-image" alt="Preview" style="max-height: 150px;">`);
                };
                reader.readAsDataURL(file);
            } else {
                preview.html(`
                    <i class="bi bi-image display-4 text-muted"></i>
                    <p class="text-muted mt-2 small">Image Preview</p>
                `);
            }
        });

        // Form validation enhancement
        $('#bookForm').on('submit', function(e) {
            if (!this.checkValidity()) {
                e.preventDefault();
                e.stopPropagation();
            }
            $(this).addClass('was-validated');
        });
    });
</script>



