@using OnlineBookManagementSystem.Presentation.ViewModels.Books
@model BookListViewModel

<!-- Books Grid -->
<div class="row g-4 mb-4" id="books-list">
    @if (Model.Books.Any())
    {
        @foreach (var book in Model.Books)
        {
            <div class="col-xl-3 col-lg-4 col-md-6 col-12">
                <div class="wp-card book-card spotlight-card hover-lift h-100">
                    <div class="book-card-header position-relative">
                        <!-- Book Actions Dropdown -->
                        <div class="book-actions">
                            <button class="btn btn-sm btn-light rounded-circle magnetic-btn" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-three-dots-vertical"></i>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow">
                                <li>
                                    <a class="dropdown-item" asp-action="Details" asp-route-id="@book.Id">
                                        <i class="bi bi-eye me-2"></i>View Details
                                    </a>
                                </li>
                                <li>
                                    <button class="dropdown-item edit-book-btn" data-book-id="@book.Id">
                                        <i class="bi bi-pencil me-2"></i>Edit Book
                                    </button>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <button class="dropdown-item text-danger delete-book-btn" data-book-id="@book.Id">
                                        <i class="bi bi-trash me-2"></i>Delete Book
                                    </button>
                                </li>
                            </ul>
                        </div>
                        
                        <!-- Stock Status Badge -->
                        @if (book.StockQuantity <= 0)
                        {
                            <div class="stock-badge out-of-stock">
                                <i class="bi bi-x-circle me-1"></i>Out of Stock
                            </div>
                        }
                        else if (book.StockQuantity <= 5)
                        {
                            <div class="stock-badge low-stock">
                                <i class="bi bi-exclamation-triangle me-1"></i>Low Stock
                            </div>
                        }
                        
                        <!-- Book Image -->
                        <div class="book-image-container">
                            <img src="@(book.ImageUrl ?? Url.Content("~/images/default-book-improved.svg"))" 
                                 alt="@book.Title" class="wp-book-image book-cover" />
                        </div>
                    </div>
                    
                    <div class="wp-card-body">
                        <h6 class="book-title mb-2">@book.Title</h6>
                        <p class="book-author text-muted mb-2">
                            <i class="bi bi-person me-1"></i>@book.Author
                        </p>
                        
                        <div class="book-details mb-3">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="book-price">₹@book.Price.Amount.ToString("N2")</span>
                                <span class="stock-info">
                                    <i class="bi bi-box me-1"></i>@book.StockQuantity units
                                </span>
                            </div>
                            
                            @if (!string.IsNullOrEmpty(book.Category?.Name))
                            {
                                <div class="book-category">
                                    <span class="wp-badge wp-badge-info">
                                        <i class="bi bi-tag me-1"></i>@book.Category.Name
                                    </span>
                                </div>
                            }
                        </div>
                        
                        <div class="book-actions-footer d-flex gap-2">
                            <a asp-action="Details" asp-route-id="@book.Id" class="wp-btn wp-btn-primary magnetic-btn flex-fill">
                                <i class="bi bi-eye me-1"></i>View
                            </a>
                            <button class="wp-btn wp-btn-secondary magnetic-btn edit-book-btn" data-book-id="@book.Id">
                                <i class="bi bi-pencil"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12">
            <div class="wp-card text-center py-5">
                <div class="wp-card-body">
                    <i class="bi bi-book display-1 text-muted mb-3"></i>
                    <h5>No Books Found</h5>
                    <p class="text-muted mb-4">No books match your current filters. Try adjusting your search criteria.</p>
                    <button class="wp-btn wp-btn-primary create-book-btn">
                        <i class="bi bi-plus-circle me-2"></i>Add Your First Book
                    </button>
                </div>
            </div>
        </div>
    }
</div>

<!-- Pagination -->
@if (Model.TotalPages > 1)
{
    <div class="wp-card pagination-container">
        <div class="wp-card-body">
            <nav aria-label="Book pagination">
                <ul class="pagination justify-content-center mb-0">
                    <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                        <a class="page-link" href="#" data-page="@(Model.CurrentPage - 1)">
                            <i class="bi bi-chevron-left"></i> Previous
                        </a>
                    </li>
                    
                    @for (int i = Math.Max(1, Model.CurrentPage - 2); i <= Math.Min(Model.TotalPages, Model.CurrentPage + 2); i++)
                    {
                        <li class="page-item @(Model.CurrentPage == i ? "active" : "")">
                            <a class="page-link" href="#" data-page="@i">@i</a>
                        </li>
                    }
                    
                    <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                        <a class="page-link" href="#" data-page="@(Model.CurrentPage + 1)">
                            Next <i class="bi bi-chevron-right"></i>
                        </a>
                    </li>
                </ul>
            </nav>
            
            <!-- Results Info -->
            <div class="text-center mt-3">
                <small class="text-muted">
                    Showing @((Model.CurrentPage - 1) * 12 + 1) to @(Math.Min(Model.CurrentPage * 12, Model.TotalBooks)) 
                    of @Model.TotalBooks books
                </small>
            </div>
        </div>
    </div>
}