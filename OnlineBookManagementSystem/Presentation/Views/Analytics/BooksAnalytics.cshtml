@model OnlineBookManagementSystem.Presentation.ViewModels.Analytics.AnalyticsViewModel<OnlineBookManagementSystem.Presentation.ViewModels.Analytics.BooksAnalyticsData>

@{
    ViewData["Title"] = "Books Analytics";
}

<div class="view-analytics-books">
<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">
            <i class="bi bi-book me-2"></i>Books Analytics
        </h2>
        
        @if (Model.Capabilities.CanExport)
        {
            <div class="wp-btn-group">
                <button type="button" class="wp-btn wp-btn-outline-primary" onclick="exportAnalytics('csv')">
                    <i class="bi bi-file-earmark-spreadsheet me-2"></i>Export CSV
                </button>
                <button type="button" class="wp-btn wp-btn-outline-primary" onclick="exportAnalytics('pdf')">
                    <i class="bi bi-file-earmark-pdf me-2"></i>Export PDF
                </button>
            </div>
        }
    </div>

    @if (Model.Capabilities.CanView)
    {
        <!-- Filters -->
        @await Html.PartialAsync("_AnalyticsFilters", Model.Filters)

        <!-- Summary Cards -->
        <div class="row g-4 mb-4">
            <div class="col-lg-3 col-md-6">
                <div class="wp-card bg-primary ">
                    <div class="wp-card-body">
                        <div class="d-flex justify-content-between">
                            <div>
                                <h6 class="wp-card-title">Total Books</h6>
                                <h3 class="mb-0">@Model.Data.TotalBooks.ToString("N0")</h3>
                            </div>
                            <div class="align-self-center">
                                <i class="bi bi-book fs-2"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="col-lg-3 col-md-6">
                <div class="wp-card bg-success ">
                    <div class="wp-card-body">
                        <div class="d-flex justify-content-between">
                            <div>
                                <h6 class="wp-card-title">Active Books</h6>
                                <h3 class="mb-0">@Model.Data.ActiveBooks.ToString("N0")</h3>
                            </div>
                            <div class="align-self-center">
                                <i class="bi bi-check-circle fs-2"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="col-lg-3 col-md-6">
                <div class="wp-card bg-info ">
                    <div class="wp-card-body">
                        <div class="d-flex justify-content-between">
                            <div>
                                <h6 class="wp-card-title">Books This Month</h6>
                                <h3 class="mb-0">@Model.Data.BooksThisMonth.ToString("N0")</h3>
                            </div>
                            <div class="align-self-center">
                                <i class="bi bi-calendar-plus fs-2"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="col-lg-3 col-md-6">
                <div class="wp-card bg-warning ">
                    <div class="wp-card-body">
                        <div class="d-flex justify-content-between">
                            <div>
                                <h6 class="wp-card-title">Categories</h6>
                                <h3 class="mb-0">@Model.Data.TotalCategories.ToString("N0")</h3>
                            </div>
                            <div class="align-self-center">
                                <i class="bi bi-tags fs-2"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Charts Row -->
        <div class="row g-4 mb-4">
            <!-- Monthly Uploads Chart -->
            <div class="col-lg-6">
                @{
                    ViewData["ChartId"] = "monthlyUploadsChart";
                    ViewData["ChartTitle"] = "Monthly Book Uploads";
                    ViewData["ChartType"] = "bar";
                    ViewData["ChartHeight"] = "300";
                    
                    var uploadsChartData = new {
                        labels = Model.Data.MonthlyUploads.Select(u => u.Month).ToArray(),
                        datasets = new[] {
                            new {
                                label = "Books Uploaded",
                                data = Model.Data.MonthlyUploads.Select(u => u.Count).ToArray(),
                                backgroundColor = "rgba(75, 192, 192, 0.6)",
                                borderColor = "rgba(75, 192, 192, 1)",
                                borderWidth = 1
                            }
                        }
                    };
                }
                @await Html.PartialAsync("_AnalyticsChart", uploadsChartData)
            </div>
            
            <!-- Category Distribution -->
            <div class="col-lg-6">
                @{
                    ViewData["ChartId"] = "categoryChart";
                    ViewData["ChartTitle"] = "Books by Category";
                    ViewData["ChartType"] = "pie";
                    ViewData["ChartHeight"] = "300";
                    
                    var categoryChartData = new {
                        labels = Model.Data.CategoryDistribution.Select(c => c.CategoryName).ToArray(),
                        datasets = new[] {
                            new {
                                data = Model.Data.CategoryDistribution.Select(c => c.Count).ToArray(),
                                backgroundColor = new[] {
                                    "#FF6384", "#36A2EB", "#FFCE56", "#4BC0C0", "#9966FF",
                                    "#FF9F40", "#FF6384", "#C9CBCF", "#4BC0C0", "#FF6384"
                                }
                            }
                        }
                    };
                }
                @await Html.PartialAsync("_AnalyticsChart", categoryChartData)
            </div>
        </div>

        <!-- Author Distribution and Favorites -->
        <div class="row g-4 mb-4">
            <div class="col-lg-8">
                @{
                    ViewData["ChartId"] = "authorChart";
                    ViewData["ChartTitle"] = "Top Authors by Book Count";
                    ViewData["ChartType"] = "horizontalBar";
                    ViewData["ChartHeight"] = "300";
                    
                    var authorChartData = new {
                        labels = Model.Data.AuthorDistribution.Take(10).Select(a => a.AuthorName).ToArray(),
                        datasets = new[] {
                            new {
                                label = "Books",
                                data = Model.Data.AuthorDistribution.Take(10).Select(a => a.Count).ToArray(),
                                backgroundColor = "rgba(153, 102, 255, 0.6)",
                                borderColor = "rgba(153, 102, 255, 1)",
                                borderWidth = 1
                            }
                        }
                    };
                }
                @await Html.PartialAsync("_AnalyticsChart", authorChartData)
            </div>
            
            <div class="col-lg-4">
                @{
                    ViewData["ChartId"] = "favoritesChart";
                    ViewData["ChartTitle"] = "Favorite vs Non-Favorite Books";
                    ViewData["ChartType"] = "doughnut";
                    ViewData["ChartHeight"] = "300";
                    
                    var favoritesChartData = new {
                        labels = new[] { "Favorited", "Not Favorited" },
                        datasets = new[] {
                            new {
                                data = new[] { Model.Data.FavoriteStats.FavoriteCount, Model.Data.FavoriteStats.NonFavoriteCount },
                                backgroundColor = new[] { "#28a745", "#6c757d" }
                            }
                        }
                    };
                }
                @await Html.PartialAsync("_AnalyticsChart", favoritesChartData)
            </div>
        </div>

        <!-- Popular Books Tables -->
        <div class="row g-4">
            <div class="col-lg-6">
                <div class="wp-card">
                    <div class="wp-card-header">
                        <h5 class="wp-card-title mb-0">
                            <i class="bi bi-star me-2"></i>Most Popular Books
                        </h5>
                    </div>
                    <div class="wp-card-body">
                        <div class="table-responsive">
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Title</th>
                                        <th>Author</th>
                                        <th>Views</th>
                                        <th>Orders</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var book in Model.Data.MostPopularBooks.Take(5))
                                    {
                                        <tr>
                                            <td>@book.Title</td>
                                            <td>@book.Author</td>
                                            <td>@book.ViewCount</td>
                                            <td>@book.OrderCount</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="col-lg-6">
                <div class="wp-card">
                    <div class="wp-card-header">
                        <h5 class="wp-card-title mb-0">
                            <i class="bi bi-heart me-2"></i>Most Favorited Books
                        </h5>
                    </div>
                    <div class="wp-card-body">
                        <div class="table-responsive">
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Title</th>
                                        <th>Author</th>
                                        <th>Favorites</th>
                                        <th>Rating</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var book in Model.Data.MostFavoritedBooks.Take(5))
                                    {
                                        <tr>
                                            <td>@book.Title</td>
                                            <td>@book.Author</td>
                                            <td>@book.FavoriteCount</td>
                                            <td>@book.AverageRating.ToString("F1")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-warning">
            <i class="bi bi-exclamation-triangle me-2"></i>
            You don't have permission to view analytics data.
        </div>
    }
</div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        function exportAnalytics(format) {
            const url = '@Url.Action("ExportBooksAnalytics", "Analytics")';
            const params = new URLSearchParams(window.location.search);
            params.append('format', format);
            
            window.open(`${url}?${params.toString()}`, '_blank');
        }
    </script>
}


