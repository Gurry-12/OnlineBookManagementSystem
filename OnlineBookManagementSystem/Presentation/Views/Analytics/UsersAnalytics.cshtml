@model OnlineBookManagementSystem.Presentation.ViewModels.Analytics.AnalyticsViewModel<OnlineBookManagementSystem.Presentation.ViewModels.Analytics.UsersAnalyticsData>

@{
    ViewData["Title"] = "Users Analytics";
}

<div class="view-analytics-users">
<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-danger">
            <i class="bi bi-people me-2"></i>Users Analytics
            <span class="wp-badge bg-danger ms-2">Sensitive Data</span>
        </h2>
        
        @if (Model.Capabilities.CanExport)
        {
            <div class="wp-btn-group">
                <button type="button" class="wp-btn wp-btn-outline-danger" onclick="exportAnalytics('csv')">
                    <i class="bi bi-file-earmark-spreadsheet me-2"></i>Export CSV
                </button>
                <button type="button" class="wp-btn wp-btn-outline-danger" onclick="exportAnalytics('pdf')">
                    <i class="bi bi-file-earmark-pdf me-2"></i>Export PDF
                </button>
            </div>
        }
    </div>

    @if (Model.Capabilities.CanView && Model.Capabilities.CanViewSensitiveMetrics)
    {
        <!-- Filters -->
        @await Html.PartialAsync("_AnalyticsFilters", Model.Filters)

        <!-- Summary Cards -->
        <div class="row g-4 mb-4">
            <div class="col-lg-3 col-md-6">
                <div class="wp-card bg-danger ">
                    <div class="wp-card-body">
                        <div class="d-flex justify-content-between">
                            <div>
                                <h6 class="wp-card-title">Total Users</h6>
                                <h3 class="mb-0">@Model.Data.TotalUsers.ToString("N0")</h3>
                            </div>
                            <div class="align-self-center">
                                <i class="bi bi-people fs-2"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="col-lg-3 col-md-6">
                <div class="wp-card bg-success ">
                    <div class="wp-card-body">
                        <div class="d-flex justify-content-between">
                            <div>
                                <h6 class="wp-card-title">Active Users</h6>
                                <h3 class="mb-0">@Model.Data.ActiveUsers.ToString("N0")</h3>
                            </div>
                            <div class="align-self-center">
                                <i class="bi bi-person-check fs-2"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="col-lg-3 col-md-6">
                <div class="wp-card bg-info ">
                    <div class="wp-card-body">
                        <div class="d-flex justify-content-between">
                            <div>
                                <h6 class="wp-card-title">New This Month</h6>
                                <h3 class="mb-0">@Model.Data.NewUsersThisMonth.ToString("N0")</h3>
                            </div>
                            <div class="align-self-center">
                                <i class="bi bi-person-plus fs-2"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="col-lg-3 col-md-6">
                <div class="wp-card bg-warning ">
                    <div class="wp-card-body">
                        <div class="d-flex justify-content-between">
                            <div>
                                <h6 class="wp-card-title">Inactive Users</h6>
                                <h3 class="mb-0">@Model.Data.InactiveUsers.ToString("N0")</h3>
                            </div>
                            <div class="align-self-center">
                                <i class="bi bi-person-x fs-2"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Growth Metrics -->
        <div class="row g-4 mb-4">
            <div class="col-md-4">
                <div class="wp-card border-success">
                    <div class="wp-card-body text-center">
                        <h6 class="wp-card-title text-success">User Growth Rate</h6>
                        <h4 class="text-success">@Model.Data.UserGrowthRate.ToString("P1")</h4>
                        <small class="text-muted">vs Previous Period</small>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="wp-card border-info">
                    <div class="wp-card-body text-center">
                        <h6 class="wp-card-title text-info">Activity Rate</h6>
                        <h4 class="text-info">@Model.Data.ActivityRate.ToString("P1")</h4>
                        <small class="text-muted">Active vs Total Users</small>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="wp-card border-warning">
                    <div class="wp-card-body text-center">
                        <h6 class="wp-card-title text-warning">Retention Rate</h6>
                        <h4 class="text-warning">@Model.Data.RetentionRate.ToString("P1")</h4>
                        <small class="text-muted">30-Day Retention</small>
                    </div>
                </div>
            </div>
        </div>

        <!-- Charts Row -->
        <div class="row g-4 mb-4">
            <!-- User Growth Chart -->
            <div class="col-lg-8">
                @{
                    ViewData["ChartId"] = "userGrowthChart";
                    ViewData["ChartTitle"] = "User Growth Over Time";
                    ViewData["ChartType"] = "line";
                    ViewData["ChartHeight"] = "350";
                    
                    var growthChartData = new {
                        labels = Model.Data.UserGrowthData.Select(u => u.Date.ToString("MMM dd")).ToArray(),
                        datasets = new[] {
                            new {
                                label = "Total Users",
                                data = Model.Data.UserGrowthData.Select(u => u.TotalUsers).ToArray(),
                                borderColor = "rgb(220, 53, 69)",
                                backgroundColor = "rgba(220, 53, 69, 0.1)",
                                tension = 0.1
                            },
                            new {
                                label = "Active Users",
                                data = Model.Data.UserGrowthData.Select(u => u.ActiveUsers).ToArray(),
                                borderColor = "rgb(40, 167, 69)",
                                backgroundColor = "rgba(40, 167, 69, 0.1)",
                                tension = 0.1
                            }
                        }
                    };
                }
                @await Html.PartialAsync("_AnalyticsChart", growthChartData)
            </div>
            
            <!-- Role Distribution -->
            <div class="col-lg-4">
                @{
                    ViewData["ChartId"] = "roleChart";
                    ViewData["ChartTitle"] = "User Role Distribution";
                    ViewData["ChartType"] = "doughnut";
                    ViewData["ChartHeight"] = "350";
                    
                    var roleChartData = new {
                        labels = Model.Data.RoleDistribution.Select(r => r.Role).ToArray(),
                        datasets = new[] {
                            new {
                                data = Model.Data.RoleDistribution.Select(r => r.Count).ToArray(),
                                backgroundColor = new[] {
                                    "#007bff", "#28a745", "#dc3545", "#ffc107", "#17a2b8"
                                }
                            }
                        }
                    };
                }
                @await Html.PartialAsync("_AnalyticsChart", roleChartData)
            </div>
        </div>

        <!-- Activity Trends Chart -->
        <div class="row g-4">
            <div class="col-12">
                @{
                    ViewData["ChartId"] = "activityChart";
                    ViewData["ChartTitle"] = "User Activity Trends";
                    ViewData["ChartType"] = "bar";
                    ViewData["ChartHeight"] = "300";
                    
                    var activityChartData = new {
                        labels = Model.Data.ActivityTrends.Select(a => a.Date.ToString("MMM dd")).ToArray(),
                        datasets = new[] {
                            new {
                                label = "Active Users",
                                data = Model.Data.ActivityTrends.Select(a => a.ActiveUsers).ToArray(),
                                backgroundColor = "rgba(40, 167, 69, 0.6)",
                                borderColor = "rgba(40, 167, 69, 1)",
                                borderWidth = 1
                            },
                            new {
                                label = "Logins",
                                data = Model.Data.ActivityTrends.Select(a => a.LoginCount).ToArray(),
                                backgroundColor = "rgba(23, 162, 184, 0.6)",
                                borderColor = "rgba(23, 162, 184, 1)",
                                borderWidth = 1
                            }
                        }
                    };
                }
                @await Html.PartialAsync("_AnalyticsChart", activityChartData)
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-danger">
            <i class="bi bi-shield-exclamation me-2"></i>
            You don't have permission to view sensitive user analytics data. This data is restricted to SuperAdmin users only.
        </div>
    }
</div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        function exportAnalytics(format) {
            const url = '@Url.Action("ExportUsersAnalytics", "Analytics")';
            const params = new URLSearchParams(window.location.search);
            params.append('format', format);
            
            window.open(`${url}?${params.toString()}`, '_blank');
        }
    </script>
}



