@model OnlineBookManagementSystem.Presentation.ViewModels.Analytics.AnalyticsViewModel<OnlineBookManagementSystem.Presentation.ViewModels.Analytics.ReviewsAnalyticsData>

@{
    ViewData["Title"] = "Reviews Analytics";
}

<div class="view-analytics-reviews">
<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">
            <i class="bi bi-chat-square-text me-2"></i>Reviews Analytics
        </h2>
        
        @if (Model.Capabilities.CanExport)
        {
            <div class="btn-group">
                <button type="button" class="btn btn-outline-primary" onclick="exportAnalytics('csv')">
                    <i class="bi bi-file-earmark-spreadsheet me-2"></i>Export CSV
                </button>
                <button type="button" class="btn btn-outline-primary" onclick="exportAnalytics('pdf')">
                    <i class="bi bi-file-earmark-pdf me-2"></i>Export PDF
                </button>
            </div>
        }
    </div>

    @if (Model.Capabilities.CanView)
    {
        <!-- Filters -->
        @await Html.PartialAsync("_AnalyticsFilters", Model.Filters)

        <!-- Summary Cards -->
        <div class="row g-4 mb-4">
            <div class="col-lg-3 col-md-6">
                <div class="card bg-primary text-white">
                    <div class="card-body">
                        <div class="d-flex justify-content-between">
                            <div>
                                <h6 class="card-title">Total Reviews</h6>
                                <h3 class="mb-0">@Model.Data.TotalReviews.ToString("N0")</h3>
                            </div>
                            <div class="align-self-center">
                                <i class="bi bi-chat-square-text fs-2"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="col-lg-3 col-md-6">
                <div class="card bg-warning text-white">
                    <div class="card-body">
                        <div class="d-flex justify-content-between">
                            <div>
                                <h6 class="card-title">Pending Reviews</h6>
                                <h3 class="mb-0">@Model.Data.PendingReviews.ToString("N0")</h3>
                            </div>
                            <div class="align-self-center">
                                <i class="bi bi-clock fs-2"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="col-lg-3 col-md-6">
                <div class="card bg-success text-white">
                    <div class="card-body">
                        <div class="d-flex justify-content-between">
                            <div>
                                <h6 class="card-title">Approved Reviews</h6>
                                <h3 class="mb-0">@Model.Data.ApprovedReviews.ToString("N0")</h3>
                            </div>
                            <div class="align-self-center">
                                <i class="bi bi-check-circle fs-2"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="col-lg-3 col-md-6">
                <div class="card bg-info text-white">
                    <div class="card-body">
                        <div class="d-flex justify-content-between">
                            <div>
                                <h6 class="card-title">Average Rating</h6>
                                <h3 class="mb-0">@Model.Data.AverageRating.ToString("F1")</h3>
                            </div>
                            <div class="align-self-center">
                                <i class="bi bi-star fs-2"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Moderation Metrics -->
        <div class="row g-4 mb-4">
            <div class="col-md-4">
                <div class="card border-success">
                    <div class="card-body text-center">
                        <h6 class="card-title text-success">Approval Rate</h6>
                        <h4 class="text-success">@Model.Data.ApprovalRate.ToString("P1")</h4>
                        <small class="text-muted">Reviews Approved</small>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-danger">
                    <div class="card-body text-center">
                        <h6 class="card-title text-danger">Rejection Rate</h6>
                        <h4 class="text-danger">@Model.Data.RejectionRate.ToString("P1")</h4>
                        <small class="text-muted">Reviews Rejected</small>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-info">
                    <div class="card-body text-center">
                        <h6 class="card-title text-info">Reviews This Month</h6>
                        <h4 class="text-info">@Model.Data.ReviewsThisMonth.ToString("N0")</h4>
                        <small class="text-muted">New Reviews</small>
                    </div>
                </div>
            </div>
        </div>

        <!-- Charts Row -->
        <div class="row g-4 mb-4">
            <!-- Review Trends Chart -->
            <div class="col-lg-8">
                @{
                    ViewData["ChartId"] = "reviewTrendsChart";
                    ViewData["ChartTitle"] = "Review Trends Over Time";
                    ViewData["ChartType"] = "line";
                    ViewData["ChartHeight"] = "350";
                    
                    var trendsChartData = new {
                        labels = Model.Data.ReviewTrends.Select(r => r.Date.ToString("MMM dd")).ToArray(),
                        datasets = new object[] {
                            new {
                                label = "Total Reviews",
                                data = Model.Data.ReviewTrends.Select(r => r.ReviewCount).ToArray(),
                                borderColor = "rgb(54, 162, 235)",
                                backgroundColor = "rgba(54, 162, 235, 0.1)",
                                tension = 0.1
                            },
                            new {
                                label = "Average Rating",
                                data = Model.Data.ReviewTrends.Select(r => r.AverageRating).ToArray(),
                                borderColor = "rgb(255, 206, 86)",
                                backgroundColor = "rgba(255, 206, 86, 0.1)",
                                tension = 0.1,
                                yAxisID = "y1"
                            }
                        }
                    };
                }
                @await Html.PartialAsync("_AnalyticsChart", trendsChartData)
            </div>
            
            <!-- Rating Distribution -->
            <div class="col-lg-4">
                @{
                    ViewData["ChartId"] = "ratingChart";
                    ViewData["ChartTitle"] = "Rating Distribution";
                    ViewData["ChartType"] = "bar";
                    ViewData["ChartHeight"] = "350";
                    
                    var ratingChartData = new {
                        labels = Model.Data.RatingDistribution.Select(r => $"{r.Rating} Star").ToArray(),
                        datasets = new[] {
                            new {
                                label = "Reviews",
                                data = Model.Data.RatingDistribution.Select(r => r.Count).ToArray(),
                                backgroundColor = new[] {
                                    "#dc3545", "#fd7e14", "#ffc107", "#20c997", "#28a745"
                                }
                            }
                        }
                    };
                }
                @await Html.PartialAsync("_AnalyticsChart", ratingChartData)
            </div>
        </div>

        <!-- Moderation Activity Chart -->
        <div class="row g-4">
            <div class="col-12">
                @{
                    ViewData["ChartId"] = "moderationChart";
                    ViewData["ChartTitle"] = "Review Moderation Activity";
                    ViewData["ChartType"] = "bar";
                    ViewData["ChartHeight"] = "300";
                    
                    var moderationChartData = new {
                        labels = Model.Data.ModerationStats.Select(m => m.Date.ToString("MMM dd")).ToArray(),
                        datasets = new[] {
                            new {
                                label = "Approved",
                                data = Model.Data.ModerationStats.Select(m => m.ApprovedCount).ToArray(),
                                backgroundColor = "rgba(40, 167, 69, 0.6)",
                                borderColor = "rgba(40, 167, 69, 1)",
                                borderWidth = 1
                            },
                            new {
                                label = "Rejected",
                                data = Model.Data.ModerationStats.Select(m => m.RejectedCount).ToArray(),
                                backgroundColor = "rgba(220, 53, 69, 0.6)",
                                borderColor = "rgba(220, 53, 69, 1)",
                                borderWidth = 1
                            },
                            new {
                                label = "Pending",
                                data = Model.Data.ModerationStats.Select(m => m.PendingCount).ToArray(),
                                backgroundColor = "rgba(255, 193, 7, 0.6)",
                                borderColor = "rgba(255, 193, 7, 1)",
                                borderWidth = 1
                            }
                        }
                    };
                }
                @await Html.PartialAsync("_AnalyticsChart", moderationChartData)
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-warning">
            <i class="bi bi-exclamation-triangle me-2"></i>
            You don't have permission to view analytics data.
        </div>
    }
</div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        function exportAnalytics(format) {
            const url = '@Url.Action("ExportReviewsAnalytics", "Analytics")';
            const params = new URLSearchParams(window.location.search);
            params.append('format', format);
            
            window.open(`${url}?${params.toString()}`, '_blank');
        }
    </script>
}