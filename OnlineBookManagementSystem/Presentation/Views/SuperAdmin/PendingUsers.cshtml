@using OnlineBookManagementSystem.Presentation.ViewModels.SuperAdmin
@model List<UserWithRoleViewModel>
@{
    ViewData["Title"] = "Pending User Requests";
    Layout = "/Presentation/Views/Shared/_LayoutSuperAdmin.cshtml";
}

<div class="view-content">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0 fw-bold" style="color: var(--text-color);">
            <i class="bi bi-person-plus text-primary me-2"></i>Pending User Requests
        </h2>
    </div>

    <div class="view-card mb-4">
        <div class="view-card__header">
            <h5 class="view-card__title"><i class="bi bi-person-exclamation me-1"></i>Requests Awaiting Approval</h5>
        </div>
        <div class="view-card__body">
            @if (!Model.Any())
            {
                <div class="alert alert-info">
                    No pending user requests found.
                </div>
            }
            else
            {
                <div class="table-wrapper">
                    <table class="table table--hover" id="pendingUsersTable">
                        <thead class="table__header">
                            <tr class="table__row">
                                <th class="table__header-cell">Name</th>
                                <th class="table__header-cell">Email</th>
                                <th class="table__header-cell">Requested Role</th>
                                <th class="table__header-cell">Date Requested</th>
                                <th class="table__header-cell">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="table__body">
                        @foreach (var user in Model)
                        {
                            <tr class="table__row">
                                <td class="table__cell">@user.Name</td>
                                <td class="table__cell">@user.Email</td>
                                <td class="table__cell">
                                    @if(user.Role == "Admin")
                                    {
                                        <span class="wp-badge bg-warning text-dark">Retailer (Admin)</span>
                                    }
                                    else
                                    {
                                        <span class="wp-badge text-white bg-primary">User</span>
                                    }
                                </td>
                                <td class="table__cell">@user.CreatedDate.ToString("g")</td>
                                <td class="table__cell">
                                    <div class="table__actions" role="group">
                                        <button type="button" class="wp-btn wp-btn-success  approve-btn"
                                                data-id="@user.Id"
                                                data-role="@user.Role"
                                                data-name="@user.Name">
                                            <i class="bi bi-check-circle"></i> Approve
                                        </button>
                                        <button type="button" class="wp-btn wp-btn-danger  reject-btn"
                                                data-id="@user.Id"
                                                data-name="@user.Name">
                                            <i class="bi bi-x-circle"></i> Reject
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                </div>
            }
        </div>
    </div>
</div>

<!-- Approve Modal -->
<div class="modal fade" id="approveModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Approve User</h5>
                <button type="button" class="wp-btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Approve registration request for <strong id="approveUserName"></strong>?</p>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label">Requested role</label>
                        <input type="text" id="requestedRoleDisplay" class="form-control-plaintext fw-bold text-primary" readonly>
                    </div>
                    <div class="col-md-6">
                        <label for="assignRole" class="form-label">Grant role</label>
                        <select id="assignRole" class="form-select">
                            <option value="User">Regular User</option>
                            <option value="Admin">Retailer (Admin)</option>
                            <option value="SuperAdmin">Super Administrator</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="wp-btn wp-btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="wp-btn wp-btn-success" id="confirmApprove">Approve</button>
            </div>
        </div>
    </div>
</div>

<!-- Reject Modal -->
<div class="modal fade" id="rejectModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Reject User</h5>
                <button type="button" class="wp-btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to reject <strong id="rejectUserName"></strong>?</p>
                <p class="text-danger small">This will effectively delete the request.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="wp-btn wp-btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="wp-btn wp-btn-danger" id="confirmReject">Reject</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <script>
        $(document).ready(function () {
            // ── Global variables ───────────────────────────────────────
            let selectedUserId = null;
            const antiForgeryToken = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

            // ── Helper: Show/hide loading state ────────────────────────
            function setButtonLoading($button, isLoading, originalText) {
                if (isLoading) {
                    $button
                        .prop('disabled', true)
                        .html(`<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>${originalText}`);
                } else {
                    $button
                        .prop('disabled', false)
                        .html(originalText);
                }
            }

            // ── Approve flow ───────────────────────────────────────────
            $('.approve-btn').on('click', function () {
                selectedUserId = $(this).data('id');
                const name = $(this).data('name');
                const requestedRole = $(this).data('role');

                $('#approveUserName').text(name);
                $('#requestedRoleDisplay').text(requestedRole);
                $('#assignRole').val(requestedRole); // Pre-select requested role

                $('#approveModal').modal('show');
            });

            $('#confirmApprove').on('click', function () {
                if (!selectedUserId) return;

                const $btn = $(this);
                const originalText = $btn.html();
                const assignedRole = $('#assignRole').val();

                setButtonLoading($btn, true, 'Approving...');

                $.ajax({
                    url: '@Url.Action("ApproveUser", "SuperAdmin")',
                    type: 'POST',
                    data: {
                        userId: selectedUserId,
                        role: assignedRole,
                        __RequestVerificationToken: antiForgeryToken
                    },
                    success: function (response) {
                        if (response.success) {
                            toastr.success(response.message || 'User approved successfully');
                            setTimeout(() => location.reload(), 1200);
                        } else {
                            toastr.warning(response.message || 'Operation completed with warning');
                        }
                    },
                    error: function (xhr) {
                        const msg = xhr.responseJSON?.message || 'An unexpected error occurred during approval.';
                        toastr.error(msg);
                    },
                    complete: function () {
                        setButtonLoading($btn, false, originalText);
                        $('#approveModal').modal('hide');
                        selectedUserId = null;
                    }
                });
            });

            // ── Reject flow ────────────────────────────────────────────
            $('.reject-btn').on('click', function () {
                selectedUserId = $(this).data('id');
                const name = $(this).data('name');

                $('#rejectUserName').text(name);
                $('#rejectModal').modal('show');
            });

            $('#confirmReject').on('click', function () {
                if (!selectedUserId) return;

                const $btn = $(this);
                const originalText = $btn.html();

                setButtonLoading($btn, true, 'Rejecting...');

                $.ajax({
                    url: '@Url.Action("RejectUser", "SuperAdmin")',
                    type: 'POST',
                    data: {
                        userId: selectedUserId,
                        __RequestVerificationToken: antiForgeryToken
                    },
                    success: function (response) {
                        if (response.success) {
                            toastr.success(response.message || 'Request rejected successfully');
                            setTimeout(() => location.reload(), 1200);
                        } else {
                            toastr.warning(response.message || 'Operation completed with warning');
                        }
                    },
                    error: function (xhr) {
                        const msg = xhr.responseJSON?.message || 'An unexpected error occurred during rejection.';
                        toastr.error(msg);
                    },
                    complete: function () {
                        setButtonLoading($btn, false, originalText);
                        $('#rejectModal').modal('hide');
                        selectedUserId = null;
                    }
                });
            });
        });
    </script>
}




