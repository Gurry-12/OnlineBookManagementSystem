@{
    ViewData["Title"] = "System Health";
    Layout = "/Presentation/Views/Shared/_LayoutSuperAdmin.cshtml";
}

<div class="view-content">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0 fw-bold" style="color: var(--text-color);">
            <i class="bi bi-heart-pulse-fill text-success me-2"></i>System Health Monitor
        </h2>
        <button id="refreshBtn" class="wp-btn wp-btn-outline-primary  magnetic-btn">
            <i class="bi bi-arrow-clockwise"></i> Refresh
        </button>
    </div>

    <!-- System Status Cards -->
    <div class="stats-row mb-4">
        <div class="stats-card stats-card--success">
            <div class="stats-card__body text-center">
                <div class="stats-card__icon"><i class="bi bi-server"></i></div>
                <h3 class="stats-card__number" id="systemStatus">Loading...</h3>
                <p class="stats-card__label">System Status</p>
            </div>
        </div>
        <div class="stats-card stats-card--info">
            <div class="stats-card__body text-center">
                <div class="stats-card__icon"><i class="bi bi-database"></i></div>
                <h3 class="stats-card__number" id="dbStatus">Loading...</h3>
                <p class="stats-card__label">Database</p>
            </div>
        </div>
        <div class="stats-card stats-card--warning">
            <div class="stats-card__body text-center">
                <div class="stats-card__icon"><i class="bi bi-memory"></i></div>
                <h3 class="stats-card__number" id="memoryUsage">Loading...</h3>
                <p class="stats-card__label">Memory (MB)</p>
            </div>
        </div>
        <div class="stats-card stats-card--primary">
            <div class="stats-card__body text-center">
                <div class="stats-card__icon"><i class="bi bi-people"></i></div>
                <h3 class="stats-card__number" id="activeUsers">Loading...</h3>
                <p class="stats-card__label">Active Users (24h)</p>
            </div>
        </div>
    </div>

    <!-- Detailed Information -->
    <div class="view-section mb-4">
        <div class="view-grid view-grid--2-cols">
            <div class="view-card">
                <div class="view-card__header">
                    <h5 class="view-card__title"><i class="bi bi-database text-info me-2"></i>Database Information</h5>
                </div>
                <div class="view-card__body">
                    <div id="databaseInfo">
                        <div class="text-center">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="view-card">
                <div class="view-card__header">
                    <h5 class="view-card__title"><i class="bi bi-cpu text-warning me-2"></i>System Information</h5>
                </div>
                <div class="view-card__body">
                    <div id="systemInfo">
                        <div class="text-center">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Uptime Information -->
    <div class="view-section mb-4">
        <div class="view-card">
            <div class="view-card__header">
                <h5 class="view-card__title"><i class="bi bi-clock-history text-success me-2"></i>System Uptime</h5>
            </div>
            <div class="view-card__body">
                <div id="uptimeInfo">
                    <div class="text-center">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            loadSystemHealth();
            
            // Auto-refresh every 30 seconds
            setInterval(loadSystemHealth, 30000);
            
            $('#refreshBtn').click(function() {
                loadSystemHealth();
            });
        });

        function loadSystemHealth() {
            $.get('/api/Health/status')
                .done(function(data) {
                    updateHealthDisplay(data);
                })
                .fail(function(xhr) {
                    console.error('Failed to load system health:', xhr);
                    showError('Failed to load system health information');
                });
        }

        function updateHealthDisplay(data) {
            // Update status cards
            $('#systemStatus').text(data.status);
            $('#dbStatus').text(data.database.status);
            $('#memoryUsage').text(data.memory.workingSetMB);
            $('#activeUsers').text(data.activeUsers);

            // Update database info
            const dbHtml = `
                <div class="row">
                    <div class="col-6"><strong>Connection:</strong></div>
                    <div class="col-6">${data.database.connected ? 'Connected' : 'Disconnected'}</div>
                </div>
                <div class="row">
                    <div class="col-6"><strong>Users:</strong></div>
                    <div class="col-6">${data.database.userCount}</div>
                </div>
                <div class="row">
                    <div class="col-6"><strong>Books:</strong></div>
                    <div class="col-6">${data.database.bookCount}</div>
                </div>
            `;
            $('#databaseInfo').html(dbHtml);

            // Update system info
            const sysHtml = `
                <div class="row">
                    <div class="col-6"><strong>Machine:</strong></div>
                    <div class="col-6">${data.systemLoad.machineName}</div>
                </div>
                <div class="row">
                    <div class="col-6"><strong>OS:</strong></div>
                    <div class="col-6">${data.systemLoad.osVersion}</div>
                </div>
                <div class="row">
                    <div class="col-6"><strong>Processors:</strong></div>
                    <div class="col-6">${data.systemLoad.processorCount}</div>
                </div>
                <div class="row">
                    <div class="col-6"><strong>Architecture:</strong></div>
                    <div class="col-6">${data.systemLoad.is64BitOS ? '64-bit' : '32-bit'}</div>
                </div>
            `;
            $('#systemInfo').html(sysHtml);

            // Update uptime info
            const uptimeHtml = `
                <div class="row">
                    <div class="col-md-3 text-center">
                        <h3 class="text-primary">${data.uptime.days}</h3>
                        <p class="mb-0">Days</p>
                    </div>
                    <div class="col-md-3 text-center">
                        <h3 class="text-primary">${data.uptime.hours}</h3>
                        <p class="mb-0">Hours</p>
                    </div>
                    <div class="col-md-3 text-center">
                        <h3 class="text-primary">${data.uptime.minutes}</h3>
                        <p class="mb-0">Minutes</p>
                    </div>
                    <div class="col-md-3 text-center">
                        <h3 class="text-success">${data.uptime.totalMinutes}</h3>
                        <p class="mb-0">Total Minutes</p>
                    </div>
                </div>
            `;
            $('#uptimeInfo').html(uptimeHtml);
        }

        function showError(message) {
            $('#systemStatus').text('Error');
            $('#dbStatus').text('Error');
            $('#memoryUsage').text('N/A');
            $('#activeUsers').text('N/A');
            
            $('#databaseInfo').html(`<div class="alert alert-danger">${message}</div>`);
            $('#systemInfo').html(`<div class="alert alert-danger">${message}</div>`);
            $('#uptimeInfo').html(`<div class="alert alert-danger">${message}</div>`);
        }
    </script>
}




