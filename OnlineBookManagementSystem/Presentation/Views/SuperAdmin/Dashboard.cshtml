@model OnlineBookManagementSystem.Presentation.ViewModels.SuperAdmin.SuperAdminDashboardViewModel
@{
    ViewData["Title"] = "Super Admin Dashboard - Whispering Pages";
    Layout = "/Presentation/Views/Shared/_LayoutSuperAdmin.cshtml";
}

<div class="dashboard-grid dashboard-grid--superadmin">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0 fw-bold" style="color: var(--text-color);">
            <i class="bi bi-crown me-2" style="color: var(--color-danger);"></i>Super Admin Dashboard
        </h2>
        <div class="d-flex gap-2">
            <span class="wp-badge bg-@(Model.SystemInfo.Environment == "Production" ? "success" : "warning") fs-6">
                @Model.SystemInfo.Environment
            </span>
            @if (Model.SystemInfo.MaintenanceMode)
            {
                <span class="wp-badge bg-danger fs-6">
                    <i class="bi bi-exclamation-triangle"></i> Maintenance Mode
                </span>
            }
        </div>
    </div>

    <!-- System Health Alert -->
    @if (Model.SystemInfo.MaintenanceMode)
    {
        <div class="alert alert-warning alert-dismissible fade show mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            <strong>Maintenance Mode Active:</strong> The system is currently in maintenance mode.
            <button type="button" class="wp-btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Quick Stats Row -->
    <div class="stats-row">
        <div class="stats-card stats-card--danger">
            <div class="stats-card__body">
                <div class="stats-card__icon">
                    <i class="bi bi-people"></i>
                </div>
                <h3 class="stats-card__number">@Model.TotalUsers.ToString("N0")</h3>
                <p class="stats-card__label">Total Users</p>
                <small class="stats-card__meta">+@Model.NewUsersToday today</small>
                <a asp-controller="SuperAdmin" asp-action="ManageUsers" class="stats-card__action">Manage Users</a>
            </div>
        </div>
        <div class="stats-card stats-card--books">
            <div class="stats-card__body">
                <div class="stats-card__icon">
                    <i class="bi bi-book"></i>
                </div>
                <h3 class="stats-card__number">@Model.TotalBooks.ToString("N0")</h3>
                <p class="stats-card__label">Total Books</p>
                <small class="stats-card__meta">+@Model.BooksAddedThisMonth this month</small>
                <a asp-controller="Admin" asp-action="Books" class="stats-card__action">View Books</a>
            </div>
        </div>
        <div class="stats-card stats-card--orders">
            <div class="stats-card__body">
                <div class="stats-card__icon">
                    <i class="bi bi-receipt-cutoff"></i>
                </div>
                <h3 class="stats-card__number">@Model.TotalOrders.ToString("N0")</h3>
                <p class="stats-card__label">Total Orders</p>
                <small class="stats-card__meta">@Model.OrdersToday today</small>
                <a asp-controller="Orders" asp-action="List" class="stats-card__action">Manage Orders</a>
            </div>
        </div>
        <div class="stats-card stats-card--revenue">
            <div class="stats-card__body">
                <div class="stats-card__icon">
                    <i class="bi bi-currency-rupee"></i>
                </div>
                <h3 class="stats-card__number">₹@Model.TotalRevenue.ToString("N0")</h3>
                <p class="stats-card__label">Total Revenue</p>
                <small class="stats-card__meta">₹@Model.RevenueToday.ToString("N0") today</small>
                <a asp-controller="Orders" asp-action="List" class="stats-card__action">View Orders</a>
            </div>
        </div>
    </div>

    <!-- System Status & Quick Actions Row -->
    <div class="view-section">
        <div class="view-grid view-grid--2-cols">
            <!-- System Status -->
            <div class="view-card">
                <div class="view-card__header">
                    <h5 class="view-card__title">
                        <i class="bi bi-heart-pulse"></i>System Status
                    </h5>
                </div>
                <div class="view-card__body">
                    <div class="system-status-grid">
                        <div class="status-item">
                            <div class="status-badge success">
                                <i class="bi bi-database"></i>
                            </div>
                            <div class="status-title">Database</div>
                            <small class="status-subtitle">Connected</small>
                        </div>
                        <div class="status-item">
                            <div class="status-badge success">
                                <i class="bi bi-lightning"></i>
                            </div>
                            <div class="status-title">Cache</div>
                            <small class="status-subtitle">Active</small>
                        </div>
                        <div class="status-item">
                            <div class="status-badge info">
                                <i class="bi bi-hdd"></i>
                            </div>
                            <div class="status-title">Storage</div>
                            <small class="status-subtitle">@Model.StorageUsagePercent%</small>
                        </div>
                        <div class="status-item">
                            <div class="status-badge info">
                                <i class="bi bi-people"></i>
                            </div>
                            <div class="status-title">Sessions</div>
                            <small class="status-subtitle">@Model.ActiveSessions active</small>
                        </div>
                    </div>
                    <div class="mt-3 pt-3" style="border-top: 1px solid var(--border-color);">
                        <small style="color: var(--color-text-muted);">
                            <i class="bi bi-clock me-1"></i>Uptime: @Model.SystemInfo.ServerUptime
                        </small>
                    </div>
                </div>
            </div>

            <!-- Quick Actions -->
            <div class="view-card">
                <div class="view-card__header">
                    <h5 class="view-card__title">
                        <i class="bi bi-lightning-charge"></i>Quick Actions
                    </h5>
                </div>
                <div class="view-card__body">
                    <div class="quick-actions-grid">
                        @foreach (var action in Model.QuickActions)
                        {
                            @if (action.Action.StartsWith("javascript:"))
                            {
                                <button onclick="@action.Action.Replace("javascript:", "")" class="quick-action-btn">
                                    <i class="@action.Icon"></i>
                                    <span>@action.Title</span>
                                </button>
                            }
                            else
                            {
                                <a href="@Url.Action(action.Action, "SuperAdmin")" class="quick-action-btn">
                                    <i class="@action.Icon"></i>
                                    <span>@action.Title</span>
                                </a>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Pending Users & Recent Activity Row -->
    <div class="view-section">
        <div class="view-grid view-grid--2-cols">
            <!-- Pending Users -->
            @if (Model.PendingUsersCount > 0)
            {
                <div class="view-card">
                    <div class="view-card__header">
                        <h5 class="view-card__title">
                            <i class="bi bi-person-plus"></i>Pending Approvals
                        </h5>
                        <span class="wp-badge bg-warning">@Model.PendingUsersCount</span>
                    </div>
                    <div class="view-card__body">
                        @foreach (var user in Model.PendingUsers)
                        {
                            <div class="pending-user-item">
                                <div class="pending-user-info">
                                    <div class="pending-user-name">@user.Name</div>
                                    <small class="pending-user-email">@user.Email</small>
                                </div>
                                <div class="pending-user-actions">
                                    <button class="wp-btn-primary wp-btn-sm" onclick="executeQuickAction('approveuser', {userId: @user.Id, role: 'User'})">
                                        <i class="bi bi-check"></i>
                                    </button>
                                    <button class="wp-btn-secondary wp-btn-sm" onclick="executeQuickAction('rejectuser', {userId: @user.Id})">
                                        <i class="bi bi-x"></i>
                                    </button>
                                </div>
                            </div>
                        }
                        @if (Model.PendingUsersCount > 5)
                        {
                            <div class="text-center mt-3">
                                <a href="@Url.Action("PendingUsers", "SuperAdmin")" class="wp-btn-secondary wp-btn-sm">
                                    View All (@Model.PendingUsersCount)
                                </a>
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- Recent Activity -->
            <div class="view-card" style="@(Model.PendingUsersCount <= 0 ? "grid-column: 1 / -1;" : "")">
                <div class="view-card__header">
                    <h5 class="view-card__title">
                        <i class="bi bi-clock"></i>Recent Activity
                    </h5>
                    <a href="@Url.Action("ActivityLogs", "SuperAdmin")" class="wp-btn-secondary wp-btn-sm">View All</a>
                </div>
                <div class="view-card__body" style="padding: 0;">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Action</th>
                                    <th>User</th>
                                    <th>Details</th>
                                    <th>Time</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var log in Model.RecentActivities.Take(10))
                                {
                                    <tr>
                                        <td><span class="wp-badge bg-primary">@log.ActionType</span></td>
                                        <td>@(log.User?.Name ?? "System")</td>
                                        <td>@log.Description</td>
                                        <td><small style="color: var(--color-text-muted);">@GetTimeAgo(log.Timestamp)</small></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@await Html.PartialAsync("_Notification")

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/js/toastr.min.js"></script>
    
    <script>
        // Enhanced Super Admin Dashboard JavaScript
        
        // Quick action functions
        function clearCache() {
            if (confirm('Are you sure you want to clear the system cache?')) {
                executeQuickAction('clearcache');
            }
        }

        function backupDatabase() {
            if (confirm('Are you sure you want to create a database backup?')) {
                executeQuickAction('backupdatabase');
            }
        }

        // Unified quick action executor
        async function executeQuickAction(action, data = {}) {
            try {
                const response = await fetch('/SuperAdmin/ExecuteQuickAction', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    },
                    body: JSON.stringify({ action: action, ...data })
                });
                
                const result = await response.json();
                
                if (result.success) {
                    toastr.success(result.message);
                    // Refresh specific sections or entire page
                    if (action === 'approveuser' || action === 'rejectuser') {
                        setTimeout(() => location.reload(), 1500);
                    }
                } else {
                    toastr.error(result.message);
                }
            } catch (error) {
                toastr.error('An error occurred while executing the action');
                console.error('Error:', error);
            }
        }

        // Auto-refresh dashboard every 5 minutes
        setInterval(function() {
            refreshSystemOverview();
        }, 300000);

        // Refresh system overview data
        async function refreshSystemOverview() {
            try {
                const response = await fetch('/SuperAdmin/GetSystemOverview');
                const result = await response.json();
                
                if (result.success) {
                    // Update stats without full page reload
                    updateDashboardStats(result.data);
                }
            } catch (error) {
                console.error('Error refreshing system overview:', error);
            }
        }

        function updateDashboardStats(data) {
            // Update stats cards if needed
            // This could be enhanced to update specific elements
        }

        // Initialize tooltips
        document.addEventListener('DOMContentLoaded', function() {
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl);
            });
        });
    </script>
}

<!-- Anti-forgery token for AJAX requests -->
@Html.AntiForgeryToken()

@functions {
    public string GetTimeAgo(DateTime time)
    {
        var span = DateTime.UtcNow - time;
        if (span.TotalMinutes < 1) return "Just now";
        if (span.TotalMinutes < 60) return $"{(int)span.TotalMinutes} min ago";
        if (span.TotalHours < 24) return $"{(int)span.TotalHours} hrs ago";
        return $"{(int)span.TotalDays} days ago";
    }
}
