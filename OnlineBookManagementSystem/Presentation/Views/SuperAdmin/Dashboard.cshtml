@model OnlineBookManagementSystem.Presentation.Controllers.EnhancedSuperAdminDashboardViewModel
@{
    ViewData["Title"] = "Super Admin Dashboard - Whispering Pages";
    Layout = "/Presentation/Views/Shared/_LayoutSuperAdmin.cshtml";
}

    <!-- Interactive Command Center Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 p-4 rounded-4 shadow-sm position-relative overflow-hidden transition-all interactive-header" style="background: linear-gradient(135deg, rgba(255,255,255,0.95), rgba(255,255,255,0.8)); backdrop-filter: blur(12px); border: 1px solid rgba(255,255,255,0.6);">
        <div class="position-absolute opacity-10 header-watermark transition-all" style="right: -2%; top: -30%; font-size: 12rem; color: var(--wp-primary); pointer-events: none;">
            <i class="bi bi-shield-check"></i>
        </div>
        <div class="d-flex align-items-center position-relative z-1">
            <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center me-3 shadow-sm" style="width: 56px; height: 56px;">
                <i class="bi bi-shield-lock-fill fs-3"></i>
            </div>
            <div>
                <h2 class="mb-0 fw-bold" style="color: #2c3e50; letter-spacing: -0.5px;">Command Center</h2>
                <p class="text-muted mb-0 fw-medium">Super Admin Overview & Control Panel</p>
            </div>
        </div>
        <div class="d-flex gap-3 position-relative z-1 align-items-center">
            <div class="bg-white px-3 py-2 rounded-pill shadow-sm border d-flex align-items-center gap-2">
                <span class="position-relative d-flex h-3 w-3 align-items-center justify-content-center">
                    <span class="animate-ping position-absolute h-100 w-100 rounded-circle bg-@(Model.SystemInfo.Environment == "Production" ? "success" : "warning") opacity-75"></span>
                    <span class="position-relative d-inline-flex rounded-circle h-100 w-100 bg-@(Model.SystemInfo.Environment == "Production" ? "success" : "warning")" style="width: 8px; height: 8px;"></span>
                </span>
                <span class="fw-bold text-@(Model.SystemInfo.Environment == "Production" ? "success" : "warning")" style="font-size: 0.9rem;">
                    @Model.SystemInfo.Environment
                </span>
            </div>
            @if (Model.SystemInfo.MaintenanceMode)
            {
                <div class="bg-danger bg-opacity-10 text-danger px-3 py-2 rounded-pill shadow-sm border border-danger border-opacity-25 d-flex align-items-center gap-2 animate-pulse">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    <span class="fw-bold" style="font-size: 0.9rem;">Maintenance Mode</span>
                </div>
            }
        </div>
    </div>

    <!-- System Health Alert -->
    @if (Model.SystemInfo.MaintenanceMode)
    {
        <div class="alert alert-danger border-0 rounded-4 shadow-sm mb-4 position-relative overflow-hidden" role="alert" style="background: linear-gradient(135deg, #fff5f5, #ffe3e3);">
            <div class="d-flex align-items-center position-relative z-1">
                <div class="bg-danger text-white rounded-circle d-flex align-items-center justify-content-center me-3 shadow-sm" style="width: 40px; height: 40px;">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                </div>
                <div>
                    <h5 class="mb-1 fw-bold text-danger">System is in Maintenance Mode</h5>
                    <p class="mb-0 text-danger opacity-75">Only Super Admins can currently access the platform. Regular users see a maintenance screen.</p>
                </div>
            </div>
            <button type="button" class="btn-close position-absolute top-50 translate-middle-y z-1" style="right: 1.5rem;" data-bs-dismiss="alert" aria-label="Close"></button>
            <i class="bi bi-cone-striped position-absolute opacity-10" style="font-size: 8rem; right: 5%; top: -50%; color: var(--bs-danger);"></i>
        </div>
    }

    <!-- Interactive Premium Stats Row -->
    <div class="row g-4 mb-4">
        <!-- Users Card -->
        <div class="col-12 col-md-6 col-xl-3">
            <div class="premium-stat-card h-100 rounded-4 p-4 position-relative overflow-hidden shadow-sm transition-all" style="background: linear-gradient(135deg, #ffffff, #f8faff); border: 1px solid rgba(80, 143, 244, 0.2);">
                <div class="stat-card-glow position-absolute w-100 h-100 top-0 start-0 opacity-0 transition-all" style="background: radial-gradient(circle at top right, rgba(80, 143, 244, 0.15) 0%, transparent 60%);"></div>
                <div class="d-flex justify-content-between align-items-start position-relative z-1 mb-3">
                    <div>
                        <p class="text-muted fw-semibold mb-1 text-uppercase" style="font-size: 0.75rem; letter-spacing: 1px;">Total Users</p>
                        <h2 class="fw-bold mb-0" style="color: #2c3e50; font-size: 2.5rem; letter-spacing: -1px;">@Model.TotalUsers.ToString("N0")</h2>
                    </div>
                    <div class="bg-primary text-white rounded-4 d-flex align-items-center justify-content-center shadow-sm stat-icon-wrapper transition-all" style="width: 52px; height: 52px; background: linear-gradient(135deg, var(--wp-primary), #3b76e0) !important;">
                        <i class="bi bi-people-fill fs-4"></i>
                    </div>
                </div>
                <div class="d-flex align-items-center justify-content-between position-relative z-1">
                    <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-2 py-1"><i class="bi bi-arrow-up-short"></i>@Model.NewUsersToday today</span>
                    <a asp-controller="SuperAdmin" asp-action="ManageUsers" class="text-primary fw-medium text-decoration-none stat-link transition-all" style="font-size: 0.85rem;">Manage <i class="bi bi-arrow-right ms-1"></i></a>
                </div>
                <i class="bi bi-person-badge position-absolute opacity-5 stat-watermark transition-all" style="font-size: 8rem; right: -10%; bottom: -15%; color: var(--wp-primary);"></i>
            </div>
        </div>

        <!-- Books Card -->
        <div class="col-12 col-md-6 col-xl-3">
            <div class="premium-stat-card h-100 rounded-4 p-4 position-relative overflow-hidden shadow-sm transition-all" style="background: linear-gradient(135deg, #ffffff, #f5fcf8); border: 1px solid rgba(32, 201, 151, 0.2);">
                <div class="stat-card-glow position-absolute w-100 h-100 top-0 start-0 opacity-0 transition-all" style="background: radial-gradient(circle at top right, rgba(32, 201, 151, 0.15) 0%, transparent 60%);"></div>
                <div class="d-flex justify-content-between align-items-start position-relative z-1 mb-3">
                    <div>
                        <p class="text-muted fw-semibold mb-1 text-uppercase" style="font-size: 0.75rem; letter-spacing: 1px;">Platform Books</p>
                        <h2 class="fw-bold mb-0" style="color: #2c3e50; font-size: 2.5rem; letter-spacing: -1px;">@Model.TotalBooks.ToString("N0")</h2>
                    </div>
                    <div class="bg-success text-white rounded-4 d-flex align-items-center justify-content-center shadow-sm stat-icon-wrapper transition-all" style="width: 52px; height: 52px; background: linear-gradient(135deg, var(--wp-success), #1aa179) !important;">
                        <i class="bi bi-book-half fs-4"></i>
                    </div>
                </div>
                <div class="d-flex align-items-center justify-content-between position-relative z-1">
                    <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-2 py-1"><i class="bi bi-arrow-up-short"></i>@Model.BooksAddedThisMonth this month</span>
                    <a asp-controller="Admin" asp-action="Books" class="text-success fw-medium text-decoration-none stat-link transition-all" style="font-size: 0.85rem;">View <i class="bi bi-arrow-right ms-1"></i></a>
                </div>
                <i class="bi bi-journal-bookmark-fill position-absolute opacity-5 stat-watermark transition-all" style="font-size: 8rem; right: -10%; bottom: -15%; color: var(--wp-success);"></i>
            </div>
        </div>

        <!-- Orders Card -->
        <div class="col-12 col-md-6 col-xl-3">
            <div class="premium-stat-card h-100 rounded-4 p-4 position-relative overflow-hidden shadow-sm transition-all" style="background: linear-gradient(135deg, #ffffff, #fffaf4); border: 1px solid rgba(253, 126, 20, 0.2);">
                <div class="stat-card-glow position-absolute w-100 h-100 top-0 start-0 opacity-0 transition-all" style="background: radial-gradient(circle at top right, rgba(253, 126, 20, 0.15) 0%, transparent 60%);"></div>
                <div class="d-flex justify-content-between align-items-start position-relative z-1 mb-3">
                    <div>
                        <p class="text-muted fw-semibold mb-1 text-uppercase" style="font-size: 0.75rem; letter-spacing: 1px;">Total Orders</p>
                        <h2 class="fw-bold mb-0" style="color: #2c3e50; font-size: 2.5rem; letter-spacing: -1px;">@Model.TotalOrders.ToString("N0")</h2>
                    </div>
                    <div class="bg-warning text-dark rounded-4 d-flex align-items-center justify-content-center shadow-sm stat-icon-wrapper transition-all" style="width: 52px; height: 52px; background: linear-gradient(135deg, var(--wp-warning), #e66e00) !important; color: white !important;">
                        <i class="bi bi-cart-check-fill fs-4"></i>
                    </div>
                </div>
                <div class="d-flex align-items-center justify-content-between position-relative z-1">
                    <span class="badge bg-warning bg-opacity-10 text-warning rounded-pill px-2 py-1 text-dark"><i class="bi bi-clock"></i> @Model.OrdersToday today</span>
                    <a asp-controller="Orders" asp-action="List" class="text-warning fw-medium text-decoration-none stat-link transition-all text-dark" style="font-size: 0.85rem;">Manage <i class="bi bi-arrow-right ms-1"></i></a>
                </div>
                <i class="bi bi-bag-check-fill position-absolute opacity-5 stat-watermark transition-all" style="font-size: 8rem; right: -10%; bottom: -15%; color: var(--wp-warning);"></i>
            </div>
        </div>

        <!-- Revenue Card -->
        <div class="col-12 col-md-6 col-xl-3">
            <div class="premium-stat-card h-100 rounded-4 p-4 position-relative overflow-hidden shadow-sm transition-all" style="background: linear-gradient(135deg, #ffffff, #f7f4fc); border: 1px solid rgba(111, 66, 193, 0.2);">
                <div class="stat-card-glow position-absolute w-100 h-100 top-0 start-0 opacity-0 transition-all" style="background: radial-gradient(circle at top right, rgba(111, 66, 193, 0.15) 0%, transparent 60%);"></div>
                <div class="d-flex justify-content-between align-items-start position-relative z-1 mb-3">
                    <div>
                        <p class="text-muted fw-semibold mb-1 text-uppercase" style="font-size: 0.75rem; letter-spacing: 1px;">Total Revenue</p>
                        <h2 class="fw-bold mb-0 text-truncate" style="color: #2c3e50; font-size: 2rem; letter-spacing: -1px; max-width: 140px;" title="₹@Model.TotalRevenue.ToString("N0")">₹@Model.TotalRevenue.ToString("N0")</h2>
                    </div>
                    <div class="text-white rounded-4 d-flex align-items-center justify-content-center shadow-sm stat-icon-wrapper transition-all" style="width: 52px; height: 52px; background: linear-gradient(135deg, #6f42c1, #563399) !important;">
                        <i class="bi bi-currency-rupee fs-4"></i>
                    </div>
                </div>
                <div class="d-flex align-items-center justify-content-between position-relative z-1">
                    <span class="badge rounded-pill px-2 py-1" style="background: rgba(111, 66, 193, 0.1); color: #6f42c1;"><i class="bi bi-graph-up-arrow"></i> ₹@Model.RevenueToday.ToString("N0") today</span>
                    <a asp-controller="Orders" asp-action="List" class="fw-medium text-decoration-none stat-link transition-all" style="color: #6f42c1; font-size: 0.85rem;">View <i class="bi bi-arrow-right ms-1"></i></a>
                </div>
                <i class="bi bi-wallet2 position-absolute opacity-5 stat-watermark transition-all" style="font-size: 8rem; right: -10%; bottom: -15%; color: #6f42c1;"></i>
            </div>
        </div>
    </div>

    <!-- System Status & Quick Actions Row -->
    <div class="row g-4 mb-4">
        <!-- Interactive System Status -->
        <div class="col-12 col-lg-7">
            <div class="view-card h-100 rounded-4 overflow-hidden shadow-sm" style="border: 1px solid rgba(0,0,0,0.05);">
                <div class="view-card__header bg-white border-bottom p-4">
                    <h5 class="view-card__title mb-0 fw-bold d-flex align-items-center">
                        <div class="bg-primary bg-opacity-10 text-primary rounded d-flex align-items-center justify-content-center me-3" style="width: 36px; height: 36px;">
                            <i class="bi bi-heart-pulse-fill"></i>
                        </div>
                        System Health Monitor
                    </h5>
                </div>
                <div class="view-card__body p-4 bg-light bg-opacity-50">
                    <div class="row g-3">
                        <!-- Database Status -->
                        <div class="col-6 col-md-3">
                            <div class="system-node-card text-center p-3 rounded-4 bg-white shadow-sm transition-all border border-success border-opacity-25 position-relative overflow-hidden h-100">
                                <div class="node-indicator bg-success shadow-sm"></div>
                                <div class="bg-success bg-opacity-10 text-success rounded-circle d-flex align-items-center justify-content-center mx-auto mb-2" style="width: 48px; height: 48px;">
                                    <i class="bi bi-server fs-5"></i>
                                </div>
                                <h6 class="fw-bold mb-1 text-dark">Database</h6>
                                <span class="badge bg-success rounded-pill fw-medium px-2 py-1" style="font-size: 0.7rem;">Connected</span>
                            </div>
                        </div>
                        <!-- Cache Status -->
                        <div class="col-6 col-md-3">
                            <div class="system-node-card text-center p-3 rounded-4 bg-white shadow-sm transition-all border border-info border-opacity-25 position-relative overflow-hidden h-100">
                                <div class="node-indicator bg-info shadow-sm"></div>
                                <div class="bg-info bg-opacity-10 text-info rounded-circle d-flex align-items-center justify-content-center mx-auto mb-2" style="width: 48px; height: 48px;">
                                    <i class="bi bi-lightning-charge-fill fs-5"></i>
                                </div>
                                <h6 class="fw-bold mb-1 text-dark">Cache</h6>
                                <span class="badge bg-info text-white rounded-pill fw-medium px-2 py-1" style="font-size: 0.7rem;">Active Fast</span>
                            </div>
                        </div>
                        <!-- Storage Status -->
                        <div class="col-6 col-md-3">
                            <div class="system-node-card text-center p-3 rounded-4 bg-white shadow-sm transition-all border border-warning border-opacity-25 position-relative overflow-hidden h-100">
                                <div class="node-indicator bg-warning shadow-sm"></div>
                                <div class="bg-warning bg-opacity-10 text-warning rounded-circle d-flex align-items-center justify-content-center mx-auto mb-2" style="width: 48px; height: 48px;">
                                    <i class="bi bi-hdd-fill fs-5"></i>
                                </div>
                                <h6 class="fw-bold mb-1 text-dark">Storage</h6>
                                <div class="w-100 bg-light rounded-pill mt-2 overflow-hidden mx-auto" style="height: 6px; max-width: 60%;">
                                    <div class="bg-warning h-100 rounded-pill" style="width: @Model.StorageUsagePercent%;"></div>
                                </div>
                                <div class="mt-1 text-muted" style="font-size: 0.75rem;"><span class="text-dark fw-bold">@Model.StorageUsagePercent%</span> Used</div>
                            </div>
                        </div>
                        <!-- Sessions -->
                        <div class="col-6 col-md-3">
                            <div class="system-node-card text-center p-3 rounded-4 bg-white shadow-sm transition-all border border-primary border-opacity-25 position-relative overflow-hidden h-100">
                                <div class="node-indicator bg-primary shadow-sm"></div>
                                <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center mx-auto mb-2" style="width: 48px; height: 48px;">
                                    <i class="bi bi-people-fill fs-5"></i>
                                </div>
                                <h6 class="fw-bold mb-1 text-dark">Sessions</h6>
                                <div class="d-flex align-items-center justify-content-center mt-1">
                                    <span class="pulse-dot bg-primary me-2"></span>
                                    <span class="text-dark fw-bold" style="font-size: 0.9rem;">@Model.ActiveSessions</span>
                                </div>
                                <div class="text-muted" style="font-size: 0.7rem;">Active Users</div>
                            </div>
                        </div>
                    </div>
                    <div class="d-flex align-items-center mt-4 px-2 py-3 bg-white rounded-3 shadow-sm border border-light">
                        <div class="bg-success bg-opacity-10 text-success rounded px-2 py-1 me-3">
                            <i class="bi bi-clock-history"></i>
                        </div>
                        <div class="flex-grow-1">
                            <span class="text-muted" style="font-size: 0.85rem;">System Uptime:</span>
                            <span class="fw-bold fs-6 text-dark ms-2 font-monospace">@Model.SystemInfo.ServerUptime</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Interactive Quick Actions -->
        <div class="col-12 col-lg-5">
            <div class="view-card h-100 rounded-4 overflow-hidden shadow-sm" style="border: 1px solid rgba(0,0,0,0.05); background: linear-gradient(135deg, #ffffff, #fdfdfe);">
                <div class="view-card__header bg-transparent border-0 p-4 pb-2">
                    <h5 class="view-card__title mb-0 fw-bold d-flex align-items-center">
                        <div class="bg-warning bg-opacity-10 text-warning rounded d-flex align-items-center justify-content-center me-3" style="width: 36px; height: 36px;">
                            <i class="bi bi-lightning-fill"></i>
                        </div>
                        Quick Controls
                    </h5>
                </div>
                <div class="view-card__body p-4 pt-2">
                    <div class="row g-3">
                        @foreach (var action in Model.QuickActions)
                        {
                            <div class="col-6">
                                @if (action.Action.StartsWith("javascript:"))
                                {
                                    <button onclick="@action.Action.Replace("javascript:", "")" class="action-btn-3d w-100 p-3 rounded-4 border-0 d-flex flex-column align-items-center justify-content-center text-center transition-all bg-white shadow-sm position-relative overflow-hidden h-100" style="min-height: 110px;">
                                        <div class="action-btn-bg position-absolute w-100 h-100 top-0 start-0 opacity-0 transition-all bg-primary bg-opacity-10"></div>
                                        <i class="@action.Icon fs-3 mb-2 text-primary position-relative z-1 action-btn-icon transition-all"></i>
                                        <span class="fw-medium text-dark position-relative z-1" style="font-size: 0.85rem;">@action.Title</span>
                                    </button>
                                }
                                else
                                {
                                    <button onclick="window.location.href='@Url.Action(action.Action, "SuperAdmin")'" class="action-btn-3d w-100 p-3 rounded-4 border-0 d-flex flex-column align-items-center justify-content-center text-center transition-all bg-white shadow-sm position-relative overflow-hidden h-100" style="min-height: 110px;">
                                        <div class="action-btn-bg position-absolute w-100 h-100 top-0 start-0 opacity-0 transition-all bg-primary bg-opacity-10"></div>
                                        <i class="@action.Icon fs-3 mb-2 text-primary position-relative z-1 action-btn-icon transition-all"></i>
                                        <span class="fw-medium text-dark position-relative z-1" style="font-size: 0.85rem;">@action.Title</span>
                                    </button>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <style>
        .transition-all { transition: all 0.3s ease; }
        
        .interactive-header:hover .header-watermark {
            transform: scale(1.1) rotate(5deg);
            opacity: 0.15 !important;
        }
        
        .animate-ping {
            animation: ping 2s cubic-bezier(0, 0, 0.2, 1) infinite;
        }
        @@keyframes ping {
            75%, 100% { transform: scale(2); opacity: 0; }
        }
        
        .animate-pulse {
            animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
        }
        @@keyframes pulse {
            0%, 100% { opacity: 1; }
            50% { opacity: .5; }
        }
        
        /* Premium Stat Cards */
        .premium-stat-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.08) !important;
        }
        .premium-stat-card:hover .stat-card-glow { opacity: 0.8 !important; }
        .premium-stat-card:hover .stat-watermark { transform: scale(1.1); right: -5% !important; opacity: 0.1 !important; }
        .premium-stat-card:hover .stat-icon-wrapper { transform: scale(1.1) rotate(5deg); }
        .stat-link:hover { transform: translateX(3px); }
        
        /* System Node Cards */
        .system-node-card { border-width: 2px !important; }
        .system-node-card:hover { transform: translateY(-3px); box-shadow: 0 8px 16px rgba(0,0,0,0.05) !important; border-color: transparent !important; }
        .node-indicator {
            position: absolute;
            top: 10px; right: 10px;
            width: 10px; height: 10px;
            border-radius: 50%;
            animation: pulse 2s infinite;
        }
        .pulse-dot {
            width: 8px; height: 8px; border-radius: 50%; display: inline-block;
            animation: pulse 1.5s infinite;
        }
        
        /* 3D Action Buttons */
        .action-btn-3d { border: 1px solid rgba(0,0,0,0.03) !important; }
        .action-btn-3d:hover {
            transform: translateY(-4px);
            box-shadow: 0 8px 15px rgba(0,0,0,0.05), 0px 4px 6px rgba(0,0,0,0.02) !important;
        }
        .action-btn-3d:hover .action-btn-bg { opacity: 1 !important; }
        .action-btn-3d:hover .action-btn-icon { transform: scale(1.2); }
    </style>

    <!-- Pending Users & Recent Activity Row -->
    <div class="view-section">
        <div class="view-grid view-grid--2-cols">
            <!-- Pending Users -->
            @if (Model.PendingUsersCount > 0)
            {
                <div class="view-card">
                    <div class="view-card__header">
                        <h5 class="view-card__title">
                            <i class="bi bi-person-plus"></i>Pending Approvals
                        </h5>
                        <span class="wp-badge bg-warning">@Model.PendingUsersCount</span>
                    </div>
                    <div class="view-card__body">
                        @foreach (var user in Model.PendingUsers)
                        {
                            <div class="pending-user-item">
                                <div class="pending-user-info">
                                    <div class="pending-user-name">@user.Name</div>
                                    <small class="pending-user-email">@user.Email</small>
                                </div>
                                <div class="pending-user-actions">
                                    <button class="wp-btn wp-btn-primary " onclick="executeQuickAction('approveuser', {userId: @user.Id, role: 'User'})">
                                        <i class="bi bi-check"></i>
                                    </button>
                                    <button class="wp-btn wp-btn-secondary " onclick="executeQuickAction('rejectuser', {userId: @user.Id})">
                                        <i class="bi bi-x"></i>
                                    </button>
                                </div>
                            </div>
                        }
                        @if (Model.PendingUsersCount > 5)
                        {
                            <div class="text-center mt-3">
                                <a href="@Url.Action("PendingUsers", "SuperAdmin")" class="wp-btn wp-btn-secondary">
                                    View All (@Model.PendingUsersCount)
                                </a>
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- Recent Activity -->
            <div class="view-card" style="@(Model.PendingUsersCount <= 0 ? "grid-column: 1 / -1;" : "")">
                <div class="view-card__header">
                    <h5 class="view-card__title">
                        <i class="bi bi-clock"></i>Recent Activity
                    </h5>
                    <a href="@Url.Action("ActivityLogs", "SuperAdmin")" class="wp-btn wp-btn-secondary ">View All</a>
                </div>
                <div class="view-card__body">
                    <div class="table-wrapper">
                        <table class="table table--hover mb-0">
                            <thead class="table__header">
                                <tr class="table__row">
                                    <th class="table__header-cell">Action</th>
                                    <th class="table__header-cell">User</th>
                                    <th class="table__header-cell">Details</th>
                                    <th class="table__header-cell">Time</th>
                                </tr>
                            </thead>
                            <tbody class="table__body">
                                @foreach (var log in Model.RecentActivities.Take(10))
                                {
                                    <tr class="table__row">
                                        <td class="table__cell"><span class="wp-badge bg-primary">@log.ActionType</span></td>
                                        <td class="table__cell">@(log.User?.Name ?? "System")</td>
                                        <td class="table__cell">@log.Description</td>
                                        <td class="table__cell"><small class="text-muted">@GetTimeAgo(log.Timestamp)</small></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@await Html.PartialAsync("_Notification")

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/js/toastr.min.js"></script>
    
    <script>
        // Enhanced Super Admin Dashboard JavaScript
        
        // Quick action functions
        function clearCache() {
            if (confirm('Are you sure you want to clear the system cache?')) {
                executeQuickAction('clearcache');
            }
        }

        function backupDatabase() {
            if (confirm('Are you sure you want to create a database backup?')) {
                executeQuickAction('backupdatabase');
            }
        }

        function testEmail() {
            if (confirm('Send a test email to verify configuration?')) {
                executeQuickAction('testemail');
            }
        }

        function clearOldLogs() {
            if (confirm('Are you sure you want to clear logs older than 30 days?')) {
                executeQuickAction('clearoldlogs');
            }
        }

        // Unified quick action executor
        async function executeQuickAction(action, data = {}) {
            try {
                const response = await fetch('/SuperAdmin/ExecuteQuickAction', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    },
                    body: JSON.stringify({ action: action, ...data })
                });
                
                const result = await response.json();
                
                if (result.success) {
                    toastr.success(result.message);
                    // Refresh specific sections or entire page
                    if (action === 'approveuser' || action === 'rejectuser') {
                        setTimeout(() => location.reload(), 1500);
                    }
                } else {
                    toastr.error(result.message);
                }
            } catch (error) {
                toastr.error('An error occurred while executing the action');
                console.error('Error:', error);
            }
        }

        // Auto-refresh dashboard every 5 minutes
        setInterval(function() {
            refreshSystemOverview();
        }, 300000);

        // Refresh system overview data
        async function refreshSystemOverview() {
            try {
                const response = await fetch('/SuperAdmin/GetSystemOverview');
                const result = await response.json();
                
                if (result.success) {
                    // Update stats without full page reload
                    updateDashboardStats(result.data);
                }
            } catch (error) {
                console.error('Error refreshing system overview:', error);
            }
        }

        function updateDashboardStats(data) {
            // Update stats cards if needed
            // This could be enhanced to update specific elements
        }

        // Initialize tooltips
        document.addEventListener('DOMContentLoaded', function() {
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl);
            });
        });
    </script>
}

