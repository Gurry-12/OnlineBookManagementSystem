@model OnlineBookManagementSystem.Presentation.ViewModels.Showcase.DeveloperStoryPageViewModel
@{
    ViewData["Title"] = ViewBag.Title ?? "Developer Story - Project Journey & Vision";
    Layout = "_LayoutPublic";
}

<section class="story-hero aurora-bg enhanced noise-overlay particles-bg" data-parallax="0.4">
    <div class="pub-hero--centered">
        <div class="pub-hero__eyebrow floating holographic continuous">
            <i class="bi bi-person-circle me-2" aria-hidden="true"></i>Developer Journey
        </div>
        <h1 class="pub-hero__title  gradient-text" data-text-reveal>
            The Story Behind the Code
        </h1>
        <p class="pub-hero__description floating slow">
            Discover the motivation, challenges, and technical decisions that shaped
            this comprehensive book management system.
        </p>
        <div class="pub-hero__actions">
            <a asp-action="TechnicalDetails" class="wp-btn wp-btn-primary magnetic-btn holographic rainbow wp-btn-lg pulse-glow">
                <i class="bi bi-gear me-2" aria-hidden="true"></i>Technical Details
            </a>
            <a asp-action="InteractiveDemo" class="wp-btn wp-btn-secondary magnetic-btn wp-btn-lg glass-deep">
                <i class="bi bi-play-circle me-2" aria-hidden="true"></i>Live Demo
            </a>
        </div>
    </div>
</section>
<section class="pub-section">
    <div class="pub-section__inner">
        <div class="pub-split">
            <div class="pub-split__content" data-fade-in>
                <h2 class="pub-section__title">Project Vision</h2>
                <p class="pub-hero__description">@Model.ProjectOverview.Vision</p>
                <p>@Model.ProjectOverview.ValueProposition</p>
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-check-circle-fill text-success" aria-hidden="true"></i>
                    <span class="fw-semibold">Status: @Model.ProjectOverview.ProjectStatus</span>
                </div>
                @if (Model.ProjectOverview.KeyFeatures.Any())
                {
                    <div>
                        <h3 class="h5 fw-semibold mb-2">Key Features Implemented:</h3>
                        <ul class="list-unstyled">
                            @foreach (var feature in Model.ProjectOverview.KeyFeatures)
                            {
                                <li class="mb-2">
                                    <i class="bi bi-arrow-right text-primary me-2" aria-hidden="true"></i>@feature
                                </li>
                            }
                        </ul>
                    </div>
                }
            </div>
            <div class="pub-split__visual" data-fade-in>
                <div class="pub-split__card">
                    <h3 class="h5 fw-bold mb-4 text-center">Project Overview</h3>
                    <div class="pub-stats-grid">
                        <div class="pub-stat-card">
                            <div class="pub-stat-card__icon"><i class="bi bi-calendar-event text-primary" aria-hidden="true"></i></div>
                            <div class="pub-stat-card__value">2024–26</div>
                            <div class="pub-stat-card__label">Development Period</div>
                        </div>
                        <div class="pub-stat-card">
                            <div class="pub-stat-card__icon"><i class="bi bi-layers text-success" aria-hidden="true"></i></div>
                            <div class="pub-stat-card__value">Clean Arch</div>
                            <div class="pub-stat-card__label">Design Pattern</div>
                        </div>
                        <div class="pub-stat-card">
                            <div class="pub-stat-card__icon"><i class="bi bi-code-slash text-info" aria-hidden="true"></i></div>
                            <div class="pub-stat-card__value">ASP.NET</div>
                            <div class="pub-stat-card__label">Primary Framework</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<section class="pub-section pub-section--alt">
    <div class="pub-section__inner">
        <div class="pub-section__header">
            <h2 class="pub-section__title">The Motivation</h2>
            <p class="pub-section__subtitle">What drove the creation of this project</p>
        </div>
        <div class="pub-centered-narrow">
            <div class="motivation-card glass p-5 rounded-4" data-fade-in>
                <blockquote class="blockquote text-center mb-4">
                    <p class="fs-4 fst-italic">"@Model.DeveloperStory.Motivation"</p>
                </blockquote>
                <div class="mt-5 text-center">
                    <h3 class="h4 fw-bold mb-3">Challenges Solved</h3>
                    <p class="text-muted">@Model.DeveloperStory.ChallengesSolved</p>
                </div>
            </div>
        </div>
    </div>
</section>
<section class="pub-section technical-decisions parallax-container" data-parallax="0.2">
    <div class="pub-section__inner">
        <div class="pub-section__header cascade-animation">
            <h2 class="pub-section__title gradient-text">Technical Decisions</h2>
            <p class="pub-section__subtitle">Key architectural and implementation choices</p>
        </div>
        <div class="pub-2col-grid cascade-animation">
            @if (Model.DeveloperStory.TechnicalDecisions.Any())
            {
                @for (int i = 0; i < Model.DeveloperStory.TechnicalDecisions.Count; i++)
                {
                    var decision = Model.DeveloperStory.TechnicalDecisions[i];
                    <div class="decision-card glass-deep spotlight-card pub-feature-card hover-lift floating" data-fade-in>
                        <div class="d-flex align-items-center mb-3">
                            <div class="pub-step-number me-3">@(i + 1)</div>
                            <h3 class="pub-feature-card__title mb-0 gradient-text">Technical Decision @(i + 1)</h3>
                        </div>
                        <p class="pub-feature-card__desc">@decision</p>
                    </div>
                }
            }
        </div>
    </div>
</section>
<section class="pub-section pub-section--alt">
    <div class="pub-section__inner">
        <div class="pub-section__header">
            <h2 class="pub-section__title">Lessons Learned</h2>
            <p class="pub-section__subtitle">Insights gained throughout the development journey</p>
        </div>
        <div class="pub-2col-grid">
            @if (Model.DeveloperStory.LessonsLearned.Any())
            {
                @foreach (var lesson in Model.DeveloperStory.LessonsLearned)
                {
                    <div class="lesson-card glass spotlight-card pub-feature-card hover-lift" data-fade-in>
                        <div class="mb-3">
                            <i class="bi bi-lightbulb text-warning" style="font-size: 2rem;" aria-hidden="true"></i>
                        </div>
                        <p class="mb-0">@lesson</p>
                    </div>
                }
            }
        </div>
    </div>
</section>
<section class="pub-section">
    <div class="pub-section__inner">
        <div class="pub-section__header">
            <h2 class="pub-section__title">Technical Achievements</h2>
            <p class="pub-section__subtitle">Notable implementations and innovations</p>
        </div>
        <div class="pub-features-grid">
            @foreach (var achievement in Model.TechnicalAchievements)
            {
                <div class="pub-feature-card glass spotlight-card hover-lift" data-fade-in>
                    <div class="pub-feature-card__category">
                        <span class="wp-badge bg-success  text-white">@achievement.Category</span>
                    </div>
                    <h3 class="pub-feature-card__title">@achievement.FeatureName</h3>
                    <p class="pub-feature-card__desc">@achievement.Description</p>
                    @if (achievement.TechnicalDetails.Any())
                    {
                        <ul class="pub-feature-card__details">
                            @foreach (var detail in achievement.TechnicalDetails.Take(3))
                            {
                                <li class="pub-feature-card__detail-item">
                                    <i class="bi bi-check-circle pub-feature-card__check" aria-hidden="true"></i>
                                    <small>@detail</small>
                                </li>
                            }
                        </ul>
                    }
                </div>
            }
        </div>
    </div>
</section>
<section class="pub-section pub-section--alt">
    <div class="pub-section__inner">
        <div class="pub-split">
            <div class="pub-split__content" data-fade-in>
                <h2 class="pub-section__title">Future Vision</h2>
                <p class="pub-hero__description">@Model.DeveloperStory.FutureVision</p>
                <div>
                    <h3 class="h5 fw-semibold mb-3">Planned Enhancements:</h3>
                    <ul class="list-unstyled">
                        <li class="mb-2"><i class="bi bi-arrow-right text-primary me-2" aria-hidden="true"></i>Microservices Architecture Migration</li>
                        <li class="mb-2"><i class="bi bi-arrow-right text-primary me-2" aria-hidden="true"></i>Advanced Analytics Dashboard</li>
                        <li class="mb-2"><i class="bi bi-arrow-right text-primary me-2" aria-hidden="true"></i>Machine Learning Recommendations</li>
                        <li class="mb-2"><i class="bi bi-arrow-right text-primary me-2" aria-hidden="true"></i>Mobile Application Development</li>
                    </ul>
                </div>
            </div>
            <div class="pub-split__visual" data-fade-in>
                <div class="pub-split__card">
                    <h3 class="h5 fw-bold mb-4 text-center">Development Roadmap</h3>
                    <div class="roadmap-timeline">
                        <div class="timeline-item mb-3">
                            <div class="timeline-marker bg-success"></div>
                            <div class="timeline-content">
                                <h4 class="h6 fw-semibold">Phase 1: Foundation</h4>
                                <small class="text-muted">Clean Architecture Implementation</small>
                            </div>
                        </div>
                        <div class="timeline-item mb-3">
                            <div class="timeline-marker bg-success"></div>
                            <div class="timeline-content">
                                <h4 class="h6 fw-semibold">Phase 2: Features</h4>
                                <small class="text-muted">Core Functionality &amp; UI</small>
                            </div>
                        </div>
                        <div class="timeline-item mb-3">
                            <div class="timeline-marker bg-primary"></div>
                            <div class="timeline-content">
                                <h4 class="h6 fw-semibold">Phase 3: Enhancement</h4>
                                <small class="text-muted">Advanced Features &amp; Analytics</small>
                            </div>
                        </div>
                        <div class="timeline-item">
                            <div class="timeline-marker bg-secondary"></div>
                            <div class="timeline-content">
                                <h4 class="h6 fw-semibold">Phase 4: Scale</h4>
                                <small class="text-muted">Microservices &amp; Mobile</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<section class="pub-section">
    <div class="pub-section__inner">
        <div class="pub-section__header">
            <h2 class="pub-section__title">Let's Connect</h2>
            <p class="pub-section__subtitle">Interested in collaboration or have questions about the project?</p>
        </div>
        <div class="pub-form-card text-center">
            <h3 class="h4 fw-bold mb-3">@Model.ContactInfo.Location</h3>
            <p class="text-muted mb-4">Available for opportunities in:</p>
            <div class="d-flex flex-wrap justify-content-center gap-2 mb-5">
                @foreach (var role in Model.ContactInfo.AvailableForRoles)
                {
                    <span class="wp-badge bg-primary  text-white px-3 py-2">@role</span>
                }
            </div>
            @if (Model.ContactInfo.Email != null || Model.ContactInfo.LinkedIn != null || Model.ContactInfo.GitHub != null)
            {
                <div class="pub-contact-methods-grid mb-5">
                    @if (!string.IsNullOrEmpty(Model.ContactInfo.Email))
                    {
                        <a href="mailto:@Model.ContactInfo.Email" class="pub-contact-method-card">
                            <i class="bi bi-envelope-fill text-primary pub-contact-method-card__icon" aria-hidden="true"></i>
                            <h4 class="h6 fw-semibold">Email</h4>
                            <small class="text-muted">Get in touch</small>
                        </a>
                    }
                    @if (!string.IsNullOrEmpty(Model.ContactInfo.LinkedIn))
                    {
                        <a href="@Model.ContactInfo.LinkedIn" target="_blank" rel="noopener" class="pub-contact-method-card">
                            <i class="bi bi-linkedin text-primary pub-contact-method-card__icon" aria-hidden="true"></i>
                            <h4 class="h6 fw-semibold">gurpreet-singh57</h4>
                            <small class="text-muted">LinkedIn Profile</small>
                        </a>
                    }
                    @if (!string.IsNullOrEmpty(Model.ContactInfo.GitHub))
                    {
                        <a href="@Model.ContactInfo.GitHub" target="_blank" rel="noopener" class="pub-contact-method-card">
                            <i class="bi bi-github text-primary pub-contact-method-card__icon" aria-hidden="true"></i>
                            <h4 class="h6 fw-semibold">Gurry-12</h4>
                            <small class="text-muted">GitHub Profile</small>
                        </a>
                    }
                </div>
            }
            @if (Model.ContactInfo.TechnicalResources.Any())
            {
                <div class="text-start mb-4">
                    <h4 class="h6 fw-semibold mb-3">Technical Resources:</h4>
                    @foreach (var resource in Model.ContactInfo.TechnicalResources.Take(4))
                    {
                        <div class="mb-2">
                            <a href="@resource.Url" target="_blank" rel="noopener" class="text-decoration-none d-flex align-items-center">
                                <i class="@resource.IconClass text-primary me-2" aria-hidden="true"></i>
                                <span class="fw-semibold">@resource.Title</span>
                                <span class="wp-badge bg-info  text-white ms-auto">@resource.Category</span>
                            </a>
                        </div>
                    }
                </div>
            }
            @if (Model.ContactInfo.OpenToCollaboration)
            {
                <div class="alert alert-success d-inline-flex align-items-center mb-4">
                    <i class="bi bi-check-circle-fill me-2" aria-hidden="true"></i>
                    Open to collaboration and new opportunities
                </div>
            }
            <div class="pub-hero__actions justify-content-center">
                <a asp-action="TechnicalDetails" class="wp-btn wp-btn-primary magnetic-btn">
                    <i class="bi bi-gear me-2" aria-hidden="true"></i>Technical Details
                </a>
                <a asp-action="InteractiveDemo" class="wp-btn wp-btn-outline magnetic-btn">
                    <i class="bi bi-play-circle me-2" aria-hidden="true"></i>Live Demo
                </a>
            </div>
        </div>
    </div>
</section>
@section Styles {
    <style>
        .pub-stat-card, .motivation-card, .decision-card, .lesson-card, .pub-feature-card, .pub-contact-method-card {
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            border: 1px solid rgba(var(--primary-color-rgb), 0.1);
            background: rgba(var(--surface-color-rgb), 0.7);
            backdrop-filter: blur(12px);
            border-radius: var(--radius-lg);
            position: relative;
            z-index: 1;
            overflow: hidden;
            box-shadow: 0 4px 6px rgba(0,0,0,0.05);
        }

        /* Hover lifting */
        .pub-stat-card:hover, .motivation-card:hover, .decision-card:hover, .lesson-card:hover, .pub-feature-card:hover, .pub-contact-method-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 25px 50px -12px rgba(var(--primary-color-rgb), 0.15);
            border-color: rgba(var(--primary-color-rgb), 0.3);
        }

        /* Background glow effect */
        .pub-stat-card::after, .motivation-card::after, .decision-card::after, .lesson-card::after, .pub-feature-card::after, .pub-contact-method-card::after {
             content: '';
             position: absolute;
             top: 0; left: 0; right: 0; bottom: 0;
             background: radial-gradient(circle at top right, rgba(var(--primary-color-rgb), 0.1), transparent 70%);
             opacity: 0;
             transition: opacity 0.4s;
             z-index: -1;
             pointer-events: none;
        }

        .pub-stat-card:hover::after, .motivation-card:hover::after, .decision-card:hover::after, .lesson-card:hover::after, .pub-feature-card:hover::after, .pub-contact-method-card:hover::after {
            opacity: 1;
        }

        /* Fun interaction for icons */
        .pub-stat-card__icon i, .lesson-card i, .pub-contact-method-card__icon { 
            position: relative; 
            z-index: 1; 
            transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            display: inline-block;
        }
        .pub-stat-card:hover .pub-stat-card__icon i, .lesson-card:hover i, .pub-contact-method-card:hover .pub-contact-method-card__icon {
            transform: scale(1.3) rotate(5deg);
        }

        /* Timeline hover effect */
        .timeline-item {
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            padding: 1rem;
            border-radius: var(--radius-md);
            border: 1px solid transparent;
            cursor: default;
        }
        .timeline-item:hover {
            background: rgba(var(--surface-color-rgb), 0.5);
            backdrop-filter: blur(8px);
            border-color: rgba(var(--primary-color-rgb), 0.2);
            transform: translateX(10px) scale(1.02);
            box-shadow: 0 10px 20px -5px rgba(0,0,0,0.1);
        }
        .timeline-marker {
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }
        .timeline-item:hover .timeline-marker {
            transform: scale(1.5);
            box-shadow: 0 0 15px currentColor;
        }

        /* 3D tilt floating */
        @@keyframes float-tilt {
            0%, 100% { transform: translateY(0) rotate(-1deg); }
            50% { transform: translateY(-10px) rotate(1deg); }
        }
        .pub-split__visual .pub-split__card {
            animation: float-tilt 5s ease-in-out infinite;
        }
    </style>
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            console.log('Developer story page loaded');
            
            // Add scroll animations for timeline
            const timelineItems = document.querySelectorAll('.timeline-item');
            const observerOptions = {
                threshold: 0.3,
                rootMargin: '0px 0px -50px 0px'
            };
            
            const timelineObserver = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.style.opacity = '1';
                        entry.target.style.transform = 'translateX(0)';
                    }
                });
            }, observerOptions);
            
            timelineItems.forEach((item, index) => {
                item.style.opacity = '0';
                item.style.transform = 'translateX(-20px)';
                item.style.transition = `opacity 0.6s ease ${index * 0.1}s, transform 0.6s ease ${index * 0.1}s`;
                timelineObserver.observe(item);
            });
            
            // Add hover effects to achievement cards
            const achievementCards = document.querySelectorAll('.achievement-card');
            achievementCards.forEach(card => {
                card.addEventListener('mouseenter', () => {
                    const badge = card.querySelector('.badge');
                    if (badge) {
                        badge.style.transform = 'scale(1.05)';
                    }
                });
                
                card.addEventListener('mouseleave', () => {
                    const badge = card.querySelector('.badge');
                    if (badge) {
                        badge.style.transform = 'scale(1)';
                    }
                });
            });
        });
    </script>
}



