@model OnlineBookManagementSystem.Presentation.ViewModels.Showcase.TechnicalDetailsViewModel
@{
    ViewData["Title"] = "Technical Details - Architecture & Implementation";
    ViewData["Description"] = "Explore the technical architecture, Clean Architecture implementation, SOLID principles, and modern technology stack powering the Online Book Management System.";
    ViewData["Keywords"] = "clean architecture, SOLID principles, ASP.NET Core, technical architecture, software design patterns, dependency injection, domain driven design";
    ViewData["OgImage"] = $"{Context.Request.Scheme}://{Context.Request.Host}/images/technical-architecture.jpg";
    ViewData["CanonicalUrl"] = $"{Context.Request.Scheme}://{Context.Request.Host}/Public/TechnicalDetails";
    Layout = "_LayoutPublic";
    
    // Structured data for technical details page
    ViewData["StructuredData"] = @"
    <script type=""application/ld+json"">
    {
        ""@context"": ""https://schema.org"",
        ""@type"": ""TechArticle"",
        ""headline"": ""Clean Architecture Implementation - Technical Deep Dive"",
        ""description"": ""Comprehensive technical documentation of Clean Architecture principles, SOLID design patterns, and modern web development practices."",
        ""author"": {
            ""@type"": ""Person"",
            ""name"": ""Whispering Pages Development Team""
        },
        ""datePublished"": ""2024-01-01"",
        ""dateModified"": ""2026-01-01"",
        ""publisher"": {
            ""@type"": ""Organization"",
            ""name"": ""Whispering Pages""
        },
        ""mainEntity"": {
            ""@type"": ""SoftwareApplication"",
            ""name"": ""Online Book Management System"",
            ""applicationCategory"": ""BusinessApplication"",
            ""operatingSystem"": ""Web Browser""
        }
    }
    </script>";
}

<!-- Technical Hero Section -->
<section class="technical-hero aurora-bg noise-overlay py-5" role="banner" aria-labelledby="technical-hero-heading">
    <div class="container">
        <div class="row align-items-center min-vh-50">
            <div class="col-lg-8 mx-auto text-center" data-fade-in>
                <div class="hero-content">
                    <div class="hero-badge mb-3">
                        <span class="badge bg-primary bg-opacity-20 text-primary px-4 py-2 rounded-pill fs-6">
                            <i class="bi bi-gear me-2" aria-hidden="true"></i>Technical Deep Dive
                        </span>
                    </div>
                    <h1 id="technical-hero-heading" class="display-3 fw-bold text-white mb-4">
                        Architecture & Implementation
                    </h1>
                    <p class="lead text-white-75 mb-4 fs-4">
                        Explore the technical decisions, architectural patterns, and implementation details 
                        behind this comprehensive book management system.
                    </p>
                    <div class="hero-actions d-flex flex-wrap justify-content-center gap-3" role="group" aria-label="Navigation actions">
                        <a asp-action="InteractiveDemo" class="wp-btn wp-btn-primary magnetic-btn holographic btn-lg"
                           aria-label="Try the interactive demo">
                            <i class="bi bi-play-circle me-2" aria-hidden="true"></i>Live Demo
                        </a>
                        <a asp-action="Index" class="wp-btn wp-btn-outline-light magnetic-btn btn-lg"
                           aria-label="Return to main showcase">
                            <i class="bi bi-house me-2" aria-hidden="true"></i>Back to Showcase
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Clean Architecture Section -->
<section class="architecture-section py-5" aria-labelledby="architecture-heading">
    <div class="container">
        <div class="text-center mb-5">
            <h2 id="architecture-heading" class="display-5 fw-bold mb-3">@Model.Architecture.ArchitectureType</h2>
            <p class="lead text-muted">@Model.Architecture.ArchitectureDescription</p>
        </div>

        <div class="row g-4 mb-5" role="group" aria-label="Architecture layers">
            @foreach (var layer in Model.Architecture.Layers)
            {
                <div class="col-lg-3 col-md-6" data-fade-in>
                    <article class="architecture-layer-card glass spotlight-card hover-lift h-100 p-4 text-center"
                             role="article" aria-labelledby="layer-@layer.Name.Replace(" ", "-").ToLower()">
                        <div class="layer-visual mb-3">
                            <div class="layer-circle mx-auto" style="background: @layer.Color; width: 80px; height: 80px; border-radius: 50%; display: flex; align-items: center; justify-content: center;"
                                 role="img" aria-label="@layer.Name layer icon">
                                <i class="bi bi-layers text-white" style="font-size: 2rem;" aria-hidden="true"></i>
                            </div>
                        </div>
                        <h3 id="layer-@layer.Name.Replace(" ", "-").ToLower()" class="layer-name fw-bold mb-3" style="color: @layer.Color;">@layer.Name</h3>
                        <p class="layer-description text-muted mb-3">@layer.Description</p>
                        @if (!string.IsNullOrEmpty(layer.Responsibilities))
                        {
                            <div class="layer-responsibilities">
                                <h4 class="fw-semibold mb-2 h6">Responsibilities:</h4>
                                <p class="small text-muted">@layer.Responsibilities</p>
                            </div>
                        }
                    </article>
                </div>
            }
        </div>

        <!-- Architecture Diagram -->
        <div class="row justify-content-center">
            <div class="col-lg-10">
                <figure class="architecture-diagram glass p-5 rounded-4" data-fade-in role="img" aria-labelledby="dependency-diagram-heading">
                    <h3 id="dependency-diagram-heading" class="text-center fw-bold mb-4">Dependency Flow</h3>
                    <div class="diagram-container">
                        <div class="layer-stack">
                            @for (int i = 0; i < Model.Architecture.Layers.Count; i++)
                            {
                                var layer = Model.Architecture.Layers[i];
                                <div class="diagram-layer mb-3 p-3 rounded text-center position-relative" 
                                     style="background: @layer.Color; opacity: 0.9; color: white;"
                                     role="img" aria-label="@layer.Name layer in dependency flow">
                                    <h4 class="fw-bold mb-1 h5">@layer.Name Layer</h4>
                                    <p class="small mb-0">@layer.Description</p>
                                    @if (i < Model.Architecture.Layers.Count - 1)
                                    {
                                        <div class="dependency-arrow" aria-hidden="true">
                                            <i class="bi bi-arrow-down text-white position-absolute" 
                                               style="bottom: -20px; left: 50%; transform: translateX(-50%); font-size: 1.5rem;"></i>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                    <figcaption class="sr-only">
                        Clean Architecture dependency flow diagram showing the four layers: 
                        Presentation, Application, Domain, and Infrastructure, with dependencies flowing inward.
                    </figcaption>
                </figure>
            </div>
        </div>
    </div>
</section>

<!-- SOLID Principles Section -->
<section class="solid-principles py-5 bg-light">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="display-5 fw-bold mb-3">SOLID Principles Implementation</h2>
            <p class="lead text-muted">How each principle is applied throughout the codebase</p>
        </div>

        <div class="row g-4">
            @foreach (var principle in Model.Architecture.SOLIDPrinciples)
            {
                <div class="col-lg-6" data-fade-in>
                    <div class="principle-card glass spotlight-card hover-lift h-100 p-4">
                        <div class="principle-header d-flex align-items-center mb-3">
                            <div class="principle-icon me-3">
                                <div class="icon-circle bg-primary bg-opacity-20 text-primary d-flex align-items-center justify-content-center" 
                                     style="width: 50px; height: 50px; border-radius: 50%;">
                                    <i class="bi bi-check-circle-fill"></i>
                                </div>
                            </div>
                            <div>
                                <h4 class="principle-name fw-bold mb-1">@principle.Name</h4>
                                <p class="principle-benefit text-primary small mb-0">@principle.Benefit</p>
                            </div>
                        </div>
                        <p class="principle-description text-muted mb-3">@principle.Description</p>
                        @if (!string.IsNullOrEmpty(principle.Implementation))
                        {
                            <div class="implementation-details">
                                <h6 class="fw-semibold mb-2">Implementation:</h6>
                                <p class="small text-muted">@principle.Implementation</p>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- Technical Stack Section -->
<section class="tech-stack py-5">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="display-5 fw-bold mb-3">Technology Stack</h2>
            <p class="lead text-muted">Modern technologies powering the application</p>
        </div>

        <div class="row g-4">
            <!-- Backend Technologies -->
            <div class="col-lg-3 col-md-6" data-fade-in>
                <div class="tech-category-card glass spotlight-card hover-lift h-100 p-4">
                    <div class="category-header text-center mb-4">
                        <div class="category-icon mb-3">
                            <i class="bi bi-server text-primary" style="font-size: 3rem;"></i>
                        </div>
                        <h4 class="fw-bold text-primary">Backend</h4>
                    </div>
                    <div class="tech-list">
                        @foreach (var tech in Model.TechnicalStack.BackendTechnologies)
                        {
                            <div class="tech-item mb-3">
                                <div class="d-flex align-items-center mb-2">
                                    <i class="@tech.IconClass me-2 text-primary"></i>
                                    <span class="fw-semibold">@tech.Name</span>
                                    @if (!string.IsNullOrEmpty(tech.Version))
                                    {
                                        <span class="badge bg-primary bg-opacity-20 text-primary ms-auto">@tech.Version</span>
                                    }
                                </div>
                                <p class="small text-muted mb-0">@tech.Description</p>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Frontend Technologies -->
            <div class="col-lg-3 col-md-6" data-fade-in>
                <div class="tech-category-card glass spotlight-card hover-lift h-100 p-4">
                    <div class="category-header text-center mb-4">
                        <div class="category-icon mb-3">
                            <i class="bi bi-palette text-success" style="font-size: 3rem;"></i>
                        </div>
                        <h4 class="fw-bold text-success">Frontend</h4>
                    </div>
                    <div class="tech-list">
                        @foreach (var tech in Model.TechnicalStack.FrontendTechnologies)
                        {
                            <div class="tech-item mb-3">
                                <div class="d-flex align-items-center mb-2">
                                    <i class="@tech.IconClass me-2 text-success"></i>
                                    <span class="fw-semibold">@tech.Name</span>
                                    @if (!string.IsNullOrEmpty(tech.Version))
                                    {
                                        <span class="badge bg-success bg-opacity-20 text-success ms-auto">@tech.Version</span>
                                    }
                                </div>
                                <p class="small text-muted mb-0">@tech.Description</p>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Database Technologies -->
            <div class="col-lg-3 col-md-6" data-fade-in>
                <div class="tech-category-card glass spotlight-card hover-lift h-100 p-4">
                    <div class="category-header text-center mb-4">
                        <div class="category-icon mb-3">
                            <i class="bi bi-database text-warning" style="font-size: 3rem;"></i>
                        </div>
                        <h4 class="fw-bold text-warning">Database</h4>
                    </div>
                    <div class="tech-list">
                        @foreach (var tech in Model.TechnicalStack.DatabaseTechnologies)
                        {
                            <div class="tech-item mb-3">
                                <div class="d-flex align-items-center mb-2">
                                    <i class="@tech.IconClass me-2 text-warning"></i>
                                    <span class="fw-semibold">@tech.Name</span>
                                    @if (!string.IsNullOrEmpty(tech.Version))
                                    {
                                        <span class="badge bg-warning bg-opacity-20 text-warning ms-auto">@tech.Version</span>
                                    }
                                </div>
                                <p class="small text-muted mb-0">@tech.Description</p>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Testing Technologies -->
            <div class="col-lg-3 col-md-6" data-fade-in>
                <div class="tech-category-card glass spotlight-card hover-lift h-100 p-4">
                    <div class="category-header text-center mb-4">
                        <div class="category-icon mb-3">
                            <i class="bi bi-check-circle text-info" style="font-size: 3rem;"></i>
                        </div>
                        <h4 class="fw-bold text-info">Testing</h4>
                    </div>
                    <div class="tech-list">
                        @foreach (var tech in Model.TechnicalStack.TestingTechnologies)
                        {
                            <div class="tech-item mb-3">
                                <div class="d-flex align-items-center mb-2">
                                    <i class="@tech.IconClass me-2 text-info"></i>
                                    <span class="fw-semibold">@tech.Name</span>
                                    @if (!string.IsNullOrEmpty(tech.Version))
                                    {
                                        <span class="badge bg-info bg-opacity-20 text-info ms-auto">@tech.Version</span>
                                    }
                                </div>
                                <p class="small text-muted mb-0">@tech.Description</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Technical Highlights Section -->
<section class="technical-highlights py-5 bg-light">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="display-5 fw-bold mb-3">Technical Highlights</h2>
            <p class="lead text-muted">Key implementation achievements and innovations</p>
        </div>

        <div class="row g-4">
            @foreach (var highlight in Model.TechnicalHighlights)
            {
                <div class="col-lg-6" data-fade-in>
                    <div class="highlight-card glass spotlight-card hover-lift h-100 p-4">
                        <div class="highlight-header mb-3">
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <h4 class="highlight-title fw-bold mb-0">@highlight.Title</h4>
                                <span class="badge bg-primary bg-opacity-20 text-primary">@highlight.Category</span>
                            </div>
                        </div>
                        <p class="highlight-description text-muted mb-3">@highlight.Description</p>
                        @if (!string.IsNullOrEmpty(highlight.CodeExample))
                        {
                            <div class="code-example">
                                <h6 class="fw-semibold mb-2">Code Example:</h6>
                                <pre class="bg-dark text-light p-3 rounded small"><code>@highlight.CodeExample</code></pre>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(highlight.DocumentationUrl))
                        {
                            <div class="highlight-actions mt-3">
                                <a href="@highlight.DocumentationUrl" target="_blank" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-book me-1"></i>Documentation
                                </a>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- Performance Metrics Section -->
<section class="performance-metrics py-5">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="display-5 fw-bold mb-3">Performance Metrics</h2>
            <p class="lead text-muted">Real-time performance indicators</p>
        </div>

        <div class="row g-4 justify-content-center">
            <div class="col-lg-3 col-md-6" data-fade-in>
                <div class="metric-card glass text-center p-4 spotlight-card hover-lift">
                    <div class="metric-icon mb-3">
                        <i class="bi bi-speedometer2 text-primary" style="font-size: 3rem;"></i>
                    </div>
                    <h3 class="metric-value fw-bold text-primary">@Model.PerformanceMetrics.PageLoadTime.ToString("F1")s</h3>
                    <p class="metric-label text-muted mb-0">Page Load Time</p>
                </div>
            </div>
            <div class="col-lg-3 col-md-6" data-fade-in>
                <div class="metric-card glass text-center p-4 spotlight-card hover-lift">
                    <div class="metric-icon mb-3">
                        <i class="bi bi-graph-up text-success" style="font-size: 3rem;"></i>
                    </div>
                    <h3 class="metric-value fw-bold text-success">@Model.PerformanceMetrics.PerformanceScore</h3>
                    <p class="metric-label text-muted mb-0">Performance Score</p>
                </div>
            </div>
            <div class="col-lg-3 col-md-6" data-fade-in>
                <div class="metric-card glass text-center p-4 spotlight-card hover-lift">
                    <div class="metric-icon mb-3">
                        <i class="bi bi-database text-warning" style="font-size: 3rem;"></i>
                    </div>
                    <h3 class="metric-value fw-bold text-warning">@((Model.PerformanceMetrics.DatabaseResponseTime * 1000).ToString("F0"))ms</h3>
                    <p class="metric-label text-muted mb-0">DB Response</p>
                </div>
            </div>
            <div class="col-lg-3 col-md-6" data-fade-in>
                <div class="metric-card glass text-center p-4 spotlight-card hover-lift">
                    <div class="metric-icon mb-3">
                        <i class="bi bi-lightning text-info" style="font-size: 3rem;"></i>
                    </div>
                    <h3 class="metric-value fw-bold text-info">@Model.PerformanceMetrics.CacheHitRate%</h3>
                    <p class="metric-label text-muted mb-0">Cache Hit Rate</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Call to Action -->
<section class="cta-section aurora-bg noise-overlay py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8 text-center text-white">
                <h2 class="display-4 fw-bold mb-4">Ready to Explore?</h2>
                <p class="lead mb-4">
                    Experience the live system and see these technical implementations in action.
                </p>
                <div class="d-flex gap-3 justify-content-center flex-wrap">
                    <a asp-action="InteractiveDemo" 
                       class="wp-btn wp-btn-primary magnetic-btn holographic btn-lg">
                        <i class="bi bi-play-circle me-2"></i>Interactive Demo
                    </a>
                    <a asp-action="DeveloperStory" 
                       class="wp-btn wp-btn-secondary magnetic-btn btn-lg">
                        <i class="bi bi-person-circle me-2"></i>Developer Story
                    </a>
                    <a asp-controller="Auth" asp-action="Registration" 
                       class="wp-btn wp-btn-outline-light magnetic-btn btn-lg">
                        <i class="bi bi-person-plus me-2"></i>Try the System
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

@section Styles {
    <style>
        .technical-hero {
            min-height: 50vh;
        }
        
        .min-vh-50 {
            min-height: 50vh;
        }
        
        .architecture-layer-card {
            background: white;
            border-radius: 16px;
            border: 1px solid rgba(0,0,0,0.1);
            transition: all 0.3s ease;
        }
        
        .architecture-layer-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 12px 40px rgba(0,0,0,0.15);
        }
        
        .layer-circle {
            transition: transform 0.3s ease;
        }
        
        .architecture-layer-card:hover .layer-circle {
            transform: scale(1.1);
        }
        
        .architecture-diagram {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(0,0,0,0.1);
        }
        
        .diagram-layer {
            transition: all 0.3s ease;
            margin-bottom: 2rem !important;
        }
        
        .diagram-layer:hover {
            transform: scale(1.02);
        }
        
        .dependency-arrow {
            position: relative;
        }
        
        .principle-card, .tech-category-card, .highlight-card, .metric-card {
            background: white;
            border-radius: 16px;
            border: 1px solid rgba(0,0,0,0.1);
            transition: all 0.3s ease;
        }
        
        .principle-card:hover, .tech-category-card:hover, .highlight-card:hover, .metric-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 12px 40px rgba(0,0,0,0.15);
        }
        
        .tech-item {
            padding: 0.5rem 0;
            border-bottom: 1px solid rgba(0,0,0,0.05);
        }
        
        .tech-item:last-child {
            border-bottom: none;
        }
        
        .code-example pre {
            font-size: 0.8rem;
            max-height: 200px;
            overflow-y: auto;
        }
        
        .metric-value {
            font-size: 2.5rem;
        }
        
        /* Responsive adjustments */
        @@media (max-width: 768px) {
            .display-3 {
                font-size: 2.5rem;
            }
            
            .hero-actions {
                flex-direction: column;
                align-items: stretch;
            }
            
            .hero-actions .wp-btn {
                text-align: center;
            }
            
            .diagram-layer {
                margin-bottom: 1rem !important;
            }
        }
    </style>
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            console.log('Technical details page loaded');
            
            // Animate metric values
            const metricValues = document.querySelectorAll('.metric-value');
            const observerOptions = {
                threshold: 0.5,
                rootMargin: '0px 0px -100px 0px'
            };
            
            const metricsObserver = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        animateMetric(entry.target);
                        metricsObserver.unobserve(entry.target);
                    }
                });
            }, observerOptions);
            
            metricValues.forEach(metric => {
                metricsObserver.observe(metric);
            });
            
            function animateMetric(element) {
                const text = element.textContent;
                const isPercentage = text.includes('%');
                const isTime = text.includes('s');
                const isMs = text.includes('ms');
                
                let target = parseFloat(text.replace(/[^\d.]/g, ''));
                const duration = 2000;
                const step = target / (duration / 16);
                let current = 0;
                
                const timer = setInterval(() => {
                    current += step;
                    if (current >= target) {
                        current = target;
                        clearInterval(timer);
                    }
                    
                    let displayValue = current.toFixed(isTime ? 1 : 0);
                    if (isPercentage) displayValue += '%';
                    else if (isTime) displayValue += 's';
                    else if (isMs) displayValue += 'ms';
                    
                    element.textContent = displayValue;
                }, 16);
            }
            
            // Add interactive effects to architecture layers
            const layerCards = document.querySelectorAll('.architecture-layer-card');
            layerCards.forEach((card, index) => {
                card.addEventListener('mouseenter', () => {
                    // Highlight related layers
                    layerCards.forEach((otherCard, otherIndex) => {
                        if (otherIndex !== index) {
                            otherCard.style.opacity = '0.7';
                        }
                    });
                });
                
                card.addEventListener('mouseleave', () => {
                    layerCards.forEach(otherCard => {
                        otherCard.style.opacity = '1';
                    });
                });
            });
        });
    </script>
}