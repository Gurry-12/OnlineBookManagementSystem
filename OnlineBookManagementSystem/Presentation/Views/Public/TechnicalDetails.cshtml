@model OnlineBookManagementSystem.Presentation.ViewModels.Showcase.TechnicalDetailsViewModel
@{
    ViewData["Title"] = "Technical Details - Architecture & Implementation";
    ViewData["Description"] = "Explore the technical architecture, Clean Architecture implementation, SOLID principles, and modern technology stack powering the Online Book Management System.";
    ViewData["Keywords"] = "clean architecture, SOLID principles, ASP.NET Core, technical architecture, software design patterns, dependency injection, domain driven design";
    ViewData["OgImage"] = $"{Context.Request.Scheme}://{Context.Request.Host}/images/technical-architecture.jpg";
    ViewData["CanonicalUrl"] = $"{Context.Request.Scheme}://{Context.Request.Host}/Public/TechnicalDetails";
    Layout = "_LayoutPublic";
    
    // Structured data for technical details page
    ViewData["StructuredData"] = @"
    <script type=""application/ld+json"">
    {
        ""@context"": ""https://schema.org"",
        ""@type"": ""TechArticle"",
        ""headline"": ""Clean Architecture Implementation - Technical Deep Dive"",
        ""description"": ""Comprehensive technical documentation of Clean Architecture principles, SOLID design patterns, and modern web development practices."",
        ""author"": {
            ""@type"": ""Person"",
            ""name"": ""Whispering Pages Development Team""
        },
        ""datePublished"": ""2024-01-01"",
        ""dateModified"": ""2026-01-01"",
        ""publisher"": {
            ""@type"": ""Organization"",
            ""name"": ""Whispering Pages""
        },
        ""mainEntity"": {
            ""@type"": ""SoftwareApplication"",
            ""name"": ""Online Book Management System"",
            ""applicationCategory"": ""BusinessApplication"",
            ""operatingSystem"": ""Web Browser""
        }
    }
    </script>";
}

<section class="technical-hero aurora-bg noise-overlay" role="banner" aria-labelledby="technical-hero-heading">
    <div class="pub-hero--centered">
        <div class="pub-hero__eyebrow">
            <i class="bi bi-gear me-2" aria-hidden="true"></i>Technical Deep Dive
        </div>
        <h1 id="technical-hero-heading" class="pub-hero__title ">
            Architecture &amp; Implementation
        </h1>
        <p class="pub-hero__description ">
            Explore the technical decisions, architectural patterns, and implementation details
            behind this comprehensive book management system.
        </p>
        <div class="pub-hero__actions" role="group" aria-label="Navigation actions">
            <a asp-action="InteractiveDemo" class="wp-btn wp-btn-primary magnetic-btn holographic wp-btn-lg"
               aria-label="Try the interactive demo">
                <i class="bi bi-play-circle me-2" aria-hidden="true"></i>Live Demo
            </a>
            <a asp-action="Index" class="wp-btn wp-btn-outline magnetic-btn wp-btn-lg"
               aria-label="Return to main showcase">
                <i class="bi bi-house me-2" aria-hidden="true"></i>Back to Showcase
            </a>
        </div>
    </div>
</section>


<section class="pub-section" aria-labelledby="architecture-heading">
    <div class="pub-section__inner">
        <div class="pub-section__header">
            <h2 id="architecture-heading" class="pub-section__title">@Model.Architecture.ArchitectureType</h2>
            <p class="pub-section__subtitle">@Model.Architecture.ArchitectureDescription</p>
        </div>
        <div class="pub-4col-grid" role="group" aria-label="Architecture layers">
            @foreach (var layer in Model.Architecture.Layers)
            {
                <article class="architecture-layer-card glass spotlight-card hover-lift p-4 text-center"
                         role="article" aria-labelledby="layer-@layer.Name.Replace(" ", "-").ToLower()">
                    <div class="mb-3">
                        <div class="layer-circle mx-auto d-flex align-items-center justify-content-center"
                             style="background-color: @layer.Color;"
                             role="img" aria-label="@layer.Name layer icon">
                            <i class="bi bi-layers  layer-icon" aria-hidden="true"></i>
                        </div>
                    </div>
                    <h3 id="layer-@layer.Name.Replace(" ", "-").ToLower()" class="layer-name fw-bold mb-3" style="color: @layer.Color;">@layer.Name</h3>
                    <p class="text-muted mb-3">@layer.Description</p>
                    @if (!string.IsNullOrEmpty(layer.Responsibilities))
                    {
                        <div>
                            <h4 class="fw-semibold mb-2 h6">Responsibilities:</h4>
                            <p class="small text-muted">@layer.Responsibilities</p>
                        </div>
                    }
                </article>
            }
        </div>

        <div class="pub-centered-narrow mt-5">
            <figure class="architecture-diagram glass p-5 rounded-4" data-fade-in role="img" aria-labelledby="dependency-diagram-heading">
                <h3 id="dependency-diagram-heading" class="text-center fw-bold mb-4">Dependency Flow</h3>
                <div class="diagram-container">
                    <div class="layer-stack">
                        @for (int i = 0; i < Model.Architecture.Layers.Count; i++)
                        {
                            var layer = Model.Architecture.Layers[i];
                            <div class="diagram-layer mb-3 p-3 rounded text-center position-relative "
                                 style="background-color: @layer.Color; opacity: 0.9;"
                                 role="img" aria-label="@layer.Name layer in dependency flow">
                                <h4 class="fw-bold mb-1 h5">@layer.Name Layer</h4>
                                <p class="small mb-0">@layer.Description</p>
                                @if (i < Model.Architecture.Layers.Count - 1)
                                {
                                    <div class="dependency-arrow" aria-hidden="true">
                                        <i class="bi bi-arrow-down  position-absolute layer-arrow"></i>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
                <figcaption class="sr-only">
                    Clean Architecture dependency flow diagram showing Presentation, Application, Domain, and Infrastructure layers.
                </figcaption>
            </figure>
        </div>
    </div>
</section>

<section class="pub-section pub-section--alt" aria-labelledby="solid-heading">
    <div class="pub-section__inner">
        <div class="pub-section__header">
            <h2 id="solid-heading" class="pub-section__title">SOLID Principles Implementation</h2>
            <p class="pub-section__subtitle">How each principle is applied throughout the codebase</p>
        </div>
        <div class="pub-2col-grid">
            @foreach (var principle in Model.Architecture.SOLIDPrinciples)
            {
                <div class="principle-card glass spotlight-card hover-lift p-4">
                    <div class="d-flex align-items-center mb-3">
                        <div class="icon-circle bg-primary  text-primary d-flex align-items-center justify-content-center me-3">
                            <i class="bi bi-check-circle-fill" aria-hidden="true"></i>
                        </div>
                        <div>
                            <h3 class="pub-feature-card__title mb-1">@principle.Name</h3>
                            <p class="text-primary small mb-0">@principle.Benefit</p>
                        </div>
                    </div>
                    <p class="pub-feature-card__desc">@principle.Description</p>
                    @if (!string.IsNullOrEmpty(principle.Implementation))
                    {
                        <div>
                            <h6 class="fw-semibold mb-2">Implementation:</h6>
                            <p class="small text-muted">@principle.Implementation</p>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>


<section class="pub-section" aria-labelledby="stack-heading">
    <div class="pub-section__inner">
        <div class="pub-section__header">
            <h2 id="stack-heading" class="pub-section__title">Technology Stack</h2>
            <p class="pub-section__subtitle">Modern technologies powering the application</p>
        </div>
        <div class="pub-tech-stack-grid">
            <div class="tech-category-card glass spotlight-card hover-lift p-4">
                <div class="text-center mb-4">
                    <i class="bi bi-server text-primary" style="font-size: 2.5rem;"></i>
                    <h3 class="pub-feature-card__title mt-2">Backend</h3>
                </div>
                <div>
                    @foreach (var tech in Model.TechnicalStack.BackendTechnologies)
                    {
                        <div class="mb-3">
                            <div class="d-flex align-items-center mb-1">
                                <i class="@tech.IconClass me-2 text-primary" aria-hidden="true"></i>
                                <span class="fw-semibold">@tech.Name</span>
                                @if (!string.IsNullOrEmpty(tech.Version))
                                {
                                    <span class="wp-badge bg-primary  text-white ms-auto">@tech.Version</span>
                                }
                            </div>
                            <p class="small text-muted mb-0">@tech.Description</p>
                        </div>
                    }
                </div>
            </div>
            <div class="tech-category-card glass spotlight-card hover-lift p-4">
                <div class="text-center mb-4">
                    <i class="bi bi-palette text-success" style="font-size: 2.5rem;"></i>
                    <h3 class="pub-feature-card__title mt-2">Frontend</h3>
                </div>
                <div>
                    @foreach (var tech in Model.TechnicalStack.FrontendTechnologies)
                    {
                        <div class="mb-3">
                            <div class="d-flex align-items-center mb-1">
                                <i class="@tech.IconClass me-2 text-success" aria-hidden="true"></i>
                                <span class="fw-semibold">@tech.Name</span>
                                @if (!string.IsNullOrEmpty(tech.Version))
                                {
                                    <span class="wp-badge bg-success  text-white ms-auto">@tech.Version</span>
                                }
                            </div>
                            <p class="small text-muted mb-0">@tech.Description</p>
                        </div>
                    }
                </div>
            </div>
            <div class="tech-category-card glass spotlight-card hover-lift p-4">
                <div class="text-center mb-4">
                    <i class="bi bi-database text-warning" style="font-size: 2.5rem;"></i>
                    <h3 class="pub-feature-card__title mt-2">Database</h3>
                </div>
                <div>
                    @foreach (var tech in Model.TechnicalStack.DatabaseTechnologies)
                    {
                        <div class="mb-3">
                            <div class="d-flex align-items-center mb-1">
                                <i class="@tech.IconClass me-2 text-warning" aria-hidden="true"></i>
                                <span class="fw-semibold">@tech.Name</span>
                                @if (!string.IsNullOrEmpty(tech.Version))
                                {
                                    <span class="wp-badge bg-warning  text-white ms-auto">@tech.Version</span>
                                }
                            </div>
                            <p class="small text-muted mb-0">@tech.Description</p>
                        </div>
                    }
                </div>
            </div>
            <div class="tech-category-card glass spotlight-card hover-lift p-4">
                <div class="text-center mb-4">
                    <i class="bi bi-check-circle text-info" style="font-size: 2.5rem;"></i>
                    <h3 class="pub-feature-card__title mt-2">Testing</h3>
                </div>
                <div>
                    @foreach (var tech in Model.TechnicalStack.TestingTechnologies)
                    {
                        <div class="mb-3">
                            <div class="d-flex align-items-center mb-1">
                                <i class="@tech.IconClass me-2 text-info" aria-hidden="true"></i>
                                <span class="fw-semibold">@tech.Name</span>
                                @if (!string.IsNullOrEmpty(tech.Version))
                                {
                                    <span class="wp-badge bg-info  text-white ms-auto">@tech.Version</span>
                                }
                            </div>
                            <p class="small text-muted mb-0">@tech.Description</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

<section class="pub-section pub-section--alt" aria-labelledby="highlights-heading">
    <div class="pub-section__inner">
        <div class="pub-section__header">
            <h2 id="highlights-heading" class="pub-section__title">Technical Highlights</h2>
            <p class="pub-section__subtitle">Key implementation achievements and innovations</p>
        </div>
        <div class="pub-2col-grid">
            @foreach (var highlight in Model.TechnicalHighlights)
            {
                <div class="highlight-card glass spotlight-card hover-lift p-4">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <h3 class="pub-feature-card__title mb-0">@highlight.Title</h3>
                        <span class="wp-badge bg-primary  text-white">@highlight.Category</span>
                    </div>
                    <p class="pub-feature-card__desc">@highlight.Description</p>
                    @if (!string.IsNullOrEmpty(highlight.CodeExample))
                    {
                        <div>
                            <h6 class="fw-semibold mb-2">Code Example:</h6>
                            <pre class="bg-dark text-light p-3 rounded small"><code>@highlight.CodeExample</code></pre>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(highlight.DocumentationUrl))
                    {
                        <div class="mt-3">
                            <a href="@highlight.DocumentationUrl" target="_blank" rel="noopener" class="wp-btn wp-btn-outline">
                                <i class="bi bi-book me-1" aria-hidden="true"></i>Documentation
                            </a>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

<section class="pub-section" aria-labelledby="metrics-heading">
    <div class="pub-section__inner">
        <div class="pub-section__header">
            <h2 id="metrics-heading" class="pub-section__title">Performance Metrics</h2>
            <p class="pub-section__subtitle">Real-time performance indicators</p>
        </div>
        <div class="pub-4col-grid">
            <div class="metric-card glass text-center p-4 spotlight-card hover-lift">
                <i class="bi bi-speedometer2 text-primary" style="font-size: 2.5rem;"></i>
                <h3 class="metric-value fw-bold text-primary mt-3">@Model.PerformanceMetrics.PageLoadTime.ToString("F1")s</h3>
                <p class="text-muted mb-0">Page Load Time</p>
            </div>
            <div class="metric-card glass text-center p-4 spotlight-card hover-lift">
                <i class="bi bi-graph-up text-success" style="font-size: 2.5rem;"></i>
                <h3 class="metric-value fw-bold text-success mt-3">@Model.PerformanceMetrics.PerformanceScore</h3>
                <p class="text-muted mb-0">Performance Score</p>
            </div>
            <div class="metric-card glass text-center p-4 spotlight-card hover-lift">
                <i class="bi bi-database text-warning" style="font-size: 2.5rem;"></i>
                <h3 class="metric-value fw-bold text-warning mt-3">@((Model.PerformanceMetrics.DatabaseResponseTime * 1000).ToString("F0"))ms</h3>
                <p class="text-muted mb-0">DB Response</p>
            </div>
            <div class="metric-card glass text-center p-4 spotlight-card hover-lift">
                <i class="bi bi-lightning text-info" style="font-size: 2.5rem;"></i>
                <h3 class="metric-value fw-bold text-info mt-3">@Model.PerformanceMetrics.CacheHitRate%</h3>
                <p class="text-muted mb-0">Cache Hit Rate</p>
            </div>
        </div>
    </div>
</section>
<section class="cta-section aurora-bg noise-overlay py-5">
    <div class="pub-hero--centered">
        <h2 class="pub-section__title ">Ready to Explore?</h2>
        <p class="pub-hero__description ">
            Experience the live system and see these technical implementations in action.
        </p>
        <div class="pub-hero__actions">
            <a asp-action="InteractiveDemo" class="wp-btn wp-btn-primary magnetic-btn holographic wp-btn-lg">
                <i class="bi bi-play-circle me-2" aria-hidden="true"></i>Interactive Demo
            </a>
            <a asp-action="DeveloperStory" class="wp-btn wp-btn-secondary magnetic-btn wp-btn-lg">
                <i class="bi bi-person-circle me-2" aria-hidden="true"></i>Developer Story
            </a>
            <a asp-controller="Auth" asp-action="Registration" class="wp-btn wp-btn-outline magnetic-btn wp-btn-lg">
                <i class="bi bi-person-plus me-2" aria-hidden="true"></i>Try the System
            </a>
        </div>
    </div>
</section>
@section Styles {
    <style>
        .architecture-layer-card, .principle-card, .tech-category-card, .highlight-card, .metric-card {
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            background: rgba(var(--surface-color-rgb), 0.6);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(var(--primary-color-rgb), 0.1);
            border-radius: var(--radius-lg);
            position: relative;
            overflow: hidden;
            z-index: 1;
        }
        
        .architecture-layer-card::before, .principle-card::before, .tech-category-card::before, .highlight-card::before, .metric-card::before {
             content: '';
             position: absolute;
             top: 0; left: 0; right: 0; bottom: 0;
             background: radial-gradient(circle at top right, rgba(var(--primary-color-rgb), 0.1), transparent 60%);
             opacity: 0;
             transition: opacity 0.4s;
             z-index: -1;
        }

        .architecture-layer-card:hover, .principle-card:hover, .tech-category-card:hover, .highlight-card:hover, .metric-card:hover {
            transform: translateY(-8px) scale(1.02);
            box-shadow: 0 20px 40px -10px rgba(0,0,0,0.1), 0 0 30px rgba(var(--primary-color-rgb), 0.1);
            border-color: rgba(var(--primary-color-rgb), 0.4);
        }
        
        .architecture-layer-card:hover::before, .principle-card:hover::before, .tech-category-card:hover::before, .highlight-card:hover::before, .metric-card:hover::before {
            opacity: 1;
        }

        /* Fun diagram interaction */
        .diagram-layer {
            transition: all 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            cursor: pointer;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
        }
        .diagram-layer:hover {
            transform: translateX(15px) scale(1.05);
            box-shadow: -10px 10px 30px rgba(0,0,0,0.15);
            z-index: 10;
        }

        .icon-circle i, .metric-card i, .layer-icon {
            transition: transform 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            display: inline-block;
        }
        .principle-card:hover .icon-circle i, .metric-card:hover i, .architecture-layer-card:hover .layer-icon {
            transform: rotateY(180deg) scale(1.3);
        }

        @@keyframes pulse-subtle {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.02); }
        }
        .diagram-container { animation: pulse-subtle 6s ease-in-out infinite; }
    </style>
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            console.log('Technical details page loaded');
            
            // Animate metric values
            const metricValues = document.querySelectorAll('.metric-value');
            const observerOptions = {
                threshold: 0.5,
                rootMargin: '0px 0px -100px 0px'
            };
            
            const metricsObserver = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        animateMetric(entry.target);
                        metricsObserver.unobserve(entry.target);
                    }
                });
            }, observerOptions);
            
            metricValues.forEach(metric => {
                metricsObserver.observe(metric);
            });
            
            function animateMetric(element) {
                const text = element.textContent;
                const isPercentage = text.includes('%');
                const isTime = text.includes('s');
                const isMs = text.includes('ms');
                
                let target = parseFloat(text.replace(/[^\d.]/g, ''));
                const duration = 2000;
                const step = target / (duration / 16);
                let current = 0;
                
                const timer = setInterval(() => {
                    current += step;
                    if (current >= target) {
                        current = target;
                        clearInterval(timer);
                    }
                    
                    let displayValue = current.toFixed(isTime ? 1 : 0);
                    if (isPercentage) displayValue += '%';
                    else if (isTime) displayValue += 's';
                    else if (isMs) displayValue += 'ms';
                    
                    element.textContent = displayValue;
                }, 16);
            }
            
            // Add interactive effects to architecture layers
            const layerCards = document.querySelectorAll('.architecture-layer-card');
            layerCards.forEach((card, index) => {
                card.addEventListener('mouseenter', () => {
                    // Highlight related layers
                    layerCards.forEach((otherCard, otherIndex) => {
                        if (otherIndex !== index) {
                            otherCard.style.opacity = '0.7';
                        }
                    });
                });
                
                card.addEventListener('mouseleave', () => {
                    layerCards.forEach(otherCard => {
                        otherCard.style.opacity = '1';
                    });
                });
            });
        });
    </script>
}


