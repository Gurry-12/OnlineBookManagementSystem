@model OnlineBookManagementSystem.Presentation.ViewModels.Books.BookDetailsViewModel
@{
    ViewData["Title"] = Model.Book.Title + " - Interactive Demo";
    Layout = "_LayoutPublic";
}

<!-- Technical Implementation Banner -->
<div class="tech-implementation-banner aurora-bg noise-overlay py-3">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-md-8">
                <div class="d-flex align-items-center text-white">
                    <i class="bi bi-code-slash me-3 fs-3 pulse-glow"></i>
                    <div>
                        <h6 class="mb-1 fw-bold">Book Details - Technical Showcase</h6>
                        <small class="text-white-75">
                            Demonstrating Clean Architecture, Domain-Driven Design, and modern UI patterns
                        </small>
                    </div>
                </div>
            </div>
            <div class="col-md-4 text-end">
                <span class="badge bg-success bg-opacity-20 text-success px-3 py-2">
                    <i class="bi bi-shield-check me-1"></i>Read-Only Demo Mode
                </span>
            </div>
        </div>
    </div>
</div>

<div class="container py-5">
    <div class="row g-4">
        <!-- Book Image -->
        <div class="col-lg-5">
            <div class="spotlight-card glass p-4 sticky-top" style="top: 80px;">
                <img src="@(Model.Book.ImageUrl ?? Url.Content("~/images/default-book-improved.svg"))" 
                     alt="@Model.Book.Title" 
                     class="img-fluid rounded shadow-lg w-100"
                     style="max-height: 600px; object-fit: contain;">
                
                @if (Model.Book.StockQuantity > 0)
                {
                    <div class="alert alert-success mt-3 mb-0">
                        <i class="bi bi-check-circle me-2"></i>
                        <strong>In Stock</strong> - @Model.Book.StockQuantity units available
                    </div>
                }
                else
                {
                    <div class="alert alert-danger mt-3 mb-0">
                        <i class="bi bi-x-circle me-2"></i>
                        <strong>Out of Stock</strong>
                    </div>
                }
            </div>
        </div>

        <!-- Book Details -->
        <div class="col-lg-7">
            <div class="glass p-4 mb-4">
                <!-- Title and Author -->
                <h1 class="display-5 fw-bold mb-3">@Model.Book.Title</h1>
                <p class="lead text-muted mb-4">
                    <i class="bi bi-person-fill me-2"></i>by <strong>@Model.Book.Author</strong>
                </p>

                <!-- Category and ISBN -->
                <div class="mb-4">
                    @if (!string.IsNullOrEmpty(Model.Book.Category?.Name))
                    {
                        <span class="badge bg-primary me-2 fs-6">
                            <i class="bi bi-tag me-1"></i>@Model.Book.Category.Name
                        </span>
                    }
                    @if (!string.IsNullOrEmpty(Model.Book.ISBN?.Value))
                    {
                        <span class="badge bg-secondary fs-6">
                            <i class="bi bi-upc me-1"></i>ISBN: @Model.Book.ISBN.Value
                        </span>
                    }
                </div>

                <!-- Price -->
                <div class="price-section mb-4 p-4 bg-light rounded">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <small class="text-muted d-block">Price</small>
                            <h2 class="text-primary fw-bold mb-0">
                                ₹@Model.Book.Price.Amount.ToString("N2")
                            </h2>
                        </div>
                        @if (Model.Book.StockQuantity > 0)
                        {
                            <div class="text-end">
                                <a asp-controller="Auth" asp-action="Login" 
                                   class="btn btn-primary btn-lg magnetic-btn holographic">
                                    <i class="bi bi-cart-plus me-2"></i>Login to Purchase
                                </a>
                                <small class="d-block text-muted mt-2">
                                    <i class="bi bi-shield-check me-1"></i>Secure checkout
                                </small>
                            </div>
                        }
                    </div>
                </div>

                <!-- Description -->
                @if (!string.IsNullOrEmpty(Model.Book.Description))
                {
                    <div class="description-section mb-4">
                        <h4 class="mb-3">
                            <i class="bi bi-book me-2"></i>About This Book
                        </h4>
                        <p class="lead">@Model.Book.Description</p>
                    </div>
                }

                <!-- Book Details Table -->
                <div class="details-table">
                    <h4 class="mb-3">
                        <i class="bi bi-info-circle me-2"></i>Book Details
                    </h4>
                    <table class="table table-borderless">
                        <tbody>
                            <tr>
                                <td class="fw-bold" style="width: 30%;">Author:</td>
                                <td>@Model.Book.Author</td>
                            </tr>
                            @if (!string.IsNullOrEmpty(Model.Book.ISBN?.Value))
                            {
                                <tr>
                                    <td class="fw-bold">ISBN:</td>
                                    <td>@Model.Book.ISBN.Value</td>
                                </tr>
                            }
                            @if (!string.IsNullOrEmpty(Model.Book.Category?.Name))
                            {
                                <tr>
                                    <td class="fw-bold">Category:</td>
                                    <td>@Model.Book.Category.Name</td>
                                </tr>
                            }
                            <tr>
                                <td class="fw-bold">Price:</td>
                                <td class="text-primary fw-bold">₹@Model.Book.Price.Amount.ToString("N2")</td>
                            </tr>
                            <tr>
                                <td class="fw-bold">Availability:</td>
                                <td>
                                    @if (Model.Book.StockQuantity > 0)
                                    {
                                        <span class="badge bg-success">
                                            <i class="bi bi-check-circle me-1"></i>In Stock (@Model.Book.StockQuantity units)
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">
                                            <i class="bi bi-x-circle me-1"></i>Out of Stock
                                        </span>
                                    }
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Call to Action -->
            <div class="glass p-4 text-center aurora-bg noise-overlay">
                <h4 class="text-white mb-3">Want to read this book?</h4>
                <p class="text-white-50 mb-4">
                    Create a free account to purchase books, write reviews, and build your reading list.
                </p>
                <div class="d-flex gap-3 justify-content-center">
                    <a asp-controller="Auth" asp-action="Registration" 
                       class="btn btn-light btn-lg magnetic-btn">
                        <i class="bi bi-person-plus me-2"></i>Create Account
                    </a>
                    <a asp-controller="Auth" asp-action="Login" 
                       class="btn btn-outline-light btn-lg magnetic-btn">
                        <i class="bi bi-box-arrow-in-right me-2"></i>Login
                    </a>
                </div>
            </div>

            <!-- Technical Implementation Notes -->
            <div class="glass p-4 mt-4">
                <h4 class="mb-3">
                    <i class="bi bi-gear me-2"></i>Technical Implementation Notes
                </h4>
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="tech-note p-3 bg-light rounded">
                            <h6 class="fw-bold text-primary mb-2">
                                <i class="bi bi-layers me-1"></i>Clean Architecture
                            </h6>
                            <ul class="list-unstyled small mb-0">
                                <li><i class="bi bi-check text-success me-1"></i>Domain Entity with Value Objects</li>
                                <li><i class="bi bi-check text-success me-1"></i>Repository Pattern Implementation</li>
                                <li><i class="bi bi-check text-success me-1"></i>Use Case Driven Design</li>
                                <li><i class="bi bi-check text-success me-1"></i>Dependency Inversion</li>
                            </ul>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="tech-note p-3 bg-light rounded">
                            <h6 class="fw-bold text-success mb-2">
                                <i class="bi bi-database me-1"></i>Data Management
                            </h6>
                            <ul class="list-unstyled small mb-0">
                                <li><i class="bi bi-check text-success me-1"></i>Entity Framework Core ORM</li>
                                <li><i class="bi bi-check text-success me-1"></i>Optimized Database Queries</li>
                                <li><i class="bi bi-check text-success me-1"></i>Read-Only Demo Constraints</li>
                                <li><i class="bi bi-check text-success me-1"></i>Caching Strategy</li>
                            </ul>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="tech-note p-3 bg-light rounded">
                            <h6 class="fw-bold text-warning mb-2">
                                <i class="bi bi-shield-lock me-1"></i>Security Features
                            </h6>
                            <ul class="list-unstyled small mb-0">
                                <li><i class="bi bi-check text-success me-1"></i>Role-Based Access Control</li>
                                <li><i class="bi bi-check text-success me-1"></i>Data Sanitization</li>
                                <li><i class="bi bi-check text-success me-1"></i>XSS Protection</li>
                                <li><i class="bi bi-check text-success me-1"></i>Rate Limiting</li>
                            </ul>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="tech-note p-3 bg-light rounded">
                            <h6 class="fw-bold text-info mb-2">
                                <i class="bi bi-palette me-1"></i>UI/UX Features
                            </h6>
                            <ul class="list-unstyled small mb-0">
                                <li><i class="bi bi-check text-success me-1"></i>Glass Morphism Effects</li>
                                <li><i class="bi bi-check text-success me-1"></i>Responsive Design</li>
                                <li><i class="bi bi-check text-success me-1"></i>Accessibility Compliance</li>
                                <li><i class="bi bi-check text-success me-1"></i>Modern CSS Animations</li>
                            </ul>
                        </div>
                    </div>
                </div>
                
                <!-- Code Example -->
                <div class="mt-4">
                    <h6 class="fw-bold mb-2">
                        <i class="bi bi-code me-1"></i>Domain Entity Example
                    </h6>
                    <div class="code-example p-3 bg-dark text-light rounded">
                        <pre class="mb-0"><code class="language-csharp">public class Book : BaseEntity
{
    public string Title { get; private set; }
    public string Author { get; private set; }
    public Money Price { get; private set; }
    public ISBN ISBN { get; private set; }
    public Category Category { get; private set; }
    
    // Domain logic encapsulated within entity
    public void UpdatePrice(Money newPrice)
    {
        if (newPrice.Amount <= 0)
            throw new DomainException("Price must be positive");
        Price = newPrice;
    }
}</code></pre>
                    </div>
                    <small class="text-muted">
                        <i class="bi bi-info-circle me-1"></i>
                        This demonstrates Value Objects (Money, ISBN), Domain Exceptions, and encapsulated business logic.
                    </small>
                </div>
            </div>
        </div>
    </div>

    <!-- Feature Comparison Table -->
    <div class="row mt-5">
        <div class="col-12">
            <div class="glass p-4">
                <h3 class="mb-4">
                    <i class="bi bi-table me-2"></i>Feature Comparison: Demo vs Full System
                </h3>
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>Feature</th>
                                <th class="text-center">Demo Mode</th>
                                <th class="text-center">Registered User</th>
                                <th class="text-center">Admin User</th>
                                <th>Technical Implementation</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td><strong>Book Browsing</strong></td>
                                <td class="text-center"><i class="bi bi-check-circle text-success"></i></td>
                                <td class="text-center"><i class="bi bi-check-circle text-success"></i></td>
                                <td class="text-center"><i class="bi bi-check-circle text-success"></i></td>
                                <td><small>Repository pattern with pagination</small></td>
                            </tr>
                            <tr>
                                <td><strong>Search & Filter</strong></td>
                                <td class="text-center"><i class="bi bi-check-circle text-success"></i></td>
                                <td class="text-center"><i class="bi bi-check-circle text-success"></i></td>
                                <td class="text-center"><i class="bi bi-check-circle text-success"></i></td>
                                <td><small>LINQ expressions with EF Core</small></td>
                            </tr>
                            <tr>
                                <td><strong>Book Purchase</strong></td>
                                <td class="text-center"><i class="bi bi-x-circle text-danger"></i></td>
                                <td class="text-center"><i class="bi bi-check-circle text-success"></i></td>
                                <td class="text-center"><i class="bi bi-check-circle text-success"></i></td>
                                <td><small>Order aggregate with domain events</small></td>
                            </tr>
                            <tr>
                                <td><strong>Reviews & Ratings</strong></td>
                                <td class="text-center"><i class="bi bi-eye text-warning"></i></td>
                                <td class="text-center"><i class="bi bi-check-circle text-success"></i></td>
                                <td class="text-center"><i class="bi bi-check-circle text-success"></i></td>
                                <td><small>Review entity with business rules</small></td>
                            </tr>
                            <tr>
                                <td><strong>Favorites</strong></td>
                                <td class="text-center"><i class="bi bi-x-circle text-danger"></i></td>
                                <td class="text-center"><i class="bi bi-check-circle text-success"></i></td>
                                <td class="text-center"><i class="bi bi-check-circle text-success"></i></td>
                                <td><small>Many-to-many relationship</small></td>
                            </tr>
                            <tr>
                                <td><strong>Book Management</strong></td>
                                <td class="text-center"><i class="bi bi-x-circle text-danger"></i></td>
                                <td class="text-center"><i class="bi bi-x-circle text-danger"></i></td>
                                <td class="text-center"><i class="bi bi-check-circle text-success"></i></td>
                                <td><small>CRUD operations with validation</small></td>
                            </tr>
                            <tr>
                                <td><strong>Analytics Dashboard</strong></td>
                                <td class="text-center"><i class="bi bi-x-circle text-danger"></i></td>
                                <td class="text-center"><i class="bi bi-x-circle text-danger"></i></td>
                                <td class="text-center"><i class="bi bi-check-circle text-success"></i></td>
                                <td><small>Chart.js with real-time data</small></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="mt-3">
                    <small class="text-muted">
                        <i class="bi bi-info-circle me-1"></i>
                        <strong>Legend:</strong> 
                        <i class="bi bi-check-circle text-success me-1"></i>Full Access
                        <i class="bi bi-eye text-warning me-1"></i>View Only
                        <i class="bi bi-x-circle text-danger me-1"></i>No Access
                    </small>
                </div>
            </div>
        </div>
    </div>

    <!-- Workflow Demonstration -->
    <div class="row mt-5">
        <div class="col-12">
            <div class="glass p-4">
                <h3 class="mb-4">
                    <i class="bi bi-diagram-3 me-2"></i>User Journey Workflow
                </h3>
                <div class="workflow-steps">
                    <div class="row g-4">
                        <div class="col-md-3">
                            <div class="workflow-step text-center p-3 bg-light rounded">
                                <div class="step-number bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 50px; height: 50px;">
                                    1
                                </div>
                                <h6 class="fw-bold">Discover</h6>
                                <p class="small text-muted mb-0">Browse books, search, and explore categories in demo mode</p>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="workflow-step text-center p-3 bg-light rounded">
                                <div class="step-number bg-success text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 50px; height: 50px;">
                                    2
                                </div>
                                <h6 class="fw-bold">Register</h6>
                                <p class="small text-muted mb-0">Create account with email verification and role assignment</p>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="workflow-step text-center p-3 bg-light rounded">
                                <div class="step-number bg-info text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 50px; height: 50px;">
                                    3
                                </div>
                                <h6 class="fw-bold">Purchase</h6>
                                <p class="small text-muted mb-0">Add books to cart, checkout with secure payment processing</p>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="workflow-step text-center p-3 bg-light rounded">
                                <div class="step-number bg-warning text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 50px; height: 50px;">
                                    4
                                </div>
                                <h6 class="fw-bold">Engage</h6>
                                <p class="small text-muted mb-0">Write reviews, manage favorites, track order history</p>
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- Technical Architecture Flow -->
                <div class="mt-4 p-3 bg-dark text-light rounded">
                    <h6 class="text-warning mb-3">
                        <i class="bi bi-cpu me-1"></i>Technical Architecture Flow
                    </h6>
                    <div class="architecture-flow small">
                        <div class="d-flex align-items-center justify-content-between flex-wrap">
                            <div class="arch-layer text-center mb-2">
                                <div class="bg-success text-white px-3 py-2 rounded">Presentation</div>
                                <small class="d-block mt-1">Controllers, Views</small>
                            </div>
                            <i class="bi bi-arrow-right text-muted"></i>
                            <div class="arch-layer text-center mb-2">
                                <div class="bg-primary text-white px-3 py-2 rounded">Application</div>
                                <small class="d-block mt-1">Use Cases, DTOs</small>
                            </div>
                            <i class="bi bi-arrow-right text-muted"></i>
                            <div class="arch-layer text-center mb-2">
                                <div class="bg-warning text-dark px-3 py-2 rounded">Domain</div>
                                <small class="d-block mt-1">Entities, Rules</small>
                            </div>
                            <i class="bi bi-arrow-right text-muted"></i>
                            <div class="arch-layer text-center mb-2">
                                <div class="bg-info text-white px-3 py-2 rounded">Infrastructure</div>
                                <small class="d-block mt-1">Data, Services</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Related Books Section -->
    <div class="row mt-5">
        <div class="col-12">
            <h3 class="mb-4">
                <i class="bi bi-grid-3x3-gap me-2"></i>More Books You Might Like
            </h3>
            <div class="text-center py-5 glass">
                <p class="text-muted mb-4">
                    <i class="bi bi-info-circle me-2"></i>
                    Login to see personalized recommendations
                </p>
                <a asp-action="Browse" class="btn btn-primary magnetic-btn">
                    <i class="bi bi-arrow-left me-2"></i>Back to Browse
                </a>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .tech-implementation-banner {
            border-bottom: 1px solid rgba(255,255,255,0.1);
        }
        
        .price-section {
            border-left: 4px solid var(--bs-primary);
        }
        
        .details-table td {
            padding: 0.75rem 0;
            border-bottom: 1px solid rgba(0,0,0,0.05);
        }
        
        .details-table tr:last-child td {
            border-bottom: none;
        }
        
        .tech-note {
            border-left: 3px solid var(--bs-primary);
            transition: all 0.3s ease;
        }
        
        .tech-note:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }
        
        .code-example {
            font-family: 'Consolas', 'Monaco', 'Courier New', monospace;
            font-size: 0.875rem;
            line-height: 1.4;
        }
        
        .workflow-step {
            transition: all 0.3s ease;
        }
        
        .workflow-step:hover {
            transform: translateY(-4px);
            box-shadow: 0 6px 20px rgba(0,0,0,0.1);
        }
        
        .step-number {
            font-weight: bold;
            font-size: 1.25rem;
        }
        
        .architecture-flow .arch-layer {
            flex: 1;
            max-width: 120px;
        }
        
        .table-hover tbody tr:hover {
            background-color: rgba(0,0,0,0.02);
        }
        
        /* Responsive adjustments */
        @@media (max-width: 768px) {
            .architecture-flow .d-flex {
                flex-direction: column;
                align-items: center;
            }
            
            .architecture-flow .bi-arrow-right {
                transform: rotate(90deg);
                margin: 10px 0;
            }
            
            .workflow-steps .row {
                text-align: center;
            }
        }
    </style>
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            console.log('Enhanced book details page loaded');
            
            // Add smooth scrolling for internal links
            document.querySelectorAll('a[href^="#"]').forEach(anchor => {
                anchor.addEventListener('click', function (e) {
                    e.preventDefault();
                    const target = document.querySelector(this.getAttribute('href'));
                    if (target) {
                        target.scrollIntoView({
                            behavior: 'smooth',
                            block: 'start'
                        });
                    }
                });
            });
            
            // Add copy functionality to code examples
            const codeBlocks = document.querySelectorAll('.code-example');
            codeBlocks.forEach(block => {
                const copyButton = document.createElement('button');
                copyButton.className = 'btn btn-sm btn-outline-light position-absolute top-0 end-0 m-2';
                copyButton.innerHTML = '<i class="bi bi-clipboard"></i>';
                copyButton.title = 'Copy code';
                
                block.style.position = 'relative';
                block.appendChild(copyButton);
                
                copyButton.addEventListener('click', function() {
                    const code = block.querySelector('code').textContent;
                    navigator.clipboard.writeText(code).then(() => {
                        copyButton.innerHTML = '<i class="bi bi-check"></i>';
                        setTimeout(() => {
                            copyButton.innerHTML = '<i class="bi bi-clipboard"></i>';
                        }, 2000);
                    });
                });
            });
            
            // Add animation to workflow steps
            const observerOptions = {
                threshold: 0.1,
                rootMargin: '0px 0px -50px 0px'
            };
            
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.style.animation = 'fadeInUp 0.6s ease forwards';
                    }
                });
            }, observerOptions);
            
            document.querySelectorAll('.workflow-step').forEach(step => {
                step.style.opacity = '0';
                step.style.transform = 'translateY(30px)';
                observer.observe(step);
            });
            
            // Add hover effects to tech notes
            document.querySelectorAll('.tech-note').forEach(note => {
                note.addEventListener('mouseenter', function() {
                    this.style.borderLeftColor = getComputedStyle(this.querySelector('h6')).color;
                });
                
                note.addEventListener('mouseleave', function() {
                    this.style.borderLeftColor = 'var(--bs-primary)';
                });
            });
        });
        
        // Add CSS animation
        const style = document.createElement('style');
        style.textContent = `
            @@keyframes fadeInUp {
                from {
                    opacity: 0;
                    transform: translateY(30px);
                }
                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }
        `;
        document.head.appendChild(style);
    </script>
}
