@{
    ViewData["Title"] = "Welcome to Whispering Pages";
    ViewData["Description"] = "Online Book Management System — Clean Architecture Showcase";
    Layout = "_LayoutPublic";
}

@section Styles {
<style>
  /* Minimal inline: only the body-level animation that must override layout */
  body.theme-public { overflow: hidden; }
  .pub-navbar-container { display: none !important; } /* hide nav on splash */
  .wp-footer { display: none !important; }            /* hide footer on splash */

  @@keyframes fade-out-body {
    0%   { opacity: 1; }
    80%  { opacity: 1; }
    100% { opacity: 0; }
  }

  body.splash-exit {
    animation: fade-out-body 0.5s ease-out forwards;
  }
</style>
}

<div class="view-public-splash" id="splashScreen" role="status" aria-label="Loading Whispering Pages">
    <img src="@Url.Content("~/images/Render_Website_Name.png")"
         alt="Whispering Pages"
         class="view-public-splash__logo"
         id="splashLogo" />
</div>

@section Scripts {
<script>
    // 3 second display → 0.5s fade → redirect
    setTimeout(function () {
        document.body.classList.add('splash-exit');
        setTimeout(function () {
            window.location.href = '@Url.Action("Dashboard", "Public")';
        }, 500);
    }, 2500);
</script>
}
