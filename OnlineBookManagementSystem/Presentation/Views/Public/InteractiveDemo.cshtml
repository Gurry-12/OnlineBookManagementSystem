@model OnlineBookManagementSystem.Presentation.ViewModels.Showcase.InteractiveDemoViewModel
@{
    ViewData["Title"] = ViewBag.Title ?? "Interactive Demo - Live System Showcase";
    Layout = "_LayoutPublic";
}

<section class="demo-hero aurora-bg noise-overlay">
    <div class="pub-hero--centered">
        <div class="pub-hero__eyebrow">
            <i class="bi bi-play-circle me-2" aria-hidden="true"></i>Live Interactive Demo
        </div>
        <h1 class="pub-hero__title ">Experience the System Live</h1>
        <p class="pub-hero__description ">
            Explore the full functionality with real data. Search, browse, and interact
            with the book management system in read-only demo mode.
        </p>
        <div class="pub-hero__mini-stats">
            <div>
                <div class="pub-hero__mini-stat-value ">@Model.Statistics.TotalBooks</div>
                <div class="pub-hero__mini-stat-label ">Books Available</div>
            </div>
            <div>
                <div class="pub-hero__mini-stat-value ">@Model.Categories.Count</div>
                <div class="pub-hero__mini-stat-label ">Categories</div>
            </div>
            <div>
                <div class="pub-hero__mini-stat-value ">@Model.Statistics.AverageRating.ToString("F1")</div>
                <div class="pub-hero__mini-stat-label ">Avg Rating</div>
            </div>
        </div>
    </div>
</section>

<section class="pub-section">
    <div class="pub-section__inner">
        <div class="pub-section__header">
            <h2 class="pub-section__title">Live Search Demo</h2>
            <p class="pub-section__subtitle">Search through our book collection in real-time</p>
        </div>
        <div class="pub-centered-narrow mb-5">
            <div class="search-container glass p-4 rounded-4" data-fade-in>
                <div class="input-group input-group-lg">
                    <span class="input-group-text bg-transparent border-0">
                        <i class="bi bi-search text-muted" aria-hidden="true"></i>
                    </span>
                    <input type="text" id="demoSearch" class="form-control border-0 bg-transparent"
                           placeholder="Search books by title, author, or category..."
                           autocomplete="off">
                    <button class="wp-btn wp-btn-primary" type="button" onclick="performDemoSearch()">
                        <i class="bi bi-search me-2" aria-hidden="true"></i>Search
                    </button>
                </div>
                <div class="mt-3">
                    <small class="text-muted">Try searching for: "fiction", "programming", "history", or any author name</small>
                </div>
            </div>
        </div>
        <div id="searchResults" class="search-results" style="display: none;">
            <div class="text-center mb-4">
                <h3 class="pub-feature-card__title">Search Results</h3>
                <div id="searchResultsCount" class="text-muted"></div>
            </div>
            <div id="searchResultsGrid" class="pub-books-grid"></div>
        </div>
    </div>
</section>

<section class="pub-section pub-section--alt">
    <div class="pub-section__inner">
        <div class="pub-section__header">
            <h2 class="pub-section__title">Browse by Category</h2>
            <p class="pub-section__subtitle">Explore books organized by genre and topic</p>
        </div>
        <div class="pub-categories-grid">
            @foreach (var category in Model.Categories.Take(8))
            {
                <div class="glass spotlight-card hover-lift p-4 text-center cursor-pointer"
                     onclick="browseCategoryDemo(@category.Id, '@category.Name')" data-fade-in>
                    <i class="@category.IconClass text-primary pub-contact-method-card__icon" aria-hidden="true"></i>
                    <h3 class="pub-feature-card__title mt-3">@category.Name</h3>
                    <p class="pub-feature-card__desc">@category.Description</p>
                    <span class="wp-badge bg-primary bg-opacity-20 text-white">@category.BookCount books</span>
                </div>
            }
        </div>
        <div id="categoryResults" class="mt-5" style="display: none;">
            <div class="text-center mb-4">
                <h3 class="pub-feature-card__title">Category: <span id="categoryResultsTitle"></span></h3>
                <div id="categoryResultsCount" class="text-muted"></div>
            </div>
            <div id="categoryResultsGrid" class="pub-books-grid"></div>
        </div>
    </div>
</section>

<section class="pub-section">
    <div class="pub-section__inner">
        <div class="pub-section__header">
            <h2 class="pub-section__title">Featured Books</h2>
            <p class="pub-section__subtitle">Handpicked selections from our collection</p>
        </div>
        <div class="pub-books-grid">
            @if (Model.FeaturedBooks.Books.Any())
            {
                @foreach (var book in Model.FeaturedBooks.Books)
                {
                    <div class="pub-book-card spotlight-card" data-fade-in>
                        <div class="position-relative">
                            <img src="@(book.ImageUrl ?? Url.Content("~/images/default-book-improved.svg"))"
                                 alt="@book.Title" class="pub-book-card__cover">
                            <div class="demo-overlay position-absolute top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center">
                                <button class="wp-btn wp-btn-primary" onclick="viewBookDemo(@book.Id)">
                                    <i class="bi bi-eye me-1" aria-hidden="true"></i>View Details
                                </button>
                            </div>
                            <div class="demo-badge position-absolute top-0 start-0 m-2">
                                <span class="wp-badge bg-success text-white">
                                    <i class="bi bi-play-circle me-1" aria-hidden="true"></i>Demo
                                </span>
                            </div>
                            @if (book.StockQuantity > 0)
                            {
                                <span class="wp-badge bg-success text-white position-absolute top-0 end-0 m-2">
                                    <i class="bi bi-check-circle me-1" aria-hidden="true"></i>In Stock
                                </span>
                            }
                            else
                            {
                                <span class="wp-badge bg-danger text-white position-absolute top-0 end-0 m-2">
                                    <i class="bi bi-x-circle me-1" aria-hidden="true"></i>Out of Stock
                                </span>
                            }
                        </div>
                        <div class="pub-book-card__body">
                            @if (!string.IsNullOrEmpty(book.Category?.Name))
                            {
                                <span class="wp-badge bg-info text-white pub-book-card__badge">
                                    <i class="bi bi-tag me-1" aria-hidden="true"></i>@book.Category.Name
                                </span>
                            }
                            <h3 class="pub-book-card__title">@book.Title</h3>
                            <p class="pub-book-card__author"><i class="bi bi-person me-1" aria-hidden="true"></i>@book.Author</p>
                            <div class="pub-book-card__footer">
                                <span class="pub-book-card__price">₹@book.Price.Amount.ToString("N2")</span>
                                @if (book.AverageRating > 0)
                                {
                                    <span class="text-warning">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            <i class="bi @(i <= book.AverageRating ? "bi-star-fill" : "bi-star")" aria-hidden="true"></i>
                                        }
                                    </span>
                                }
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div style="grid-column: 1 / -1;" class="text-center py-5">
                    <i class="bi bi-book display-1 text-muted" aria-hidden="true"></i>
                    <h3 class="mt-3">Loading demo content...</h3>
                    <p class="text-muted">Please wait while we prepare the interactive demo</p>
                </div>
            }
        </div>
    </div>
</section>

<section class="pub-section pub-section--alt">
