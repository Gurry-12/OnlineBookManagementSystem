        function createDemoModal(title, content) {
            // Remove existing modal if present
            const existingModal = document.getElementById('demoModal');
            if (existingModal) {
                existingModal.remove();
            }
            
            // Create modal HTML
            const modalHTML = `
                <div class="modal fade" id="demoModal" tabindex="-1" aria-labelledby="demoModalLabel" aria-hidden="true">
                    <div class="modal-dialog modal-lg">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title" id="demoModalLabel">${title}</h5>
                                <button type="button" class="wp-btn wp-btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body">
                                ${content}
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="wp-btn wp-btn-secondary" data-bs-dismiss="modal">Close</button>
                            </div>
                        </div>
                    </div>
                </div>
            `;
            
            // Add modal to DOM
            document.body.insertAdjacentHTML('beforeend', modalHTML);
            
            // Show modal
            const modal = new bootstrap.Modal(document.getElementById('demoModal'));
            modal.show();
            
            // Clean up when modal is hidden
            document.getElementById('demoModal').addEventListener('hidden.bs.modal', function() {
                this.remove();
            });
            
            return modal;
        }
        
        function displaySearchResults(books, query) {
            const resultsSection = document.getElementById('searchResults');
            const resultsCount = document.getElementById('searchResultsCount');
            const resultsGrid = document.getElementById('searchResultsGrid');
            
            resultsCount.textContent = `Found ${books.totalBooks} results for "${query}"`;
            resultsGrid.innerHTML = '';
            
            if (books.books && books.books.length > 0) {
                books.books.forEach(book => {
                    const bookCard = createBookCard(book);
                    resultsGrid.appendChild(bookCard);
                });
            } else {
                resultsGrid.innerHTML = `
                    <div class="col-12">
                        <div class="text-center py-5">
                            <i class="bi bi-search display-1 text-muted"></i>
                            <h4 class="mt-3">No books found</h4>
                            <p class="text-muted">Try searching with different keywords</p>
                        </div>
                    </div>
                `;
            }
            
            resultsSection.style.display = 'block';
            resultsSection.scrollIntoView({ behavior: 'smooth' });
        }
        
        function displayCategoryResults(books, categoryName) {
            const resultsSection = document.getElementById('categoryResults');
            const resultsTitle = document.getElementById('categoryResultsTitle');
            const resultsCount = document.getElementById('categoryResultsCount');
            const resultsGrid = document.getElementById('categoryResultsGrid');
            
            resultsTitle.textContent = categoryName;
            resultsCount.textContent = `${books.totalBooks} books in this category`;
            resultsGrid.innerHTML = '';
            
            if (books.books && books.books.length > 0) {
                books.books.forEach(book => {
                    const bookCard = createBookCard(book);
                    resultsGrid.appendChild(bookCard);
                });
            } else {
                resultsGrid.innerHTML = `
                    <div class="col-12">
                        <div class="text-center py-5">
                            <i class="bi bi-book display-1 text-muted"></i>
                            <h4 class="mt-3">No books in this category</h4>
                            <p class="text-muted">Check back soon for new additions</p>
                        </div>
                    </div>
                `;
            }
            
            resultsSection.style.display = 'block';
            resultsSection.scrollIntoView({ behavior: 'smooth' });
        }
        
        function createBookCard(book) {
            const col = document.createElement('div');
            col.className = 'col-lg-3 col-md-4 col-sm-6';
            
            const imageUrl = book.imageUrl || '/images/default-book-improved.svg';
            const stockBadge = book.stockQuantity > 0 
                ? '<span class="wp-badge text-white bg-success position-absolute top-0 end-0 m-2"><i class="bi bi-check-circle me-1"></i>In Stock</span>'
                : '<span class="wp-badge text-white bg-danger position-absolute top-0 end-0 m-2"><i class="bi bi-x-circle me-1"></i>Out of Stock</span>';
            
            col.innerHTML = `
                <div class="demo-book-card spotlight-card hover-lift h-100">
                    <div class="book-image-wrapper position-relative">
                        <img src="${imageUrl}" alt="${book.title}" class="demo-book-cover w-100">
                        <div class="demo-overlay position-absolute top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center">
                            <button class="wp-btn wp-btn-light" onclick="viewBookDemo(${book.id})">
                                <i class="bi bi-eye me-1"></i>View Details
                            </button>
                        </div>
                        <div class="demo-badge position-absolute top-0 start-0 m-2">
                            <span class="wp-badge text-white bg-success bg-opacity-90">
                                <i class="bi bi-play-circle me-1"></i>Demo
                            </span>
                        </div>
                        ${stockBadge}
                    </div>
                    <div class="book-details p-3">
                        <h5 class="book-title mb-2 text-truncate">${book.title}</h5>
                        <p class="book-author text-muted mb-2">
                            <i class="bi bi-person me-1"></i>${book.author}
                        </p>
                        ${book.category ? `<span class="wp-badge bg-info mb-2"><i class="bi bi-tag me-1"></i>${book.category.name}</span>` : ''}
                        <div class="d-flex justify-content-between align-items-center mt-3">
                            <span class="book-price fw-bold text-primary fs-5">₹${book.price.amount.toFixed(2)}</span>
                            <div class="book-rating">
                                ${book.averageRating > 0 ? generateStarRating(book.averageRating) : ''}
                            </div>
                        </div>
                    </div>
                </div>
            `;
            
            return col;
        }
        
        function generateStarRating(rating) {
            let stars = '<span class="text-warning">';
            for (let i = 1; i <= 5; i++) {
                stars += `<i class="bi ${i <= rating ? 'bi-star-fill' : 'bi-star'}"></i>`;
            }
            stars += '</span>';
            return stars;
        }
        
        function hideSearchResults() {
            document.getElementById('searchResults').style.display = 'none';
        }
        
        function showLoading() {
            document.getElementById('loadingOverlay').style.display = 'flex';
        }
        
        function hideLoading() {
            document.getElementById('loadingOverlay').style.display = 'none';
        }
        
        function showError(message) {
