                        <p class="small text-muted mb-0">User fills registration form</p>
                    </div>
                    <div class="pub-workflow-step">
                        <div class="pub-step-number bg-info">2</div>
                        <h4 class="h6 fw-bold">Validation</h4>
                        <p class="small text-muted mb-0">Server-side validation and security checks</p>
                    </div>
                    <div class="pub-workflow-step">
                        <div class="pub-step-number bg-warning">3</div>
                        <h4 class="h6 fw-bold">Email Verification</h4>
                        <p class="small text-muted mb-0">Confirmation email sent</p>
                    </div>
                    <div class="pub-workflow-step">
                        <div class="pub-step-number" style="background: var(--color-success);">4</div>
                        <h4 class="h6 fw-bold">Role Assignment</h4>
                        <p class="small text-muted mb-0">Default User role assigned</p>
                    </div>
                    <div class="pub-workflow-step">
                        <div class="pub-step-number" style="background: var(--color-text);">5</div>
                        <h4 class="h6 fw-bold">Admin Approval</h4>
                        <p class="small text-muted mb-0">Admin reviews and approves</p>
                    </div>
                    <div class="pub-workflow-step">
                        <div class="pub-step-number" style="background: var(--color-success);">6</div>
                        <h4 class="h6 fw-bold">Access Granted</h4>
