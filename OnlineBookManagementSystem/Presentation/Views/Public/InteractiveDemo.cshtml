@model OnlineBookManagementSystem.Presentation.ViewModels.Showcase.InteractiveDemoViewModel
@{
    ViewData["Title"] = ViewBag.Title ?? "Interactive Demo - Live System Showcase";
    Layout = "_LayoutPublic";
}

<!-- Demo Hero Section -->
<section class="demo-hero aurora-bg noise-overlay py-5">
    <div class="container">
        <div class="row align-items-center min-vh-50">
            <div class="col-lg-8 mx-auto text-center" data-fade-in>
                <div class="hero-content">
                    <div class="hero-badge mb-3">
                        <span class="badge bg-success bg-opacity-20 text-success px-4 py-2 rounded-pill fs-6">
                            <i class="bi bi-play-circle me-2"></i>Live Interactive Demo
                        </span>
                    </div>
                    <h1 class="display-3 fw-bold text-white mb-4">
                        Experience the System Live
                    </h1>
                    <p class="lead text-white-75 mb-4 fs-4">
                        Explore the full functionality with real data. Search, browse, and interact 
                        with the book management system in read-only demo mode.
                    </p>
                    <div class="demo-stats d-flex justify-content-center gap-4 mb-4">
                        <div class="stat-item text-center">
                            <div class="stat-value text-white fw-bold fs-3">@Model.Statistics.TotalBooks</div>
                            <div class="stat-label text-white-50 small">Books Available</div>
                        </div>
                        <div class="stat-item text-center">
                            <div class="stat-value text-white fw-bold fs-3">@Model.Categories.Count</div>
                            <div class="stat-label text-white-50 small">Categories</div>
                        </div>
                        <div class="stat-item text-center">
                            <div class="stat-value text-white fw-bold fs-3">@Model.Statistics.AverageRating.ToString("F1")</div>
                            <div class="stat-label text-white-50 small">Avg Rating</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Interactive Search Section -->
<section class="search-demo py-5">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="display-5 fw-bold mb-3">Live Search Demo</h2>
            <p class="lead text-muted">Search through our book collection in real-time</p>
        </div>

        <div class="row justify-content-center mb-5">
            <div class="col-lg-8">
                <div class="search-container glass p-4 rounded-4" data-fade-in>
                    <div class="search-form">
                        <div class="input-group input-group-lg">
                            <span class="input-group-text bg-transparent border-0">
                                <i class="bi bi-search text-muted"></i>
                            </span>
                            <input type="text" id="demoSearch" class="form-control border-0 bg-transparent" 
                                   placeholder="Search books by title, author, or category..." 
                                   autocomplete="off">
                            <button class="btn btn-primary" type="button" onclick="performDemoSearch()">
                                <i class="bi bi-search me-2"></i>Search
                            </button>
                        </div>
                    </div>
                    <div class="search-suggestions mt-3">
                        <small class="text-muted">Try searching for: "fiction", "programming", "history", or any author name</small>
                    </div>
                </div>
            </div>
        </div>

        <!-- Search Results -->
        <div id="searchResults" class="search-results" style="display: none;">
            <div class="text-center mb-4">
                <h4 class="fw-bold">Search Results</h4>
                <div id="searchResultsCount" class="text-muted"></div>
            </div>
            <div id="searchResultsGrid" class="row g-4">
                <!-- Results will be populated by JavaScript -->
            </div>
        </div>
    </div>
</section>

<!-- Category Browse Demo -->
<section class="category-demo py-5 bg-light">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="display-5 fw-bold mb-3">Browse by Category</h2>
            <p class="lead text-muted">Explore books organized by genre and topic</p>
        </div>

        <div class="row g-4">
            @foreach (var category in Model.Categories.Take(8))
            {
                <div class="col-lg-3 col-md-4 col-sm-6" data-fade-in>
                    <div class="category-demo-card glass spotlight-card hover-lift text-decoration-none d-block p-4 text-center cursor-pointer"
                         onclick="browseCategoryDemo(@category.Id, '@category.Name')">
                        <div class="category-icon mb-3">
                            <i class="@category.IconClass text-primary" style="font-size: 2.5rem;"></i>
                        </div>
                        <h5 class="category-name fw-bold mb-2">@category.Name</h5>
                        <p class="category-description text-muted small mb-2">@category.Description</p>
                        <div class="category-stats">
                            <span class="badge bg-primary bg-opacity-20 text-primary">
                                @category.BookCount books
                            </span>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Category Results -->
        <div id="categoryResults" class="category-results mt-5" style="display: none;">
            <div class="text-center mb-4">
                <h4 class="fw-bold">Category: <span id="categoryResultsTitle"></span></h4>
                <div id="categoryResultsCount" class="text-muted"></div>
            </div>
            <div id="categoryResultsGrid" class="row g-4">
                <!-- Results will be populated by JavaScript -->
            </div>
        </div>
    </div>
</section>

<!-- Featured Books Demo -->
<section class="featured-demo py-5">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="display-5 fw-bold mb-3">Featured Books</h2>
            <p class="lead text-muted">Handpicked selections from our collection</p>
        </div>

        <div class="row g-4">
            @if (Model.FeaturedBooks.Books.Any())
            {
                @foreach (var book in Model.FeaturedBooks.Books)
                {
                    <div class="col-lg-3 col-md-4 col-sm-6" data-fade-in>
                        <div class="demo-book-card spotlight-card hover-lift h-100">
                            <div class="book-image-wrapper position-relative">
                                <img src="@(book.ImageUrl ?? Url.Content("~/images/default-book-improved.svg"))" 
                                     alt="@book.Title" 
                                     class="book-cover w-100" 
                                     style="height: 300px; object-fit: cover; border-radius: 12px 12px 0 0;">
                                
                                <div class="demo-overlay position-absolute top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center"
                                     style="background: rgba(0,0,0,0.7); opacity: 0; transition: opacity 0.3s ease; border-radius: 12px 12px 0 0;">
                                    <button class="btn btn-light btn-sm" onclick="viewBookDemo(@book.Id)">
                                        <i class="bi bi-eye me-1"></i>View Details
                                    </button>
                                </div>
                                
                                <div class="demo-badge position-absolute top-0 start-0 m-2">
                                    <span class="badge bg-success bg-opacity-90">
                                        <i class="bi bi-play-circle me-1"></i>Demo
                                    </span>
                                </div>
                                
                                @if (book.StockQuantity > 0)
                                {
                                    <span class="badge bg-success position-absolute top-0 end-0 m-2">
                                        <i class="bi bi-check-circle me-1"></i>In Stock
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger position-absolute top-0 end-0 m-2">
                                        <i class="bi bi-x-circle me-1"></i>Out of Stock
                                    </span>
                                }
                            </div>
                            
                            <div class="book-details p-3">
                                <h5 class="book-title mb-2 text-truncate">@book.Title</h5>
                                <p class="book-author text-muted mb-2">
                                    <i class="bi bi-person me-1"></i>@book.Author
                                </p>
                                
                                @if (!string.IsNullOrEmpty(book.Category?.Name))
                                {
                                    <span class="badge bg-info mb-2">
                                        <i class="bi bi-tag me-1"></i>@book.Category.Name
                                    </span>
                                }
                                
                                <div class="d-flex justify-content-between align-items-center mt-3">
                                    <span class="book-price fw-bold text-primary fs-5">
                                        ₹@book.Price.Amount.ToString("N2")
                                    </span>
                                    <div class="book-rating">
                                        @if (book.AverageRating > 0)
                                        {
                                            <span class="text-warning">
                                                @for (int i = 1; i <= 5; i++)
                                                {
                                                    <i class="bi @(i <= book.AverageRating ? "bi-star-fill" : "bi-star")"></i>
                                                }
                                            </span>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12">
                    <div class="text-center py-5">
                        <i class="bi bi-book display-1 text-muted"></i>
                        <h4 class="mt-3">Loading demo content...</h4>
                        <p class="text-muted">Please wait while we prepare the interactive demo</p>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- Feature Showcases -->
<section class="feature-showcases py-5 bg-light">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="display-5 fw-bold mb-3">System Features & Capabilities</h2>
            <p class="lead text-muted">Comprehensive feature demonstrations with technical insights</p>
        </div>

        <!-- Feature Comparison Table -->
        <div class="row mb-5">
            <div class="col-12">
                <div class="glass p-4">
                    <h3 class="mb-4">
                        <i class="bi bi-table me-2"></i>Feature Comparison Matrix
                    </h3>
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead class="table-dark">
                                <tr>
                                    <th>Feature Category</th>
                                    <th class="text-center">Demo Mode</th>
                                    <th class="text-center">User Role</th>
                                    <th class="text-center">Admin Role</th>
                                    <th class="text-center">SuperAdmin Role</th>
                                    <th>Technical Implementation</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td><strong>Book Management</strong></td>
                                    <td class="text-center"><i class="bi bi-eye text-warning" title="View Only"></i></td>
                                    <td class="text-center"><i class="bi bi-eye text-warning" title="View Only"></i></td>
                                    <td class="text-center"><i class="bi bi-check-circle text-success" title="Full Access"></i></td>
                                    <td class="text-center"><i class="bi bi-check-circle text-success" title="Full Access"></i></td>
                                    <td><small>Repository pattern, CQRS, Domain events</small></td>
                                </tr>
                                <tr>
                                    <td><strong>User Management</strong></td>
                                    <td class="text-center"><i class="bi bi-x-circle text-danger" title="No Access"></i></td>
                                    <td class="text-center"><i class="bi bi-person text-info" title="Self Only"></i></td>
                                    <td class="text-center"><i class="bi bi-check-circle text-success" title="Full Access"></i></td>
                                    <td class="text-center"><i class="bi bi-check-circle text-success" title="Full Access"></i></td>
                                    <td><small>Identity framework, Role-based authorization</small></td>
                                </tr>
                                <tr>
                                    <td><strong>Order Processing</strong></td>
                                    <td class="text-center"><i class="bi bi-x-circle text-danger" title="No Access"></i></td>
                                    <td class="text-center"><i class="bi bi-check-circle text-success" title="Full Access"></i></td>
                                    <td class="text-center"><i class="bi bi-check-circle text-success" title="Full Access"></i></td>
                                    <td class="text-center"><i class="bi bi-check-circle text-success" title="Full Access"></i></td>
                                    <td><small>Order aggregate, State machine, Payment integration</small></td>
                                </tr>
                                <tr>
                                    <td><strong>Analytics & Reports</strong></td>
                                    <td class="text-center"><i class="bi bi-x-circle text-danger" title="No Access"></i></td>
                                    <td class="text-center"><i class="bi bi-x-circle text-danger" title="No Access"></i></td>
                                    <td class="text-center"><i class="bi bi-check-circle text-success" title="Full Access"></i></td>
                                    <td class="text-center"><i class="bi bi-check-circle text-success" title="Full Access"></i></td>
                                    <td><small>Chart.js, Real-time data, Caching strategies</small></td>
                                </tr>
                                <tr>
                                    <td><strong>System Configuration</strong></td>
                                    <td class="text-center"><i class="bi bi-x-circle text-danger" title="No Access"></i></td>
                                    <td class="text-center"><i class="bi bi-x-circle text-danger" title="No Access"></i></td>
                                    <td class="text-center"><i class="bi bi-x-circle text-danger" title="No Access"></i></td>
                                    <td class="text-center"><i class="bi bi-check-circle text-success" title="Full Access"></i></td>
                                    <td><small>Configuration management, System monitoring</small></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <div class="mt-3">
                        <small class="text-muted">
                            <i class="bi bi-info-circle me-1"></i>
                            <strong>Legend:</strong> 
                            <i class="bi bi-check-circle text-success me-1"></i>Full Access
                            <i class="bi bi-eye text-warning me-1"></i>View Only
                            <i class="bi bi-person text-info me-1"></i>Self Only
                            <i class="bi bi-x-circle text-danger me-1"></i>No Access
                        </small>
                    </div>
                </div>
            </div>
        </div>

        <!-- Individual Feature Cards -->
        <div class="row g-4">
            @foreach (var feature in Model.FeatureShowcases)
            {
                <div class="col-lg-4 col-md-6" data-fade-in>
                    <div class="feature-showcase-card glass spotlight-card hover-lift h-100 p-4">
                        <div class="feature-header mb-3">
                            <div class="feature-category mb-2">
                                <span class="badge bg-primary bg-opacity-20 text-primary">@feature.Category</span>
                            </div>
                            <h4 class="feature-title fw-bold mb-2">@feature.FeatureName</h4>
                        </div>
                        <p class="feature-description text-muted mb-3">@feature.Description</p>
                        @if (feature.IsInteractive)
                        {
                            <div class="feature-demo mb-3">
                                <button class="btn btn-outline-primary btn-sm" onclick="demonstrateFeature('@feature.FeatureName')">
                                    <i class="bi bi-play-circle me-1"></i>Try Feature
                                </button>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(feature.ScreenshotUrl))
                        {
                            <div class="feature-screenshot">
                                <img src="@feature.ScreenshotUrl" alt="@feature.FeatureName Screenshot" 
                                     class="img-fluid rounded">
                            </div>
                        }
                    </div>
                </div>
            }
            
            <!-- Additional Static Feature Cards -->
            <div class="col-lg-4 col-md-6" data-fade-in>
                <div class="feature-showcase-card glass spotlight-card hover-lift h-100 p-4">
                    <div class="feature-header mb-3">
                        <div class="feature-category mb-2">
                            <span class="badge bg-success bg-opacity-20 text-success">Architecture</span>
                        </div>
                        <h4 class="feature-title fw-bold mb-2">Clean Architecture</h4>
                    </div>
                    <p class="feature-description text-muted mb-3">
                        Implements Uncle Bob's Clean Architecture with clear separation of concerns and dependency inversion.
                    </p>
                    <div class="feature-demo mb-3">
                        <button class="btn btn-outline-success btn-sm" onclick="showArchitectureDemo()">
                            <i class="bi bi-diagram-3 me-1"></i>View Architecture
                        </button>
                    </div>
                    <div class="tech-highlights">
                        <small class="text-muted">
                            <i class="bi bi-check text-success me-1"></i>Domain-Driven Design<br>
                            <i class="bi bi-check text-success me-1"></i>SOLID Principles<br>
                            <i class="bi bi-check text-success me-1"></i>Testable Architecture
                        </small>
                    </div>
                </div>
            </div>
            
            <div class="col-lg-4 col-md-6" data-fade-in>
                <div class="feature-showcase-card glass spotlight-card hover-lift h-100 p-4">
                    <div class="feature-header mb-3">
                        <div class="feature-category mb-2">
                            <span class="badge bg-warning bg-opacity-20 text-warning">Security</span>
                        </div>
                        <h4 class="feature-title fw-bold mb-2">Role-Based Security</h4>
                    </div>
                    <p class="feature-description text-muted mb-3">
                        Comprehensive security with JWT authentication, role-based authorization, and data protection.
                    </p>
                    <div class="feature-demo mb-3">
                        <button class="btn btn-outline-warning btn-sm" onclick="showSecurityDemo()">
                            <i class="bi bi-shield-lock me-1"></i>Security Features
                        </button>
                    </div>
                    <div class="tech-highlights">
                        <small class="text-muted">
                            <i class="bi bi-check text-success me-1"></i>JWT Authentication<br>
                            <i class="bi bi-check text-success me-1"></i>Claims-based Authorization<br>
                            <i class="bi bi-check text-success me-1"></i>Data Protection
                        </small>
                    </div>
                </div>
            </div>
            
            <div class="col-lg-4 col-md-6" data-fade-in>
                <div class="feature-showcase-card glass spotlight-card hover-lift h-100 p-4">
                    <div class="feature-header mb-3">
                        <div class="feature-category mb-2">
                            <span class="badge bg-info bg-opacity-20 text-info">UI/UX</span>
                        </div>
                        <h4 class="feature-title fw-bold mb-2">Modern UI Effects</h4>
                    </div>
                    <p class="feature-description text-muted mb-3">
                        Glass morphism, aurora backgrounds, and smooth animations create an engaging user experience.
                    </p>
                    <div class="feature-demo mb-3">
                        <button class="btn btn-outline-info btn-sm" onclick="showUIDemo()">
                            <i class="bi bi-palette me-1"></i>UI Showcase
                        </button>
                    </div>
                    <div class="tech-highlights">
                        <small class="text-muted">
                            <i class="bi bi-check text-success me-1"></i>Glass Morphism<br>
                            <i class="bi bi-check text-success me-1"></i>CSS3 Animations<br>
                            <i class="bi bi-check text-success me-1"></i>Responsive Design
                        </small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Workflow Demonstration -->
<section class="workflow-demo py-5">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="display-5 fw-bold mb-3">System Workflows</h2>
            <p class="lead text-muted">End-to-end process demonstrations</p>
        </div>
        
        <!-- User Registration Workflow -->
        <div class="workflow-section mb-5">
            <div class="glass p-4">
                <h3 class="mb-4">
                    <i class="bi bi-person-plus me-2"></i>User Registration Workflow
                </h3>
                <div class="workflow-steps">
                    <div class="row g-4">
                        <div class="col-md-2">
                            <div class="workflow-step text-center p-3 bg-light rounded">
                                <div class="step-number bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 50px; height: 50px;">
                                    1
                                </div>
                                <h6 class="fw-bold">Registration</h6>
                                <p class="small text-muted mb-0">User fills registration form</p>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="workflow-step text-center p-3 bg-light rounded">
                                <div class="step-number bg-info text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 50px; height: 50px;">
                                    2
                                </div>
                                <h6 class="fw-bold">Validation</h6>
                                <p class="small text-muted mb-0">Server-side validation and security checks</p>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="workflow-step text-center p-3 bg-light rounded">
                                <div class="step-number bg-warning text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 50px; height: 50px;">
                                    3
                                </div>
                                <h6 class="fw-bold">Email Verification</h6>
                                <p class="small text-muted mb-0">Confirmation email sent</p>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="workflow-step text-center p-3 bg-light rounded">
                                <div class="step-number bg-success text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 50px; height: 50px;">
                                    4
                                </div>
                                <h6 class="fw-bold">Role Assignment</h6>
                                <p class="small text-muted mb-0">Default User role assigned</p>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="workflow-step text-center p-3 bg-light rounded">
                                <div class="step-number bg-dark text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 50px; height: 50px;">
                                    5
                                </div>
                                <h6 class="fw-bold">Admin Approval</h6>
                                <p class="small text-muted mb-0">Admin reviews and approves</p>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="workflow-step text-center p-3 bg-light rounded">
                                <div class="step-number bg-success text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 50px; height: 50px;">
                                    6
                                </div>
                                <h6 class="fw-bold">Access Granted</h6>
                                <p class="small text-muted mb-0">User can access full system</p>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="mt-4 p-3 bg-dark text-light rounded">
                    <h6 class="text-warning mb-2">
                        <i class="bi bi-code me-1"></i>Technical Implementation
                    </h6>
                    <small>
                        Uses ASP.NET Core Identity with custom user entity, email service integration, 
                        role-based authorization with claims, and admin approval workflow with notifications.
                    </small>
                </div>
            </div>
        </div>
        
        <!-- Book Purchase Workflow -->
        <div class="workflow-section mb-5">
            <div class="glass p-4">
                <h3 class="mb-4">
                    <i class="bi bi-cart me-2"></i>Book Purchase Workflow
                </h3>
                <div class="workflow-steps">
                    <div class="row g-4">
                        <div class="col-md-3">
                            <div class="workflow-step text-center p-3 bg-light rounded">
                                <div class="step-number bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 50px; height: 50px;">
                                    1
                                </div>
                                <h6 class="fw-bold">Browse & Select</h6>
                                <p class="small text-muted mb-0">User browses and adds books to cart</p>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="workflow-step text-center p-3 bg-light rounded">
                                <div class="step-number bg-info text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 50px; height: 50px;">
                                    2
                                </div>
                                <h6 class="fw-bold">Checkout</h6>
                                <p class="small text-muted mb-0">Review cart and enter shipping details</p>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="workflow-step text-center p-3 bg-light rounded">
                                <div class="step-number bg-warning text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 50px; height: 50px;">
                                    3
                                </div>
                                <h6 class="fw-bold">Payment</h6>
                                <p class="small text-muted mb-0">Secure payment processing</p>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="workflow-step text-center p-3 bg-light rounded">
                                <div class="step-number bg-success text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 50px; height: 50px;">
                                    4
                                </div>
                                <h6 class="fw-bold">Order Fulfillment</h6>
                                <p class="small text-muted mb-0">Order processing and delivery</p>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="mt-4 p-3 bg-dark text-light rounded">
                    <h6 class="text-warning mb-2">
                        <i class="bi bi-code me-1"></i>Technical Implementation
                    </h6>
                    <small>
                        Order aggregate with domain events, state machine pattern for order status, 
