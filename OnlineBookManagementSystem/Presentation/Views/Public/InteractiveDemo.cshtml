        <!-- Book Purchase Workflow -->
        <div>
            <div class="glass p-4">
                <h3 class="mb-4">
                    <i class="bi bi-cart me-2" aria-hidden="true"></i>Book Purchase Workflow
                </h3>
                <div class="pub-workflow-steps">
                    <div class="pub-workflow-step">
                        <div class="pub-step-number bg-primary">1</div>
                        <h4 class="h6 fw-bold">Browse &amp; Select</h4>
                        <p class="small text-muted mb-0">User browses and adds books to cart</p>
                    </div>
                    <div class="pub-workflow-step">
                        <div class="pub-step-number bg-info">2</div>
                        <h4 class="h6 fw-bold">Checkout</h4>
                        <p class="small text-muted mb-0">Review cart and enter shipping details</p>
                    </div>
                    <div class="pub-workflow-step">
                        <div class="pub-step-number bg-warning">3</div>
                        <h4 class="h6 fw-bold">Payment</h4>
                        <p class="small text-muted mb-0">Secure payment processing</p>
                    </div>
                    <div class="pub-workflow-step">
                        <div class="pub-step-number" style="background: var(--color-success);">4</div>
                        <h4 class="h6 fw-bold">Order Fulfillment</h4>
                        <p class="small text-muted mb-0">Order processing and delivery</p>
                    </div>
                </div>
                <div class="mt-4 p-3 bg-dark text-light rounded">
                    <h4 class="h6 text-warning mb-2">
                        <i class="bi bi-code me-1" aria-hidden="true"></i>Technical Implementation
                    </h4>
                    <small>
                        Order aggregate with domain events, state machine pattern for order status,
                        payment gateway integration, inventory management, and email notifications.
                    </small>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="demo-actions aurora-bg noise-overlay">
    <div class="pub-hero--centered">
        <h2 class="pub-section__title ">Ready to Get Started?</h2>
        <p class="pub-hero__description ">
            Experience the full system by creating your account and accessing all features.
        </p>
        <div class="pub-hero__actions">
            <a asp-controller="Auth" asp-action="Registration" class="wp-btn wp-btn-primary magnetic-btn holographic wp-btn-lg">
                <i class="bi bi-person-plus me-2" aria-hidden="true"></i>Create Account
            </a>
            <a asp-controller="Auth" asp-action="Login" class="wp-btn wp-btn-secondary magnetic-btn wp-btn-lg">
                <i class="bi bi-box-arrow-in-right me-2" aria-hidden="true"></i>Login
            </a>
            <a asp-action="TechnicalDetails" class="wp-btn wp-btn-outline magnetic-btn wp-btn-lg">
                <i class="bi bi-gear me-2" aria-hidden="true"></i>Technical Details
            </a>
        </div>
    </div>
</section>

<!-- Loading Overlay -->
<div id="loadingOverlay" class="loading-overlay" style="display: none;">
    <div class="loading-content">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <p class="mt-3">Loading demo content...</p>
    </div>
</div>

@section Styles {
    
}

@section Scripts {
    <script>
        // Demo functionality
        let searchTimeout;
        
        document.addEventListener('DOMContentLoaded', function() {
            console.log('Interactive demo page loaded');
            
            // Setup search input
            const searchInput = document.getElementById('demoSearch');
            searchInput.addEventListener('input', function() {
                clearTimeout(searchTimeout);
                searchTimeout = setTimeout(() => {
                    if (this.value.length >= 2) {
                        performDemoSearch();
                    } else if (this.value.length === 0) {
                        hideSearchResults();
                    }
                }, 500);
            });
            
            // Setup enter key for search
            searchInput.addEventListener('keypress', function(e) {
                if (e.key === 'Enter') {
                    performDemoSearch();
                }
            });
        });
        
        function performDemoSearch() {
            const query = document.getElementById('demoSearch').value.trim();
            if (!query) return;
            
            showLoading();
            
            fetch(`/Public/SearchBooks?query=${encodeURIComponent(query)}`)
                .then(response => response.json())
                .then(data => {
                    hideLoading();
                    if (data.success) {
                        displaySearchResults(data.data, query);
                    } else {
                        showError('Search temporarily unavailable. Please try again later.');
                    }
                })
                .catch(error => {
                    hideLoading();
                    console.error('Search error:', error);
                    showError('Search failed. Please try again.');
                });
        }
        
        function browseCategoryDemo(categoryId, categoryName) {
            showLoading();
            
            fetch(`/Public/GetBooksByCategory?categoryId=${categoryId}`)
                .then(response => response.json())
                .then(data => {
                    hideLoading();
                    if (data.success) {
                        displayCategoryResults(data.data, categoryName);
                    } else {
                        showError('Category data temporarily unavailable.');
                    }
                })
                .catch(error => {
                    hideLoading();
                    console.error('Category browse error:', error);
                    showError('Failed to load category. Please try again.');
                });
        }
        
        function viewBookDemo(bookId) {
            // In a real implementation, this would open a modal or navigate to book details
            window.open(`/Public/BookDetails/${bookId}`, '_blank');
        }
        
        function demonstrateFeature(featureName) {
            // Enhanced feature demonstrations with more detail
            const demonstrations = {
                'Admin Dashboard': showAdminDashboardDemo,
                'Book Management': showBookManagementDemo,
                'User Management': showUserManagementDemo,
                'Order Processing': showOrderProcessingDemo,
                'Analytics': showAnalyticsDemo
            };
            
            const demoFunction = demonstrations[featureName];
            if (demoFunction) {
                demoFunction();
            } else {
                showGenericFeatureDemo(featureName);
            }
        }
        
        function showArchitectureDemo() {
            const modal = createDemoModal('Clean Architecture Implementation', `
                <div class="architecture-demo">
                    <h5 class="mb-3">Clean Architecture Layers</h5>
                    <div class="architecture-diagram mb-4">
                        <div class="layer presentation-layer p-3 mb-2 rounded" style="background: #4CAF50; color: white;">
                            <strong>Presentation Layer</strong><br>
                            <small>Controllers, Views, ViewModels</small>
                        </div>
                        <div class="layer application-layer p-3 mb-2 rounded" style="background: #2196F3; color: white;">
                            <strong>Application Layer</strong><br>
                            <small>Use Cases, Interfaces, DTOs</small>
                        </div>
                        <div class="layer domain-layer p-3 mb-2 rounded" style="background: #FF9800; color: white;">
                            <strong>Domain Layer</strong><br>
                            <small>Entities, Value Objects, Business Rules</small>
                        </div>
                        <div class="layer infrastructure-layer p-3 mb-2 rounded" style="background: #9C27B0; color: white;">
                            <strong>Infrastructure Layer</strong><br>
                            <small>Data Access, External Services</small>
                        </div>
                    </div>
                    <h6>Key Benefits:</h6>
                    <ul>
                        <li>Testable architecture with dependency inversion</li>
                        <li>Clear separation of concerns</li>
                        <li>Framework-independent business logic</li>
                        <li>Maintainable and scalable codebase</li>
                    </ul>
                </div>
            `);
        }
        
        function showSecurityDemo() {
            const modal = createDemoModal('Security Features', `
                <div class="security-demo">
                    <h5 class="mb-3">Multi-Layer Security Implementation</h5>
                    <div class="security-features">
                        <div class="security-feature mb-3 p-3 bg-light rounded">
                            <h6 class="text-primary"><i class="bi bi-shield-lock me-2"></i>Authentication</h6>
                            <ul class="mb-0">
                                <li>JWT token-based authentication</li>
                                <li>Secure password hashing with bcrypt</li>
                                <li>Email verification workflow</li>
                                <li>Account lockout protection</li>
                            </ul>
                        </div>
                        <div class="security-feature mb-3 p-3 bg-light rounded">
                            <h6 class="text-success"><i class="bi bi-person-check me-2"></i>Authorization</h6>
                            <ul class="mb-0">
                                <li>Role-based access control (RBAC)</li>
                                <li>Claims-based authorization</li>
                                <li>Resource-based permissions</li>
                                <li>Admin approval workflow</li>
                            </ul>
                        </div>
                        <div class="security-feature mb-3 p-3 bg-light rounded">
                            <h6 class="text-warning"><i class="bi bi-shield-check me-2"></i>Data Protection</h6>
                            <ul class="mb-0">
                                <li>XSS and CSRF protection</li>
                                <li>SQL injection prevention</li>
                                <li>Rate limiting and throttling</li>
                                <li>Secure data transmission (HTTPS)</li>
                            </ul>
                        </div>
                    </div>
                </div>
            `);
        }
        
        function showUIDemo() {
            const modal = createDemoModal('Modern UI Effects', `
                <div class="ui-demo">
                    <h5 class="mb-3">Advanced CSS Effects</h5>
                    <div class="ui-examples">
                        <div class="ui-example mb-3 p-3 glass rounded">
                            <h6><i class="bi bi-droplet me-2"></i>Glass Morphism</h6>
                            <p class="mb-0">Translucent backgrounds with backdrop blur effects for modern, layered interfaces.</p>
                        </div>
                        <div class="ui-example mb-3 p-3 aurora-bg noise-overlay rounded">
                            <h6 class=""><i class="bi bi-stars me-2"></i>Aurora Backgrounds</h6>
                            <p class=" mb-0">Dynamic gradient animations creating immersive visual experiences.</p>
                        </div>
                        <div class="ui-example mb-3 p-3 bg-light rounded spotlight-card">
                            <h6><i class="bi bi-magic me-2"></i>Interactive Elements</h6>
