@model OnlineBookManagementSystem.Presentation.ViewModels.Showcase.ShowcaseViewModel
@{
    ViewData["Title"] = "Online Book Management System - Clean Architecture Showcase";
    ViewData["Description"] = "Experience a comprehensive book management system built with Clean Architecture, SOLID principles, and modern web technologies. Interactive demo, technical insights, and professional portfolio showcase.";
    ViewData["Keywords"] = "clean architecture, book management system, ASP.NET Core, SOLID principles, software portfolio, modern web development, interactive demo, technical showcase";
    ViewData["OgImage"] = $"{Context.Request.Scheme}://{Context.Request.Host}/images/showcase-hero.jpg";
    ViewData["CanonicalUrl"] = $"{Context.Request.Scheme}://{Context.Request.Host}/";
    Layout = "_LayoutPublic";
    
    // Structured data for the homepage
    ViewData["StructuredData"] = @"
    <script type=""application/ld+json"">
    {
        ""@context"": ""https://schema.org"",
        ""@type"": ""SoftwareApplication"",
        ""name"": ""Whispering Pages - Online Book Management System"",
        ""description"": ""A comprehensive book management system showcasing Clean Architecture principles and modern web development practices."",
        ""url"": """ + $"{Context.Request.Scheme}://{Context.Request.Host}/" + @""",
        ""applicationCategory"": ""BusinessApplication"",
        ""operatingSystem"": ""Web Browser"",
        ""offers"": {
            ""@type"": ""Offer"",
            ""price"": ""0"",
            ""priceCurrency"": ""USD""
        },
        ""creator"": {
            ""@type"": ""Person"",
            ""name"": ""Whispering Pages Development Team""
        },
        ""featureList"": [
            ""Clean Architecture Implementation"",
            ""SOLID Principles"",
            ""Interactive Book Browsing"",
            ""Modern UI/UX Design"",
            ""Role-based Authentication"",
            ""Real-time Analytics""
        ]
    }
    </script>";
}

@* Hero Section — CSS Grid .pub-hero replacing Bootstrap col-lg-8/col-lg-4 *@
<section class="pub-section" style="padding-top: 0; padding-bottom: 0;" role="banner" aria-labelledby="hero-heading">
    <div class="pub-hero">
        <div class="pub-hero__content">
            <div class="pub-hero__eyebrow">
                <i class="bi bi-code-slash" aria-hidden="true"></i>
                Clean Architecture Portfolio
            </div>
            <h1 id="hero-heading" class="pub-hero__title">@Model.ProjectOverview.HeroTitle</h1>
            <h2 class="pub-hero__subtitle">@Model.ProjectOverview.HeroSubtitle</h2>
            <p class="pub-hero__description">@Model.ProjectOverview.Vision</p>
            <div class="pub-hero__actions" role="group" aria-label="Main navigation actions">
                <a asp-action="InteractiveDemo" class="wp-btn wp-btn-primary ">
                    <i class="bi bi-play-circle me-2" aria-hidden="true"></i>Live Demo
                </a>
                <a asp-action="TechnicalDetails" class="wp-btn wp-btn-outline ">
                    <i class="bi bi-gear me-2" aria-hidden="true"></i>Architecture
                </a>
                <a asp-controller="Auth" asp-action="Login" class="wp-btn wp-btn-outline ">
                    <i class="bi bi-box-arrow-in-right me-2" aria-hidden="true"></i>Login
                </a>
                <a asp-controller="Auth" asp-action="Registration" class="wp-btn wp-btn-ghost ">
                    <i class="bi bi-person-plus me-2" aria-hidden="true"></i>Register
                </a>
            </div>
            <div class="pub-hero__tech-pills" role="list" aria-label="Technology stack">
                <span class="pub-hero__tech-label">Built with:</span>
                @foreach (var tech in Model.TechnicalStack.BackendTechnologies.Take(4))
                {
                    <span class="wp-badge bg-primary  text-white border-0" role="listitem">@tech.Name</span>
                }
            </div>
        </div>
        <div class="pub-hero__visual">
            <div class="pub-hero__arch-card">
                @foreach (var layer in Model.Architecture.Layers)
                {
                    <div class="pub-hero__arch-layer" style="background-color: @layer.Color;">
                        <small>@layer.Name</small>
                    </div>
                }
                <p class="pub-hero__arch-label">@Model.Architecture.ArchitectureType</p>
            </div>
        </div>
    </div>
</section>

@* Stats Section — CSS Grid .pub-stats-grid *@
<section class="pub-section pub-section--alt" aria-labelledby="stats-heading">
    <div class="pub-section__inner">
        <div class="pub-section__header">
            <span class="pub-section__overline">Live Data</span>
            <h2 id="stats-heading" class="pub-section__title">System Statistics</h2>
            <p class="pub-section__subtitle">Real-time data from the production system</p>
        </div>
        <div class="pub-stats-grid" role="group" aria-label="System statistics">
            <div class="pub-stat-card">
                <i class="bi bi-book pub-stat-card__icon text-primary" aria-hidden="true"></i>
                <span class="pub-stat-card__value">@Model.Statistics.TotalBooks</span>
                <span class="pub-stat-card__label">Books</span>
            </div>
            <div class="pub-stat-card">
                <i class="bi bi-tags pub-stat-card__icon text-success" aria-hidden="true"></i>
                <span class="pub-stat-card__value">@Model.Statistics.TotalCategories</span>
                <span class="pub-stat-card__label">Categories</span>
            </div>
            <div class="pub-stat-card">
                <i class="bi bi-people pub-stat-card__icon text-info" aria-hidden="true"></i>
                <span class="pub-stat-card__value">@Model.Statistics.TotalUsers</span>
                <span class="pub-stat-card__label">Users</span>
            </div>
            <div class="pub-stat-card">
                <i class="bi bi-star pub-stat-card__icon text-warning" aria-hidden="true"></i>
                <span class="pub-stat-card__value">@Model.Statistics.AverageRating.ToString("F1")</span>
                <span class="pub-stat-card__label">Avg Rating</span>
            </div>
            <div class="pub-stat-card">
                <i class="bi bi-cart-check pub-stat-card__icon text-success" aria-hidden="true"></i>
                <span class="pub-stat-card__value">@Model.Statistics.TotalOrders</span>
                <span class="pub-stat-card__label">Orders</span>
            </div>
        </div>
    </div>
</section>
@* Feature Highlights — CSS Grid .pub-features-grid *@
<section class="pub-section">
    <div class="pub-section__inner">
        <div class="pub-section__header">
            <span class="pub-section__overline">Architecture</span>
            <h2 class="pub-section__title">Technical Highlights</h2>
            <p class="pub-section__subtitle">Key architectural and implementation achievements</p>
        </div>
        <div class="pub-features-grid">
            @foreach (var feature in Model.FeatureHighlights)
            {
                <article class="pub-feature-card">
                    <div class="pub-feature-card__category">
                        <span class="wp-badge bg-info  text-primary">@feature.Category</span>
                    </div>
                    <h3 class="pub-feature-card__title">@feature.FeatureName</h3>
                    <p class="pub-feature-card__desc">@feature.Description</p>
                    @if (feature.TechnicalDetails.Any())
                    {
                        <ul class="pub-feature-card__details">
                            @foreach (var detail in feature.TechnicalDetails)
                            {
                                <li class="pub-feature-card__detail-item">
                                    <i class="bi bi-check-circle pub-feature-card__check" aria-hidden="true"></i>
                                    <small>@detail</small>
                                </li>
                            }
                        </ul>
                    }
                </article>
            }
        </div>
        <div class="text-center mt-5">
            <a asp-action="TechnicalDetails" class="wp-btn wp-btn-primary wp-btn-lg">
                <i class="bi bi-gear me-2" aria-hidden="true"></i>View Technical Details
            </a>
        </div>
    </div>
</section>
@* Interactive Book Demo — CSS Grid .pub-books-grid *@
<section class="pub-section pub-section--alt">
    <div class="pub-section__inner">
        <div class="pub-section__header">
            <span class="pub-section__overline">Live System</span>
            <h2 class="pub-section__title">Interactive Book Demo</h2>
            <p class="pub-section__subtitle">Experience the live system with real data</p>
        </div>
        <div class="pub-books-grid" role="group" aria-label="Featured books collection">
            @if (Model.FeaturedBooks.Books.Any())
            {
                @foreach (var book in Model.FeaturedBooks.Books.Take(8))
                {
                    <article class="pub-book-card">
                        <img src="@(book.ImageUrl ?? Url.Content("~/images/default-book-improved.svg"))"
                             alt="Cover of @book.Title by @book.Author"
                             class="pub-book-card__cover"
                             loading="lazy" />
                        <div class="pub-book-card__body">
                            <span class="wp-badge bg-info  text-primary pub-book-card__badge">
                                <i class="bi bi-play-circle me-1" aria-hidden="true"></i>Demo
                            </span>
                            <h3 class="pub-book-card__title">@book.Title</h3>
                            <p class="pub-book-card__author">@book.Author</p>
                            <div class="pub-book-card__footer">
                                <span class="pub-book-card__price">₹@book.Price</span>
                                <a asp-action="InteractiveDemo" class="wp-btn wp-btn-secondary ">View</a>
                            </div>
                        </div>
                    </article>
                }
            }
            else
            {
                <div style="grid-column: 1 / -1; text-align: center; padding: var(--space-10) 0;">
                    <p class="text-muted">No books available at the moment.</p>
                </div>
            }
        </div>
        <div class="text-center mt-5">
            <a asp-action="InteractiveDemo" class="wp-btn wp-btn-primary wp-btn-lg">
                <i class="bi bi-play-circle me-2" aria-hidden="true"></i>Explore Full Demo
            </a>
        </div>
    </div>
</section>
@* Developer Story — CSS Grid .pub-split *@
<section class="pub-section" aria-labelledby="story-heading">
    <div class="pub-section__inner">
        <div class="pub-split">
            <div class="pub-split__content">
                <h2 id="story-heading" class="pub-section__title">Developer Story</h2>
                <p class="pub-hero__description">@Model.DeveloperStory.Motivation</p>
                <p>@Model.DeveloperStory.ChallengesSolved</p>
                @if (Model.DeveloperStory.TechnicalDecisions.Any())
                {
                    <div>
                        <h5 class="pub-footer__col-title">Key Technical Decisions</h5>
                        <ul class="pub-feature-card__details">
                            @foreach (var decision in Model.DeveloperStory.TechnicalDecisions.Take(3))
                            {
                                <li class="pub-feature-card__detail-item">
                                    <i class="bi bi-arrow-right text-primary pub-feature-card__check" aria-hidden="true"></i>
                                    @decision
                                </li>
                            }
                        </ul>
                    </div>
                }
                <a asp-action="DeveloperStory" class="wp-btn wp-btn-primary magnetic-btn">
                    <i class="bi bi-person-circle me-2" aria-hidden="true"></i>Read Full Story
                </a>
            </div>
            <div class="pub-split__visual">
                <div class="pub-split__card">
                    <h5 class="pub-footer__col-title text-center mb-4">Technology Stack</h5>
                    <div style="display: flex; flex-direction: column; gap: var(--space-4);">
                        <div>
                            <h6 class="pub-footer__col-title text-primary">Backend</h6>
                            <div style="display: flex; flex-wrap: wrap; gap: var(--space-2);">
                                @foreach (var tech in Model.TechnicalStack.BackendTechnologies.Take(3))
                                {
                                    <span class="wp-badge bg-primary text-white">@tech.Name</span>
                                }
                            </div>
                        </div>
                        <div>
                            <h6 class="pub-footer__col-title text-success">Frontend</h6>
                            <div style="display: flex; flex-wrap: wrap; gap: var(--space-2);">
                                @foreach (var tech in Model.TechnicalStack.FrontendTechnologies.Take(3))
                                {
                                    <span class="wp-badge bg-success  text-white">@tech.Name</span>
                                }
                            </div>
                        </div>
                        <div>
                            <h6 class="pub-footer__col-title text-info">Testing</h6>
                            <div style="display: flex; flex-wrap: wrap; gap: var(--space-2);">
                                @foreach (var tech in Model.TechnicalStack.TestingTechnologies.Take(2))
                                {
                                    <span class="wp-badge bg-info  text-white">@tech.Name</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@* Contact & Collaboration — CSS Grid .pub-contact-grid + .pub-form-card *@
<section class="pub-section pub-section--alt" aria-labelledby="contact-heading">
    <div class="pub-section__inner">
        <div class="pub-section__header">
            <span class="pub-section__overline">Get in Touch</span>
            <h2 id="contact-heading" class="pub-section__title">Let's Connect &amp; Collaborate</h2>
            <p class="pub-section__subtitle">Interested in collaboration, have questions, or want to explore opportunities?</p>
        </div>

        <div class="pub-contact-grid">

            @* Left Card: Contact Info *@
            <div class="pub-contact-card">
                <h3 class="pub-contact-card__title">
                    <i class="bi bi-person-circle" aria-hidden="true"></i>Contact Information
                </h3>

                <div class="pub-contact-info-list">
                    <div class="pub-contact-info-row">
                        <span class="pub-contact-info-icon text-primary"><i class="bi bi-geo-alt-fill"></i></span>
                        <div>
                            <span class="pub-contact-info-label">Location</span>
                            <span class="pub-contact-info-value">@Model.ContactInfo.Location</span>
                        </div>
                    </div>

                    <div class="pub-contact-info-row">
                        <span class="pub-contact-info-icon text-success"><i class="bi bi-briefcase-fill"></i></span>
                        <div>
                            <span class="pub-contact-info-label">Available for</span>
                            <div class="pub-contact-tags">
                                @foreach (var role in Model.ContactInfo.AvailableForRoles)
                                {
                                    <span class="wp-badge bg-primary text-white">@role</span>
                                }
                            </div>
                        </div>
                    </div>

                    @if (Model.ContactInfo.OpenToCollaboration)
                    {
                        <div class="pub-contact-info-row pub-contact-info-row--alert">
                            <span class="pub-contact-info-icon text-success"><i class="bi bi-check-circle-fill"></i></span>
                            <span class="pub-contact-info-value">Open to collaboration &amp; new opportunities</span>
                        </div>
                    }
                </div>

                <div class="pub-contact-actions">
                    <h6 class="pub-footer__col-title">Get in Touch</h6>
                    <div class="pub-contact-actions__links">
                        @if (!string.IsNullOrEmpty(Model.ContactInfo.Email))
                        {
                            <a href="mailto:@Model.ContactInfo.Email" class="wp-btn wp-btn-outline magnetic-btn">
                                <i class="bi bi-envelope-fill me-2" aria-hidden="true"></i>Email
                            </a>
                        }
                        @if (!string.IsNullOrEmpty(Model.ContactInfo.LinkedIn))
                        {
                            <a href="@Model.ContactInfo.LinkedIn" target="_blank" rel="noopener" class="wp-btn wp-btn-outline magnetic-btn">
                                <i class="bi bi-linkedin me-2" aria-hidden="true"></i>LinkedIn
                            </a>
                        }
                    </div>
                    @if (Model.ContactInfo.SocialMediaLinks.Any())
                    {
                        <h6 class="pub-footer__col-title mt-3">Professional Networks</h6>
                        <div class="pub-contact-actions__links">
                            @foreach (var social in Model.ContactInfo.SocialMediaLinks)
                            {
                                <a href="@social.Url" target="_blank" rel="noopener" class="wp-btn wp-btn-ghost" title="@social.DisplayName">
                                    <i class="@social.IconClass me-1" aria-hidden="true"></i>@social.Platform
                                </a>
                            }
                        </div>
                    }
                </div>
            </div>

            @* Right Card: Technical Resources *@
            <div class="pub-contact-card">
                <h3 class="pub-contact-card__title">
                    <i class="bi bi-code-slash" aria-hidden="true"></i>Technical Resources
                </h3>

                @if (Model.ContactInfo.TechnicalResources.Any())
                {
                    <div class="pub-contact-resources">
                        @foreach (var resource in Model.ContactInfo.TechnicalResources)
                        {
                            <div class="pub-resource-row">
                                <i class="@resource.IconClass text-primary pub-resource-row__icon" aria-hidden="true"></i>
                                <div class="pub-resource-row__body">
                                    <a href="@resource.Url" target="_blank" rel="noopener" class="pub-resource-row__title">@resource.Title</a>
                                    <p class="pub-resource-row__desc">@resource.Description</p>
                                    <span class="wp-badge bg-info text-white">@resource.Category</span>
                                </div>
                            </div>
                        }
                    </div>
                }

                <div class="pub-contact-actions mt-4">
                    <h6 class="pub-footer__col-title">Quick Access</h6>
                    <div class="pub-contact-actions__links">
                        <a href="@Model.ContactInfo.GitHub" target="_blank" rel="noopener" class="wp-btn wp-btn-outline magnetic-btn">
                            <i class="bi bi-github me-1" aria-hidden="true"></i>Repository
                        </a>
                        <a asp-action="TechnicalDetails" class="wp-btn wp-btn-outline magnetic-btn">
                            <i class="bi bi-gear me-1" aria-hidden="true"></i>Architecture
                        </a>
                        <a asp-action="InteractiveDemo" class="wp-btn wp-btn-outline magnetic-btn">
                            <i class="bi bi-play-circle me-1" aria-hidden="true"></i>Live Demo
                        </a>
                    </div>
                </div>
            </div>
        </div>

        @* Full-width Inquiry Form *@
        <div class="pub-form-card">
            <div class="pub-form-card__header">
                <h3 class="pub-section__title">
                    <i class="bi bi-chat-dots me-2" aria-hidden="true"></i>Collaboration Inquiry
                </h3>
                <p class="pub-section__subtitle">Have a project in mind or want to discuss opportunities? Let's talk!</p>
            </div>
            <form id="collaborationForm" class="pub-inquiry-form needs-validation" novalidate>
                @Html.AntiForgeryToken()
                <div class="pub-inquiry-grid">
                    <div class="form__group">
                        <label for="inquiryName" class="form__label"><i class="bi bi-person"></i>Full Name <span class="form__label--required"></span></label>
                        <input type="text" class="form__input" id="inquiryName" name="Name" required placeholder="Your full name">
                        <span class="form__error" hidden>Please provide your name.</span>
                    </div>
                    <div class="form__group">
                        <label for="inquiryEmail" class="form__label"><i class="bi bi-envelope"></i>Email Address <span class="form__label--required"></span></label>
                        <input type="email" class="form__input" id="inquiryEmail" name="Email" required placeholder="your.email@example.com">
                        <span class="form__error" hidden>Please provide a valid email.</span>
                    </div>
                    <div class="form__group">
                        <label for="inquiryCompany" class="form__label"><i class="bi bi-building"></i>Company / Organization</label>
                        <input type="text" class="form__input" id="inquiryCompany" name="Company" placeholder="Your company or organization">
                    </div>
                    <div class="form__group">
                        <label for="inquiryType" class="form__label"><i class="bi bi-tag"></i>Inquiry Type <span class="form__label--required"></span></label>
                        <select class="form__select" id="inquiryType" name="InquiryType" required>
                            <option value="">Select inquiry type</option>
                            <option value="Job Opportunity">Job Opportunity</option>
                            <option value="Collaboration">Project Collaboration</option>
                            <option value="Technical Question">Technical Question</option>
                            <option value="Consulting">Consulting Services</option>
                            <option value="Other">Other</option>
                        </select>
                        <span class="form__error" hidden>Please select an inquiry type.</span>
                    </div>
                    <div class="form__group pub-inquiry-grid__full">
                        <label for="inquirySubject" class="form__label"><i class="bi bi-chat-text"></i>Subject <span class="form__label--required"></span></label>
                        <input type="text" class="form__input" id="inquirySubject" name="Subject" required placeholder="Brief subject line">
                        <span class="form__error" hidden>Please provide a subject.</span>
                    </div>
                    <div class="form__group pub-inquiry-grid__full">
                        <label for="inquiryMessage" class="form__label"><i class="bi bi-chat-dots"></i>Message <span class="form__label--required"></span></label>
                        <textarea class="form__textarea" id="inquiryMessage" name="Message" rows="5" required
                                  placeholder="Tell me about your project, opportunity, or question."></textarea>
                        <span class="form__error" hidden>Please provide a message.</span>
                        <span class="form__help"><i class="bi bi-info-circle"></i>Maximum 2000 characters</span>
                    </div>
                    <div class="form__group">
                        <label for="preferredContact" class="form__label"><i class="bi bi-telephone"></i>Preferred Contact</label>
                        <select class="form__select" id="preferredContact" name="PreferredContactMethod">
                            <option value="Email">Email</option>
                            <option value="LinkedIn">LinkedIn</option>
                            <option value="Phone">Phone Call</option>
                        </select>
                    </div>
                    <div class="form__group">
                        <label for="timeline" class="form__label"><i class="bi bi-calendar"></i>Timeline</label>
                        <select class="form__select" id="timeline" name="Timeline">
                            <option value="Flexible">Flexible</option>
                            <option value="Immediate">Immediate (ASAP)</option>
                            <option value="Within 1 week">Within 1 week</option>
                            <option value="Within 1 month">Within 1 month</option>
                            <option value="Within 3 months">Within 3 months</option>
                        </select>
                    </div>
                </div>
                <div class="pub-form-card__submit">
                    <button type="submit" class="wp-btn wp-btn-primary wp-btn-lg magnetic-btn">
                        <i class="bi bi-send me-2" aria-hidden="true"></i>Send Inquiry
                    </button>
                </div>
                <div id="formMessage" class="mt-3" hidden></div>
            </form>
        </div>
    </div>
</section>


@section Styles {
    <style>
        /* Interactive Showcase Styles */
        .pub-hero { position: relative; }
        .pub-hero__arch-card { 
            transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
            transform-style: preserve-3d;
        }
        .pub-hero__arch-card:hover {
            transform: translateY(-10px) rotateX(5deg) rotateY(-5deg);
            box-shadow: 0 25px 50px -12px rgba(var(--primary-color-rgb), 0.25);
        }

        .pub-stat-card, .pub-feature-card, .pub-book-card, .pub-contact-card, .pub-form-card {
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
            overflow: hidden;
            background: rgba(var(--surface-color-rgb), 0.7);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(var(--primary-color-rgb), 0.1);
            border-radius: var(--radius-lg);
        }

        /* Hover glows */
        .pub-stat-card::before, .pub-feature-card::before, .pub-contact-card::before, .pub-form-card::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0; bottom: 0;
            background: radial-gradient(circle at center, rgba(var(--primary-color-rgb), 0.1) 0%, transparent 70%);
            opacity: 0;
            transition: opacity 0.4s ease;
            pointer-events: none;
            z-index: 0;
        }

        .pub-stat-card:hover, .pub-feature-card:hover, .pub-contact-card:hover, .pub-form-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 20px 40px -10px rgba(0,0,0,0.1), 0 0 20px rgba(var(--primary-color-rgb), 0.05);
            border-color: rgba(var(--primary-color-rgb), 0.3);
        }

        .pub-stat-card:hover::before, .pub-feature-card:hover::before, .pub-contact-card:hover::before, .pub-form-card:hover::before {
            opacity: 1;
        }

        /* Fun interaction for icons */
        .pub-feature-card > i, .pub-stat-card > i { 
            position: relative; 
            z-index: 1; 
            transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }
        .pub-feature-card:hover > i, .pub-stat-card:hover > i {
            transform: scale(1.3) rotate(5deg);
        }
        
        /* Book card extra interaction */
        .pub-book-card__cover { transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1); }
        .pub-book-card:hover .pub-book-card__cover { transform: scale(1.08); }
        .pub-book-card__body { position: relative; z-index: 2; background: linear-gradient(to top, var(--surface-color) 70%, transparent); transition: transform 0.4s ease; }
        .pub-book-card:hover .pub-book-card__body { transform: translateY(-5px); }

        /* Floating Animation */
        @@keyframes float {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-10px); }
        }
        .pub-hero__visual { animation: float 6s ease-in-out infinite; }
    </style>
}

@section Scripts {
    <script>
        // Initialize modern effects and showcase interactions
        document.addEventListener('DOMContentLoaded', function() {
            console.log('Enhanced public showcase loaded with modern effects');
            
            // Initialize enhanced modern effects
            if (window.ModernEffects) {
                window.ModernEffects.initParallaxScrolling();
                window.ModernEffects.initAdvancedAnimations();
                window.ModernEffects.initTextRevealAnimations();
                window.ModernEffects.init3DCardEffects();
            }
            
            // Animate statistics counters with enhanced effects
            const statNumbers = document.querySelectorAll('.stat-number');
            const observerOptions = {
                threshold: 0.5,
                rootMargin: '0px 0px -100px 0px'
            };
            
            const statsObserver = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        animateCounter(entry.target);
                        // Add pulsing effect during animation
                        entry.target.classList.add('pulse-glow');
                        statsObserver.unobserve(entry.target);
                    }
                });
            }, observerOptions);
            
            statNumbers.forEach(stat => {
                statsObserver.observe(stat);
            });
            
            function animateCounter(element) {
                const target = parseInt(element.textContent.replace(/[^\d]/g, ''));
                const duration = 2000;
                const step = target / (duration / 16);
                let current = 0;
                
                const timer = setInterval(() => {
                    current += step;
                    if (current >= target) {
                        current = target;
                        clearInterval(timer);
                        // Remove pulsing effect after animation
                        setTimeout(() => {
                            element.classList.remove('pulse-glow');
                        }, 1000);
                    }
                    
                    const suffix = element.textContent.includes('%') ? '%' : 
                                  element.textContent.includes('+') ? '+' : '';
                    element.textContent = Math.floor(current) + suffix;
                }, 16);
            }
            
            // Enhanced hover effects for architecture layers
            const architectureLayers = document.querySelectorAll('.architecture-layer');
            architectureLayers.forEach((layer, index) => {
                layer.addEventListener('mouseenter', () => {
                    layer.style.transform = `translateX(${5 + index * 2}px) scale(1.05)`;
                    layer.classList.add('pulse-glow');
                });
                
                layer.addEventListener('mouseleave', () => {
                    layer.style.transform = 'translateX(0) scale(1)';
                    layer.classList.remove('pulse-glow');
                });
            });
            
            // Initialize enhanced spotlight effects for feature cards
            const featureCards = document.querySelectorAll('.feature-card');
            featureCards.forEach(card => {
                card.addEventListener('mouseenter', () => {
                    card.style.transform = 'translateY(-12px) scale(1.02)';
                });
                
                card.addEventListener('mouseleave', () => {
                    card.style.transform = 'translateY(0) scale(1)';
                });
            });
            
            // Add dynamic particle effects to hero section
            const heroSection = document.querySelector('.hero-section');
            if (heroSection) {
                createFloatingParticles(heroSection);
            }
            
            function createFloatingParticles(container) {
                for (let i = 0; i < 20; i++) {
                    const particle = document.createElement('div');
                    particle.style.cssText = `
                        position: absolute;
                        width: 4px;
                        height: 4px;
                        background: rgba(255, 255, 255, 0.3);
                        border-radius: 50%;
                        left: ${Math.random() * 100}%;
                        top: ${Math.random() * 100}%;
                        animation: float-particle ${5 + Math.random() * 10}s ease-in-out infinite;
                        animation-delay: ${Math.random() * 5}s;
                        pointer-events: none;
                    `;
                    container.appendChild(particle);
                }
                
                // Add CSS for particle animation
                if (!document.querySelector('#particle-styles')) {
                    const style = document.createElement('style');
                    style.id = 'particle-styles';
                    style.textContent = `
                        @@keyframes float-particle {
                            0%, 100% { 
                                transform: translateY(0px) translateX(0px);
                                opacity: 0.3;
                            }
                            50% { 
                                transform: translateY(-100px) translateX(50px);
                                opacity: 0.8;
                            }
                        }
                    `;
                    document.head.appendChild(style);
                }
            }
            
            // Initialize collaboration form handling
            const collaborationForm = document.getElementById('collaborationForm');
            if (collaborationForm) {
                collaborationForm.addEventListener('submit', handleCollaborationFormSubmit);
            }
            
            async function handleCollaborationFormSubmit(event) {
                event.preventDefault();
                event.stopPropagation();
                
                const form = event.target;
                const formMessage = document.getElementById('formMessage');
                const submitButton = form.querySelector('button[type="submit"]');
                const originalButtonText = submitButton.innerHTML;
                
                // Validate form
                if (!form.checkValidity()) {
                    form.classList.add('was-validated');
                    return;
                }
                
                // Show loading state
                submitButton.disabled = true;
                submitButton.innerHTML = '<i class="bi bi-hourglass-split me-2"></i>Sending...';
                
                try {
                    // Collect form data
                    const formData = new FormData(form);
                    const inquiryData = {
                        Name: formData.get('Name'),
                        Email: formData.get('Email'),
                        Company: formData.get('Company') || '',
                        Subject: formData.get('Subject'),
                        Message: formData.get('Message'),
                        InquiryType: formData.get('InquiryType'),
                        PreferredContactMethod: formData.get('PreferredContactMethod'),
                        Timeline: formData.get('Timeline')
                    };
                    
                    // Get anti-forgery token
                    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                    
                    // Submit form
                    const response = await fetch('/Public/SubmitCollaborationInquiry', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': token
                        },
                        body: JSON.stringify(inquiryData)
                    });
                    
                    const result = await response.json();
                    
                    if (result.success) {
                        // Show success message
                        formMessage.className = 'alert alert-success';
                        formMessage.innerHTML = `
                            <i class="bi bi-check-circle-fill me-2"></i>
                            ${result.message}
                        `;
                        formMessage.style.display = 'block';
                        
                        // Reset form
                        form.reset();
                        form.classList.remove('was-validated');
                        
                        // Scroll to message
                        formMessage.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    } else {
                        // Show error message
                        formMessage.className = 'alert alert-danger';
                        formMessage.innerHTML = `
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>
                            ${result.message}
                        `;
                        formMessage.style.display = 'block';
                    }
                } catch (error) {
                    console.error('Error submitting collaboration inquiry:', error);
                    formMessage.className = 'alert alert-danger';
                    formMessage.innerHTML = `
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                        Sorry, there was an error sending your inquiry. Please try again or contact me directly via email.
                    `;
                    formMessage.style.display = 'block';
                } finally {
                    // Restore button state
                    submitButton.disabled = false;
                    submitButton.innerHTML = originalButtonText;
                }
            }
            
            // Add character counter for message field
            const messageField = document.getElementById('inquiryMessage');
            if (messageField) {
                const maxLength = 2000;
                const counterElement = document.createElement('div');
                counterElement.className = 'form-text text-end';
                counterElement.style.fontSize = '0.8rem';
                messageField.parentNode.appendChild(counterElement);
                
                function updateCounter() {
                    const remaining = maxLength - messageField.value.length;
                    counterElement.textContent = `${remaining} characters remaining`;
                    counterElement.className = remaining < 100 ? 'form-text text-end text-warning' : 'form-text text-end text-muted';
                }
                
                messageField.addEventListener('input', updateCounter);
                updateCounter();
            }
            
            // Add enhanced hover effects for resource items
            const resourceItems = document.querySelectorAll('.resource-item');
            resourceItems.forEach(item => {
                item.addEventListener('mouseenter', () => {
                    const icon = item.querySelector('.resource-icon i');
                    if (icon) {
                        icon.style.transform = 'scale(1.1)';
                        icon.classList.add('pulse-glow');
                    }
                });
                
                item.addEventListener('mouseleave', () => {
                    const icon = item.querySelector('.resource-icon i');
                    if (icon) {
                        icon.style.transform = 'scale(1)';
                        icon.classList.remove('pulse-glow');
                    }
                });
            });
        });
    </script>
}




