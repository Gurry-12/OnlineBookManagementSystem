@{
    ViewData["Title"] = "Order Confirmation";
    // Layout will be determined by role-based logic in _ViewStart.cshtml
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8 text-center">
            <!-- Success Icon -->
            <div class="mb-4">
                <i class="bi bi-check-circle-fill text-success" style="font-size: 4rem;"></i>
            </div>
            
            <!-- Success Message -->
            <h2 class="text-success mb-3">Thank You for Your Order!</h2>
            <p class="lead text-muted mb-4">
                Your order has been successfully processed. We will contact you shortly with order details and tracking information.
            </p>
            
            <!-- Order Details Card -->
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-body p-4">
                    <h5 class="card-title mb-3">
                        <i class="bi bi-receipt me-2"></i>What Happens Next?
                    </h5>
                    <div class="row g-3 text-start">
                        <div class="col-md-4">
                            <div class="d-flex align-items-start">
                                <i class="bi bi-envelope-check text-primary me-3 mt-1"></i>
                                <div>
                                    <h6 class="mb-1">Order Confirmation</h6>
                                    <small class="text-muted">You'll receive an email confirmation shortly</small>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="d-flex align-items-start">
                                <i class="bi bi-box-seam text-warning me-3 mt-1"></i>
                                <div>
                                    <h6 class="mb-1">Order Processing</h6>
                                    <small class="text-muted">We'll prepare your books for shipment</small>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="d-flex align-items-start">
                                <i class="bi bi-truck text-success me-3 mt-1"></i>
                                <div>
                                    <h6 class="mb-1">Delivery</h6>
                                    <small class="text-muted">Your books will be delivered to your address</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Action Buttons -->
            <div class="d-flex gap-3 justify-content-center flex-wrap">
                <a asp-controller="Orders" asp-action="List" class="btn btn-primary">
                    <i class="bi bi-list-ul me-2"></i>View My Orders
                </a>
                <a asp-controller="Books" asp-action="BookList" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-2"></i>Continue Shopping
                </a>
            </div>
            
            <!-- Support Information -->
            <div class="mt-5 p-4 bg-light rounded">
                <h6 class="mb-2">
                    <i class="bi bi-headset me-2"></i>Need Help?
                </h6>
                <p class="text-muted small mb-0">
                    If you have any questions about your order, please contact our support team. 
                    We're here to help ensure you have a great experience with your purchase.
                </p>
            </div>
        </div>
    </div>
</div>

<style>
    .card {
        border: none;
        box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
    }
    
    .bg-light {
        background-color: #f8f9fa !important;
    }
</style>
