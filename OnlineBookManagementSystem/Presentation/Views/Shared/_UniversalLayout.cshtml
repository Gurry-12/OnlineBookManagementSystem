@using Microsoft.AspNetCore.Identity
@inject SignInManager<User> SignInManager
@inject UserManager<User> UserManager
@{
    var user = await UserManager.GetUserAsync(User);
    var userRole = "Public";
    var layoutClass = "public-layout";
    var isAuthenticated = SignInManager.IsSignedIn(User);
    
    if (isAuthenticated)
    {
        if (User.IsInRole("SuperAdmin"))
        {
            userRole = "SuperAdmin";
            layoutClass = "superadmin-layout";
        }
        else if (User.IsInRole("Admin"))
        {
            userRole = "Admin";
            layoutClass = "admin-layout";
        }
        else if (User.IsInRole("User"))
        {
            userRole = "User";
            layoutClass = "user-layout";
        }
    }
    
    var pageTitle = ViewData["Title"]?.ToString() ?? "Whispering Pages";
    var metaDescription = ViewData["MetaDescription"]?.ToString() ?? "Online Book Management System - Clean Architecture Implementation";
}

<!DOCTYPE html>
<html lang="en" class="@userRole.ToLower()-theme">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="@metaDescription" />
    <meta name="author" content="Whispering Pages" />
    <meta name="csrf-token" content="@Html.AntiForgeryToken()" />
    
    <title>@pageTitle - Whispering Pages</title>
    
    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    
    <!-- Toastr CSS -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />
    
    <!-- Unified Theme CSS -->
    <link rel="stylesheet" href="~/css/unified-theme.css" asp-append-version="true" />
    
    <!-- Page-specific CSS -->
    @await RenderSectionAsync("Styles", required: false)
</head>

<body class="@layoutClass" data-user-role="@userRole" data-authenticated="@isAuthenticated.ToString().ToLower()">
    
    <!-- Navigation -->
    <nav class="wp-navbar navbar navbar-expand-lg sticky-top">
        <div class="container-fluid">
            <!-- Brand -->
            <a class="wp-navbar-brand navbar-brand" asp-controller="@(userRole == "Public" ? "Public" : userRole)" asp-action="Dashboard">
                <i class="fas fa-book-open me-2"></i>
                Whispering Pages
                @if (userRole != "Public")
                {
                    <small class="badge wp-badge-info ms-2">@userRole</small>
                }
            </a>

            <!-- Mobile Toggle -->
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <!-- Navigation Links -->
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    @if (userRole == "Public")
                    {
                        <li class="nav-item">
                            <a class="wp-nav-link nav-link" asp-controller="Public" asp-action="Dashboard">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="wp-nav-link nav-link" asp-controller="UniversalBooks" asp-action="List">Browse Books</a>
                        </li>
                        <li class="nav-item">
                            <a class="wp-nav-link nav-link" asp-controller="Public" asp-action="Showcase">Showcase</a>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="wp-nav-link nav-link" asp-controller="@userRole" asp-action="Dashboard">Dashboard</a>
                        </li>
                        <li class="nav-item">
                            <a class="wp-nav-link nav-link" asp-controller="UniversalBooks" asp-action="List">Books</a>
                        </li>
                        
                        @if (userRole == "User")
                        {
                            <li class="nav-item">
                                <a class="wp-nav-link nav-link" asp-controller="Cart" asp-action="Index">
                                    <i class="fas fa-shopping-cart me-1"></i>Cart
                                    <span class="badge wp-badge-info" id="cartCount">0</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="wp-nav-link nav-link" asp-controller="UserFavorites" asp-action="Index">
                                    <i class="fas fa-heart me-1"></i>Favorites
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="wp-nav-link nav-link" asp-controller="UserOrders" asp-action="OrderHistory">
                                    <i class="fas fa-history me-1"></i>Orders
                                </a>
                            </li>
                        }
                        
                        @if (userRole == "Admin" || userRole == "SuperAdmin")
                        {
                            <li class="nav-item dropdown">
                                <a class="wp-nav-link nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                    <i class="fas fa-cog me-1"></i>Management
                                </a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-controller="AdminBookManagement" asp-action="Index">Books</a></li>
                                    <li><a class="dropdown-item" asp-controller="AdminCategoryManagement" asp-action="Index">Categories</a></li>
                                    <li><a class="dropdown-item" asp-controller="AdminOrderManagement" asp-action="Index">Orders</a></li>
                                    <li><a class="dropdown-item" asp-controller="AdminUserManagement" asp-action="Index">Users</a></li>
                                    @if (userRole == "SuperAdmin")
                                    {
                                        <li><hr class="dropdown-divider"></li>
                                        <li><a class="dropdown-item" asp-controller="SuperAdmin" asp-action="SystemSettings">System Settings</a></li>
                                        <li><a class="dropdown-item" asp-controller="SuperAdmin" asp-action="Analytics">Analytics</a></li>
                                    }
                                </ul>
                            </li>
                        }
                    }
                </ul>

                <!-- User Menu -->
                <ul class="navbar-nav">
                    @if (isAuthenticated)
                    {
                        <li class="nav-item dropdown">
                            <a class="wp-nav-link nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                <i class="fas fa-user-circle me-1"></i>
                                @(user?.Email?.Split('@')[0] ?? "User")
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" asp-controller="UserProfile" asp-action="Index">
                                    <i class="fas fa-user me-2"></i>Profile
                                </a></li>
                                <li><a class="dropdown-item" asp-controller="UserProfile" asp-action="Settings">
                                    <i class="fas fa-cog me-2"></i>Settings
                                </a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form asp-controller="Auth" asp-action="Logout" method="post" class="d-inline">
                                        <button type="submit" class="dropdown-item">
                                            <i class="fas fa-sign-out-alt me-2"></i>Logout
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="wp-nav-link nav-link" asp-controller="Auth" asp-action="Login">
                                <i class="fas fa-sign-in-alt me-1"></i>Login
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="wp-btn wp-btn-primary nav-link" asp-controller="Auth" asp-action="Register">
                                <i class="fas fa-user-plus me-1"></i>Register
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <!-- Sidebar for Admin/SuperAdmin -->
    @if (userRole == "Admin" || userRole == "SuperAdmin")
    {
        <div class="container-fluid">
            <div class="row">
                <nav class="col-md-3 col-lg-2 d-md-block wp-sidebar collapse">
                    <div class="position-sticky pt-3">
                        <ul class="wp-sidebar-nav nav flex-column">
                            <li class="wp-sidebar-nav-item">
                                <a class="wp-sidebar-nav-link" asp-controller="@userRole" asp-action="Dashboard">
                                    <i class="fas fa-tachometer-alt me-2"></i>Dashboard
                                </a>
                            </li>
                            <li class="wp-sidebar-nav-item">
                                <a class="wp-sidebar-nav-link" asp-controller="AdminBookManagement" asp-action="Index">
                                    <i class="fas fa-book me-2"></i>Books
                                </a>
                            </li>
                            <li class="wp-sidebar-nav-item">
                                <a class="wp-sidebar-nav-link" asp-controller="AdminCategoryManagement" asp-action="Index">
                                    <i class="fas fa-tags me-2"></i>Categories
                                </a>
                            </li>
                            <li class="wp-sidebar-nav-item">
                                <a class="wp-sidebar-nav-link" asp-controller="AdminOrderManagement" asp-action="Index">
                                    <i class="fas fa-shopping-bag me-2"></i>Orders
                                </a>
                            </li>
                            <li class="wp-sidebar-nav-item">
                                <a class="wp-sidebar-nav-link" asp-controller="AdminUserManagement" asp-action="Index">
                                    <i class="fas fa-users me-2"></i>Users
                                </a>
                            </li>
                            <li class="wp-sidebar-nav-item">
                                <a class="wp-sidebar-nav-link" asp-controller="ReviewModeration" asp-action="Index">
                                    <i class="fas fa-comments me-2"></i>Reviews
                                </a>
                            </li>
                            
                            @if (userRole == "SuperAdmin")
                            {
                                <li class="wp-sidebar-nav-item mt-3">
                                    <h6 class="sidebar-heading d-flex justify-content-between align-items-center px-3 mt-4 mb-1 text-muted text-uppercase">
                                        <span>System</span>
                                    </h6>
                                </li>
                                <li class="wp-sidebar-nav-item">
                                    <a class="wp-sidebar-nav-link" asp-controller="SuperAdmin" asp-action="SystemSettings">
                                        <i class="fas fa-cogs me-2"></i>Settings
                                    </a>
                                </li>
                                <li class="wp-sidebar-nav-item">
                                    <a class="wp-sidebar-nav-link" asp-controller="SuperAdmin" asp-action="Analytics">
                                        <i class="fas fa-chart-bar me-2"></i>Analytics
                                    </a>
                                </li>
                                <li class="wp-sidebar-nav-item">
                                    <a class="wp-sidebar-nav-link" asp-controller="SuperAdmin" asp-action="SystemHealth">
                                        <i class="fas fa-heartbeat me-2"></i>Health
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>
                </nav>

                <!-- Main Content with Sidebar -->
                <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
                    @RenderBody()
                </main>
            </div>
        </div>
    }
    else
    {
        <!-- Main Content without Sidebar -->
        <main>
            @RenderBody()
        </main>
    }

    <!-- Footer -->
    <footer class="wp-footer mt-5 py-4 border-top">
        <div class="container">
            <div class="row">
                <div class="col-md-6">
                    <p class="text-muted mb-0">
                        &copy; @DateTime.Now.Year Whispering Pages. 
                        @if (userRole == "Public")
                        {
                            <text>Clean Architecture Demo</text>
                        }
                        else
                        {
                            <text>All rights reserved.</text>
                        }
                    </p>
                </div>
                <div class="col-md-6 text-end">
                    @if (userRole == "Public")
                    {
                        <a href="https://github.com" class="text-muted me-3" target="_blank">
                            <i class="fab fa-github"></i> View Source
                        </a>
                        <a href="/Public/TechnicalDetails" class="text-muted">
                            <i class="fas fa-code"></i> Technical Details
                        </a>
                    }
                    else
                    {
                        <small class="text-muted">
                            <i class="fas fa-clock me-1"></i>
                            <span id="currentTime"></span>
                        </small>
                    }
                </div>
            </div>
        </div>
    </footer>

    <!-- CSRF Token for AJAX -->
    @Html.AntiForgeryToken()

    <!-- Core JavaScript -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    
    <!-- Unified HTTP Client -->
    <script src="~/js/unified-http-client.js" asp-append-version="true"></script>
    
    <!-- Page-specific JavaScript -->
    @await RenderSectionAsync("Scripts", required: false)

    <!-- Initialize Global Features -->
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Update current time for authenticated users
            @if (isAuthenticated)
            {
                <text>
                function updateTime() {
                    const now = new Date();
                    const timeString = now.toLocaleTimeString();
                    const timeElement = document.getElementById('currentTime');
                    if (timeElement) {
                        timeElement.textContent = timeString;
                    }
                }
                
                updateTime();
                setInterval(updateTime, 1000);
                </text>
            }
            
            // Update cart count for users
            @if (userRole == "User")
            {
                <text>
                function updateCartCount() {
                    httpClient.get('/Cart/GetCartCount')
                        .then(response => {
                            if (response.success) {
                                document.getElementById('cartCount').textContent = response.data;
                            }
                        });
                }
                
                updateCartCount();
                
                // Update cart count every 30 seconds
                setInterval(updateCartCount, 30000);
                </text>
            }
            
            // Global role context
            window.roleContext = {
                userRole: '@userRole',
                isAuthenticated: @isAuthenticated.ToString().ToLower(),
                userId: @(user?.Id ?? 0)
            };
        });
    </script>
</body>
</html>