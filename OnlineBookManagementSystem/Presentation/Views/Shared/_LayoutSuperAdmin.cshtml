<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Whispering Pages</title>

    <!-- Bootstrap CSS - Local First -->
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet"
          asp-fallback-href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          asp-fallback-test-class="visually-hidden" asp-fallback-test-property="position" asp-fallback-test-value="absolute" />

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet" />

    <link href="~/css/main.css" rel="stylesheet" asp-append-version="true" />



    @RenderSection("Styles", required: false)
</head>
<body class="@(ViewData["ThemeClass"] ?? "theme-superadmin")">
    <!-- Sidebar -->
    <div class="wp-sidebar" id="sidebar">
        <div class="wp-sidebar__header">
            <a href="/" class="wp-sidebar__logo">
                <img src="@Url.Content("~/images/render_website_name.png")" alt="Whispering Pages Logo" class="wp-sidebar__logo-icon">
            </a>
        </div>

        <nav class="wp-sidebar__nav">
            <div class="wp-sidebar__section">
                <span class="wp-sidebar__section-header">Main</span>
                <div class="wp-sidebar__nav-item">
                    <a asp-controller="SuperAdmin" asp-action="Dashboard" class="wp-sidebar__nav-link">
                        <i class="bi bi-house-door-fill wp-sidebar__nav-icon"></i>
                        <span class="wp-sidebar__nav-text">Dashboard</span>
                    </a>
                </div>
                <div class="wp-sidebar__nav-item">
                    <a asp-controller="SuperAdmin" asp-action="ManageUsers" class="wp-sidebar__nav-link">
                        <i class="bi bi-people wp-sidebar__nav-icon"></i>
                        <span class="wp-sidebar__nav-text">Manage Users & Roles</span>
                    </a>
                </div>
                <div class="wp-sidebar__nav-item">
                    <a asp-controller="SuperAdmin" asp-action="PendingUsers" class="wp-sidebar__nav-link">
                        <i class="bi bi-person-plus wp-sidebar__nav-icon"></i>
                        <span class="wp-sidebar__nav-text">Pending Approvals</span>
                    </a>
                </div>
                <div class="wp-sidebar__nav-item">
                    <a asp-controller="Logs" asp-action="LogList" class="wp-sidebar__nav-link">
                        <i class="bi bi-journal-text wp-sidebar__nav-icon"></i>
                        <span class="wp-sidebar__nav-text">Activity Logs</span>
                    </a>
                </div>
                <div class="wp-sidebar__nav-item">
                    <a asp-controller="SuperAdmin" asp-action="SystemSettings" class="wp-sidebar__nav-link">
                        <i class="bi bi-sliders2 wp-sidebar__nav-icon"></i>
                        <span class="wp-sidebar__nav-text">Site Settings</span>
                    </a>
                </div>
                <div class="wp-sidebar__nav-item">
                    <a asp-controller="Admin" asp-action="Books" class="wp-sidebar__nav-link">
                        <i class="bi bi-bookshelf wp-sidebar__nav-icon"></i>
                        <span class="wp-sidebar__nav-text">Books Management</span>
                    </a>
                </div>
            </div>

            <div class="wp-sidebar__section">
                <span class="wp-sidebar__section-header">Analytics</span>
                <div class="wp-sidebar__nav-item">
                    <a asp-controller="Analytics" asp-action="OrdersAnalytics" class="wp-sidebar__nav-link">
                        <i class="bi bi-graph-up wp-sidebar__nav-icon"></i>
                        <span class="wp-sidebar__nav-text">Orders Analytics</span>
                    </a>
                </div>
                <div class="wp-sidebar__nav-item">
                    <a asp-controller="Analytics" asp-action="BooksAnalytics" class="wp-sidebar__nav-link">
                        <i class="bi bi-book wp-sidebar__nav-icon"></i>
                        <span class="wp-sidebar__nav-text">Books Analytics</span>
                    </a>
                </div>
                <div class="wp-sidebar__nav-item">
                    <a asp-controller="Analytics" asp-action="ReviewsAnalytics" class="wp-sidebar__nav-link">
                        <i class="bi bi-chat-square-text wp-sidebar__nav-icon"></i>
                        <span class="wp-sidebar__nav-text">Reviews Analytics</span>
                    </a>
                </div>
            </div>
        </nav>
    </div>

    <!-- Main Content Area -->
    <div class="wp-main-content">
        <!-- Top Bar -->
        <div class="wp-top-bar">
            <div class="wp-top-bar__left">
                <button class="wp-btn wp-btn-secondary d-lg-none p-2 border-0" id="toggleSidebar" aria-label="Toggle Sidebar">
                    <i class="bi bi-list fs-5"></i>
                </button>
                <button class="wp-btn wp-btn-secondary  rounded-pill d-none d-md-flex">
                    <i class="bi bi-shield-lock-fill me-2 text-primary"></i>SuperAdmin View
                </button>
                
                <!-- Role Switcher Dropdown -->
                <div class="dropdown">
                    <button class="wp-btn wp-btn-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="bi bi-view-stacked me-2"></i>Quick Views
                    </button>
                    <ul class="dropdown-menu shadow">
                        <li><a class="dropdown-item" asp-controller="Analytics" asp-action="OrdersAnalytics"><i class="bi bi-graph-up me-2 text-muted"></i>Orders Analytics</a></li>
                        <li><a class="dropdown-item" asp-controller="Analytics" asp-action="BooksAnalytics"><i class="bi bi-book me-2 text-muted"></i>Books Analytics</a></li>
                        <li><a class="dropdown-item" asp-controller="Analytics" asp-action="UsersAnalytics"><i class="bi bi-people me-2 text-muted"></i>Users Analytics</a></li>
                    </ul>
                </div>
            </div>
            <div class="wp-top-bar__right d-flex align-items-center gap-3">
                <div class="wp-top-bar__search d-none d-md-flex align-items-center bg-light rounded-pill px-3 py-1">
                    <i class="bi bi-search text-muted"></i>
                    <input type="text" class="form-control border-0 bg-transparent shadow-none ms-2" placeholder="Search system...">
                </div>
                
                <div class="wp-datetime-container d-none d-xl-flex">
                    <span class="wp-datetime-item">
                        <i class="bi bi-clock"></i>
                        <span class="currenttime"></span>
                    </span>
                    <span class="wp-datetime-item">
                        <i class="bi bi-calendar"></i>
                        <span class="currentdate"></span>
                    </span>
                </div>

                     <a class="wp-btn wp-btn-secondary rounded-circle p-2" asp-controller="Auth" asp-action="ProfileView">
                        <i class="bi bi-person-fill fs-5"></i>
                    </a>
                    <div>
                        <form asp-controller="Auth" asp-action="Logout" method="post" class="m-0 p-0">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="wp-btn wp-btn-primary rounded-circle p-2 text-danger">
                                    <i class="bi bi-box-arrow-right fs-5"></i>
                                </button>
                            </form>
                        </div>             
                </div>
            </div>

        <main class="wp-content px-4 py-3">
            <partial name="_BreadcrumbPartial" />
            @RenderBody()
        </main>

        <footer class="wp-footer text-center py-4 text-muted border-top mt-auto">
            <div class="container">
                &copy; @DateTime.Now.Year - Whispering Pages <i class="bi bi-book-half ms-1"></i>
            </div>
        </footer>
    </div>

    <!-- Sidebar Overlay for Mobile -->
    <div class="wp-sidebar-overlay" id="sidebarOverlay"></div>

    <!-- Toast Container -->
    <div class="toast-container position-fixed bottom-0 end-0 p-3">
        <!-- Toasts will be inserted here -->
    </div>

    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <!-- Toastr JS -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/js/toastr.min.js"></script>

    <!-- Bootstrap JS - Local First -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"
            asp-fallback-src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
            asp-fallback-test="window.bootstrap"></script>

    @await RenderSectionAsync("Scripts", required: false)

    <!-- Shared Scripts -->
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/role-switcher.js" asp-append-version="true"></script>
    
    <!-- Essential Effects JS -->
    <script src="~/js/essential-effects.js" asp-append-version="true"></script>

    
    <!-- Pure CSS Dropdown Script -->
    <script>
        // Global confirmation function for role switching (called from onclick)
        function confirmRoleSwitch(role) {
            return confirm(`Are you sure you want to switch to ${role} view? You can return to SuperAdmin view at any time.`);
        }
        
        // Simple initialization logging
        document.addEventListener('DOMContentLoaded', function() {
            console.log('SuperAdmin layout loaded - Pure CSS dropdown implementation');
            
            // All dropdown functionality is now handled by role-switcher.js
            // No Bootstrap dependencies required
        });
    </script>

</body>
</html>


