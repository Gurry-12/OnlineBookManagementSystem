<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Whispering Pages</title>

    <!-- Bootstrap CSS - Local First -->
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet"
          asp-fallback-href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          asp-fallback-test-class="visually-hidden" asp-fallback-test-property="position" asp-fallback-test-value="absolute" />

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet" />

    <link href="~/css/main.css" rel="stylesheet" asp-append-version="true" />



    @RenderSection("Styles", required: false)
</head>
<body class="@(ViewData["ThemeClass"] ?? "theme-superadmin")">
    <!-- Sidebar -->
    <div class="wp-sidebar">
        <div class="d-flex align-items-center mb-4">
            <img src="@Url.Content("~/images/Render_main_logo.png")" alt="Whispering Pages Logo" width="40" height="40" class="me-2 rounded-circle">
            <span class="fw-bold fs-5">Whispering Pages</span>
        </div>
        <ul class="wp-sidebar-nav">
            <li class="wp-sidebar-nav-item">
                <a class="wp-sidebar-nav-link" asp-controller="SuperAdmin" asp-action="Dashboard">
                    <i class="bi bi-house-door-fill"></i>
                    <span class="wp-sidebar-nav-text">Dashboard</span>
                </a>
            </li>
            <li class="wp-sidebar-nav-item">
                <a class="wp-sidebar-nav-link" asp-controller="SuperAdmin" asp-action="ManageUsers">
                    <i class="bi bi-people"></i>
                    <span class="wp-sidebar-nav-text">Manage Users & Roles</span>
                </a>
            </li>
            <li class="wp-sidebar-nav-item">
                <a class="wp-sidebar-nav-link" asp-controller="SuperAdmin" asp-action="PendingUsers">
                    <i class="bi bi-person-plus"></i>
                    <span class="wp-sidebar-nav-text">Pending Approvals</span>
                </a>
            </li>
            <li class="wp-sidebar-nav-item">
                <a class="wp-sidebar-nav-link" asp-controller="Logs" asp-action="LogList">
                    <i class="bi bi-journal-text"></i>
                    <span class="wp-sidebar-nav-text">Activity Logs</span>
                </a>
            </li>
            <li class="wp-sidebar-nav-item">
                <a class="wp-sidebar-nav-link" asp-controller="SuperAdmin" asp-action="SystemSettings">
                    <i class="bi bi-sliders2"></i>
                    <span class="wp-sidebar-nav-text">Site Settings</span>
                </a>
            </li>
            <li class="wp-sidebar-nav-item">
                <a class="wp-sidebar-nav-link" asp-controller="Admin" asp-action="Books">
                    <i class="bi bi-bookshelf"></i>
                    <span class="wp-sidebar-nav-text">Books Management</span>
                </a>
            </li>
        </ul>
        <div class="wp-sidebar-nav-section">
            <span class="wp-sidebar-nav-header">Analytics</span>
            <a asp-controller="Analytics" asp-action="OrdersAnalytics" class="wp-sidebar-nav-link">
                <i class="bi bi-graph-up"></i>
                <span class="wp-sidebar-nav-text sidebar-text">Orders Analytics</span>
            </a>
            <a asp-controller="Analytics" asp-action="BooksAnalytics" class="wp-sidebar-nav-link">
                <i class="bi bi-book"></i>
                <span class="wp-sidebar-nav-text sidebar-text">Books Analytics</span>
            </a>
            <a asp-controller="Analytics" asp-action="ReviewsAnalytics" class="wp-sidebar-nav-link">
                <i class="bi bi-chat-square-text"></i>
                <span class="wp-sidebar-nav-text sidebar-text">Reviews Analytics</span>
            </a>
        </div>
    </div>

    <!-- Main Content Area -->
    <div class="wp-content ms-250">
        <!-- Top Bar -->
        <header class="wp-top-bar d-flex align-items-center justify-content-between px-4 py-3 bg-white shadow-sm border-bottom sticky-top">
            <div class="d-flex align-items-center gap-4">
                <button class="wp-btn-secondary wp-btn-light rounded-pill"><i class="bi bi-briefcase-fill me-2"></i>SuperAdmin Workspace </button>
                
                <!-- Role Switcher Dropdown - Pure CSS Implementation -->
                
                <ul class="nav nav-tabs border-0">
                    <li class="nav-item"><a class="nav-link" asp-controller="Analytics" asp-action="OrdersAnalytics">Orders Analytics</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Analytics" asp-action="BooksAnalytics">Books Analytics</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Analytics" asp-action="UsersAnalytics">Users Analytics</a></li>
                </ul>
            </div>
            <div class="d-flex align-items-center gap-3">
                <div class="position-relative">
                    <input type="search" class="form-control rounded-pill ps-5" placeholder="Search...">
                    <i class="bi bi-search position-absolute top-50 start-3 ps-3 translate-middle-y text-muted"></i>
                </div>
                <a class="wp-btn-secondary wp-btn-outline-secondary rounded-circle p-2" asp-controller="Auth" asp-action="ProfileView"><i class="bi bi-person-fill fs-5"></i></a>
                <form asp-controller="Auth" asp-action="Logout" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="wp-btn-secondary wp-btn-outline-danger rounded-circle p-2"><i class="bi bi-box-arrow-right fs-5"></i></button>
                </form>
            </div>
        </header>

        <main class="wp-main-content container-fluid py-4">
            @RenderBody()
        </main>

        <footer class="wp-footer text-center py-4 text-muted border-top mt-auto">
            <div class="container">
                &copy; @DateTime.Now.Year - Whispering Pages <i class="bi bi-book-half ms-1"></i>
            </div>
        </footer>
    </div>

    <!-- Toast Container -->
    <div class="toast-container position-fixed bottom-0 end-0 p-3">
        <!-- Toasts will be inserted here -->
    </div>

    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <!-- Toastr JS -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/js/toastr.min.js"></script>

    <!-- Bootstrap JS - Local First -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"
            asp-fallback-src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
            asp-fallback-test="window.bootstrap"></script>

    @await RenderSectionAsync("Scripts", required: false)

    <!-- Shared Scripts -->
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/role-switcher.js" asp-append-version="true"></script>
    
    <!-- Essential Effects JS -->
    <script src="~/js/essential-effects.js" asp-append-version="true"></script>

    
    <!-- Pure CSS Dropdown Script -->
    <script>
        // Global confirmation function for role switching (called from onclick)
        function confirmRoleSwitch(role) {
            return confirm(`Are you sure you want to switch to ${role} view? You can return to SuperAdmin view at any time.`);
        }
        
        // Simple initialization logging
        document.addEventListener('DOMContentLoaded', function() {
            console.log('SuperAdmin layout loaded - Pure CSS dropdown implementation');
            
            // All dropdown functionality is now handled by role-switcher.js
            // No Bootstrap dependencies required
        });
    </script>

</body>
</html>


