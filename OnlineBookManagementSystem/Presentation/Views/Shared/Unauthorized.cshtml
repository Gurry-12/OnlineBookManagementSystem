@{
    ViewData["Title"] = "Access Denied";
    Layout = "~/Views/Shared/_LayoutPublic.cshtml";
}

<div class="container-fluid d-flex align-items-center justify-content-center min-vh-100">
    <div class="row justify-content-center w-100">
        <div class="col-md-6 col-lg-5">
            <div class="wp-card border-0 shadow-lg rounded-4">
                <div class="wp-card-body text-center p-5">
                    <div class="mb-4">
                        <i class="bi bi-shield-exclamation text-danger error-page__icon"></i>
                    </div>
                    
                    <h1 class="display-6 fw-bold text-danger mb-3">Access Denied</h1>
                    
                    <p class="text-muted mb-4">
                        You don't have permission to access this resource. 
                        Please contact an administrator if you believe this is an error.
                    </p>
                    
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <div class="alert alert-info">
                            <i class="bi bi-info-circle me-2"></i>
                            You are logged in as <strong>@User.Identity.Name</strong>
                        </div>
                        
                        <div class="d-flex flex-column flex-sm-row gap-3 justify-content-center">
                            <button onclick="history.back()" class="wp-btn wp-btn-outline-primary">
                                <i class="bi bi-arrow-left me-2"></i>Go Back
                            </button>
                            
                            @if (User.IsInRole("User"))
                            {
                                <a asp-controller="User" asp-action="Dashboard" class="wp-btn wp-btn-primary">
                                    <i class="bi bi-house me-2"></i>My Dashboard
                                </a>
                            }
                            else if (User.IsInRole("Admin"))
                            {
                                <a asp-controller="Admin" asp-action="Dashboard" class="wp-btn wp-btn-primary">
                                    <i class="bi bi-house me-2"></i>Admin Dashboard
                                </a>
                            }
                            else if (User.IsInRole("SuperAdmin"))
                            {
                                <a asp-controller="SuperAdmin" asp-action="Dashboard" class="wp-btn wp-btn-primary">
                                    <i class="bi bi-house me-2"></i>SuperAdmin Dashboard
                                </a>
                            }
                            else
                            {
                                <a asp-controller="Home" asp-action="Index" class="wp-btn wp-btn-primary">
                                    <i class="bi bi-house me-2"></i>Go Home
                                </a>
                            }
                            
                            <form asp-controller="Auth" asp-action="Logout" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="wp-btn wp-btn-outline-secondary">
                                    <i class="bi bi-box-arrow-right me-2"></i>Logout
                                </button>
                            </form>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning">
                            <i class="bi bi-exclamation-triangle me-2"></i>
                            You need to log in to access this resource.
                        </div>
                        
                        <div class="d-flex flex-column flex-sm-row gap-3 justify-content-center">
                            <a asp-controller="Auth" asp-action="Login" asp-route-returnUrl="@Context.Request.Path" class="wp-btn wp-btn-primary">
                                <i class="bi bi-box-arrow-in-right me-2"></i>Login
                            </a>
                            <a asp-controller="Auth" asp-action="Registration" class="wp-btn wp-btn-outline-primary">
                                <i class="bi bi-person-plus me-2"></i>Register
                            </a>
                            <a asp-controller="Home" asp-action="Index" class="wp-btn wp-btn-outline-secondary">
                                <i class="bi bi-house me-2"></i>Go Home
                            </a>
                        </div>
                    }
                    
                    <hr class="my-4">
                    
                    <div class="text-muted">
                        <small>
                            Need help? Contact our support team at 
                            <a href="mailto:support@whisperingpages.com" class="text-decoration-none">
                                support@whisperingpages.com
                            </a>
                        </small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


