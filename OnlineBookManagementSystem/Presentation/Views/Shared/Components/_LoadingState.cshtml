@model dynamic

@* 
    Atomic Component: Loading State
    Purpose: Reusable loading indicator
    Usage: Show during AJAX operations
*@

<div class="loading-state" data-component="loading-state">
    <div class="loading-state__content">
        <div class="loading-state__spinner">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
        <p class="loading-state__text">@(Model?.Message ?? "Loading...")</p>
    </div>
</div>
