@using OnlineBookManagementSystem.Presentation.ViewModels.Books
@model BookListViewModel

@* 
    Atomic Component: Pagination
    Purpose: Reusable pagination component
    Usage: Works with any paginated data
*@

<div class="pagination-wrapper" data-component="pagination">
    <nav aria-label="Page navigation" class="pagination-nav">
        <ul class="pagination">
            <li class="pagination__item @(Model.CurrentPage == 1 ? "pagination__item--disabled" : "")">
                <a class="pagination__link" 
                   href="#" 
                   data-page="@(Model.CurrentPage - 1)"
                   aria-label="Previous page"
                   @(Model.CurrentPage == 1 ? "tabindex=-1" : "")>
                    <i class="bi bi-chevron-left"></i> Previous
                </a>
            </li>
            
            @for (int i = Math.Max(1, Model.CurrentPage - 2); i <= Math.Min(Model.TotalPages, Model.CurrentPage + 2); i++)
            {
                <li class="pagination__item @(Model.CurrentPage == i ? "pagination__item--active" : "")">
                    <a class="pagination__link" 
                       href="#" 
                       data-page="@i"
                       aria-label="Page @i"
                       @(Model.CurrentPage == i ? "aria-current=page" : "")>
                        @i
                    </a>
                </li>
            }
            
            <li class="pagination__item @(Model.CurrentPage == Model.TotalPages ? "pagination__item--disabled" : "")">
                <a class="pagination__link" 
                   href="#" 
                   data-page="@(Model.CurrentPage + 1)"
                   aria-label="Next page"
                   @(Model.CurrentPage == Model.TotalPages ? "tabindex=-1" : "")>
                    Next <i class="bi bi-chevron-right"></i>
                </a>
            </li>
        </ul>
    </nav>
    
    <div class="pagination__info">
        <small class="pagination__text">
            Showing @((Model.CurrentPage - 1) * 12 + 1) to @(Math.Min(Model.CurrentPage * 12, Model.TotalBooks)) 
            of @Model.TotalBooks books
        </small>
    </div>
</div>
