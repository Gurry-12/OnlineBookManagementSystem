@model dynamic

@* 
    Atomic Component: Error Alert
    Purpose: Reusable error display component
    Usage: Show AJAX errors inline
*@

<div class="error-alert" data-component="error-alert" role="alert">
    <div class="error-alert__content">
        <div class="error-alert__icon">
            <i class="bi bi-exclamation-triangle-fill"></i>
        </div>
        <div class="error-alert__body">
            <h6 class="error-alert__title">@(Model?.Title ?? "Error")</h6>
            <p class="error-alert__message">@(Model?.Message ?? "An error occurred. Please try again.")</p>
        </div>
        <button type="button" class="error-alert__close" data-dismiss="error" aria-label="Close">
            <i class="bi bi-x-lg"></i>
        </button>
    </div>
    
    @if (Model?.RetryAction != null)
    {
        <div class="error-alert__actions">
            <button type="button" class="wp-btn btn--sm wp-btn--primary" onclick="@Model.RetryAction">
                <i class="bi bi-arrow-clockwise me-1"></i>Retry
            </button>
        </div>
    }
</div>

