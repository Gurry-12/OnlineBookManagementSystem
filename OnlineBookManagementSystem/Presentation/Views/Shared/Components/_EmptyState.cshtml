@model dynamic

@* 
    Atomic Component: Empty State
    Purpose: Reusable empty state component
    Usage: Show when no data is available
*@

<div class="empty-state" data-component="empty-state">
    <div class="empty-state__content">
        <i class="bi bi-@(Model.Icon ?? "inbox") empty-state__icon"></i>
        <h5 class="empty-state__title">@(Model.Title ?? "No Data Available")</h5>
        <p class="empty-state__message">@(Model.Message ?? "There is no data to display at this time.")</p>
        
        @if (Model.ActionText != null)
        {
            <button class="btn btn--primary @(Model.ActionClass ?? "")" type="button">
                <i class="bi bi-plus-circle me-2"></i>@Model.ActionText
            </button>
        }
    </div>
</div>
