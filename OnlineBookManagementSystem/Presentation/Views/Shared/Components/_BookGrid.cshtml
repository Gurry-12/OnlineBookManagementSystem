@using OnlineBookManagementSystem.Presentation.ViewModels.Books
@model BookListViewModel

@* 
    Component: Book Grid Container
    Purpose: Handles the grid layout and loops through books
    Usage: Loaded via AJAX for dynamic updates
*@

<div class="book-grid" data-component="book-grid">
    @if (Model.Books.Any())
    {
        <div class="book-grid__items">
            @foreach (var book in Model.Books)
            {
                <div class="book-grid__item">
                    @await Html.PartialAsync("Components/_BookCard", book)
                </div>
            }
        </div>
    }
    else
    {
        @await Html.PartialAsync("Components/_EmptyState", new { 
            Icon = "book",
            Title = "No Books Found",
            Message = "No books match your current filters. Try adjusting your search criteria.",
            ActionText = "Add Your First Book",
            ActionClass = "create-book-btn"
        })
    }
</div>

@if (Model.TotalPages > 1)
{
    @await Html.PartialAsync("Components/_Pagination", Model)
}
