@model OnlineBookManagementSystem.Presentation.ViewModels.Books.BookDetailsViewModel
@{
    var roleContext = Model.RoleContext;
    var isAdmin = roleContext.UserRole == "Admin" || roleContext.UserRole == "SuperAdmin";
    var isUser = roleContext.UserRole == "User";
    var isPublic = roleContext.UserRole == "Public";
    var layoutClass = isAdmin ? "admin-layout" : isUser ? "user-layout" : "public-layout";
}

<div class="@layoutClass">
    <div class="container-fluid py-4">
        
        @* Breadcrumb Navigation - Role Aware *@
        <nav aria-label="breadcrumb" class="mb-4">
            <ol class="breadcrumb">
                @if (isAdmin)
                {
                    <li class="breadcrumb-item"><a asp-controller="Admin" asp-action="Dashboard">Dashboard</a></li>
                    <li class="breadcrumb-item"><a asp-controller="Admin" asp-action="Books">Books</a></li>
                }
                else if (isUser)
                {
                    <li class="breadcrumb-item"><a asp-controller="User" asp-action="Dashboard">Dashboard</a></li>
                    <li class="breadcrumb-item"><a asp-controller="UserBookBrowsing" asp-action="UserBookList">Books</a></li>
                }
                else
                {
                    <li class="breadcrumb-item"><a asp-controller="Public" asp-action="Dashboard">Home</a></li>
                    <li class="breadcrumb-item"><a asp-controller="Public" asp-action="Browse">Browse</a></li>
                }
                <li class="breadcrumb-item active" aria-current="page">@Model.Title</li>
            </ol>
        </nav>

        @* Header Section with Role-Based Actions *@
        <div class="row mb-4">
            <div class="col-12">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h2 class="text-primary mb-1">
                            <i class="fas fa-book me-2"></i>
                            @if (isPublic) { <text>Book Showcase</text> }
                            else { <text>Book Details</text> }
                        </h2>
                        @if (isPublic)
                        {
                            <div class="alert alert-info d-inline-block mb-0">
                                <i class="bi bi-info-circle me-1"></i>
                                <small>Interactive Demo - Clean Architecture Implementation</small>
                            </div>
                        }
                    </div>
                    
                    @* Role-Based Action Buttons *@
                    <div class="btn-group" role="group">
                        @if (roleContext.CanEdit)
                        {
                            <a href="@Url.Action("EditBook", isAdmin ? "Admin" : "Books", new { id = Model.Id })" 
                               class="btn btn-warning">
                                <i class="fas fa-edit me-1"></i>Edit Book
                            </a>
                        }
                        
                        @if (roleContext.CanDelete)
                        {
                            <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#deleteModal">
                                <i class="fas fa-trash me-1"></i>Delete
                            </button>
                        }
                        
                        @if (isUser || isPublic)
                        {
                            <a href="@Url.Action(isUser ? "UserBookList" : "Browse", isUser ? "UserBookBrowsing" : "Public")" 
                               class="btn btn-secondary">
                                <i class="fas fa-arrow-left me-1"></i>Back to Books
                            </a>
                        }
                        else if (isAdmin)
                        {
                            <a href="@Url.Action("Books", "Admin")" class="btn btn-secondary">
                                <i class="fas fa-arrow-left me-1"></i>Back to Books
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>

        @* Main Content Row *@
        <div class="row g-4">
            
            @* Book Image Column *@
            <div class="col-lg-4 col-md-6">
                <div class="wp-card h-100 sticky-top" style="top: 80px;">
                    <div class="wp-card-header">
                        <h5 class="wp-card-title mb-0">
                            <i class="fas fa-image me-2"></i>Book Cover
                        </h5>
                    </div>
                    <div class="wp-card-body text-center">
                        <div class="book-cover-container mb-3">
                            <img src="@(Model.ImageUrl ?? Url.Content("~/images/default-book-improved.svg"))" 
                                 alt="@Model.Title" 
                                 class="img-fluid rounded shadow-sm w-100"
                                 style="max-height: 400px; object-fit: contain;">
                        </div>
                        
                        @* Stock Status *@
                        <div class="mb-3">
                            <span class="@Model.StockBadgeClass">@Model.StockStatus</span>
                        </div>
                        
                        @* User Actions *@
                        @if (roleContext.CanAddToCart && Model.IsInStock)
                        {
                            <div class="d-grid gap-2 mb-3">
                                <div class="input-group mb-2">
                                    <button class="btn btn-outline-secondary" type="button" id="decreaseQty">-</button>
                                    <input type="number" class="form-control text-center" id="quantity" value="1" min="1" max="@Model.StockQuantity">
                                    <button class="btn btn-outline-secondary" type="button" id="increaseQty">+</button>
                                </div>
                                <button class="btn btn-primary btn-lg" id="addToCartBtn" data-book-id="@Model.Id">
                                    <i class="fas fa-shopping-cart me-2"></i>Add to Cart
                                </button>
                            </div>
                        }
                        
                        @if (roleContext.CanToggleFavorite)
                        {
                            <button class="btn @(Model.IsFavorite == true ? "btn-danger" : "btn-outline-danger") w-100" 
                                    id="favoriteBtn" data-book-id="@Model.Id">
                                <i class="fas fa-heart me-2"></i>
                                @(Model.IsFavorite == true ? "Remove from Favorites" : "Add to Favorites")
                            </button>
                        }
                    </div>
                </div>
            </div>

            @* Book Information Column *@
            <div class="col-lg-8 col-md-6">
                <div class="wp-card">
                    <div class="wp-card-header">
                        <h5 class="wp-card-title mb-0">
                            <i class="fas fa-info-circle me-2"></i>Book Information
                        </h5>
                    </div>
                    <div class="wp-card-body">
                        
                        @* Title and Author *@
                        <div class="mb-4">
                            <h1 class="display-6 fw-bold text-primary mb-2">@Model.Title</h1>
                            <p class="fs-4 text-muted mb-0">by @Model.Author</p>
                        </div>

                        @* Rating Display *@
                        <div class="mb-4">
                            <div class="d-flex align-items-center">
                                <div class="star-rating me-3" data-rating="@Model.Rating.AverageRating">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        @if (i <= Math.Floor(Model.Rating.AverageRating))
                                        {
                                            <i class="fas fa-star text-warning"></i>
                                        }
                                        else if (i - 0.5 <= Model.Rating.AverageRating)
                                        {
                                            <i class="fas fa-star-half-alt text-warning"></i>
                                        }
                                        else
                                        {
                                            <i class="far fa-star text-warning"></i>
                                        }
                                    }
                                </div>
                                <span class="text-muted">
                                    @Model.Rating.AverageRating.ToString("F1") 
                                    (@Model.Rating.TotalReviews @(Model.Rating.TotalReviews == 1 ? "review" : "reviews"))
                                </span>
                            </div>
                        </div>

                        @* Book Details Grid *@
                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <div class="info-item">
                                    <strong class="text-muted">Price:</strong>
                                    <span class="fs-4 text-success fw-bold">@Model.FormattedPrice</span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="info-item">
                                    <strong class="text-muted">Category:</strong>
                                    <span>@(Model.CategoryName ?? "Uncategorized")</span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="info-item">
                                    <strong class="text-muted">ISBN:</strong>
                                    <span>@(Model.ISBN ?? "Not Available")</span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="info-item">
                                    <strong class="text-muted">Publication Date:</strong>
                                    <span>@Model.FormattedPublicationDate</span>
                                </div>
                            </div>
                        </div>

                        @* Description *@
                        @if (!string.IsNullOrEmpty(Model.Description))
                        {
                            <div class="mb-4">
                                <h6 class="fw-bold text-muted mb-2">Description</h6>
                                <p class="text-justify">@Model.Description</p>
                            </div>
                        }

                        @* Admin-Only Metadata *@
                        @if (roleContext.ShowAdminMetadata && isAdmin)
                        {
                            <div class="admin-metadata mt-4 pt-4 border-top">
                                <h6 class="fw-bold text-muted mb-3">
                                    <i class="fas fa-cog me-2"></i>Administrative Information
                                </h6>
                                <div class="row g-3">
                                    <div class="col-md-4">
                                        <div class="info-item">
                                            <strong class="text-muted">Created:</strong>
                                            <span>@Model.FormattedCreatedAt</span>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="info-item">
                                            <strong class="text-muted">Updated:</strong>
                                            <span>@Model.FormattedUpdatedAt</span>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="info-item">
                                            <strong class="text-muted">Status:</strong>
                                            <span class="@Model.DeletedBadgeClass">@Model.DeletedStatus</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }

                        @* Public Demo Technical Details *@
                        @if (roleContext.ShowTechnicalDetails && isPublic)
                        {
                            <div class="technical-showcase mt-4 pt-4 border-top">
                                <h6 class="fw-bold text-info mb-3">
                                    <i class="bi bi-code-slash me-2"></i>Technical Implementation
                                </h6>
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <div class="tech-feature">
                                            <strong>Architecture:</strong> Clean Architecture
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="tech-feature">
                                            <strong>Pattern:</strong> CQRS + Repository
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="tech-feature">
                                            <strong>ORM:</strong> Entity Framework Core
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="tech-feature">
                                            <strong>UI:</strong> Bootstrap 5 + Custom CSS
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                @* Reviews Section - Conditional based on role *@
                @if (Model.Rating.TotalReviews > 0 || (roleContext.IsAuthenticated && Model.CanReview == true))
                {
                    <div class="wp-card mt-4">
                        <div class="wp-card-header">
                            <h5 class="wp-card-title mb-0">
                                <i class="fas fa-comments me-2"></i>Reviews & Ratings
                            </h5>
                        </div>
                        <div class="wp-card-body">
                            @if (roleContext.IsAuthenticated && Model.CanReview == true)
                            {
                                @* Review Form for authenticated users *@
                                <div class="review-form mb-4">
                                    <h6 class="fw-bold mb-3">Write a Review</h6>
                                    @await Html.PartialAsync("_ReviewForm", Model.ReviewForm)
                                </div>
                            }
                            
                            @if (Model.Rating.TotalReviews > 0)
                            {
                                @* Reviews List *@
                                <div id="reviewsList">
                                    @* Reviews will be loaded via AJAX *@
                                    <div class="text-center py-3">
                                        <div class="spinner-border text-primary" role="status">
                                            <span class="visually-hidden">Loading reviews...</span>
                                        </div>
                                    </div>
                                </div>
                            }
                            else if (!roleContext.IsAuthenticated)
                            {
                                <div class="text-center text-muted py-4">
                                    <p>No reviews yet. <a asp-controller="Auth" asp-action="Login">Login</a> to write the first review!</p>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@* Delete Confirmation Modal - Admin Only *@
@if (roleContext.CanDelete)
{
    <div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="deleteModalLabel">Confirm Delete</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to delete "<strong>@Model.Title</strong>"?</p>
                    <p class="text-danger"><small>This action cannot be undone.</small></p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-danger" id="confirmDeleteBtn" data-book-id="@Model.Id">
                        <i class="fas fa-trash me-1"></i>Delete Book
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@* Role-Specific Scripts *@
<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Initialize role-based functionality
        const roleContext = @Html.Raw(Json.Serialize(Model.RoleContext));
        
        // Initialize unified interactions
        if (typeof initializeBookDetails === 'function') {
            initializeBookDetails(@Model.Id, roleContext);
        }
        
        // Load reviews if needed
        @if (Model.Rating.TotalReviews > 0)
        {
            <text>
            if (typeof loadBookReviews === 'function') {
                loadBookReviews(@Model.Id);
            }
            </text>
        }
    });
</script>