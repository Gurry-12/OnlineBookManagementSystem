<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Whispering Pages</title>

    <!-- Bootstrap CSS - Local First -->
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet"
          asp-fallback-href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          asp-fallback-test-class="visually-hidden" asp-fallback-test-property="position" asp-fallback-test-value="absolute" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet" />

    <!-- Unified Role-Based Theme Engine -->
    <link href="~/css/role-based-color-system.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/role-based-theme-engine.css" rel="stylesheet" asp-append-version="true" />
    
    <!-- Role Color Palette Fix -->
    <link href="~/css/role-color-palette-fix.css" rel="stylesheet" asp-append-version="true" />


    @RenderSection("Styles", required: false)
</head>
<body class="user-layout user-theme" data-authenticated="true">
    @Html.AntiForgeryToken()
    <!-- Sidebar -->
    <div class="wp-sidebar" id="sidebar">
        <div class="d-flex justify-content-end">
            <button id="toggleSidebar" class="btn btn-transparent border-0 text-light my-3" aria-label="Toggle Sidebar">
                <i class="bi bi-list"></i>
            </button>
        </div>
        <!-- Logo Section -->
        <div class="wp-sidebar-logo container-fluid p-3 mx-auto w-75 bg-white shadow rounded-3 logo-card">
            <img src="@Url.Content("~/images/render_website_name.png")" alt="Whispering Pages Logo" class="img-fluid">
        </div>

        <!-- Sidebar Navigation -->
        <nav class="wp-sidebar-nav">
            <a asp-controller="User" asp-action="Dashboard" class="wp-sidebar-nav-link d-flex align-items-center">
                <i class="bi bi-house-door me-2"></i>
                <span class="wp-sidebar-nav-text sidebar-text">Dashboard</span>
            </a>
            <a asp-controller="User" asp-action="UserBookList" class="wp-sidebar-nav-link d-flex align-items-center">
                <i class="bi bi-search me-2"></i>
                <span class="wp-sidebar-nav-text sidebar-text">Explore Books</span>
            </a>
            <a asp-controller="User" asp-action="UserCart" class="wp-sidebar-nav-link d-flex align-items-center cart-link">
                <i class="bi bi-cart me-2"></i>
                <span class="wp-sidebar-nav-text sidebar-text">Cart</span>
            </a>
            <a asp-controller="User" asp-action="Favorite" class="wp-sidebar-nav-link d-flex align-items-center favorites-link">
                <i class="bi bi-heart-fill me-2"></i>
                <span class="wp-sidebar-nav-text sidebar-text">Favorites</span>
            </a>
            <a asp-controller="User" asp-action="OrderHistory" class="wp-sidebar-nav-link d-flex align-items-center">
                <i class="bi bi-bag-check me-2"></i>
                <span class="wp-sidebar-nav-text sidebar-text">My Orders</span>
            </a>
            <hr />
            <a asp-controller="Home" asp-action="About" class="wp-sidebar-nav-link d-flex align-items-center">
                <i class="bi bi-info-circle me-2"></i>
                <span class="wp-sidebar-nav-text sidebar-text">About</span>
            </a>
            <a asp-controller="Home" asp-action="Support" class="wp-sidebar-nav-link d-flex align-items-center">
                <i class="bi bi-question-circle me-2"></i>
                <span class="wp-sidebar-nav-text sidebar-text">Support</span>
            </a>
            <a asp-controller="Home" asp-action="Terms" class="wp-sidebar-nav-link d-flex align-items-center">
                <i class="bi bi-file-earmark-text me-2"></i>
                <span class="wp-sidebar-nav-text sidebar-text">Terms & Conditions</span>
            </a>
        </nav>
    </div>

    <!-- Main Content -->
    <div class="wp-content ">
        <!-- Top Bar -->
        <div class="wp-top-bar d-flex align-items-center justify-content-between px-4 py-3 bg-white shadow-sm border-bottom sticky-top">
            <div class="d-flex align-items-center gap-3">
                <div class="d-none d-md-block">
                    <h3 class="fw-bold">Welcome to <i class="">Whispering Pages</i></h3>
                    <h5 class="wp-text-muted">Good Morning, Reader</h5>
                </div>
                
                <!-- SuperAdmin Return Button - Only show when SuperAdmin is viewing -->
                @if (Context.Session.GetString("OriginalRole") == "SuperAdmin")
                {
                    <div class="alert superadmin-return-alert d-flex align-items-center mb-0 py-2 px-3 rounded-pill" role="alert">
                        <i class="bi bi-info-circle me-2"></i>
                        <small class="me-3">Viewing as User</small>
                        <a asp-controller="SuperAdmin" asp-action="ReturnToSuperAdmin" class="btn btn-sm rounded-pill">
                            <i class="bi bi-arrow-left me-1"></i>Return to SuperAdmin
                        </a>
                    </div>
                }
            </div>
            <div class="d-flex align-items-center gap-3">
                <span><i class="bi bi-clock me-1"></i><span class="currenttime"></span></span>
                <span><i class="bi bi-calendar me-1"></i><span class="currentdate"></span></span>
                <!-- Cart Badge -->
                <div class="position-relative">
                    <a class="text-decoration-none text-dark" asp-controller="User" asp-action="UserCart">
                        <i class="bi bi-cart" style="font-size: 1.5rem;"></i>
                        <span id="cartItemCount" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="display: none;">0</span>
                    </a>
                </div>
                <!-- Profile Link -->
                <a asp-controller="User" asp-action="Profile" class="wp-btn wp-btn-secondary btn btn-outline-light btn-sm">
                    <i class="bi bi-person-circle me-1"></i>Profile
                </a>
                <!-- User Dropdown -->
                <form asp-controller="Auth" asp-action="Logout" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="wp-btn wp-btn-secondary btn btn-outline-light">
                        <i class="bi bi-box-arrow-right me-1"></i>Logout
                    </button>
                </form>
            </div>
        </div>

        <main class="wp-main-content container-fluid py-4">
            @RenderBody()
        </main>
    </div>

    <!-- Bootstrap Toast Container -->
    <div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1100">
        <!-- Toasts injected via JS -->
    </div>

    <!-- Bootstrap JS - Local First -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"
            asp-fallback-src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
            asp-fallback-test="window.bootstrap"></script>

    @await RenderSectionAsync("Scripts", required: false)

    <!-- Shared Scripts -->
    <script src="~/js/site.js" asp-append-version="true"></script>
    
    <script>
        // Initialize cart count on page load
        document.addEventListener('DOMContentLoaded', function() {
            updateCartCount();
        });

        // Global function to update cart count
        async function updateCartCount() {
            try {
                const response = await fetch('/User/GetCartCount');
                const data = await response.json();
                
                const cartCountElement = document.getElementById('cartItemCount');
                if (cartCountElement) {
                    const newCount = data.count || 0;
                    const oldCount = parseInt(cartCountElement.textContent) || 0;
                    
                    cartCountElement.textContent = newCount;
                    cartCountElement.style.display = (newCount > 0) ? 'inline' : 'none';
                    
                    // Trigger animation if count changed
                    if (newCount !== oldCount && newCount > 0) {
                        cartCountElement.style.animation = 'none';
                        cartCountElement.offsetHeight; // Trigger reflow
                        cartCountElement.style.animation = 'pulse 0.5s ease-in-out';
                    }
                }
            } catch (error) {
                console.error('Error updating cart count:', error);
            }
        }

        // Make updateCartCount globally available
        window.updateCartCount = updateCartCount;
    </script>

</body>
</html>
