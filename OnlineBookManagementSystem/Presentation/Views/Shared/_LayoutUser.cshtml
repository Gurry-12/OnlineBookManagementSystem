<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Whispering Pages</title>

    <!-- Bootstrap CSS - Local First -->
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet"
          asp-fallback-href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          asp-fallback-test-class="visually-hidden" asp-fallback-test-property="position" asp-fallback-test-value="absolute" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet" />

    <!-- Main CSS System -->
    <link href="~/css/main.css" rel="stylesheet" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/css/toastr.min.css" />

    @RenderSection("Styles", required: false)
</head>
<body class="@(ViewData["ThemeClass"] ?? "theme-user")" data-authenticated="true">
    @Html.AntiForgeryToken()
    <div class="wp-sidebar" id="sidebar">
        <div class="wp-sidebar__header">
            <a href="/" class="wp-sidebar__logo">
                <img src="@Url.Content("~/images/render_website_name.png")" alt="Whispering Pages Logo" class="wp-sidebar__logo-icon">
                <span class="wp-sidebar__logo-text">Whispering Pages</span>
            </a>
        </div>

        <nav class="wp-sidebar__nav">
            <div class="wp-sidebar__section">
                <span class="wp-sidebar__section-header">Main</span>
                <div class="wp-sidebar__nav-item">
                    <a asp-controller="User" asp-action="Dashboard" class="wp-sidebar__nav-link">
                        <i class="bi bi-house-door wp-sidebar__nav-icon"></i>
                        <span class="wp-sidebar__nav-text">Dashboard</span>
                    </a>
                </div>
                <div class="wp-sidebar__nav-item">
                    <a asp-controller="User" asp-action="UserBookList" class="wp-sidebar__nav-link">
                        <i class="bi bi-search wp-sidebar__nav-icon"></i>
                        <span class="wp-sidebar__nav-text">Explore Books</span>
                    </a>
                </div>
                <div class="wp-sidebar__nav-item">
                    <a asp-controller="User" asp-action="UserCart" class="wp-sidebar__nav-link cart-link">
                        <i class="bi bi-cart wp-sidebar__nav-icon"></i>
                        <span class="wp-sidebar__nav-text">Cart</span>
                        <span class="wp-sidebar__nav-badge d-none" id="sidebarCartCount">0</span>
                    </a>
                </div>
                <div class="wp-sidebar__nav-item">
                    <a asp-controller="User" asp-action="Favorite" class="wp-sidebar__nav-link favorites-link">
                        <i class="bi bi-heart-fill wp-sidebar__nav-icon"></i>
                        <span class="wp-sidebar__nav-text">Favorites</span>
                    </a>
                </div>
                <div class="wp-sidebar__nav-item">
                    <a asp-controller="User" asp-action="OrderHistory" class="wp-sidebar__nav-link">
                        <i class="bi bi-bag-check wp-sidebar__nav-icon"></i>
                        <span class="wp-sidebar__nav-text">My Orders</span>
                    </a>
                </div>
            </div>
            
            <div class="wp-sidebar__section">
                <span class="wp-sidebar__section-header">Support</span>
                <div class="wp-sidebar__nav-item">
                    <a asp-controller="Home" asp-action="About" class="wp-sidebar__nav-link">
                        <i class="bi bi-info-circle wp-sidebar__nav-icon"></i>
                        <span class="wp-sidebar__nav-text">About</span>
                    </a>
                </div>
                <div class="wp-sidebar__nav-item">
                    <a asp-controller="Home" asp-action="Support" class="wp-sidebar__nav-link">
                        <i class="bi bi-question-circle wp-sidebar__nav-icon"></i>
                        <span class="wp-sidebar__nav-text">Support</span>
                    </a>
                </div>
                <div class="wp-sidebar__nav-item">
                    <a asp-controller="Home" asp-action="Terms" class="wp-sidebar__nav-link">
                        <i class="bi bi-file-earmark-text wp-sidebar__nav-icon"></i>
                        <span class="wp-sidebar__nav-text">Terms & Conditions</span>
                    </a>
                </div>
            </div>
        </nav>
    </div>

    <div class="wp-main-content">
        <div class="wp-top-bar">
            <div class="wp-top-bar__left">
                <button class="wp-top-bar__toggle d-lg-none" id="toggleSidebar" aria-label="Toggle Sidebar">
                    <i class="bi bi-list"></i>
                </button>
                <div class="wp-top-bar__search d-none d-md-block">
                    <i class="bi bi-search wp-top-bar__search-icon"></i>
                    <input type="text" class="wp-top-bar__search-input" placeholder="Search books, authors..." />
                </div>
            </div>
            <div class="wp-top-bar__right">
                <div class="wp-datetime-container d-none d-xl-flex">
                    <span class="wp-datetime-item">
                        <i class="bi bi-clock"></i>
                        <span class="currenttime"></span>
                    </span>
                    <span class="wp-datetime-item">
                        <i class="bi bi-calendar"></i>
                        <span class="currentdate"></span>
                    </span>
                </div>
                
                <div class="position-relative mx-2">
                    <a class="text-decoration-none text-dark" href="#">
                        <i class="bi bi-bell wp-top-bar__cart-icon"></i>
                        <span class="position-absolute top-0 start-100 translate-middle wp-badge rounded-pill bg-danger border border-2 border-white wp-sidebar__nav-badge" style="padding: 0.15rem 0.35rem; font-size: 0.65rem;">3</span>
                    </a>
                </div>
                
                <div class="position-relative mx-2">
                    <a class="text-decoration-none text-dark" asp-controller="User" asp-action="UserCart">
                        <i class="bi bi-cart wp-top-bar__cart-icon"></i>
                        <span id="cartItemCount" class="position-absolute top-0 start-100 translate-middle wp-badge rounded-pill bg-danger border border-2 border-white d-none wp-sidebar__nav-badge" style="padding: 0.15rem 0.35rem; font-size: 0.65rem;">0</span>
                    </a>
                </div>
                
                <div class="dropdown ms-2">
                    <div class="wp-top-bar__user dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                        <div class="d-flex justify-content-center align-items-center rounded-circle bg-primary bg-opacity-20 text-primary" style="width: 2.25rem; height: 2.25rem;">
                            <i class="bi bi-person fw-bold fs-5"></i>
                        </div>
                        <div class="wp-top-bar__user-info d-none d-sm-flex ms-2">
                            <span class="wp-top-bar__user-name fw-bold">My Account</span>
                            <span class="wp-top-bar__user-role">User</span>
                        </div>
                    </div>
                    <ul class="dropdown-menu dropdown-menu-end shadow border-1 glass border-white rounded-3 mt-2">
                        <li>
                            <a class="dropdown-item py-2" asp-controller="User" asp-action="Profile">
                                <i class="bi bi-person-circle me-2 text-primary"></i>Profile settings
                            </a>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <form asp-controller="Auth" asp-action="Logout" method="post" class="m-0 p-0">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="dropdown-item py-2 text-danger">
                                    <i class="bi bi-box-arrow-right me-2"></i>Sign out
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        <main class="wp-content">
            @RenderBody()
        </main>
    </div>

    <!-- Sidebar Overlay for Mobile -->
    <div class="wp-sidebar-overlay" id="sidebarOverlay"></div>

    <!-- Bootstrap Toast Container -->
    <div class="toast-container position-fixed bottom-0 end-0 p-3">
        <!-- Toasts injected via JS -->
    </div>

    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <!-- Toastr JS -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/js/toastr.min.js"></script>

    <!-- Bootstrap JS - Local First -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"
            asp-fallback-src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
            asp-fallback-test="window.bootstrap"></script>

    @await RenderSectionAsync("Scripts", required: false)

    <!-- Shared Scripts -->
    <script src="~/js/site.js" asp-append-version="true"></script>
    
    <script>
        // Initialize cart count on page load
        document.addEventListener('DOMContentLoaded', function() {
            updateCartCount();
        });

        // Global function to update cart count
        async function updateCartCount() {
            try {
                const response = await fetch('/User/GetCartCount');
                const data = await response.json();
                
                const cartCountElement = document.getElementById('cartItemCount');
                if (cartCountElement) {
                    const newCount = data.count || 0;
                    const oldCount = parseInt(cartCountElement.textContent) || 0;
                    
                    cartCountElement.textContent = newCount;
                    cartCountElement.classList.toggle('d-none', newCount <= 0);
                    
                    // Trigger animation if count changed
                    if (newCount !== oldCount && newCount > 0) {
                        cartCountElement.classList.remove('d-none');
                    }
                }
            } catch (error) {
                console.error('Error updating cart count:', error);
            }
        }

        // Make updateCartCount globally available
        window.updateCartCount = updateCartCount;
    </script>

</body>
</html>



