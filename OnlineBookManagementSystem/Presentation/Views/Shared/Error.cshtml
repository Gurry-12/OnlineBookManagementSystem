@model OnlineBookManagementSystem.Infrastructure.Data.Context.ErrorViewModel
@{
    ViewData["Title"] = Model?.Title ?? "Error";
    Layout = "~/Views/Shared/_LayoutPublic.cshtml"; // Ensure we use the public layout
}

<div class="container-fluid d-flex align-items-center justify-content-center min-vh-100 bg-light">
    <div class="row justify-content-center w-100">
        <div class="col-md-8 col-lg-6">
            <div class="wp-card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="wp-card-header bg-danger  text-center py-4">
                    <i class="bi bi-exclamation-triangle-fill display-4"></i>
                    <h2 class="mt-2 mb-0">@Model?.Title</h2>
                </div>
                <div class="wp-card-body p-5 text-center">
                    
                    <h1 class="display-1 fw-bold text-muted mb-4">@Model?.StatusCode</h1>

                    <p class="lead text-dark mb-4">
                        @Model?.Message
                    </p>
                    
                    @if (Model?.ShowRequestId == true)
                    {
                        <div class="alert alert-secondary d-inline-block mb-4">
                            <small class="text-muted">Request ID: <strong>@Model.RequestId</strong></small>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(Model?.Details))
                    {
                        <div class="text-start mb-4">
                            <button class="wp-btn wp-btn-outline-secondary w-100" type="button" data-bs-toggle="collapse" data-bs-target="#errorDetails" aria-expanded="false" aria-controls="errorDetails">
                                Show Technical Details <i class="bi bi-chevron-down"></i>
                            </button>
                            <div class="collapse mt-2" id="errorDetails">
                                <div class="wp-card-body bg-dark text-light font-monospace small error-page__details">
                                    @Model.Details
                                </div>
                            </div>
                        </div>
                    }
                    
                    <div class="d-flex flex-column flex-sm-row gap-3 justify-content-center mt-4">
                        <button onclick="history.back()" class="wp-btn wp-btn-outline-dark px-4">
                            <i class="bi bi-arrow-left me-2"></i>Go Back
                        </button>
                        <a asp-controller="Home" asp-action="Index" class="wp-btn wp-btn-primary px-4">
                            <i class="bi bi-house me-2"></i>Go Home
                        </a>
                    </div>

                    <hr class="my-5">

                    <div class="text-muted small">
                        If you believe this is a mistake, please contact support at
                        <a href="mailto:support@whisperingpages.com" class="text-decoration-none">support@whisperingpages.com</a>.
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Optional: Client-side logging or analytics
        console.error("Error Page Loaded: @Model?.StatusCode - @Model?.Title");
    </script>
}



