<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Whispering Pages Admin</title>

    <!-- Bootstrap CSS - Local First -->
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet"
          asp-fallback-href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          asp-fallback-test-class="visually-hidden" asp-fallback-test-property="position" asp-fallback-test-value="absolute" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet" />

    <!-- Toastr CSS for notifications -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/css/toastr.min.css" />

    <!-- Main CSS System -->
    <link href="~/css/main.css" rel="stylesheet" asp-append-version="true" />

    @RenderSection("Styles", required: false)
</head>
<body class="@(ViewData["ThemeClass"] ?? "theme-admin")">
    @Html.AntiForgeryToken()
    <div class="wp-sidebar" id="sidebar">
        <div class="wp-sidebar__header">
            <a href="/" class="wp-sidebar__logo">
                <img src="@Url.Content("~/images/render_website_name.png")" alt="Whispering Pages Logo" class="wp-sidebar__logo-icon">
                <span class="wp-sidebar__logo-text">Whispering Pages</span>
            </a>
        </div>

        <nav class="wp-sidebar__nav">
            <div class="wp-sidebar__section">
                <span class="wp-sidebar__section-header">Main</span>
                <div class="wp-sidebar__nav-item">
                    <a asp-controller="Admin" asp-action="Dashboard" class="wp-sidebar__nav-link">
                        <i class="bi bi-house-door wp-sidebar__nav-icon"></i>
                        <span class="wp-sidebar__nav-text">Dashboard</span>
                    </a>
                </div>
                <div class="wp-sidebar__nav-item">
                    <a asp-controller="Admin" asp-action="Books" asp-route-page="1" class="wp-sidebar__nav-link">
                        <i class="bi bi-book wp-sidebar__nav-icon"></i>
                        <span class="wp-sidebar__nav-text">Books</span>
                    </a>
                </div>
                <div class="wp-sidebar__nav-item">
                    <a asp-controller="Category" asp-action="CategoryList" class="wp-sidebar__nav-link">
                        <i class="bi bi-tags wp-sidebar__nav-icon"></i>
                        <span class="wp-sidebar__nav-text">Categories</span>
                    </a>
                </div>
                <div class="wp-sidebar__nav-item">
                    <a asp-controller="Admin" asp-action="CreateBook" class="wp-sidebar__nav-link">
                        <i class="bi bi-plus-square wp-sidebar__nav-icon"></i>
                        <span class="wp-sidebar__nav-text">Add Book</span>
                    </a>
                </div>
                <div class="wp-sidebar__nav-item">
                    <a asp-controller="Admin" asp-action="OrderManagement" class="wp-sidebar__nav-link">
                        <i class="bi bi-box-seam wp-sidebar__nav-icon"></i>
                        <span class="wp-sidebar__nav-text">Orders</span>
                    </a>
                </div>
                <div class="wp-sidebar__nav-item">
                    <a asp-controller="Admin" asp-action="UserList" class="wp-sidebar__nav-link">
                        <i class="bi bi-people wp-sidebar__nav-icon"></i>
                        <span class="wp-sidebar__nav-text">Users</span>
                    </a>
                </div>
                <div class="wp-sidebar__nav-item">
                    <a asp-controller="Logs" asp-action="LogList" class="wp-sidebar__nav-link">
                        <i class="bi bi-clock-history wp-sidebar__nav-icon"></i>
                        <span class="wp-sidebar__nav-text">Activity Logs</span>
                    </a>
                </div>
                <div class="wp-sidebar__nav-item">
                    <a asp-controller="ReviewModeration" asp-action="Pending" class="wp-sidebar__nav-link">
                        <i class="bi bi-chat-square-text wp-sidebar__nav-icon"></i>
                        <span class="wp-sidebar__nav-text">Review Moderation</span>
                    </a>
                </div>
            </div>
            
            <div class="wp-sidebar__section">
                <span class="wp-sidebar__section-header">Analytics</span>
                <div class="wp-sidebar__nav-item">
                    <a asp-controller="Analytics" asp-action="OrdersAnalytics" class="wp-sidebar__nav-link">
                        <i class="bi bi-graph-up wp-sidebar__nav-icon"></i>
                        <span class="wp-sidebar__nav-text">Orders Analytics</span>
                    </a>
                </div>
                <div class="wp-sidebar__nav-item">
                    <a asp-controller="Analytics" asp-action="BooksAnalytics" class="wp-sidebar__nav-link">
                        <i class="bi bi-book wp-sidebar__nav-icon"></i>
                        <span class="wp-sidebar__nav-text">Books Analytics</span>
                    </a>
                </div>
                <div class="wp-sidebar__nav-item">
                    <a asp-controller="Analytics" asp-action="ReviewsAnalytics" class="wp-sidebar__nav-link">
                        <i class="bi bi-chat-square-text wp-sidebar__nav-icon"></i>
                        <span class="wp-sidebar__nav-text">Reviews Analytics</span>
                    </a>
                </div>
            </div>
            
            <div class="wp-sidebar__section">
                <span class="wp-sidebar__section-header">Support</span>
                <div class="wp-sidebar__nav-item">
                    <a asp-controller="Home" asp-action="About" class="wp-sidebar__nav-link">
                        <i class="bi bi-info-circle wp-sidebar__nav-icon"></i>
                        <span class="wp-sidebar__nav-text">About</span>
                    </a>
                </div>
                <div class="wp-sidebar__nav-item">
                    <a asp-controller="Home" asp-action="Support" class="wp-sidebar__nav-link">
                        <i class="bi bi-telephone wp-sidebar__nav-icon"></i>
                        <span class="wp-sidebar__nav-text">Support</span>
                    </a>
                </div>
                <div class="wp-sidebar__nav-item">
                    <a asp-controller="Home" asp-action="Terms" class="wp-sidebar__nav-link">
                        <i class="bi bi-file-earmark-text wp-sidebar__nav-icon"></i>
                        <span class="wp-sidebar__nav-text">Terms & Conditions</span>
                    </a>
                </div>
            </div>
        </nav>
    </div>

    <div class="wp-main-content">
        <div class="wp-top-bar">
            <div class="wp-top-bar__left">
                <button class="wp-top-bar__toggle d-lg-none" id="toggleSidebar" aria-label="Toggle Sidebar">
                    <i class="bi bi-list"></i>
                </button>
                <div class="wp-top-bar__search d-none d-md-block">
                    <i class="bi bi-search wp-top-bar__search-icon"></i>
                    <input type="text" class="wp-top-bar__search-input" placeholder="Search books, users, orders..." />
                </div>
            </div>
            <div class="wp-top-bar__right">
                <div class="wp-datetime-container d-none d-xl-flex">
                    <span class="wp-datetime-item">
                        <i class="bi bi-clock"></i>
                        <span class="currenttime"></span>
                    </span>
                    <span class="wp-datetime-item">
                        <i class="bi bi-calendar"></i>
                        <span class="currentdate"></span>
                    </span>
                </div>
                
                <div class="position-relative mx-2">
                    <a class="text-decoration-none text-dark" href="#">
                        <i class="bi bi-bell wp-top-bar__cart-icon"></i>
                        <span class="position-absolute top-0 start-100 translate-middle wp-badge rounded-pill bg-danger border border-2 border-white wp-sidebar__nav-badge" style="padding: 0.15rem 0.35rem; font-size: 0.65rem;">5</span>
                    </a>
                </div>
                
                <div class="dropdown ms-2">
                    <div class="wp-top-bar__user dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                        <div class="d-flex justify-content-center align-items-center rounded-circle bg-success bg-opacity-20 text-success" style="width: 2.25rem; height: 2.25rem;">
                            <i class="bi bi-shield-lock fw-bold fs-5"></i>
                        </div>
                        <div class="wp-top-bar__user-info d-none d-sm-flex ms-2">
                            <span class="wp-top-bar__user-name fw-bold">Admin Portal</span>
                            <span class="wp-top-bar__user-role">Administrator</span>
                        </div>
                    </div>
                    <ul class="dropdown-menu dropdown-menu-end shadow border-1 glass border-white rounded-3 mt-2">
                        <li>
                            <a class="dropdown-item py-2" asp-controller="Auth" asp-action="ProfileView">
                                <i class="bi bi-person-circle me-2 text-primary"></i>Profile settings
                            </a>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <form asp-controller="Auth" asp-action="Logout" method="post" class="m-0 p-0">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="dropdown-item py-2 text-danger">
                                    <i class="bi bi-box-arrow-right me-2"></i>Sign out
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        <main class="wp-content">
            @RenderBody()
        </main>
    </div>

    <!-- Sidebar Overlay for Mobile -->
    <div class="wp-sidebar-overlay" id="sidebarOverlay"></div>

    <!-- Bootstrap Toast Container -->
    <div class="toast-container position-fixed bottom-0 end-0 p-3">
        <!-- Toasts injected via JS -->
    </div>

    <!-- Bootstrap JS - Local First -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"
            asp-fallback-src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
            asp-fallback-test="window.bootstrap"></script>

    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    
    <!-- Toastr JS for notifications -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/js/toastr.min.js"></script>

    <!-- Global AJAX Wrapper (Load before page-specific scripts) -->
    <script src="~/js/core/ajaxWrapper.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

    <!-- Shared Scripts -->
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/role-switcher.js" asp-append-version="true"></script>
    
    <!-- Essential Effects JS -->
    <script src="~/js/essential-effects.js" asp-append-version="true"></script>


</body>
</html>


