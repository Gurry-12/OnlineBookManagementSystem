@model OnlineBookManagementSystem.Presentation.ViewModels.Shared.BookCardViewModel

<div class="book-card @Model.CustomCssClass">
    <!-- Book Image -->
    <div class="book-card__image-container">
        <img src="@(Model.ImageUrl ?? Url.Content("~/images/default-book-improved.svg"))"
             alt="@Model.Title" 
             class="book-card__image">
        
        <!-- Stock Badge -->
        <div class="book-card__badge-container book-card__badge-container--top-right">
            @if (Model.IsInStock)
            {
                <span class="wp-badge-success">
                    <i class="bi bi-check-circle me-1"></i>In Stock
                </span>
            }
            else
            {
                <span class="wp-badge-error">
                    <i class="bi bi-x-circle me-1"></i>Out of Stock
                </span>
            }
        </div>
        
        <!-- Admin Actions Dropdown -->
        @if (Model.CanEdit || Model.CanDelete)
        {
            <div class="book-card__badge-container book-card__badge-container--top-left">
                <div class="dropdown">
                    <button class="wp-btn-secondary wp-btn-sm rounded-circle p-0 d-flex align-items-center justify-content-center" 
                            type="button" data-bs-toggle="dropdown">
                        <i class="bi bi-three-dots"></i>
                    </button>
                    <ul class="dropdown-menu shadow">
                        @if (Model.CanEdit)
                        {
                            <li>
                                <a class="dropdown-item" asp-controller="Admin" asp-action="EditBook" asp-route-id="@Model.Id">
                                    <i class="bi bi-pencil me-2 text-warning"></i>Edit Book
                                </a>
                            </li>
                        }
                        @if (Model.CanDelete)
                        {
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <a class="dropdown-item text-danger" href="#" onclick="deleteBook(@Model.Id, '@Model.Title')">
                                    <i class="bi bi-trash me-2"></i>Delete Book
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        }

        <!-- Favorite Button Overlay (User Role Only) -->
        @if (Model.CanFavorite)
        {
            <div class="book-card__badge-container book-card__badge-container--favorite">
                <button class="wp-btn-secondary wp-btn-sm rounded-circle p-0 d-flex align-items-center justify-content-center" 
                        onclick="toggleFavorite(@Model.Id)" 
                        title="Add to Favorites">
                    <i class="bi @(Model.IsFavorite ? "bi-heart-fill text-danger" : "bi-heart")"></i>
                </button>
            </div>
        }
    </div>

    <!-- Book Info -->
    <div class="book-card__body">
        <div class="book-card__header">
            <h6 class="book-card__title" title="@Model.Title">@Model.Title</h6>
            <p class="book-card__author">
                <i class="bi bi-person me-1"></i>by @Model.Author
            </p>
        </div>
        
        @if (!string.IsNullOrEmpty(Model.CategoryName))
        {
            <div class="book-card__category">
                <span class="wp-badge-info">
                    <i class="bi bi-tag me-1"></i>@Model.CategoryName
                </span>
            </div>
        }
        
        <div class="book-card__footer">
            <!-- Price and Stock Info -->
            <div class="book-card__price-section">
                <div class="book-card__price-info">
                    <span class="book-card__price text-primary fw-bold">@Model.FormattedPrice</span>
                    @if (Model.CanViewTechnicalInfo)
                    {
                        <small class="book-card__stock-info">Stock: @Model.StockQuantity units</small>
                    }
                </div>
                @if (Model.AverageRating > 0)
                {
                    <div class="book-card__rating">
                        <div class="book-card__stars text-warning">
                            @for (int i = 1; i <= 5; i++)
                            {
                                @if (i <= Math.Round(Model.AverageRating))
                                {
                                    <i class="bi bi-star-fill"></i>
                                }
                                else
                                {
                                    <i class="bi bi-star"></i>
                                }
                            }
                        </div>
                        <small class="book-card__rating-score text-muted">@Model.AverageRating.ToString("F1")</small>
                    </div>
                }
            </div>
            
            <!-- Action Buttons -->
            <div class="book-card__actions mt-3 d-flex gap-2">
                <!-- View Details Button (Always Available) -->
                @if (Model.CanViewDetails)
                {
                    <a asp-controller="@Model.DetailsControllerName" 
                       asp-action="@Model.DetailsActionName" 
                       asp-route-id="@Model.Id" 
                       class="wp-btn-secondary wp-btn-sm flex-grow-1">
                        <i class="bi bi-eye me-1"></i>View
                    </a>
                }
                
                <!-- Add to Cart -->
                @if (Model.CanAddToCart && Model.StockQuantity > 0)
                {
                    <button class="wp-btn-primary wp-btn-sm flex-grow-1" onclick="addToCart(@Model.Id)">
                        <i class="bi bi-cart-plus me-1"></i>Add
                    </button>
                }
                else if (Model.CanAddToCart && Model.StockQuantity == 0)
                {
                    <button class="wp-btn-secondary wp-btn-sm flex-grow-1" disabled>
                        <i class="bi bi-x-circle me-1"></i>Out
                    </button>
                }
            </div>
        </div>
    </div>
</div>



