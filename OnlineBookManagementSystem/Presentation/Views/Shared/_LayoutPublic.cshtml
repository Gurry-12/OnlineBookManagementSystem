<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Whispering Pages</title>
    
    <!-- SEO Meta Tags -->
    <meta name="description" content="@(ViewData["Description"] ?? "Online Book Management System - A comprehensive Clean Architecture showcase featuring modern web development practices, SOLID principles, and interactive book browsing experience.")" />
    <meta name="keywords" content="@(ViewData["Keywords"] ?? "book management, clean architecture, ASP.NET Core, portfolio, software development, SOLID principles, modern web design")" />
    <meta name="author" content="Whispering Pages Development Team" />
    <meta name="robots" content="index, follow" />
    <meta name="language" content="English" />
    <meta name="revisit-after" content="7 days" />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="@(ViewData["CanonicalUrl"] ?? $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}")" />
    <meta property="og:title" content="@ViewData["Title"] - Whispering Pages" />
    <meta property="og:description" content="@(ViewData["Description"] ?? "Experience a comprehensive book management system showcasing Clean Architecture, modern UI/UX design, and professional software development practices.")" />
    <meta property="og:image" content="@(ViewData["OgImage"] ?? $"{Context.Request.Scheme}://{Context.Request.Host}/images/og-showcase.jpg")" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Whispering Pages" />
    <meta property="og:locale" content="en_US" />
    
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content="@(ViewData["CanonicalUrl"] ?? $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}")" />
    <meta name="twitter:title" content="@ViewData["Title"] - Whispering Pages" />
    <meta name="twitter:description" content="@(ViewData["Description"] ?? "Experience a comprehensive book management system showcasing Clean Architecture and modern web development.")" />
    <meta name="twitter:image" content="@(ViewData["TwitterImage"] ?? $"{Context.Request.Scheme}://{Context.Request.Host}/images/twitter-showcase.jpg")" />
    <meta name="twitter:creator" content="@@WhisperingPages" />
    <meta name="twitter:site" content="@@WhisperingPages" />
    
    <!-- Canonical URL -->
    <link rel="canonical" href="@(ViewData["CanonicalUrl"] ?? $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}")" />
    
    <!-- Favicon and App Icons -->
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="~/images/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="~/images/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="~/images/favicon-16x16.png" />
    <link rel="manifest" href="~/site.webmanifest" />
    
    <!-- Preconnect for Performance -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" />
    
    <!-- DNS Prefetch -->
    <link rel="dns-prefetch" href="//fonts.googleapis.com" />
    <link rel="dns-prefetch" href="//cdn.jsdelivr.net" />

    <!-- Bootstrap CSS - Local First -->
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet"
          asp-fallback-href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          asp-fallback-test-class="visually-hidden" asp-fallback-test-property="position" asp-fallback-test-value="absolute" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet" />

    <link href="~/css/main.css" rel="stylesheet" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/css/toastr.min.css" />

    @RenderSection("Styles", required: false)
    
    <!-- Structured Data -->
    <script type="application/ld+json">
    {
        "@@context": "https://schema.org",
        "@@type": "WebSite",
        "name": "Whispering Pages",
        "description": "Online Book Management System - Clean Architecture Showcase",
        "url": "@($"{Context.Request.Scheme}://{Context.Request.Host}")",
        "potentialAction": {
            "@@type": "SearchAction",
            "target": {
                "@@type": "EntryPoint",
                "urlTemplate": "@($"{Context.Request.Scheme}://{Context.Request.Host}/Public/Browse?search={{search_term_string}}")"
            },
            "query-input": "required name=search_term_string"
        },
        "publisher": {
            "@@type": "Organization",
            "name": "Whispering Pages",
            "logo": {
                "@@type": "ImageObject",
                "url": "@($"{Context.Request.Scheme}://{Context.Request.Host}/images/logo.png")"
            }
        }
    }
    </script>
    
    @if (ViewData["StructuredData"] != null)
    {
        @Html.Raw(ViewData["StructuredData"])
    }
</head>
<body class="@(ViewData["ThemeClass"] ?? "theme-public")" data-authenticated="false">
    <!-- Skip to main content for screen readers -->
    <a href="#main-content" class="visually-hidden-focusable wp-btn wp-btn-primary wp-skip-link">
        Skip to main content
    </a>
    <nav class="navbar navbar-expand-lg wp-top-bar shadow-sm sticky-top pub-nav" role="navigation" aria-label="Main navigation">
        <div class="pub-nav__inner">
            <a class="pub-nav__brand" href="/" aria-label="Whispering Pages Home">
                <img src="@Url.Content("~/images/Render_main_logo.png")" alt="Whispering Pages Logo" height="40">
                <span>Whispering Pages</span>
            </a>
            <button class="navbar-toggler d-lg-none border-0" type="button" data-bs-toggle="collapse" data-bs-target="#publicNavbar"
                    aria-controls="publicNavbar" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="d-flex justify-content-end collapse navbar-collapse" id="publicNavbar">
                <ul class="pub-nav__links ms-auto" role="menubar">
                    <li><a class="pub-nav__link" asp-controller="Public" asp-action="Dashboard" role="menuitem" aria-label="Go to homepage"><i class="bi bi-house-door" aria-hidden="true"></i>Home</a></li>
                    <li><a class="pub-nav__link" asp-controller="Public" asp-action="Browse" role="menuitem" aria-label="Browse books"><i class="bi bi-book" aria-hidden="true"></i>Browse Books</a></li>
                    <li><a class="pub-nav__link" asp-controller="Public" asp-action="TechnicalDetails" role="menuitem"><i class="bi bi-gear" aria-hidden="true"></i>Technical Details</a></li>
                    <li><a class="pub-nav__link" asp-controller="Public" asp-action="DeveloperStory" role="menuitem"><i class="bi bi-person-circle" aria-hidden="true"></i>Developer Story</a></li>
                
                <li class="pub-nav__cta-group ms-3">
                    <a class="pub-nav__link" asp-controller="Auth" asp-action="Login" aria-label="Login">
                        <i class="bi bi-box-arrow-in-right me-1" aria-hidden="true"></i>Login
                    </a>
                    </li>
                    <li>
                    <a class="pub-nav__link active" asp-controller="Auth" asp-action="Registration" aria-label="Sign Up">
                        <i class="bi bi-person-plus me-1" aria-hidden="true"></i>Sign Up
                    </a>
                </li>
                </ul>
            </div>
        </div>
    </nav>

    <main id="main-content" role="main" class="container mt-4">
        <partial name="_BreadcrumbPartial" />
        @RenderBody()
    </main>

    <footer class="pub-footer" role="contentinfo" aria-label="Site footer">
        <div class="pub-footer__grid">
            <div>
                <h5 class="pub-footer__brand-name">Whispering Pages</h5>
                <p class="pub-footer__brand-desc">Your gateway to endless stories and knowledge. A Clean Architecture showcase for modern web development.</p>
                <div class="pub-footer__social" aria-label="Social media links">
                    <a href="#" class="pub-footer__social-link" aria-label="Facebook" title="Facebook"><i class="bi bi-facebook" aria-hidden="true"></i></a>
                    <a href="#" class="pub-footer__social-link" aria-label="Twitter" title="Twitter"><i class="bi bi-twitter" aria-hidden="true"></i></a>
                    <a href="#" class="pub-footer__social-link" aria-label="Instagram" title="Instagram"><i class="bi bi-instagram" aria-hidden="true"></i></a>
                    <a href="#" class="pub-footer__social-link" aria-label="LinkedIn" title="LinkedIn"><i class="bi bi-linkedin" aria-hidden="true"></i></a>
                </div>
            </div>
            <div>
                <h6 class="pub-footer__col-title">Quick Links</h6>
                <nav aria-label="Footer navigation">
                    <ul class="pub-footer__links">
                        <li><a href="/" class="pub-footer__link" aria-label="Go to homepage">Home</a></li>
                        <li><a asp-controller="Public" asp-action="Browse" class="pub-footer__link">Browse Books</a></li>
                        <li><a asp-controller="Public" asp-action="TechnicalDetails" class="pub-footer__link">Technical Details</a></li>
                        <li><a asp-controller="Public" asp-action="DeveloperStory" class="pub-footer__link">Developer Story</a></li>
                        <li><a asp-controller="Public" asp-action="InteractiveDemo" class="pub-footer__link">Interactive Demo</a></li>
                    </ul>
                </nav>
            </div>
            <div>
                <h6 class="pub-footer__col-title">Get Started</h6>
                <ul class="pub-footer__links">
                    <li><a asp-controller="Auth" asp-action="Login" class="pub-footer__link">Login</a></li>
                    <li><a asp-controller="Auth" asp-action="Registration" class="pub-footer__link">Sign Up</a></li>
                </ul>
            </div>
        </div>
        <div class="pub-footer__bottom">
            <p class="pub-footer__copyright">&copy; 2026 Whispering Pages <i class="bi bi-book-half" aria-hidden="true"></i> — All Rights Reserved</p>
        </div>
    </footer>

    <!-- Bootstrap Toast Container -->
    <div class="toast-container position-fixed bottom-0 end-0 p-3">
        <!-- Toasts injected via JS -->
    </div>

    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <!-- Toastr JS -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/js/toastr.min.js"></script>

    <!-- Bootstrap JS - Local First -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"
            asp-fallback-src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
            asp-fallback-test="window.bootstrap"></script>

    @await RenderSectionAsync("Scripts", required: false)

    <!-- Shared Scripts -->
    <script src="~/js/site.js" asp-append-version="true"></script>
    
    <!-- Essential Effects JS -->

    
    <!-- Accessibility Enhancement Script -->
    <script>
        // Enhanced keyboard navigation and accessibility
        document.addEventListener('DOMContentLoaded', function() {
            // Add focus indicators for keyboard navigation
            document.addEventListener('keydown', function(e) {
                if (e.key === 'Tab') {
                    document.body.classList.add('keyboard-navigation');
                }
            });
            
            document.addEventListener('mousedown', function() {
                document.body.classList.remove('keyboard-navigation');
            });
            
            // Announce page changes to screen readers
            const pageTitle = document.title;
            const announcement = document.createElement('div');
            announcement.setAttribute('aria-live', 'polite');
            announcement.setAttribute('aria-atomic', 'true');
            announcement.className = 'visually-hidden';
            announcement.textContent = `Page loaded: ${pageTitle}`;
            document.body.appendChild(announcement);
            
            // Enhanced skip link functionality
            const skipLink = document.querySelector('.visually-hidden-focusable');
            if (skipLink) {
                skipLink.addEventListener('click', function(e) {
                    e.preventDefault();
                    const target = document.querySelector(this.getAttribute('href'));
                    if (target) {

                        target.focus();
                        target.scrollIntoView({ behavior: 'smooth' });
                    }
                });
            }
        });
    </script>
    
    <!-- Accessibility Styles -->
    
</body>
</html>


