@model OnlineBookManagementSystem.Core.Domain.Entities.Order

@{
    ViewData["Title"] = $"Order #{Model.Id}";
    Layout = ViewData["Layout"]?.ToString() ?? "_LayoutUser";
}

<div class="container py-5">
    <div class="card shadow-lg border-0 rounded-4 mx-auto" style="max-width: 800px;">
        <div class="card-header bg-gradient-success text-white text-center py-4">
            <h2>Order Confirmed!</h2>
            <p class="mb-0">Order ID: <strong>#@Model.Id</strong></p>
        </div>
        <div class="card-body p-5">
            <div class="text-center mb-5">
                <i class="bi bi-check-circle-fill text-success" style="font-size: 5rem;"></i>
                <h3>Thank you, @Model.FullName!</h3>
                <p>Your order has been placed successfully.</p>
            </div>

            <div class="row g-4">
                <div class="col-md-6">
                    <h5>Delivery Address</h5>
                    <p><strong>@Model.FullName</strong><br>@Model.ShippingAddress</p>
                </div>
                <div class="col-md-6 text-md-end">
                    <p><strong>Order Date:</strong> @Model.OrderDate</p>
                    <p><strong>Payment:</strong> @Model.PaymentMethod</p>
                </div>
            </div>

            <hr>

            <h5>Order Items</h5>
            <table class="table">
                <!-- Same as AdminDetails -->
            </table>

            <div class="text-end mt-4">
                <h4>Total: ₹@Model.TotalAmount</h4>
            </div>

            <div class="text-center mt-5">
                <a asp-action="Index" class="btn btn-outline-primary btn-lg">Back to Orders</a>
                <a href="javascript:window.print()" class="btn btn-success btn-lg ms-3">Print Receipt</a>
            </div>
        </div>
    </div>
</div>