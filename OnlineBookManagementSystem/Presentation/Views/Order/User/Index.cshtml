@model IEnumerable<OnlineBookManagementSystem.Core.Domain.Entities.Order>

@{
    ViewData["Title"] = "My Orders";
    Layout = ViewData["Layout"]?.ToString() ?? "_LayoutUser";
}

<div class="container py-5">
    <h2 class="text-center mb-5 display-5 fw-bold text-primary">
        My Orders
    </h2>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-inbox display-1 text-muted mb-4"></i>
            <h4>No orders yet</h4>
            <p class="text-muted">Your ordered books will appear here.</p>
            <a asp-controller="User" asp-action="BookDetails" class="btn btn-primary btn-lg">Start Shopping</a>
        </div>
        return;
    }

    <div class="timeline">
        @foreach (var order in Model.OrderByDescending(o => o.OrderDate))
        {
            var badge = order.Status switch
            {
                OrderStatus.Pending => "bg-warning",
                OrderStatus.Processing => "bg-info",
                OrderStatus.Shipped => "bg - primary",
                OrderStatus.Completed => "bg - success",
                OrderStatus.Cancelled => "bg - danger",
                _ => "bg-secondary"
            };

            <div class="timeline-item mb-5">
                <div class="timeline-marker"></div>
                <div class="timeline-content card shadow-sm border-0 p-4">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div>
                            <h5>Order #@order.Id</h5>
                            <p class="text-muted mb-0">@order.OrderDate</p>
                        </div>
                        <span class="badge @badge fs-6 px-4 py-2">@order.Status</span>
                    </div>
                    <p><strong>Total:</strong> ₹@order.TotalAmount</p>
                    <p><strong>Items:</strong> @order.OrderDetails.Sum(od => od.Quantity)</p>
                    <a asp-action="Details" asp-route-id="@order.Id" class="btn btn-outline-primary btn-sm">
                        View Details
                    </a>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .timeline {
        position: relative;
        padding-left: 40px;
    }

        .timeline::before {
            content: '';
            position: absolute;
            left: 20px;
            top: 0;
            bottom: 0;
            width: 4px;
            background: #e9ecef;
        }

    .timeline-marker {
        width: 16px;
        height: 16px;
        background: #007bff;
        border: 4px solid white;
        border-radius: 50%;
        position: absolute;
        left: 12px;
        box-shadow: 0 0 0 4px #007bff;
    }

    .timeline-item {
        position: relative;
    }

    .timeline-content {
        margin-left: 40px;
    }
</style>