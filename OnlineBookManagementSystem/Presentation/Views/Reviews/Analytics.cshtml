@model OnlineBookManagementSystem.Presentation.ViewModels.Reviews.ReviewAnalyticsViewModel

@{
    ViewData["Title"] = "Review Analytics";
}

<div class="container-fluid py-4">
    <div class="alert alert-info">
        <i class="bi bi-info-circle me-2"></i>
        <strong>Analytics have been moved!</strong> 
        Review analytics are now part of the unified analytics system.
        <a href="@Url.Action("ReviewsAnalytics", "Analytics")" class=" wp-btn wp-btn-primary ms-3">
            <i class="bi bi-graph-up me-2"></i>View Reviews Analytics
        </a>
    </div>
    
    <!-- Legacy compatibility - basic stats -->
    <div class="row g-4">
        <div class="col-md-3">
            <div class="wp-card bg-primary ">
                <div class="wp-card-body text-center">
                    <h6>Total Reviews</h6>
                    <h4>@Model.TotalReviews</h4>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="wp-card bg-warning ">
                <div class="wp-card-body text-center">
                    <h6>Pending</h6>
                    <h4>@Model.PendingReviews</h4>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="wp-card bg-success ">
                <div class="wp-card-body text-center">
                    <h6>Approved</h6>
                    <h4>@Model.ApprovedReviews</h4>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="wp-card bg-danger ">
                <div class="wp-card-body text-center">
                    <h6>Rejected</h6>
                    <h4>@Model.RejectedReviews</h4>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
// Auto-redirect to new analytics after 3 seconds
setTimeout(function() {
    window.location.href = '@Url.Action("ReviewsAnalytics", "Analytics")';
}, 3000);
</script>


