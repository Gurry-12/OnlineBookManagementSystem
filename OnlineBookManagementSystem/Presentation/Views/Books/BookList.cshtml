@model OnlineBookManagementSystem.Presentation.ViewModels.Books.BookListViewModel
@{
    ViewData["Title"] = Model.Capabilities.PageTitle;
    // Layout will be determined by role-based logic in _ViewStart.cshtml
}

<div class="view-books-list">
<div class="book-list">
    <div class="book-list__container">
        <!-- Page Header -->
        <div class="book-list__header">
            <div class="book-list__header-content">
                <div class="book-list__title-section">
                    <h2 class="book-list__title">
                        <i class="bi bi-book me-2"></i>@Model.Capabilities.PageTitle
                    </h2>
                    <p class="book-list__subtitle">
                        @if (Model.TotalBooks > 0)
                        {
                            <text>Showing @Model.Books.Count of @Model.TotalBooks books</text>
                        }
                        else
                        {
                            <text>No books found</text>
                        }
                    </p>
                </div>
                @if (Model.Capabilities.CanCreate)
                {
                    <a asp-controller="Admin" asp-action="CreateBook" class="action-bar__button action-bar__button--primary">
                        <i class="bi bi-plus-circle me-2"></i>@Model.Capabilities.CreateButtonText
                    </a>
                }
            </div>
        </div>

        <!-- Search & Filters -->
        @if (Model.Capabilities.CanSearch || Model.Capabilities.CanFilter || Model.Capabilities.CanSort)
        {
            <div class="action-bar">
                <div class="action-bar__body">
                    <form method="get" asp-action="BookList" id="filter-form">
                        <div class="action-bar__filters">
                            @if (Model.Capabilities.CanSearch)
                            {
                                <div class="filter-group">
                                    <label class="filter-group__label">
                                        <i class="bi bi-search me-1"></i>Search Books
                                    </label>
                                    <div class="search-bar">
                                        <i class="bi bi-search search-bar__icon"></i>
                                        <input type="text" name="search" value="@Model.SearchTerm" 
                                               class="search-bar__input" placeholder="Search by title or author..." />
                                        @if (!string.IsNullOrEmpty(Model.SearchTerm))
                                        {
                                            <button type="button" class="search-bar__clear" onclick="clearSearch()">
                                                <i class="bi bi-x"></i>
                                            </button>
                                        }
                                    </div>
                                </div>
                            }
                            
                            @if (Model.Capabilities.CanFilter)
                            {
                                <div class="filter-group">
                                    <label class="filter-group__label">
                                        <i class="bi bi-tags me-1"></i>Category
                                    </label>
                                    <select name="categoryId" class="filter-group__select" asp-items="ViewBag.Categories">
                                        <option value="">All Categories</option>
                                    </select>
                                </div>
                                
                                <div class="filter-group">
                                    <label class="filter-group__label">
                                        <i class="bi bi-box me-1"></i>Availability
                                    </label>
                                    <select name="inStock" class="filter-group__select">
                                        <option value="">All Books</option>
                                        <option value="true">In Stock</option>
                                        <option value="false">Out of Stock</option>
                                    </select>
                                </div>
                            }
                            
                            @if (Model.Capabilities.CanSort)
                            {
                                <div class="filter-group">
                                    <label class="filter-group__label">
                                        <i class="bi bi-sort-down me-1"></i>Sort By
                                    </label>
                                    <select name="sortBy" class="filter-group__select">
                                        <option value="">Default Order</option>
                                        <option value="priceAsc">Price: Low to High</option>
                                        <option value="priceDesc">Price: High to Low</option>
                                        <option value="stock">Stock: Low to High</option>
                                        <option value="title">Title A-Z</option>
                                        <option value="newest">Newest First</option>
                                    </select>
                                </div>
                            }
                        </div>
                        
                        <div class="action-bar__actions">
                            <button type="submit" class="action-bar__button action-bar__button--primary">
                                <i class="bi bi-funnel me-1"></i>Filter
                            </button>
                            <button type="button" class="action-bar__button action-bar__button--secondary" onclick="clearFilters()">
                                <i class="bi bi-x-circle me-1"></i>Clear
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        }

        <!-- Books Grid -->
        @if (Model.Books.Any())
        {
            <div class="book-list__grid">
                @foreach (var book in Model.Books)
                {
                    <div class="book-card">
                        <!-- Book Image -->
                        <div class="book-card__image-container">
                            <img src="@(book.ImageUrl ?? Url.Content("~/images/default-book-improved.svg"))"
                                 alt="@book.Title" 
                                 class="book-card__image">
                            
                            <!-- Stock Badge -->
                            <div class="book-card__badge-container book-card__badge-container--top-right">
                                @if (book.StockQuantity > 0)
                                {
                                    <span class="book-card__badge book-card__badge--success">
                                        <i class="bi bi-check-circle me-1"></i>In Stock
                                    </span>
                                }
                                else
                                {
                                    <span class="book-card__badge book-card__badge--danger">
                                        <i class="bi bi-x-circle me-1"></i>Out of Stock
                                    </span>
                                }
                            </div>
                            
                            <!-- Admin Actions Dropdown -->
                            @if (Model.Capabilities.CanEdit || Model.Capabilities.CanDelete)
                            {
                                <div class="book-card__badge-container book-card__badge-container--top-left">
                                    <div class="dropdown">
                                        <button class="book-card__action-btn book-card__action-btn--dropdown" 
                                                type="button" data-bs-toggle="dropdown">
                                            <i class="bi bi-three-dots"></i>
                                        </button>
                                        <ul class="dropdown-menu shadow">
                                            @if (Model.Capabilities.CanEdit)
                                            {
                                                <li>
                                                    <a class="dropdown-item" asp-controller="Admin" asp-action="EditBook" asp-route-id="@book.Id">
                                                        <i class="bi bi-pencil me-2 text-warning"></i>Edit Book
                                                    </a>
                                                </li>
                                            }
                                            @if (Model.Capabilities.CanDelete)
                                            {
                                                <li><hr class="dropdown-divider"></li>
                                                <li>
                                                    <a class="dropdown-item text-danger" href="#" onclick="deleteBook(@book.Id, '@book.Title')">
                                                        <i class="bi bi-trash me-2"></i>Delete Book
                                                    </a>
                                                </li>
                                            }
                                        </ul>
                                    </div>
                                </div>
                            }

                            <!-- Favorite Button Overlay (User Role Only) -->
                            @if (Model.Capabilities.CanFavorite)
                            {
                                <div class="book-card__badge-container book-card__badge-container--favorite">
                                    <button class="book-card__action-btn book-card__action-btn--favorite" 
                                            onclick="toggleFavorite(@book.Id)" 
                                            title="Add to Favorites">
                                        <i class="bi bi-heart"></i>
                                    </button>
                                </div>
                            }
                        </div>

                        <!-- Book Info -->
                        <div class="book-card__body">
                            <div class="book-card__header">
                                <h6 class="book-card__title" title="@book.Title">@book.Title</h6>
                                <p class="book-card__author">
                                    <i class="bi bi-person me-1"></i>by @book.Author
                                </p>
                            </div>
                            
                            @if (!string.IsNullOrEmpty(book.Category?.Name))
                            {
                                <div class="book-card__category">
                                    <span class="book-card__category-badge">
                                        <i class="bi bi-tag me-1"></i>@book.Category.Name
                                    </span>
                                </div>
                            }
                            
                            <div class="book-card__footer">
                                <!-- Price and Stock Info -->
                                <div class="book-card__price-section">
                                    <div class="book-card__price-info">
                                        <span class="book-card__price">@book.Price.Amount.ToString("C")</span>
                                        @if (Model.Capabilities.CanViewTechnicalInfo)
                                        {
                                            <small class="book-card__stock-info">Stock: @book.StockQuantity units</small>
                                        }
                                    </div>
                                    @if (book.AverageRating > 0)
                                    {
                                        <div class="book-card__rating">
                                            <div class="book-card__stars">
                                                @for (int i = 1; i <= 5; i++)
                                                {
                                                    @if (i <= Math.Round(book.AverageRating))
                                                    {
                                                        <i class="bi bi-star-fill"></i>
                                                    }
                                                    else
                                                    {
                                                        <i class="bi bi-star"></i>
                                                    }
                                                }
                                            </div>
                                            <small class="book-card__rating-score">@book.AverageRating.ToString("F1")</small>
                                        </div>
                                    }
                                </div>
                                
                                <!-- Action Buttons -->
                                <div class="book-card__actions">
                                    <!-- View Details Button (Always Available) -->
                                    @if (Model.Capabilities.CanViewBookDetails)
                                    {
                                        <a asp-controller="@Model.Capabilities.DetailsControllerName" 
                                           asp-action="@Model.Capabilities.DetailsActionName" 
                                           asp-route-id="@book.Id" 
                                           class="book-card__btn book-card__btn--secondary">
                                            <i class="bi bi-eye me-1"></i>View Details
                                        </a>
                                    }
                                    
                                    <!-- User-Only Actions -->
                                    @if (Model.Capabilities.CanAddToCart && book.StockQuantity > 0)
                                    {
                                        <button class="book-card__btn book-card__btn--primary" onclick="addToCart(@book.Id)">
                                            <i class="bi bi-cart-plus me-1"></i>Add to Cart
                                        </button>
                                    }
                                    else if (Model.Capabilities.CanAddToCart && book.StockQuantity == 0)
                                    {
                                        <button class="book-card__btn book-card__btn--disabled" disabled>
                                            <i class="bi bi-x-circle me-1"></i>Out of Stock
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <!-- No Books Found -->
            <div class="empty-state">
                <div class="empty-state__icon">
                    <i class="bi bi-book"></i>
                </div>
                <h4 class="empty-state__title">No books found</h4>
                <p class="empty-state__description">
                    @if (!string.IsNullOrEmpty(Model.SearchTerm))
                    {
                        <text>Try adjusting your search criteria or </text>
                        <a href="@Url.Action("BookList")" class="empty-state__link">view all books</a>
                    }
                    else if (Model.Capabilities.CanCreate)
                    {
                        <text>Get started by adding your first book to the catalog.</text>
                    }
                    else
                    {
                        <text>Check back later for new additions to our catalog.</text>
                    }
                </p>
                @if (Model.Capabilities.CanCreate)
                {
                    <div class="empty-state__action">
                        <a asp-controller="Admin" asp-action="CreateBook" class="action-bar__button action-bar__button--primary">
                            <i class="bi bi-plus-circle me-2"></i>Add First Book
                        </a>
                    </div>
                }
            </div>
        }

        <!-- Pagination -->
        @if (Model.Capabilities.CanPaginate && Model.TotalPages > 1)
        {
            <nav aria-label="Book pagination" class="book-list__pagination">
                <ul class="pagination justify-content-center">
                    <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="BookList" asp-route-page="@(Model.CurrentPage - 1)" 
                           asp-route-search="@Model.SearchTerm" asp-route-categoryId="@Model.CategoryId" 
                           asp-route-sortBy="@Model.SortBy">
                            <i class="bi bi-chevron-left"></i> Previous
                        </a>
                    </li>
                    
                    @{
                        int startPage = Math.Max(1, Model.CurrentPage - 2);
                        int endPage = Math.Min(Model.TotalPages, Model.CurrentPage + 2);
                    }
                    
                    @if (startPage > 1)
                    {
                        <li class="page-item">
                            <a class="page-link" asp-action="BookList" asp-route-page="1" 
                               asp-route-search="@Model.SearchTerm" asp-route-categoryId="@Model.CategoryId" 
                               asp-route-sortBy="@Model.SortBy">1</a>
                        </li>
                        @if (startPage > 2)
                        {
                            <li class="page-item disabled">
                                <span class="page-link">...</span>
                            </li>
                        }
                    }
                    
                    @for (int i = startPage; i <= endPage; i++)
                    {
                        <li class="page-item @(Model.CurrentPage == i ? "active" : "")">
                            <a class="page-link" asp-action="BookList" asp-route-page="@i" 
                               asp-route-search="@Model.SearchTerm" asp-route-categoryId="@Model.CategoryId" 
                               asp-route-sortBy="@Model.SortBy">@i</a>
                        </li>
                    }
                    
                    @if (endPage < Model.TotalPages)
                    {
                        @if (endPage < Model.TotalPages - 1)
                        {
                            <li class="page-item disabled">
                                <span class="page-link">...</span>
                            </li>
                        }
                        <li class="page-item">
                            <a class="page-link" asp-action="BookList" asp-route-page="@Model.TotalPages" 
                               asp-route-search="@Model.SearchTerm" asp-route-categoryId="@Model.CategoryId" 
                               asp-route-sortBy="@Model.SortBy">@Model.TotalPages</a>
                        </li>
                    }
                    
                    <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="BookList" asp-route-page="@(Model.CurrentPage + 1)" 
                           asp-route-search="@Model.SearchTerm" asp-route-categoryId="@Model.CategoryId" 
                           asp-route-sortBy="@Model.SortBy">
                            Next <i class="bi bi-chevron-right"></i>
                        </a>
                    </li>
                </ul>
            </nav>
        }
    </div>
</div>
</div>

@section Scripts {
    <script>
        function clearSearch() {
            document.querySelector('input[name="search"]').value = '';
            document.getElementById('filter-form').submit();
        }

        function clearFilters() {
            document.getElementById('filter-form').reset();
            window.location.href = '@Url.Action("BookList")';
        }

        function addToCart(bookId) {
            if (!@Model.Capabilities.IsAuthenticated.ToString().ToLower()) {
                window.location.href = '@Url.Action("Login", "Auth")';
                return;
            }

            fetch('/Cart/Add', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
                },
                body: JSON.stringify({ bookId: bookId, quantity: 1 })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    showNotification('Book added to cart!', 'success');
                    updateCartCount(data.cartCount);
                } else {
                    showNotification(data.message || 'Failed to add book to cart', 'error');
                }
            })
            .catch(error => {
                showNotification('Error adding book to cart', 'error');
                console.error('Error:', error);
            });
        }

        function toggleFavorite(bookId) {
            if (!@Model.Capabilities.IsAuthenticated.ToString().ToLower()) {
                window.location.href = '@Url.Action("Login", "Auth")';
                return;
            }

            fetch('/Books/ToggleFavorite', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
                },
                body: JSON.stringify({ bookId: bookId })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    showNotification('Favorites updated!', 'success');
                    // Update heart icon
                    const heartIcon = document.querySelector(`button[onclick="toggleFavorite(${bookId})"] i`);
                    if (heartIcon) {
                        heartIcon.classList.toggle('bi-heart');
                        heartIcon.classList.toggle('bi-heart-fill');
                    }
                } else {
                    showNotification(data.message || 'Failed to update favorites', 'error');
                }
            })
            .catch(error => {
                showNotification('Error updating favorites', 'error');
                console.error('Error:', error);
            });
        }

        function deleteBook(bookId, bookTitle) {
            if (confirm(`Are you sure you want to delete "${bookTitle}"?`)) {
                fetch(`/Admin/DeleteBook/${bookId}`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
                    }
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        showNotification('Book deleted successfully!', 'success');
                        setTimeout(() => {
                            window.location.reload();
                        }, 1500);
                    } else {
                        showNotification(data.message || 'Failed to delete book', 'error');
                    }
                })
                .catch(error => {
                    showNotification('Error deleting book', 'error');
                    console.error('Error:', error);
                });
            }
        }

        function updateCartCount(count) {
            const cartBadge = document.querySelector('#cart-count');
            if (cartBadge) {
                cartBadge.textContent = count;
                cartBadge.style.display = count > 0 ? 'inline' : 'none';
            }
        }

        function showNotification(message, type) {
            // Create toast notification
            const toast = document.createElement('div');
            toast.className = `alert alert-${type === 'error' ? 'danger' : type} alert-dismissible fade show position-fixed`;
            toast.style.cssText = 'top: 20px; right: 20px; z-index: 9999; min-width: 300px;';
            toast.innerHTML = `
                ${message}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            `;
            document.body.appendChild(toast);

            // Auto remove after 3 seconds
            setTimeout(() => {
                if (toast.parentNode) {
                    toast.parentNode.removeChild(toast);
                }
            }, 3000);
        }
    </script>
}