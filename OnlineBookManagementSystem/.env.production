# PRODUCTION ENVIRONMENT VARIABLES
# Copy this file to .env and update with your actual values

# ===== DOMAIN CONFIGURATION =====
DOMAIN_NAME=whisperingpages.com
ENABLE_HTTPS=true
SSL_EMAIL=admin@whisperingpages.com

# ===== DATABASE CONFIGURATION =====
SA_PASSWORD=YourStrong!ProductionPassw0rd2024
DATABASE_CONNECTION_STRING=Server=sqlserver;Database=WhisperingPages;User Id=sa;Password=YourStrong!ProductionPassw0rd2024;TrustServerCertificate=true;

# ===== JWT CONFIGURATION =====
JWT_SECRET_KEY=WhisperingPages_Production_JWT_Key_2024_Enterprise_BookManagement_System_512bit_SecureKey_ForProductionUse
JWT_ISSUER=WhisperingPages
JWT_AUDIENCE=WhisperingPagesUsers

# ===== EMAIL CONFIGURATION =====
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=noreply@whisperingpages.com
SMTP_PASSWORD=your-app-specific-password
FROM_EMAIL=noreply@whisperingpages.com
FROM_NAME=Whispering Pages

# ===== REDIS CONFIGURATION =====
REDIS_CONNECTION_STRING=redis:6379

# ===== APPLICATION SETTINGS =====
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080;https://+:8443

# ===== SECURITY SETTINGS =====
ENABLE_RATE_LIMITING=true
ENABLE_HTTPS_REDIRECT=true
ENABLE_HSTS=true

# ===== PERFORMANCE SETTINGS =====
ENABLE_RESPONSE_COMPRESSION=true
ENABLE_RESPONSE_CACHING=true
ENABLE_DISTRIBUTED_CACHE=true

# ===== MONITORING =====
ENABLE_HEALTH_CHECKS=true
ENABLE_DETAILED_ERRORS=false