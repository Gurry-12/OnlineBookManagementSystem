# Environment Variables for Docker Deployment
# Copy this file to .env and update the values

# Database Configuration
SA_PASSWORD=YourStrong!Passw0rd
DATABASE_CONNECTION_STRING=Server=sqlserver;Database=WhisperingPages;User Id=sa;Password=YourStrong!Passw0rd;TrustServerCertificate=true;

# JWT Configuration
JWT_SECRET_KEY=WhisperingPages_SuperSecure_JWT_Key_2024_Enterprise_BookManagement_System_256bit_Updated_For_Production_Security
JWT_ISSUER=WhisperingPages
JWT_AUDIENCE=WhisperingPagesUsers

# Email Configuration (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
FROM_EMAIL=noreply@whisperingpages.com

# Redis Configuration
REDIS_CONNECTION_STRING=redis:6379

# Application Settings
ASPNETCORE_ENVIRONMENT=Production