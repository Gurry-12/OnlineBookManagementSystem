{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Error"
    }
  },
  
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=WhisperingPages;Trusted_Connection=true;MultipleActiveResultSets=true;TrustServerCertificate=true;"
  },
  
  "RateLimiting": {
    "EnableRateLimiting": true,
    "PermitLimit": 50,
    "Window": "00:01:00",
    "QueueLimit": 5
  },
  
  "Features": {
    "EnableSwagger": false,
    "EnableHealthChecks": true,
    "EnableMetrics": true,
    "EnableDatabaseSeeding": false
  }
}